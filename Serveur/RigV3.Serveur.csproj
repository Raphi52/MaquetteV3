<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- LA PARTIE SERVEUR de la V3 de RIG (decision Q4 : .NET 10, hebergee chez
       Amitel ; l'ecran RigV3Desktop l'appelle depuis les serveurs RDS).
       Un module par fichier (IModuleServeur), trouve tout seul au demarrage :
       ajouter une route n'oblige a toucher aucun fichier commun.
       Mode d'emploi : docs/reconstruction/architecture.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RigV3.Serveur</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Contrats/RigV3.Contrats.csproj" />
    <ProjectReference Include="../Base/RigV3.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SOC-001 : la session Windows de l'agent (Kerberos / NTLM), inscrite par
         Socle/Identite/ModuleIdentite.cs. Hors du framework partage ASP.NET Core. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <!-- SOC-010 : la partie serveur tourne en SERVICE WINDOWS sur chaque site (Amitel, Antilles,
         Reunion, Polynesie), comme la vingtaine de services de la V2 (catalogue-services.md:11-20).
         Program.cs appelle UseWindowsService, sans effet hors service (bancs, dotnet run). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

</Project>
