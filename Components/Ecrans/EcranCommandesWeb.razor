    private RenderFragment ZoneTypes(CommandeRecue c) => __builder =>
    {
        var cases = TraitementCommandes.CasesCommandees(c);
        var dt = TraitementCommandes.DateTravail.ToString("dd/MM/yyyy");
        <section class="rig-tcw__zone"
                 title="@InfobulleTypes">
            <div class="rig-tcw__zone-tete">
                <span class="rig-tcw__section">Types d'inscription commandés</span>
            </div>
            <div class="rig-tcw__discret">Travail @dt · Fraîcheur @dt</div>
            @if (cases.Count == 0)
            {
                <div class="rig-tcw__discret">Aucun type d'inscription n'a été reçu avec cette commande.</div>
            }
            else
            {
                <label class="rig-tcw__case rig-tcw__case--tout">
                    <input type="checkbox" checked="@TousTypesCoches(cases)" @onchange="e => CocherTous(cases, e.Value is true)" />
                    <span>Tout cocher</span>
