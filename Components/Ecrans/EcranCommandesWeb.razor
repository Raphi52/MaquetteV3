    protected override void OnInitialized() => Rafraichir();

    // ================================================================ recherche

    private void BasculerEtat(EtatCommande etat)
    {
        if (!EtatsChoisis.Remove(etat)) EtatsChoisis.Add(etat);
    }

    private void SurToucheRecherche(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Rechercher();
    }

    private void Rechercher()
    {
        FamilleCommande? famille = Enum.TryParse<FamilleCommande>(FamilleChoisie, out var f) ? f : null;
        Appliques = new CriteresCommandes(famille, new HashSet<EtatCommande>(EtatsChoisis), Du, Au,
                                          SirenCherche, ReferenceCherchee, EnAttenteEnvoi);
        Selection = null;
        Message = null;
        Rafraichir();
    }

    /// <summary>Relit la liste selon les criteres appliques ; une liste sans selection se deplie.</summary>
    private void Rafraichir()
    {
        Groupes = TraitementCommandes.Regrouper(TraitementCommandes.Filtrer(Toutes, Appliques), DirectsEnTete);
        if (Selection is null && Groupes.Count > 0) { RechercheRepliee = false; ListeRepliee = false; }
    }

    private IReadOnlyList<CommandeRecue> Ordre => Groupes.SelectMany(g => g.Commandes).ToList();

    private void RouvrirRecherche()
    {
        RechercheRepliee = false;
        ListeRepliee = false;
    }

    private void BasculerDirects()
    {
        DirectsEnTete = !DirectsEnTete;
        Rafraichir();
    }

    private void BasculerGroupe(FamilleCommande famille)
    {
        if (!GroupesReplies.Remove(famille)) GroupesReplies.Add(famille);
    }

    private void ToutReplier()
    {
        foreach (var g in Groupes) GroupesReplies.Add(g.Famille);
    }

    // ================================================================ selection

    private void Choisir(CommandeRecue c)
    {
        Selection = c;
        // Une commande choisie : la recherche se reduit a une loupe et la liste a un rail.
        RechercheRepliee = true;
        ListeRepliee = true;
        BandeOuverte = null;
        MotifSaisi = string.Empty;
        CoordonneesOuvertes = false;

        RechSiren = c.Siren;
        RechRaison = c.Denomination;
        TousDebiteurs = false;
        TousEtablissements = false;
        Resultat = TraitementCommandes.RechercherPour(c);

        TypesCoches.Clear();
        foreach (var k in TraitementCommandes.CasesCommandees(c))
            foreach (var code in k.EstRegroupement ? k.Enfants.Select(e => e.Code) : [k.Code])
                TypesCoches.Add(code);
        QuantiteInscriptions = 1;

        SousTypes.Clear();
        if (c.SousType is { } st && st != SousTypeCno.InjonctionDePayer) SousTypes.Add(st);
        QuantiteCno = 1;
        CertificatDOpposition = false;

        Certificats.Clear();
        Certificats[CertificatFaillite.NonFaillite] = c.Famille == FamilleCommande.Faillite ? 1 : 0;
        Certificats[CertificatFaillite.NonRcs] = 0;
        Certificats[CertificatFaillite.NonRsac] = 0;
        CertificatDeFaillite = false;

        // Une commande web porte deja son adresse mail : la case est cochee par defaut (#2294).
        AdresseMail = c.Email;
        EnvoiMail = c.Origine != OrigineCommande.Guichet && c.Email.Length > 0;
    }

    private static List<(string Libelle, string Valeur)> DonneesRecues(CommandeRecue c)
    {
        var champs = new List<(string, string)>();
        switch (TraitementCommandes.Groupe(c.Famille))
        {
            case FamilleCommande.NonOpposition:
                champs.Add(("Sous-type reçu", c.SousType is { } st ? TraitementCommandes.Libelle(st) : ""));
                champs.Add(("N° affaire", c.NumeroAffaire));
                champs.Add(("Dénomination", c.Denomination));
                champs.Add(("SIREN", TraitementCommandes.FormaterSiren(c.Siren)));
                champs.Add(("Réf. client", c.ReferenceClient));
                champs.Add(("Adresse de livraison", string.Join(", ", c.AdresseLivraison)));
                champs.Add(("Email", c.Email));
                break;
            case FamilleCommande.Faillite:
                champs.Add(("N° de gestion", c.NumeroGestion));
                champs.Add(("Raison sociale", c.Denomination));
                champs.Add(("SIREN", TraitementCommandes.FormaterSiren(c.Siren)));
                break;
            default:
                champs.Add(("Raison sociale", c.Denomination));
                champs.Add(("SIREN", TraitementCommandes.FormaterSiren(c.Siren)));
                champs.Add(("Non Inscrit", c.Famille == FamilleCommande.EtatEndettementNonInscrit ? "Oui" : "Non"));
                champs.Add(("Adresse", ""));
                break;
        }
        champs.Add(("Nom du requérant", c.Requerant));
        return champs;
    }

    // ================================================================ zones

    private RenderFragment ZoneRapprochement(CommandeRecue c, bool debiteur) => __builder =>
    {
        var retenue = TraitementCommandes.Entite(c.CibleRetenue);
        var entites = Resultat.Entites;
        var affichees = entites.Select(e => (Entite: e, Lignes: debiteur
                ? TraitementCommandes.LignesVisibles(e, TousDebiteurs, TousEtablissements)
                : e.Lignes.ToList())).ToList();
        <section class="rig-tcw__zone">
            <div class="rig-tcw__zone-tete">
                <span class="rig-tcw__section">@(debiteur ? "Débiteur — rapprochement" : "Dossier concerné")</span>
                @if (!debiteur)
                {
                    <span class="rig-tcw__discret">@(c.Famille == FamilleCommande.Faillite
                        ? "Résolution directe par le n° de gestion reçu : aucune recherche à faire dans le cas nominal."
                        : "Un seul dossier attendu. Si la recherche ne ramène rien, la création du non-inscrit se fait dans RIG V2.")</span>
                }
            </div>
            <div class="rig-tcw__rech-debiteur">
                <input class="rig-saisie-champ__saisie" aria-label="SIREN" placeholder="SIREN" @bind="RechSiren" @bind:event="oninput" />
                <input class="rig-saisie-champ__saisie" aria-label="Raison sociale" placeholder="Raison sociale" @bind="RechRaison" @bind:event="oninput" />
                <button class="rig-bouton rig-tcw__bouton" @onclick="RelancerRapprochement">Rechercher</button>
                @if (debiteur)
                {
                    <button class="rig-bascule @(TousDebiteurs ? "rig-bascule--actif" : "")" @onclick="() => TousDebiteurs = !TousDebiteurs">
                        <span class="rig-bascule__temoin"></span><span>Tous les débiteurs</span>
                    </button>
                    <button class="rig-bascule @(TousEtablissements ? "rig-bascule--actif" : "")" @onclick="() => TousEtablissements = !TousEtablissements">
                        <span class="rig-bascule__temoin"></span><span>Tous les établissements</span>
