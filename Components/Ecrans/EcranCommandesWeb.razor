                    ? "Sélectionnez le dossier concerné pour rattacher le certificat."
                    : "Plusieurs entités répondent alors qu'un seul dossier est attendu : désignez la bonne.")</div>
            }
            @if (entites.Count > 0)
            {
                <div class="rig-table-cadre rig-tcw__cadre">
                    <table class="rig-table rig-tcw__rappro">
                        <thead>
                            <tr><th>Dossier</th><th>Nature</th><th>Désignation</th><th>Siren</th><th>Adresse</th><th>Type</th><th>Nb ins</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (entite, lignes) in affichees)
                            {
                                var e = entite;
                                var estRetenue = e.Cle == c.CibleRetenue;
                                <tr class="rig-tcw__bloc @(estRetenue ? "rig-tcw__bloc--retenu" : "")" @ondblclick="() => Retenir(e)">
                                    <td colspan="7">
                                        <span class="rig-tcw__pastille rig-tcw__pastille--accent">@(e.NonInscrit ? "NON-INSCRIT" : "DOSSIER RCS")</span>
                                        <b>@e.Designation</b>
                                        <span class="rig-tcw__discret">@TraitementCommandes.ResumeEntite(e)</span>
                                        @if (e.Radie)
                                        {
                                            <span class="rig-tcw__pastille rig-tcw__pastille--radie">RADIÉ</span>
                                        }
                                        @if (estRetenue)
                                        {
                                            <span class="rig-tcw__pastille rig-tcw__pastille--retenue">RETENUE</span>
                                        }
                                    </td>
                                    <td class="rig-tcw__cellule-action">
                                        @if (!estRetenue)
                                        {
                                            <button class="rig-tcw__lien" @onclick="() => Retenir(e)">Retenir</button>
                                        }
                                    </td>
                                </tr>
                                @foreach (var l in lignes)
                                {
                                    <tr class="@(estRetenue ? "rig-tcw__ligne--retenue" : "")" @ondblclick="() => Retenir(e)">
                                        <td class="rig-table__mono">@(e.Gestion.Length > 0 ? e.Gestion : "NI")</td>
                                        <td><span class="rig-tcw__nature">@l.Nature</span></td>
                                        <td>@e.Designation</td>
                                        <td class="rig-table__mono">@TraitementCommandes.FormaterSiren(e.Siren)</td>
                                        <td title="@l.Adresse">@l.Adresse</td>
                                        <td>@e.Type</td>
                                        <td class="rig-table__centre">@l.NbInscriptions</td>
