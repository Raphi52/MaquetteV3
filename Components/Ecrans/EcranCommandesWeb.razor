@* Ecran PROC_COMMANDES_WEB — « Traitement des commandes » de NeoRIG, porte dans
   la maquette pour le voir avec ses themes.

   Mise en page reprise de D:\RIG-V3 (lu sans y toucher) :
     CommandesWebViewModel.cs   carte de recherche + date de travail, puis
                                liste a gauche, en-tete et detail a droite ;
                                une commande choisie replie la recherche (loupe)
                                et reduit la liste a un rail.
     ListeCommandesWebNode.cs   « Nouvelle commande », groupes par type,
                                pastille « Rapprochement direct ».
     DetailCommandeWebNode.cs   zones selon le type (ZonesCommandeWebRegle),
                                edition repliee et decisions en pied.
   Les libelles sont ceux de Libelles.resx ; les regles sont dans
   Metier/TraitementCommandes.cs, controlees par tests/CommandesWebCheck.
   Aucune base n'est branchee : un jeu neuf a chaque ouverture. *@

<div class="rig-tcw">
    @if (!RechercheRepliee)
    {
        <section class="rig-tcw__recherche" @onkeydown="SurToucheRecherche">
            <div class="rig-tcw__criteres">
                <label class="rig-saisie-champ rig-tcw__champ">
                    <span class="rig-saisie-champ__libelle">Type</span>
                    <select class="rig-saisie-champ__saisie" @bind="FamilleChoisie">
                        <option value="">Toutes</option>
                        @foreach (var f in Enum.GetValues<FamilleCommande>())
                        {
                            <option value="@f">@TraitementCommandes.Libelle(f)</option>
                        }
                    </select>
                </label>

                <div class="rig-saisie-champ rig-tcw__champ">
                    <span class="rig-saisie-champ__libelle">État</span>
                    <div class="rig-tcw__puces" role="group" aria-label="État">
                        @foreach (var e in Enum.GetValues<EtatCommande>())
                        {
                            var etat = e;
                            var pris = EtatsChoisis.Contains(etat);
                            <button class="rig-tcw__puce @(pris ? "rig-tcw__puce--prise" : "")"
                                    aria-pressed="@(pris ? "true" : "false")"
                                    @onclick="() => BasculerEtat(etat)">
                                <span class="rig-tcw__icone rig-tcw__icone--@TraitementCommandes.IconeEtat(etat)"></span>@TraitementCommandes.Libelle(etat)
                            </button>
                        }
                    </div>
                </div>

                <div class="rig-saisie-champ rig-tcw__champ">
                    <span class="rig-saisie-champ__libelle">Période du</span>
                    <div class="rig-tcw__periode">
                        <input type="date" class="rig-saisie-champ__saisie" aria-label="Période du" @bind="Du" />
                        <span class="rig-tcw__discret">au</span>
                        <input type="date" class="rig-saisie-champ__saisie" aria-label="au" @bind="Au" />
                    </div>
                </div>

                <label class="rig-saisie-champ rig-tcw__champ rig-tcw__champ--court">
                    <span class="rig-saisie-champ__libelle">SIREN</span>
                    <input class="rig-saisie-champ__saisie" placeholder="123456789" @bind="SirenCherche" @bind:event="oninput" />
                </label>

                <label class="rig-saisie-champ rig-tcw__champ rig-tcw__champ--court">
                    <span class="rig-saisie-champ__libelle">N° commande</span>
                    <input class="rig-saisie-champ__saisie" placeholder="IG-12345" @bind="ReferenceCherchee" @bind:event="oninput" />
                </label>

                <button class="rig-bascule @(EnAttenteEnvoi ? "rig-bascule--actif" : "") rig-tcw__bascule-recherche"
                        @onclick="() => EnAttenteEnvoi = !EnAttenteEnvoi">
                    <span class="rig-bascule__temoin"></span><span>Validées en attente d'envoi</span>
                </button>

                <button class="rig-bouton rig-bouton--fort" @onclick="Rechercher">Rechercher</button>
            </div>

            <div class="rig-tcw__date">
                <span class="rig-tcw__libelle-fiche">Date de travail</span>
                <b class="rig-tcw__date-valeur">@TraitementCommandes.DateTravail.ToString("dd/MM/yyyy")</b>
            </div>
        </section>
    }

    @if (Message is { } m)
    {
        <div class="rig-tcw__message rig-tcw__message--@m.Severite" role="status">
            <span>@m.Texte</span>
            <button class="rig-tcw__fermer" title="Fermer" aria-label="Fermer" @onclick="() => Message = null">×</button>
        </div>
    }

    <div class="rig-tcw__corps @(ListeRepliee ? "rig-tcw__corps--rail" : "")">
        @if (ListeRepliee)
        {
            @* Le rail : le chevron, puis le compte de chaque groupe sous sa couleur. *@
            <nav class="rig-tcw__rail" aria-label="Liste des commandes repliée">
                <button class="rig-tcw__chevron" title="Déplier la liste" aria-label="Déplier la liste"
                        @onclick="() => ListeRepliee = false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                </button>
                @foreach (var g in Groupes)
                {
                    <span class="rig-tcw__rail-compte rig-tcw__rang-@g.Rang" title="@g.Titre">@g.Commandes.Count</span>
                }
            </nav>
        }
        else
        {
            <aside class="rig-tcw__liste">
                <div class="rig-tcw__liste-entete">
                    <span class="rig-tcw__compteur">@TraitementCommandes.Compteur(Groupes)</span>
                    @if (Groupes.Count > 1)
                    {
                        <button class="rig-tcw__lien" title="Replier tous les groupes de la liste" @onclick="ToutReplier">Tout replier</button>
                    }
                    <button class="rig-tcw__chevron" title="Replier la liste" aria-label="Replier la liste"
                            @onclick="() => ListeRepliee = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                    </button>
                </div>

                <button class="rig-bouton rig-tcw__nouvelle" @onclick="NouvelleCommande">+&nbsp;&nbsp;Nouvelle commande saisie au guichet</button>

                <button class="rig-bascule @(DirectsEnTete ? "rig-bascule--actif" : "")"
                        title="Place en tête de chaque groupe les commandes qui se rapprochent d'un seul dossier."
                        @onclick="BasculerDirects">
                    <span class="rig-bascule__temoin"></span><span>Rapprochements directs en tête</span>
                </button>

                @if (Groupes.Count == 0)
                {
                    <div class="rig-tcw__vide">Aucune commande ne correspond aux critères.</div>
                }

                <div class="rig-tcw__groupes">
                    @foreach (var g in Groupes)
                    {
                        var groupe = g;
                        var replie = GroupesReplies.Contains(groupe.Famille);
                        <div class="rig-tcw__groupe rig-tcw__rang-@groupe.Rang">
                            <button class="rig-tcw__groupe-titre" aria-expanded="@(replie ? "false" : "true")"
                                    @onclick="() => BasculerGroupe(groupe.Famille)">
                                <span class="rig-tcw__groupe-chevron @(replie ? "" : "rig-tcw__groupe-chevron--ouvert")">›</span>
                                <span class="rig-tcw__groupe-nom">@groupe.Titre</span>
                                <span class="rig-tcw__groupe-compte">@groupe.Commandes.Count</span>
                            </button>
                            @if (!replie)
                            {
                                @foreach (var c in groupe.Commandes)
                                {
                                    var cmd = c;
                                    <button class="rig-tcw__cmd @(cmd.Id == Selection?.Id ? "rig-tcw__cmd--active" : "")"
                                            @onclick="() => Choisir(cmd)">
                                        <span class="rig-tcw__cmd-ligne">
                                            <span class="rig-tcw__icone rig-tcw__icone--@TraitementCommandes.IconeEtat(cmd.Etat)"></span>
                                            <span class="rig-tcw__cmd-nom">@(string.IsNullOrWhiteSpace(cmd.Denomination) ? "—" : cmd.Denomination)</span>
                                            <span class="rig-tcw__cmd-etat">(@TraitementCommandes.Libelle(cmd.Etat))</span>
                                            @if (TraitementCommandes.EstRapprochementDirect(cmd))
                                            {
                                                <span class="rig-tcw__direct" title="Un seul dossier correspond à la commande : à traiter en premier.">Rapprochement direct</span>
                                            }
                                        </span>
                                        <span class="rig-tcw__cmd-precisions">@TraitementCommandes.Precisions(cmd)</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            </aside>
        }

        <section class="rig-tcw__droite">
            @if (Selection is null)
            {
                <div class="rig-tcw__invite">Sélectionnez une commande dans la liste pour la traiter.</div>
            }
            else
            {
                var c = Selection;
                var enveloppe = TraitementCommandes.Enveloppe(Toutes, c);

                <header class="rig-tcw__entete">
                    <div class="rig-tcw__entete-texte">
                        <b class="rig-tcw__titre">@TraitementCommandes.Titre(c)</b>
                        <div class="rig-tcw__sous-titre">
                            <span>@TraitementCommandes.SousTitre(c)</span>
                            @if (enveloppe.Count > 1)
                            {
                                <span class="rig-tcw__enveloppe" title="@TraitementCommandes.EtatEnveloppe(enveloppe)">Enveloppe · @c.Reference</span>
                                @foreach (var membre in enveloppe)
                                {
                                    var mb = membre;
                                    <button class="rig-tcw__membre @(mb.Id == c.Id ? "rig-tcw__membre--courant" : "")"
                                            title="@TraitementCommandes.Libelle(mb.Famille) : @TraitementCommandes.Libelle(mb.Etat)"
                                            @onclick="() => Choisir(mb)">
                                        <span class="rig-tcw__icone rig-tcw__icone--@TraitementCommandes.IconeEtat(mb.Etat)"></span>@TraitementCommandes.Libelle(mb.Famille)
                                    </button>
                                }
                                <span class="rig-tcw__discret">@TraitementCommandes.EtatEnveloppe(enveloppe)</span>
                                @if (enveloppe.Any(x => x.EnvoiGroupeEnAttente))
                                {
                                    <button class="rig-tcw__lien" @onclick="EnvoyerSansAttendre">Envoyer sans attendre</button>
                                }
                            }
                        </div>
                    </div>
                    <div class="rig-tcw__entete-actions">
                        <button class="rig-bouton rig-tcw__bouton" title="Consulter ou corriger l'adresse d'envoi de cette commande"
                                @onclick="OuvrirCoordonnees">Coordonnées du destinataire</button>
                        <button class="rig-bouton rig-tcw__bouton" @onclick="() => Consulter(DocumentConsulte.Kbis)">Kbis</button>
                        <button class="rig-bouton rig-tcw__bouton" @onclick="() => Consulter(DocumentConsulte.EtatSynthese)">État de synthèse</button>
                        <button class="rig-bouton rig-tcw__bouton" @onclick="() => Consulter(DocumentConsulte.KbisHorsRessort)">Kbis hors ressort</button>
                        <button class="rig-bouton rig-tcw__bouton" @onclick="() => Consulter(DocumentConsulte.SyntheseRne)">Synthèse RNE</button>
                        @if (RechercheRepliee)
                        {
                            <button class="rig-bouton rig-tcw__bouton rig-tcw__loupe" title="@TraitementCommandes.Resumer(Appliques)"
                                    aria-label="Modifier la recherche" @onclick="RouvrirRecherche">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>
                            </button>
                        }
                    </div>
                </header>

                <div class="rig-tcw__detail">
                    @if (c.Etat == EtatCommande.SaisieManuelle)
                    {
                        <section class="rig-tcw__zone">
                            <div class="rig-tcw__zone-tete">
                                <span class="rig-tcw__section">Informations saisies</span>
                            </div>
                            <div class="rig-tcw__saisie">
                                <label class="rig-saisie-champ">
                                    <span class="rig-saisie-champ__libelle">Type de commande</span>
                                    <select class="rig-saisie-champ__saisie" value="@c.Famille" @onchange="ChoisirTypeSaisi">
                                        @foreach (var f in Enum.GetValues<FamilleCommande>())
                                        {
                                            <option value="@f">@TraitementCommandes.Libelle(f)</option>
                                        }
                                    </select>
                                </label>
                                <label class="rig-saisie-champ">
                                    <span class="rig-saisie-champ__libelle">Raison sociale</span>
                                    <input class="rig-saisie-champ__saisie" @bind="c.Denomination" @bind:event="oninput" />
                                </label>
                                <label class="rig-saisie-champ">
                                    <span class="rig-saisie-champ__libelle">SIREN</span>
                                    <input class="rig-saisie-champ__saisie" @bind="c.Siren" @bind:event="oninput" />
                                </label>
                                <label class="rig-saisie-champ">
                                    <span class="rig-saisie-champ__libelle">Nom du requérant</span>
                                    <input class="rig-saisie-champ__saisie" @bind="c.Requerant" @bind:event="oninput" />
                                </label>
                            </div>
                            <div class="rig-tcw__actions-saisie">
                                <button class="rig-bouton" @onclick="AnnulerSaisie">Annuler la commande</button>
                                <button class="rig-bouton rig-bouton--fort" @onclick="EnregistrerSaisie">Enregistrer la saisie</button>
                            </div>
                        </section>
                    }
                    else
                    {
                        <details class="rig-tcw__zone rig-tcw__recues">
                            <summary class="rig-tcw__section">Données reçues</summary>
                            <dl class="rig-tcw__champs">
                                @foreach (var (libelle, valeur) in DonneesRecues(c))
                                {
                                    <dt>@libelle</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(valeur) ? "—" : valeur)</dd>
                                }
                            </dl>
                        </details>
                    }

                    @if (c.EstTraitee)
                    {
                        <section class="rig-tcw__zone">
                            <div class="rig-tcw__zone-tete"><span class="rig-tcw__section">Ce qui a été envoyé</span></div>
                            @if (c.Etat == EtatCommande.Rejetee)
                            {
                                <div class="rig-tcw__ligne-statut rig-tcw__ligne-statut--rejet">Motif du rejet : @c.Motif</div>
                                <div class="rig-tcw__discret">Aucun document n'a été édité pour cette demande.</div>
                            }
                            else if (c.Envoyes.Count == 0)
                            {
                                <div class="rig-tcw__discret">Aucun document n'a été édité pour cette demande.</div>
                            }
                            else
                            {
                                <div class="rig-tcw__discret">Demande n° @c.Reference · @c.Envoyes.Count document(s) envoyé(s)</div>
                                <table class="rig-table rig-tcw__table">
                                    <thead><tr><th>Document</th><th>Bac</th><th>Ex.</th><th>Origine de la règle</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in c.Envoyes)
                                        {
                                            <tr><td>@d.Document</td><td>@d.Bac</td><td>@(d.Exemplaires?.ToString() ?? "—")</td><td>@d.Origine</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            <div class="rig-tcw__discret">Commande traitée : consultation seule, aucune action possible.</div>
                        </section>
                    }
                    else if (c.Etat != EtatCommande.SaisieManuelle)
                    {
                        @if (c.Etat == EtatCommande.EnAttente && c.Motif.Length > 0)
                        {
                            <div class="rig-tcw__ligne-statut rig-tcw__ligne-statut--attente">Motif de la mise en attente : @c.Motif</div>
                        }

                        @switch (TraitementCommandes.Groupe(c.Famille))
                        {
                            case FamilleCommande.EtatEndettement:
                                <div class="rig-tcw__deux-colonnes">
                                    @ZoneRapprochement(c, debiteur: true)
                                    @ZoneTypes(c)
                                </div>
                                break;

                            case FamilleCommande.NonOpposition:
                                @ZoneRapprochement(c, debiteur: false)
                                @ZoneNonOpposition(c)
                                break;

                            case FamilleCommande.Faillite:
                                @ZoneRapprochement(c, debiteur: false)
                                @ZoneCertificats(c)
                                break;
                        }
                    }
                </div>

                @if (!c.EstTraitee && c.Etat != EtatCommande.SaisieManuelle)
                {
                    var docs = DocumentsEnCours(c);
                    var blocage = BlocageValider(c, docs);
                    <footer class="rig-tcw__pied">
                        @if (BandeOuverte is { } bande)
                        {
                            var rejet = bande == ActionCommande.Rejeter;
                            <div class="rig-tcw__bande @(rejet ? "rig-tcw__bande--rejet" : "rig-tcw__bande--attente")">
                                <label class="rig-tcw__bande-champ">
                                    <span>@(rejet ? "Motif du rejet" : "Motif de la mise en attente (facultatif)")</span>
                                    <input class="rig-saisie-champ__saisie" maxlength="@TraitementCommandes.LongueurMaxMotif"
                                           placeholder="Saisir le motif…" @bind="MotifSaisi" @bind:event="oninput" />
                                </label>
                                <button class="rig-bouton rig-tcw__bouton @(rejet ? "rig-tcw__bouton--danger" : "rig-bouton--fort")"
                                        disabled="@(TraitementCommandes.Refus(c, bande, MotifSaisi) is not null)"
                                        title="@(rejet ? "Obligatoire pour un rejet" : null)"
                                        @onclick="() => Decider(bande)">@(rejet ? "Confirmer le rejet" : "Confirmer la mise en attente")</button>
                                <button class="rig-bouton rig-tcw__bouton" @onclick="FermerBande">Annuler</button>
                            </div>
                        }
                        <div class="rig-tcw__pied-ligne">
                            <details class="rig-tcw__edition">
                                <summary title="@("Édition & impression")">@TraitementCommandes.BarreEdition(docs)</summary>
                                <table class="rig-table rig-tcw__table">
                                    <thead><tr><th>Document</th><th>Bac</th><th>Ex.</th><th>Origine de la règle</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in docs)
                                        {
                                            <tr title="Voir le document tel que la validation l'éditera (rien n'est imprimé). Double-clic sur la ligne : même effet.">
                                                <td>@d.Document</td><td>@d.Bac</td><td>@(d.Exemplaires?.ToString() ?? "—")</td><td>@d.Origine</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="rig-tcw__discret">Aucun paramètre d'impression ici : agrafage, coffre, envoi par mail et choix de l'imprimante restent dans le Tableau des éditions.</div>
                            </details>

                            <div class="rig-tcw__mail">
                                <button class="rig-bascule @(EnvoiMail ? "rig-bascule--actif" : "")"
                                        title="Les documents sont imprimés comme d'habitude, et envoyés en plus par mail une fois générés, avec le modèle de mail du greffe. Plusieurs adresses se séparent par « ; »."
                                        @onclick="() => EnvoiMail = !EnvoiMail">
                                    <span class="rig-bascule__temoin"></span><span>Envoyer aussi par mail</span>
                                </button>
                                <input class="rig-saisie-champ__saisie rig-tcw__mail-adresse" title="Adresse du destinataire"
                                       aria-label="Adresse du destinataire" disabled="@(!EnvoiMail)" @bind="AdresseMail" @bind:event="oninput" />
                            </div>

                            <div class="rig-tcw__decisions">
                                <button class="rig-bouton rig-tcw__bouton"
                                        disabled="@(TraitementCommandes.Refus(c, ActionCommande.MettreEnAttente, "") is not null)"
                                        @onclick="() => OuvrirBande(ActionCommande.MettreEnAttente)">Mettre en attente…</button>
                                <button class="rig-bouton rig-tcw__bouton rig-tcw__bouton--danger"
                                        @onclick="() => OuvrirBande(ActionCommande.Rejeter)">Rejeter…</button>
                                <button class="rig-bouton rig-bouton--fort rig-tcw__valider" disabled="@(blocage is not null)"
                                        title="@blocage" @onclick="() => Decider(ActionCommande.Valider)">Valider</button>
                            </div>
                        </div>
                        @if (blocage is not null)
                        {
                            <div class="rig-tcw__blocage">@blocage</div>
                        }
                    </footer>
                }
            }
        </section>
    </div>

    @if (CoordonneesOuvertes && Selection is not null)
    {
        var lectureSeule = Selection.EstTraitee;
        var lignes = LignesEnveloppe();
        <div class="rig-voile" @onclick="FermerCoordonnees">
            <div class="rig-tcw__dialogue" role="dialog" aria-label="Coordonnées du destinataire" @onclick:stopPropagation="true">
                <div class="rig-tcw__dialogue-titre">Coordonnées du destinataire</div>
                @if (lectureSeule)
                {
                    <div class="rig-tcw__discret">Commande déjà traitée : l'adresse se consulte sans se modifier.</div>
                }
                <div class="rig-tcw__dialogue-corps">
                    <div class="rig-tcw__adresse">
                        @foreach (var champ in ChampsAdresse)
                        {
                            var ch = champ;
                            <label class="rig-saisie-champ @(ch.Large ? "rig-saisie-champ--pleine" : "")">
                                <span class="rig-saisie-champ__libelle">@ch.Libelle</span>
                                <input class="rig-saisie-champ__saisie" disabled="@lectureSeule"
                                       value="@Adresse[ch.Cle]" @oninput="e => Adresse[ch.Cle] = e.Value?.ToString() ?? string.Empty" />
                            </label>
                        }
                    </div>
                    <div class="rig-tcw__enveloppe-apercu">
                        <span class="rig-tcw__libelle-fiche">Aperçu de l'enveloppe</span>
                        <div class="rig-tcw__fenetre-enveloppe">
                            @foreach (var l in lignes)
                            {
                                <div>@l</div>
                            }
                        </div>
                    </div>
                </div>
                @foreach (var a in TraitementCommandes.ControlerAdresse(lignes, Adresse["Pays"]))
                {
                    <div class="rig-tcw__ligne-statut rig-tcw__ligne-statut--attente">@a</div>
                }
                @if (Selection.AdresseCorrigee.Length > 0)
                {
                    <div class="rig-tcw__discret">Adresse corrigée : c'est elle qui sera imprimée sur les documents.</div>
                }
                <div class="rig-tcw__dialogue-pied">
                    @if (!lectureSeule && Selection.AdresseCorrigee.Length > 0)
                    {
                        <button class="rig-bouton" @onclick="RevenirAdresseRecue">Revenir à l'adresse reçue</button>
                    }
                    @if (!lectureSeule)
                    {
                        <button class="rig-bouton rig-bouton--fort" @onclick="EnregistrerAdresse">Enregistrer l'adresse</button>
                    }
                    <button class="rig-bouton" @onclick="FermerCoordonnees">Fermer</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<CommandeRecue> Toutes = TraitementCommandes.JeuDemoCommandes();

    // ------------------------------------------------------------ recherche
    private string FamilleChoisie = string.Empty;
    private readonly HashSet<EtatCommande> EtatsChoisis = [EtatCommande.ATraiter];
    private DateTime? Du;
    private DateTime? Au;
    private string SirenCherche = string.Empty;
    private string ReferenceCherchee = string.Empty;
    private bool EnAttenteEnvoi;
    private CriteresCommandes Appliques = TraitementCommandes.CriteresParDefaut();

    // ------------------------------------------------------------ liste
    private List<GroupeCommandes> Groupes = [];
    private bool DirectsEnTete;
    private readonly HashSet<FamilleCommande> GroupesReplies = [];
    private bool RechercheRepliee;
