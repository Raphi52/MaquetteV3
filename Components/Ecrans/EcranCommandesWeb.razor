    private RenderFragment CaseCochable(CaseType k, bool enfantDeGroupe) => __builder =>
    {
        var codeCase = k.Code;
        <label class="rig-tcw__case @(enfantDeGroupe ? "rig-tcw__case--enfant" : "")">
            <input type="checkbox" checked="@TypesCoches.Contains(codeCase)"
                   @onchange="e => { if (e.Value is true) TypesCoches.Add(codeCase); else TypesCoches.Remove(codeCase); }" />
            <span class="rig-tcw__case-code">@codeCase</span><span>@k.Libelle</span>
        </label>
    };

