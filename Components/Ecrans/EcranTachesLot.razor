@implements IDisposable

@* ============================================================
   TRAITEMENT EN LOT : la MEME recette appliquee a PLUSIEURS affaires.

   Au greffe, un evenement recurrent n'arrive pas dossier par dossier :
   quarante denominations a reprendre font QUARANTE alertes et UNE seule
   operation. Les ouvrir une a une coute quarante ouvertures d'affaire.
   Ici, une ligne par dossier, les champs de la recette en colonnes, et
   une cloture PAR DOSSIER -- jamais une cloture globale, qui fermerait
   des dossiers incomplets avec les autres.

   Le lot n'est proposé QUE pour les recettes SANS repetition : une tache
   qui se saisit en plusieurs lignes (changer un dirigeant) ne tient pas
   dans une ligne de tableau, et pretendre le contraire ferait perdre des
   donnees. La recette le dit elle-meme (RecetteTache.ARepetition).

   Origine : Sans origine RIG v2. L'ancienne application traitait les
   taches UNE PAR UNE, dossier par dossier ; aucun ecran v2 ne portait le
   lot. Il n'y a donc pas de procedure PROC_ a citer ici.

   PORTE EN REACT (lot 3 de la migration, 19/11/2026) : l'ecran est rendu
   par web/src/ecrans/EcranTachesLot.tsx ; ses regles (lots, choix
   d'ouverture, saisie, cloture par dossier) vivent dans
   Pont/EcranTachesLot.cs. Ce fichier n'est plus qu'une COQUILLE : il garde
   les parametres d'origine (Etat, Utilisateur, CodeRecette) pour que
   Home.razor ne change pas.

   Pourquoi la coquille ouvre ELLE-MEME la session : l'ecran ecrit dans
   l'etat VIVANT de l'accueil (AccueilEtat), un objet qui ne traverse pas
   vers React. La session le recoit ici ; React n'en recoit que
   l'identifiant, et « version » change quand un nouveau parametre change la
   recette affichee (une alerte de lot qui rouvre l'ecran sur une autre).
   Mode d'emploi : web/README.md.
   ============================================================ *@

<IleReact Composant="EcranTachesLot" Proprietes="Proprietes" />

@code {
    [Parameter, EditorRequired] public AccueilEtat Etat { get; set; } = default!;

    /// <summary>Qui traite : son nom part dans la trace et dans la cloture.</summary>
    [Parameter] public string Utilisateur { get; set; } = "";

    /// <summary>
    /// La recette a ouvrir d'office, quand on vient d'une alerte de lot
    /// (« 2 dossiers : renommer la societe »). Vide = choix automatique.
    /// </summary>
    [Parameter] public string CodeRecette { get; set; } = "";

    private string? Session;
    private int Version;

    /// <summary>
    /// Premier passage : la session s'ouvre et pose la recette (OnInitialized
    /// du .razor d'origine). Ensuite, a chaque rendu de l'accueil : rouvrir
    /// l'ecran sur une AUTRE recette doit changer la vue.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Session is null)
            Session = global::RigV3Desktop.Pont.EcranTachesLot.Ouvrir(Etat, Utilisateur, CodeRecette);
        else if (global::RigV3Desktop.Pont.EcranTachesLot.Parametrer(Session, Etat, Utilisateur, CodeRecette))
            Version++;
    }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["session"] = Session,
        ["version"] = Version
    };

    public void Dispose()
    {
        if (Session is not null) global::RigV3Desktop.Pont.EcranTachesLot.Fermer(Session);
    }
}
