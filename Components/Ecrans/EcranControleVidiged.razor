@* Ecran de la procedure PROC_CONTROLE_VIDIGED (RIG v2 : trois blocs
   OPE_CRITERES, OPE_PAGINATION et OPE_RESULTATS). Colonnes lues dans les
   grilles v2 : Guid, Type, Date, DateArchivage, Taille, Info, CD, Count. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Criteres</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Guid ou info</span>
            <input class="rig-saisie-champ__saisie" @bind="Recherche" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Type d'archive</span>
            <select class="rig-saisie-champ__saisie" @bind="CritType">
                <option value="">Tous</option>
                @foreach (var t in Archives.Select(a => a.Type).Distinct().Order())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Date d'archivage</div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Du</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="Du" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Au</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="Au" />
                </label>
            </div>
        </div>

        <button class="rig-bascule @(SansCd ? "rig-bascule--actif" : "")"
                @onclick="() => SansCd = !SansCd">
            <span class="rig-bascule__temoin"></span>
            <span>Sans support CD uniquement</span>
        </button>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Pagination</div>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Lignes par page</span>
                <input class="rig-saisie-champ__saisie" type="number" min="1" max="200" @bind="ParPage" />
            </label>
            <div class="rig-criteres__actions">
                <button class="rig-bouton rig-bouton--plat" @onclick="() => Page = Math.Max(1, Page - 1)">Precedent</button>
                <button class="rig-bouton rig-bouton--plat" @onclick="() => Page = Math.Min(NbPages, Page + 1)">Suivant</button>
            </div>
            <span class="rig-resultats-proc__compte">Page @Page / @NbPages</span>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Resultats</div>
            <span class="rig-resultats-proc__compte">@Filtrees.Length archive(s) — @PageCourante.Length affichee(s)</span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>Guid</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>DateArchivage</th>
                        <th>Taille</th>
                        <th>Info</th>
                        <th>CD</th>
                        <th class="rig-table__centre">Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in PageCourante)
                    {
                        <tr class="@(string.IsNullOrEmpty(a.Cd) ? "rig-table__ligne--alerte" : "")">
                            <td class="rig-table__mono">@a.Guid</td>
                            <td>@a.Type</td>
                            <td class="rig-table__mono">@a.Date.ToString("dd/MM/yyyy")</td>
                            <td class="rig-table__mono">@a.Archivage.ToString("dd/MM/yyyy")</td>
                            <td class="rig-table__mono">@a.Taille</td>
                            <td>@a.Info</td>
                            <td class="rig-table__mono">@a.Cd</td>
                            <td class="rig-table__centre">@a.Nombre</td>
                        </tr>
                    }
                    @if (PageCourante.Length == 0)
                    {
                        <tr><td colspan="8" class="rig-table__vide">Aucune archive ne repond a ces criteres.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private sealed record ArchiveVidi(string Guid, string Type, DateTime Date, DateTime Archivage,
                                      string Taille, string Info, string Cd, int Nombre);

    private static readonly ArchiveVidi[] Archives =
    [
        new("a41f-2026-0091", "Lot de numerisation", new(2026, 8, 3),  new(2026, 8, 4),  "412 Mo", "Actes RCS aout",        "CD-2026-014", 318),
        new("a41f-2026-0092", "Lot de numerisation", new(2026, 8, 10), new(2026, 8, 11), "377 Mo", "Actes RCS aout",        "CD-2026-014", 291),
        new("b77c-2026-0103", "Comptes annuels",     new(2026, 8, 20), new(2026, 8, 21), "1,2 Go", "Depots comptes 2025",   "",            904),
        new("b77c-2026-0104", "Comptes annuels",     new(2026, 8, 27), new(2026, 8, 28), "980 Mo", "Depots comptes 2025",   "CD-2026-015", 733),
        new("c12d-2026-0110", "Documents judiciaires", new(2026, 9, 1), new(2026, 9, 2), "204 Mo", "GED judiciaire",        "",            126)
    ];

    private string Recherche = string.Empty;
    private string CritType = string.Empty;
    private DateTime? Du;
    private DateTime? Au;
    private bool SansCd;
    private int ParPage = 3;
    private int Page = 1;

    private ArchiveVidi[] Filtrees
    {
        get
        {
            IEnumerable<ArchiveVidi> q = Archives;
            if (!string.IsNullOrWhiteSpace(Recherche))
            {
                var t = Recherche.Trim();
                q = q.Where(a => a.Guid.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || a.Info.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrEmpty(CritType)) q = q.Where(a => a.Type == CritType);
            if (Du is { } du) q = q.Where(a => a.Archivage.Date >= du.Date);
            if (Au is { } au) q = q.Where(a => a.Archivage.Date <= au.Date);
            if (SansCd) q = q.Where(a => string.IsNullOrEmpty(a.Cd));
            return q.ToArray();
        }
    }

    private int NbPages => Math.Max(1, (int)Math.Ceiling(Filtrees.Length / (double)Math.Max(ParPage, 1)));

    private ArchiveVidi[] PageCourante
    {
        get
        {
            var page = Math.Clamp(Page, 1, NbPages);
            return Filtrees.Skip((page - 1) * Math.Max(ParPage, 1)).Take(Math.Max(ParPage, 1)).ToArray();
        }
    }
}
