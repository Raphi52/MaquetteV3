@* Ecran de la procedure PROC_FACTURE.

   Sources RIG v2 (D:\RigApplication\Source\RIG\DLL\Processus\PROC_FACTURE) :
     - FormFacture/OPE_FACTURE_CLIENT   : ult_client_abrege, ult_client_nom,
                                          ult_client_adresse, btn_Changer_client,
                                          ult_lblSolde
     - FormFacture/OPE_FACTURE_MODE     : ult_Facturer_Tarifer (valeur "F" ou "T")
     - FormFacture/OPE_FACTURE_INFOS    : ult_combo_payeur, ult_References,
                                          ult_Attention
     - FormFacture/OPE_FACTURE_ARTICLES : grille ult_DataGridViewArticles,
                                          colonnes colCodeArtut, colTypeArticle,
                                          colQte, colPUHT, colTauxTVA, colBODACC,
                                          colINPI, colAutre, colTTC
     - FormEncaissement/OPE_FACTU_ENCAISS : cboModePaiement, cboPayeurs, txtBanque,
                                          txtNumTitre, ultMontant, ultDateEncaissement,
                                          txtCommentaire, TxtVentilationId *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Informations client</div>

        <div class="rig-criteres__paire">
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Abrege</span>
                <input class="rig-saisie-champ__saisie" value="@Fiche.Abrege" readonly />
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Type de client</span>
                <input class="rig-saisie-champ__saisie" value="@Fiche.TypeClient" readonly />
            </label>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nom du client</span>
            <select class="rig-saisie-champ__saisie" @bind="Client">
                @foreach (var c in Fiches)
                {
                    <option value="@c.Nom">@c.Nom</option>
                }
            </select>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Adresse</span>
            <input class="rig-saisie-champ__saisie" value="@Fiche.Adresse" readonly />
        </label>

        <div class="rig-criteres__actions">
            <button class="rig-bouton" @onclick="ChangerClient">Changer de client</button>
            <span class="rig-etat rig-etat--@(Fiche.Solde > 0 ? "attente" : "ok")">
                Solde client @Fiche.Solde.ToString("N2") EUR
            </span>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">N de demande</span>
            <input class="rig-saisie-champ__saisie" @bind="NumDemande" />
        </label>

        @* v2 : ult_Facturer_Tarifer, un choix exclusif dont la valeur vaut
           « F » (facturer) ou « T » (tarifer). *@
        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Mode</div>
            <div class="rig-onglets">
                <button class="rig-onglet @(Tarifer ? "" : "rig-onglet--actif")"
                        @onclick="() => Tarifer = false">Facturer</button>
                <button class="rig-onglet @(Tarifer ? "rig-onglet--actif" : "")"
                        @onclick="() => Tarifer = true">Tarifer</button>
            </div>
            <p class="rig-nonmaq__texte rig-nonmaq__texte--sourd">
                @(Tarifer
                    ? "Tarifer : le montant est calcule sans emettre de facture."
                    : "Facturer : une facture numerotee sera emise.")
            </p>
        </div>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Infos complementaires</div>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Tiers payeur</span>
                <select class="rig-saisie-champ__saisie" @bind="Payeur">
                    @foreach (var p in Payeurs)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">References client</span>
                <input class="rig-saisie-champ__saisie" @bind="References" />
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">A l'attention de</span>
                <input class="rig-saisie-champ__saisie" @bind="Attention" />
            </label>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Articles de la facture</div>
            <span class="rig-resultats-proc__compte">
                Total TTC @Total.ToString("N2") EUR — reste a encaisser @Reste.ToString("N2") EUR
            </span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>Article</th>
                        <th>Libelle</th>
                        <th class="rig-table__centre">Quantite</th>
                        <th>Prix UHT</th>
                        <th>Taux TVA</th>
                        <th>BODACC</th>
                        <th>INPI</th>
                        <th>Autre</th>
                        <th>Montant TTC</th>
                        <th>Commentaire</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Articles)
                    {
                        var art = a;
                        <tr class="@(Retires.Contains(art.Code) ? "rig-table__ligne--inerte" : "")"
                            @onclick="() => Basculer(art.Code)">
                            <td class="rig-table__mono">@art.Code</td>
                            <td>@art.Libelle</td>
                            <td class="rig-table__centre">@art.Quantite</td>
                            <td class="rig-table__mono">@art.PrixUht.ToString("N2")</td>
                            <td class="rig-table__mono">@art.TauxTva.ToString("N1") %</td>
                            <td class="rig-table__mono">@art.Bodacc.ToString("N2")</td>
                            <td class="rig-table__mono">@art.Inpi.ToString("N2")</td>
                            <td class="rig-table__mono">@art.Autre.ToString("N2")</td>
                            <td class="rig-table__mono">@art.Ttc.ToString("N2")</td>
                            <td>@art.Commentaire</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="rig-criteres__bloc" style="padding:var(--rig-esp-3)">
            <div class="rig-kicker">Encaissement</div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Montant encaisse</span>
                    <input class="rig-saisie-champ__saisie" type="number" step="0.01" @bind="Encaisse" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Date d'encaissement</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="DateEncaissement" />
                </label>
            </div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Mode de paiement</span>
                    <select class="rig-saisie-champ__saisie" @bind="Mode">
                        <option>Compte</option>
                        <option>Cheque</option>
                        <option>Carte bancaire</option>
                        <option>Virement</option>
                        <option>Especes</option>
                    </select>
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Banque</span>
                    <input class="rig-saisie-champ__saisie" @bind="Banque" />
                </label>
            </div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">N de titre</span>
                    <input class="rig-saisie-champ__saisie" @bind="NumTitre" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Identifiant de ventilation</span>
                    <input class="rig-saisie-champ__saisie" value="@VentilationId" readonly />
                </label>
            </div>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Commentaire</span>
                <textarea class="rig-saisie-champ__saisie" rows="2" @bind="Commentaire"></textarea>
            </label>
            <span class="rig-etat rig-etat--@(Reste <= 0 ? "ok" : "attente")">
                @(Reste <= 0 ? "Facture soldee" : "Solde restant " + Reste.ToString("N2") + " EUR")
            </span>
        </div>
    </section>
</div>

@code {
    private sealed record ArticleFacture(string Code, string Libelle, int Quantite, decimal PrixUht,
                                         decimal TauxTva, decimal Bodacc, decimal Inpi, decimal Autre,
                                         decimal Ttc, string Commentaire);

    // v2 : ult_client_abrege (dont le titre indique le type de client),
    // ult_client_nom, ult_client_adresse, ult_lblSolde.
    private sealed record FicheClient(string Nom, string Abrege, string TypeClient,
                                      string Adresse, decimal Solde);

    private static readonly FicheClient[] Fiches =
    [
        new("SELARL LEROY & ASSOCIES", "LEROY",  "Client en compte", "12 rue de la Paix, 51100 Reims",     812.40m),
        new("CABINET BLANC",           "BLANC",  "Client WEB",       "4 avenue Jean Jaures, 51000 Chalons", 326.15m),
        new("SCP DUPONT-MARTIN",       "DUPONT", "Compte PC",        "9 place d Erlon, 51100 Reims",        149.00m),
        new("Client de passage",       "DIVERS", "Client divers",    "",                                      0m)
    ];

    private static readonly ArticleFacture[] Articles =
    [
        new("IMM01", "Immatriculation societe",      1, 37.45m, 20m, 105.90m, 0m,     0m,    194.85m, ""),
        new("MOD02", "Modification statutaire",       1, 45.60m, 20m, 108.00m, 0m,     0m,    162.72m, "Changement de gerant"),
        new("DEP03", "Depot des comptes annuels",     2, 22.30m, 20m, 0m,      0m,     0m,     53.52m, ""),
        new("INP04", "Transmission INPI",             1, 12.00m, 20m, 0m,      18.50m, 0m,     32.90m, "Refacturation INPI"),
        new("DIV05", "Frais divers",                  1,  8.00m, 20m, 0m,      0m,     4.20m,  14.64m, "")
    ];

    private static readonly string[] Payeurs =
        ["", "Debiteur", "Tiers payeur principal", "Avocat mandataire"];

    private string Client = Fiches[0].Nom;
    private string NumDemande = "D2026-04118";

    // v2 : ult_Facturer_Tarifer, "F" par defaut.
    private bool Tarifer;

    private string Payeur = string.Empty;
    private string References = string.Empty;
    private string Attention = string.Empty;
    private string VentilationId = "V-2026-8801";
    private string Mode = "Compte";
    private string Banque = string.Empty;
    private string NumTitre = string.Empty;
    private string Commentaire = string.Empty;
    private decimal Encaisse = 200m;
    private DateTime? DateEncaissement = JeuDemo.Aujourdhui;
    private readonly HashSet<string> Retires = new();

    private FicheClient Fiche =>
        Fiches.FirstOrDefault(f => f.Nom == Client) ?? Fiches[0];

    // v2 : btn_Changer_client fait defiler les clients rattachables a la facture.
    private void ChangerClient()
    {
        var i = Array.FindIndex(Fiches, f => f.Nom == Client);
        Client = Fiches[(i + 1) % Fiches.Length].Nom;
    }

    private void Basculer(string code) { if (!Retires.Add(code)) Retires.Remove(code); }

    private decimal Total => Articles.Where(a => !Retires.Contains(a.Code)).Sum(a => a.Ttc);
    private decimal Reste => Math.Max(0m, Total - Encaisse);
}
