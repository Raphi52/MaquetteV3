@* Ecran de la procedure PROC_COFFRE_FORT (RIG v2 : FORM_COFFRE_FORT,
   blocs OPE_RECHERCHE_COFFRE, OPE_OPTION_RECHERCHE, OPE_TREEVIEW_TRANSMETTRE
   / OPE_TREEVIEW_RETRANSMETTRE, OPE_RECHERCHE_HISTORIQUE, OPE_DESTINATAIRE,
   OPE_PARAMETRAGE_COFFRE). Colonnes lues dans les grilles v2 : Code, Abrege,
   Destinataire, Etat, Date envoi infogreffe, Date AR Infogreffe,
   Date AR destinataire, Date lecture destinataire, Date traitement RIG,
   Code de depot dans le coffre, Erreur. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Criteres de recherche</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Code ou destinataire</span>
            <input class="rig-saisie-champ__saisie" @bind="Recherche" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nom du coffre</span>
            <select class="rig-saisie-champ__saisie" @bind="Coffre">
                <option value="">Tous</option>
                @foreach (var c in Depots.Select(d => d.Coffre).Distinct().Order())
                {
                    <option value="@c">@c</option>
                }
            </select>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Type de decision</span>
            <select class="rig-saisie-champ__saisie" @bind="TypeDecision">
                <option value="">Tous</option>
                <option value="ACAD">Avec code de depot</option>
                <option value="CD">Sans code de depot</option>
            </select>
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Historique</div>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Nombre de lignes d'historique</span>
                <input class="rig-saisie-champ__saisie" type="number" min="1" max="200" @bind="NbLignesHisto" />
            </label>
        </div>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Parametrage du coffre</div>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Coffre par defaut</span>
                <input class="rig-saisie-champ__saisie" @bind="CoffreDefaut" />
            </label>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-onglets">
                <button class="rig-onglet @(ATransmettre ? "rig-onglet--actif" : "")"
                        @onclick="() => ATransmettre = true">A transmettre</button>
                <button class="rig-onglet @(!ATransmettre ? "rig-onglet--actif" : "")"
                        @onclick="() => ATransmettre = false">Deja transmis</button>
            </div>
            <span class="rig-resultats-proc__compte">@Trouves.Length depot(s)</span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Abrege</th>
                        <th>Destinataire</th>
                        <th>Etat</th>
                        <th>Date envoi infogreffe</th>
                        <th>Date AR Infogreffe</th>
                        <th>Date AR destinataire</th>
                        <th>Date lecture destinataire</th>
                        <th>Date traitement RIG</th>
                        <th>Code de depot</th>
                        <th>Erreur</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Trouves)
                    {
                        var dep = d;
                        <tr class="@(string.IsNullOrEmpty(dep.Erreur) ? "" : "rig-table__ligne--alerte")"
                            @onclick="() => Selection = dep">
                            <td class="rig-table__mono">@dep.Code</td>
                            <td class="rig-table__mono">@dep.Abrege</td>
                            <td>@dep.Destinataire</td>
                            <td><span class="rig-etat rig-etat--@dep.Statut">@dep.Etat</span></td>
                            <td class="rig-table__mono">@Jour(dep.EnvoiInfogreffe)</td>
                            <td class="rig-table__mono">@Jour(dep.ArInfogreffe)</td>
                            <td class="rig-table__mono">@Jour(dep.ArDestinataire)</td>
                            <td class="rig-table__mono">@Jour(dep.LectureDestinataire)</td>
                            <td class="rig-table__mono">@Jour(dep.TraitementRig)</td>
                            <td class="rig-table__mono">@dep.CodeDepot</td>
                            <td>@dep.Erreur</td>
                        </tr>
                    }
                    @if (Trouves.Length == 0)
                    {
                        <tr><td colspan="11" class="rig-table__vide">Aucun depot ne repond a ces criteres.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Selection is { } s)
        {
            <div class="rig-criteres__bloc" style="padding:var(--rig-esp-3)">
                <div class="rig-kicker">Historique de @s.Code (@NbLignesHisto ligne(s) au plus)</div>
                <ul class="rig-historique__liste">
                    @foreach (var h in s.Historique.Take(Math.Max(NbLignesHisto, 1)))
                    {
                        <li>@h</li>
                    }
                </ul>
            </div>
        }
    </section>
</div>

@code {
    private sealed record DepotCoffre(string Code, string Abrege, string Destinataire, string Coffre,
                                      string TypeDecision, string Etat, string Statut,
                                      DateTime? EnvoiInfogreffe, DateTime? ArInfogreffe,
                                      DateTime? ArDestinataire, DateTime? LectureDestinataire,
                                      DateTime? TraitementRig, string CodeDepot, string Erreur,
                                      string[] Historique);

    private static readonly DepotCoffre[] Depots =
    [
        new("CF-2026-0412", "DUVAL",  "Me LEROY",  "COFFRE_LEROY", "ACAD", "Transmis",  "ok",      new(2026, 3, 7), new(2026, 3, 7), new(2026, 3, 8), new(2026, 3, 9), new(2026, 3, 7), "DEP-77120", "",                       ["07/03/2026 — depose", "08/03/2026 — accuse de reception", "09/03/2026 — lu"]),
        new("CF-2026-0518", "MARNE",  "Me BLANC",  "COFFRE_BLANC", "ACAD", "Transmis",  "ok",      new(2026, 6, 3), new(2026, 6, 3), new(2026, 6, 4), null,            new(2026, 6, 3), "DEP-77455", "",                       ["03/06/2026 — depose", "04/06/2026 — accuse de reception"]),
        new("CF-2026-0603", "MARIE",  "Me LEROY",  "COFFRE_LEROY", "CD",   "A envoyer", "attente", null,            null,            null,            null,            new(2026, 9, 1), "",          "",                       ["01/09/2026 — prepare"]),
        new("CF-2026-0610", "MOULIN", "Me PETIT",  "COFFRE_PETIT", "CD",   "En erreur", "alerte",  new(2026, 9, 4), null,            null,            null,            new(2026, 9, 4), "",          "Destinataire inconnu",   ["04/09/2026 — envoi refuse par le coffre"])
    ];

    private string Recherche = string.Empty;
    private string Coffre = string.Empty;
    private string TypeDecision = string.Empty;
    private int NbLignesHisto = 20;
    private string CoffreDefaut = "COFFRE_LEROY";
    private bool ATransmettre = true;
    private DepotCoffre? Selection;

    private static string Jour(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "";

    private DepotCoffre[] Trouves
    {
        get
        {
            IEnumerable<DepotCoffre> q = Depots.Where(d => (d.EnvoiInfogreffe is null || d.Erreur != "") == ATransmettre);
            if (!string.IsNullOrWhiteSpace(Recherche))
            {
                var t = Recherche.Trim();
                q = q.Where(d => d.Code.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || d.Destinataire.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrEmpty(Coffre)) q = q.Where(d => d.Coffre == Coffre);
            if (!string.IsNullOrEmpty(TypeDecision)) q = q.Where(d => d.TypeDecision == TypeDecision);
            return q.ToArray();
        }
    }
}
