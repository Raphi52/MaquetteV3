@* Ecran de la procedure PROC_RECHAFF — recherche d'affaires.

   Reference RIG v2 (D:/RigApplication/Source/RIG/DLL/Processus/PROC_RECHAFF) :
     - Operations/OPE_CRITERES.cs : n° affaire, n° demande, n° facture, dates
     - Ults/ULT_GRIDVIEW_RECHAFF.cs : colonnes N° Affaire, Libelle,
       Date creation, Solde, Demandes, Factures.

   PORTE EN REACT (lot 3 de la migration, 18/11/2026) : l'ecran est rendu par
   web/src/ecrans/EcranRechAffaires.tsx ; le fonds d'affaires, le filtre et le
   tri des colonnes sont dans Pont/EcranRechAffaires.cs. Ce fichier n'est plus
   qu'une COQUILLE : il garde les parametres d'origine (NoAffaire, Ouvrir,
   OuvrirUnDossier) pour que Home.razor ne change pas. Mode d'emploi :
   web/README.md. *@

<IleReact Composant="EcranRechAffaires" Proprietes="Proprietes" Rappels="Rappels" />

@code {
    /// <summary>Numero d'affaire pre-rempli a l'ouverture (tuile de l'accueil).</summary>
    [Parameter] public string? NoAffaire { get; set; }

    /// <summary>Remonte le numero choisi ; la page ouvre la visionneuse.</summary>
    [Parameter] public EventCallback<string> Ouvrir { get; set; }

    /// <summary>Remonte un SIREN a immatriculer : la recherche n'a rien trouve,
    /// c'est donc ICI que l'agent constate qu'il faut ouvrir le dossier. Le
    /// renvoyer au menu lui ferait retaper le numero.</summary>
    [Parameter] public EventCallback<string> OuvrirUnDossier { get; set; }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["noAffaire"] = NoAffaire
    };

    private Dictionary<string, IleReact.RappelIle> Rappels => new()
    {
        ["ouvrir"] = IleReact.Rappel(Ouvrir),
        ["ouvrirUnDossier"] = IleReact.Rappel(OuvrirUnDossier)
    };
}
