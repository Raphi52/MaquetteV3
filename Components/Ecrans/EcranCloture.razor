@* Ecran de la procedure PROC_CLOT (RIG v2 : « Examen des Clotures »).
   Les colonnes sont celles des grilles de PROC_CLOT (HeaderText lus dans
   les sources v2) : N Role, Nom de l'Affaire, Demandeur, Defendeur,
   Chambre, Date d'audience, Heure d'appel, Type de classement, A facturer,
   Limite Examen, Dernier courrier envoye. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Criteres d'examen</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Affaire</span>
            <input class="rig-saisie-champ__saisie" placeholder="nom ou n de role"
                   @bind="CritAffaire" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Chambre</span>
            <select class="rig-saisie-champ__saisie" @bind="CritChambre">
                <option value="">Toutes</option>
                @foreach (var c in Lignes.Select(l => l.Chambre).Distinct().Order())
                {
                    <option value="@c">@c</option>
                }
            </select>
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Date d'audience</div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Du</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="CritDu" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Au</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="CritAu" />
                </label>
            </div>
        </div>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Type de classement</div>
            @foreach (var t in Classements)
            {
                var v = t;
                <button class="rig-bascule @(CritTypes.Contains(v) ? "rig-bascule--actif" : "")"
                        @onclick="() => Basculer(v)">
                    <span class="rig-bascule__temoin"></span>
                    <span>@v</span>
                </button>
            }
        </div>

        <div class="rig-criteres__bloc">
            <button class="rig-bascule @(CritAFacturer ? "rig-bascule--actif" : "")"
                    @onclick="() => CritAFacturer = !CritAFacturer">
                <span class="rig-bascule__temoin"></span>
                <span>A facturer uniquement</span>
            </button>
            <button class="rig-bascule @(CritExamenDepasse ? "rig-bascule--actif" : "")"
                    @onclick="() => CritExamenDepasse = !CritExamenDepasse">
                <span class="rig-bascule__temoin"></span>
                <span>Limite d'examen depassee</span>
            </button>
        </div>

        <div class="rig-criteres__actions">
            <button class="rig-bouton" @onclick="Effacer">Effacer</button>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Affaires a examiner</div>
            <span class="rig-resultats-proc__compte">
                @Trouvees.Length affichee(s) sur @Lignes.Length
            </span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>N Role</th>
                        <th>Nom de l'Affaire</th>
                        <th>Demandeur</th>
                        <th>Defendeur</th>
                        <th>Chambre</th>
                        <th>Date d'audience</th>
                        <th>Heure d'appel</th>
                        <th>Type de classement</th>
                        <th>Limite Examen</th>
                        <th class="rig-table__centre">A facturer</th>
                        <th>Dernier courrier envoye</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Trouvees)
                    {
                        var ligne = l;
                        var retard = ligne.LimiteExamen.Date < JeuDemo.Aujourdhui.Date;
                        <tr class="@(retard ? "rig-table__ligne--alerte" : "")"
                            @onclick="() => OuvrirDossier.InvokeAsync(ligne.Dossier)">
                            <td class="rig-table__mono">@ligne.Role</td>
                            <td>@ligne.Affaire</td>
                            <td>@ligne.Demandeur</td>
                            <td>@ligne.Defendeur</td>
                            <td class="rig-table__mono">@ligne.Chambre</td>
                            <td class="rig-table__mono">@ligne.Audience.ToString("dd/MM/yyyy")</td>
                            <td class="rig-table__mono">@ligne.HeureAppel</td>
                            <td>@ligne.Classement</td>
                            <td class="rig-table__mono">@ligne.LimiteExamen.ToString("dd/MM/yyyy")</td>
                            <td class="rig-table__centre">@(ligne.AFacturer ? "oui" : "")</td>
                            <td class="rig-table__mono">@ligne.DernierCourrier</td>
                        </tr>
                    }
                    @if (Trouvees.Length == 0)
                    {
                        <tr><td colspan="11" class="rig-table__vide">Aucune affaire ne repond a ces criteres.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    /// <summary>Remonte le dossier a ouvrir dans la visionneuse.</summary>
    [Parameter] public EventCallback<string> OuvrirDossier { get; set; }

    private sealed record LigneClot(string Role, string Affaire, string Demandeur, string Defendeur,
                                    string Chambre, DateTime Audience, string HeureAppel,
                                    string Classement, DateTime LimiteExamen, bool AFacturer,
                                    string DernierCourrier, string Dossier);

    private static readonly string[] Classements =
        ["Insuffisance d'actif", "Extinction du passif", "Conversion en liquidation", "Report"];

    private static readonly LigneClot[] Lignes =
    [
        new("2024/00318", "SARL BOULANGERIE DUVAL", "Me LEROY", "SARL BOULANGERIE DUVAL", "1re", new(2026, 9, 15), "09:00", "Insuffisance d'actif",      new(2026, 9, 12), true,  "28/08/2026", "2024B00318"),
        new("2024/00407", "SAS TRANSPORTS MARNE",   "Me BLANC", "SAS TRANSPORTS MARNE",   "2e",  new(2026, 9, 15), "09:30", "Extinction du passif",      new(2026, 9, 5),  false, "12/08/2026", "2024B00407"),
        new("2023/01120", "EURL COIFFURE MARIE",    "Me LEROY", "EURL COIFFURE MARIE",    "1re", new(2026, 9, 22), "10:15", "Conversion en liquidation", new(2026, 9, 20), true,  "02/09/2026", "2023B01120"),
        new("2025/00044", "SCI DU MOULIN",          "Me PETIT", "SCI DU MOULIN",          "3e",  new(2026, 9, 29), "11:00", "Report",                    new(2026, 10, 2), false, "",           "2025B00044"),
        new("2022/00876", "SARL PLOMBERIE NORD",    "Me BLANC", "SARL PLOMBERIE NORD",    "2e",  new(2026, 10, 6), "14:00", "Insuffisance d'actif",      new(2026, 9, 30), true,  "19/07/2026", "2022B00876")
    ];

    private string CritAffaire = string.Empty;
    private string CritChambre = string.Empty;
    private DateTime? CritDu;
    private DateTime? CritAu;
    private bool CritAFacturer;
    private bool CritExamenDepasse;
    private readonly HashSet<string> CritTypes = new();

    private void Basculer(string t) { if (!CritTypes.Add(t)) CritTypes.Remove(t); }

    private void Effacer()
    {
        CritAffaire = string.Empty; CritChambre = string.Empty;
        CritDu = null; CritAu = null;
        CritAFacturer = false; CritExamenDepasse = false;
        CritTypes.Clear();
    }

    private LigneClot[] Trouvees
    {
        get
        {
            IEnumerable<LigneClot> q = Lignes;
            if (!string.IsNullOrWhiteSpace(CritAffaire))
            {
                var t = CritAffaire.Trim();
                q = q.Where(l => l.Affaire.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || l.Role.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(CritChambre)) q = q.Where(l => l.Chambre == CritChambre);
            if (CritDu is { } du) q = q.Where(l => l.Audience.Date >= du.Date);
            if (CritAu is { } au) q = q.Where(l => l.Audience.Date <= au.Date);
            if (CritTypes.Count > 0) q = q.Where(l => CritTypes.Contains(l.Classement));
            if (CritAFacturer) q = q.Where(l => l.AFacturer);
            if (CritExamenDepasse) q = q.Where(l => l.LimiteExamen.Date < JeuDemo.Aujourdhui.Date);
            return q.ToArray();
        }
    }
}
