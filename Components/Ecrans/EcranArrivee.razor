@* Ecran de la procedure PROC_ARRIVEE.
   Blocs de criteres lus dans RIG v2 : OPE_ARRIVEE.Designer.cs ("Arrivee",
   "Date d'arrivee", "Mode d'arrivee") et OPE_DEMANDE.Designer.cs
   ("N Demande", "Type de demande", "Utilisateur designe", "Numerisation",
   "Attestation de depot"). Colonnes : table ARRIVEE (ARRV_*). *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Criteres de recherche</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Arrivee</span>
            <input class="rig-saisie-champ__saisie" placeholder="n arrivee ou n demande"
                   @bind="CritNumArrivee" @bind:event="oninput" />
            <span class="rig-saisie-champ__colonne">ARRV_NUM_ARRIVEE</span>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nom</span>
            <input class="rig-saisie-champ__saisie" placeholder="expediteur"
                   @bind="CritNomArrivee" @bind:event="oninput" />
            <span class="rig-saisie-champ__colonne">ARRV_NOM</span>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">References</span>
            <input class="rig-saisie-champ__saisie" placeholder="n de suivi, reference"
                   @bind="CritReferences" @bind:event="oninput" />
            <span class="rig-saisie-champ__colonne">ARRV_REFERENCES</span>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Mode d arrivee</span>
            <select class="rig-saisie-champ__saisie" @bind="CritMode">
                <option value="">Tous</option>
                @foreach (var m in JeuDemo.ModesArrivee)
                {
                    <option value="@m.Code">@m.Libelle</option>
                }
            </select>
            <span class="rig-saisie-champ__colonne">ARRV_MODE_ARRIVEE &middot; dbo.MODE_ARRIVEE</span>
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Date d arrivee</div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Du</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="CritDu" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Au</span>
                    <input class="rig-saisie-champ__saisie" type="date" @bind="CritAu" />
                </label>
            </div>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Case courrier</span>
            <input class="rig-saisie-champ__saisie" placeholder="C-01"
                   @bind="CritCase" @bind:event="oninput" />
            <span class="rig-saisie-champ__colonne">ARRV_CASE_COURRIER</span>
        </label>

        <div class="rig-criteres__bloc">
            <button class="rig-bascule @(CritPaiement ? "rig-bascule--actif" : "")"
                    @onclick="() => CritPaiement = !CritPaiement">
                <span class="rig-bascule__temoin"></span>
                <span>Paiement joint</span>
            </button>
            <button class="rig-bascule @(CritNonNumerise ? "rig-bascule--actif" : "")"
                    @onclick="() => CritNonNumerise = !CritNonNumerise">
                <span class="rig-bascule__temoin"></span>
                <span>Reste a numeriser</span>
            </button>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nombre maxi. d arrivees affichees</span>
            <input class="rig-saisie-champ__saisie" type="number" min="1" max="500" @bind="CritTopMax" />
        </label>

        <div class="rig-criteres__actions">
            <button class="rig-bouton" @onclick="Effacer">Effacer</button>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Courrier arrive</div>
            <span class="rig-resultats-proc__compte">
                @Trouvees.Length affichee(s) sur @JeuDemo.Arrivees.Length &middot;
                @Trouvees.Count(a => !a.Numerise) a numeriser
            </span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>N Arrivee</th>
                        <th>Date et heure</th>
                        <th>Mode</th>
                        <th>Nom</th>
                        <th>References</th>
                        <th class="rig-table__centre">Case</th>
                        <th class="rig-table__centre">Paiement</th>
                        <th>N Demande</th>
                        <th>Type de demande</th>
                        <th>Utilisateur designe</th>
                        <th class="rig-table__centre">Numerisation</th>
                        <th class="rig-table__centre">Attestation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Trouvees)
                    {
                        var arr = a;
                        var liee = !string.IsNullOrWhiteSpace(arr.NumDemande);
                        <tr class="@(arr.Numerise ? "" : "rig-table__ligne--alerte") @(liee ? "" : "rig-table__ligne--inerte")"
                            title="@(liee ? "Ouvrir la demande " + arr.NumDemande : "Aucune demande rattachee a cette arrivee")"
                            @onclick="() => Ouvrir(arr)">
                            <td class="rig-table__mono">@arr.Numero</td>
                            <td class="rig-table__mono">@arr.Horodatage</td>
                            <td><span class="rig-etat">@arr.ModeLisible</span></td>
                            <td>@arr.Nom</td>
                            <td class="rig-table__mono">@arr.References</td>
                            <td class="rig-table__centre rig-table__mono">@arr.Case_</td>
                            <td class="rig-table__centre">@(arr.PaiementJoint ? "oui" : "")</td>
                            <td class="rig-table__mono">
                                @if (liee)
                                {
                                    @arr.NumDemande
                                }
                                else
                                {
                                    <span class="rig-table__sans">non rattachee</span>
                                }
                            </td>
                            <td>@arr.TypeDemande</td>
                            <td>@arr.Utilisateur</td>
                            <td class="rig-table__centre">@(arr.Numerise ? "faite" : "a faire")</td>
                            <td class="rig-table__centre">@(arr.Attestation ? "oui" : "")</td>
                        </tr>
                    }
                    @if (Trouvees.Length == 0)
                    {
                        <tr>
                            <td colspan="12" class="rig-table__vide">
                                Aucune arrivee ne repond a ces criteres.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    /// <summary>Remonte le numero de dossier a ouvrir.</summary>
    [Parameter] public EventCallback<string> OuvrirDossier { get; set; }

    private string CritNumArrivee = string.Empty;
    private string CritNomArrivee = string.Empty;
    private string CritReferences = string.Empty;
    private string CritMode = string.Empty;
    private string CritCase = string.Empty;
    private DateTime? CritDu;
    private DateTime? CritAu;
    private bool CritPaiement;
    private bool CritNonNumerise;
    private int CritTopMax = 50;

    /// <summary>
    /// Une arrivee mene a SA demande. Toutes n en ont pas : un pli peut
    /// arriver avant qu une demande soit creee (colis, navette interne).
    /// </summary>
    private Task Ouvrir(Arrivee a)
        => string.IsNullOrWhiteSpace(a.NumDemande)
            ? Task.CompletedTask
            : OuvrirDossier.InvokeAsync(a.NumDemande);

    private void Effacer()
    {
        CritNumArrivee = string.Empty;
        CritNomArrivee = string.Empty;
        CritReferences = string.Empty;
        CritMode = string.Empty;
        CritCase = string.Empty;
        CritDu = null;
        CritAu = null;
        CritPaiement = false;
        CritNonNumerise = false;
        CritTopMax = 50;
    }

    private Arrivee[] Trouvees
    {
        get
        {
            IEnumerable<Arrivee> q = JeuDemo.Arrivees;

            if (!string.IsNullOrWhiteSpace(CritNumArrivee))
            {
                var t = CritNumArrivee.Trim();
                q = q.Where(a => a.Numero.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || a.NumDemande.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(CritNomArrivee))
            {
                var t = CritNomArrivee.Trim();
                q = q.Where(a => a.Nom.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(CritReferences))
            {
                var t = CritReferences.Trim();
                q = q.Where(a => a.References.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(CritMode)) q = q.Where(a => a.Mode == CritMode);
            if (!string.IsNullOrWhiteSpace(CritCase))
            {
                var t = CritCase.Trim();
                q = q.Where(a => a.Case_.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (CritPaiement) q = q.Where(a => a.PaiementJoint);
            if (CritNonNumerise) q = q.Where(a => !a.Numerise);
            if (CritDu is { } du) q = q.Where(a => a.Instant.Date >= du.Date);
            if (CritAu is { } au) q = q.Where(a => a.Instant.Date <= au.Date);

            return q.Take(Math.Clamp(CritTopMax, 1, 500)).ToArray();
        }
    }
}
