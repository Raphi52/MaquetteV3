@* Ecran de la procedure PROC_GESTAUDS — gestion des audiences et cabinets.

   Sources RIG v2 (D:/RigApplication/Source/RIG/DLL/Processus/PROC_GESTAUDS) :
     - Operations/OPE_RECHERCHE_GESTAUDS.Designer.cs : les criteres de
       recherche — Date (OPE_DATE_AUDIENCE, puis OPE_DATE_AUDCAB1 et
       OPE_DATE_AUDCAB2 pour l'encadrement), Type d'audience, Chambre,
       Section, Juge, Type de cabinet, Code de cabinet, Type de Classement,
       Nombre de resultats maximum.
     - Operations/OPE_RESULTAT_GESTAUDS.cs : la liste de resultats. Ses
       colonnes sont montees dans Columns.AddRange() et leurs libelles poses
       plus bas (_jour.Text, _date.Text, ...) — d'ou les TREIZE colonnes
       reprises ici. La colonne « Greffier » n'existe QUE lorsque la
       recherche porte sur les cabinets (test ParamTypeRecherche ==
       EnumTypeRecherche.Cabinet) : la bascule « Cabinets » ci-dessous
       reproduit cette condition, elle n'est pas un confort d'affichage.
       De meme, « jugeOuSection » est une seule colonne qui change de titre
       selon le mode — d'ou l'en-tete calcule. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Recherche d'une audience</div>

        <button class="rig-bascule @(ModeCabinet ? "rig-bascule--actif" : "")"
                @onclick="() => ModeCabinet = !ModeCabinet">
            <span class="rig-bascule__temoin"></span>
            <span>Recherche par cabinets</span>
        </button>

        <div class="rig-criteres__paire">
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Du</span>
                <input class="rig-saisie-champ__saisie" type="date" @bind="DateDebut" />
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Au</span>
                <input class="rig-saisie-champ__saisie" type="date" @bind="DateFin" />
            </label>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Type d'audience</span>
            <select class="rig-saisie-champ__saisie" @bind="CritType">
                <option value="">Tous</option>
                @foreach (var t in Audiences.Select(a => a.Type).Distinct().Order())
                {
                    <option value="@t">@t</option>
                }
            </select>
        </label>

        <div class="rig-criteres__paire">
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Chambre</span>
                <select class="rig-saisie-champ__saisie" @bind="CritChambre">
                    <option value="">Toutes</option>
                    @foreach (var c in Audiences.Select(a => a.Chambre).Distinct().Order())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Section</span>
                <select class="rig-saisie-champ__saisie" @bind="CritSection">
                    <option value="">Toutes</option>
                    @foreach (var s in Audiences.Select(a => a.Section).Distinct().Order())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </label>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Juge</span>
            <select class="rig-saisie-champ__saisie" @bind="CritJuge">
                <option value="">Tous</option>
                @foreach (var j in Audiences.Select(a => a.Juge).Distinct().Order())
                {
                    <option value="@j">@j</option>
                }
            </select>
        </label>

        <div class="rig-criteres__paire">
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Type de cabinet</span>
                <select class="rig-saisie-champ__saisie" @bind="CritTypeCabinet">
                    <option value="">Tous</option>
                    @foreach (var t in Audiences.Select(a => a.TypeCabinet).Where(t => t.Length > 0).Distinct().Order())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </label>
            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Code de cabinet</span>
                <select class="rig-saisie-champ__saisie" @bind="CritCodeCabinet">
                    <option value="">Tous</option>
                    @foreach (var c in Audiences.Select(a => a.CodeCabinet).Where(c => c.Length > 0).Distinct().Order())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </label>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Type de classement</span>
            <select class="rig-saisie-champ__saisie" @bind="CritClassement">
                <option value="">Tous</option>
                @foreach (var c in Audiences.Select(a => a.TypeClassement).Distinct().Order())
                {
                    <option value="@c">@c</option>
                }
            </select>
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nombre de resultats maximum</span>
            <input class="rig-saisie-champ__saisie" type="number" min="1" max="999" @bind="MaxResultats" />
        </label>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Audiences trouvees</div>
            <span class="rig-resultats-proc__compte">@Trouvees.Length sur @MaxResultats maximum</span>
        </div>

        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <th>Jour</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Type</th>
                        <th>Code de cabinet</th>
                        @* Une seule colonne en v2, dont le titre change avec le mode. *@
                        <th>@(ModeCabinet ? "Juge" : "Section")</th>
                        @if (ModeCabinet)
                        {
                            <th>Greffier</th>
                        }
                        <th>Type de classement</th>
                        <th>Public</th>
                        <th>Auteur suppression</th>
                        <th>Date suppression</th>
                        <th>Envoi suppression Infogreffe</th>
                        <th>Web (non dispo.)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Trouvees)
                    {
                        <tr>
                            <td>@a.Jour</td>
                            <td class="rig-table__mono">@a.Date</td>
                            <td class="rig-table__mono">@a.Heure</td>
                            <td>@a.Type</td>
                            <td class="rig-table__mono">@Vide(a.CodeCabinet)</td>
                            <td>@(ModeCabinet ? a.Juge : a.Section)</td>
                            @if (ModeCabinet)
                            {
                                <td>@Vide(a.Greffier)</td>
                            }
                            <td>@a.TypeClassement</td>
                            <td class="rig-table__centre">@(a.Public ? "Oui" : "Non")</td>
                            <td>@Vide(a.AuteurSuppression)</td>
                            <td class="rig-table__mono">@Vide(a.DateSuppression)</td>
                            <td class="rig-table__centre">@Vide(a.EnvoiSuppression)</td>
                            <td class="rig-table__centre rig-table__sans">non dispo.</td>
                        </tr>
                    }
                    @if (Trouvees.Length == 0)
                    {
                        <tr class="rig-table__ligne--inerte">
                            <td colspan="13" class="rig-table__vide">Aucune audience ne repond a ces criteres.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private sealed record Audience(string Jour, string Date, string Heure, string Type,
                                   string CodeCabinet, string TypeCabinet, string Juge,
                                   string Section, string Chambre, string Greffier,
                                   string TypeClassement, bool Public,
                                   string AuteurSuppression, string DateSuppression,
                                   string EnvoiSuppression);

    private static readonly Audience[] Audiences =
    [
        new("Lundi",    "14/09/2026", "09h00", "Audience de procedure", "CAB-01", "Cabinet du president", "Mme LEROY",   "1re section", "1re chambre", "M. PETIT",   "Renvoi",       true,  "",          "",           ""),
        new("Lundi",    "14/09/2026", "10h30", "Audience publique",     "CAB-01", "Cabinet du president", "Mme LEROY",   "1re section", "1re chambre", "M. PETIT",   "Mise en delibere", true, "",       "",           ""),
        new("Mardi",    "15/09/2026", "14h00", "Cabinet du juge",       "CAB-03", "Cabinet du rapporteur", "M. DUVAL",   "2e section",  "2e chambre",  "Mme FAURE",  "Renvoi",       false, "",          "",           ""),
        new("Jeudi",    "17/09/2026", "09h30", "Audience publique",     "",       "",                      "M. DUVAL",   "2e section",  "2e chambre",  "",           "Radiation",    true,  "rvilain",   "02/09/2026", "Envoye"),
        new("Vendredi", "18/09/2026", "11h00", "Audience de procedure", "CAB-02", "Cabinet du president",  "Mme LEROY",  "3e section",  "1re chambre", "M. PETIT",   "Clos",         true,  "",          "",           "")
    ];

    private bool ModeCabinet = true;
    private DateOnly? DateDebut;
    private DateOnly? DateFin;
    private string CritType = string.Empty;
    private string CritChambre = string.Empty;
    private string CritSection = string.Empty;
    private string CritJuge = string.Empty;
    private string CritTypeCabinet = string.Empty;
    private string CritCodeCabinet = string.Empty;
    private string CritClassement = string.Empty;
    private int MaxResultats = 100;

    private static string Vide(string valeur) => string.IsNullOrEmpty(valeur) ? "—" : valeur;

    private Audience[] Trouvees
    {
        get
        {
            IEnumerable<Audience> q = Audiences;
            if (!string.IsNullOrEmpty(CritType))        q = q.Where(a => a.Type == CritType);
            if (!string.IsNullOrEmpty(CritChambre))     q = q.Where(a => a.Chambre == CritChambre);
            if (!string.IsNullOrEmpty(CritSection))     q = q.Where(a => a.Section == CritSection);
            if (!string.IsNullOrEmpty(CritJuge))        q = q.Where(a => a.Juge == CritJuge);
            if (!string.IsNullOrEmpty(CritTypeCabinet)) q = q.Where(a => a.TypeCabinet == CritTypeCabinet);
            if (!string.IsNullOrEmpty(CritCodeCabinet)) q = q.Where(a => a.CodeCabinet == CritCodeCabinet);
            if (!string.IsNullOrEmpty(CritClassement))  q = q.Where(a => a.TypeClassement == CritClassement);
            if (DateDebut is { } d) q = q.Where(a => Jour(a.Date) >= d);
            if (DateFin is { } f)   q = q.Where(a => Jour(a.Date) <= f);
            return q.Take(Math.Max(1, MaxResultats)).ToArray();
        }
    }

    private static DateOnly Jour(string texte) =>
        DateOnly.TryParseExact(texte, "dd/MM/yyyy", null,
            System.Globalization.DateTimeStyles.None, out var d) ? d : DateOnly.MinValue;
}
