@* Ecran de la procedure PROC_GESTEMAIL (RIG v2 : « Modele de mail »,
   etapes ETP_RECHERCHE_EMAILMODEL, ETP_EDIT_EMAILMODEL,
   ETP_EDIT_TEMPLATE_MAIL, ETP_APERCU_TEMPLATE_MAIL et
   ETP_RECHERCHE/EDIT_LISTEDISTRIBUTIONMAIL). Champs lus dans les
   formulaires v2 : TxtCode, TxtLib, TxtLibEcran, TxtType, TxtSujet,
   TxtMultiLineCorps, TxtExpediteurCourrierLib / Adr, et les domaines
   CheckBoxRCS, CheckBoxJud, CheckBoxCPT, CheckBoxINS. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Modeles de mail</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Code ou libelle</span>
            <input class="rig-saisie-champ__saisie" @bind="Recherche" @bind:event="oninput" />
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Domaine</div>
            @foreach (var d in Domaines)
            {
                var v = d;
                <button class="rig-bascule @(CritDomaines.Contains(v) ? "rig-bascule--actif" : "")"
                        @onclick="() => BasculerDomaine(v)">
                    <span class="rig-bascule__temoin"></span><span>@v</span>
                </button>
            }
        </div>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Resultats (@Trouves.Length)</div>
            @foreach (var item in Trouves)
            {
                var m = item;
                <button class="rig-bascule @(Selection?.Code == m.Code ? "rig-bascule--actif" : "")"
                        @onclick="() => Selection = m">
                    <span class="rig-bascule__temoin"></span>
                    <span>@m.Code — @m.Libelle</span>
                </button>
            }
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-onglets">
                <button class="rig-onglet @(Apercu ? "rig-onglet--actif" : "")"
                        @onclick="() => Apercu = true">Apercu</button>
                <button class="rig-onglet @(!Apercu ? "rig-onglet--actif" : "")"
                        @onclick="() => Apercu = false">Listes de distribution</button>
            </div>
            <span class="rig-resultats-proc__compte">@(Selection?.Code ?? "aucun modele")</span>
        </div>

        @if (Apercu && Selection is { } s)
        {
            <div class="rig-criteres__bloc" style="padding:var(--rig-esp-3)">
                <div class="rig-criteres__paire">
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Code</span>
                        <input class="rig-saisie-champ__saisie" value="@s.Code" readonly />
                    </label>
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Type</span>
                        <input class="rig-saisie-champ__saisie" value="@s.Type" readonly />
                    </label>
                </div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Libelle ecran</span>
                    <input class="rig-saisie-champ__saisie" value="@s.LibelleEcran" readonly />
                </label>
                <div class="rig-criteres__paire">
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Expediteur (libelle)</span>
                        <input class="rig-saisie-champ__saisie" value="@s.ExpediteurLib" readonly />
                    </label>
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Expediteur (adresse)</span>
                        <input class="rig-saisie-champ__saisie" value="@s.ExpediteurAdr" readonly />
                    </label>
                </div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Sujet</span>
                    <input class="rig-saisie-champ__saisie" value="@s.Sujet" readonly />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Corps du message</span>
                    <textarea class="rig-saisie-champ__saisie" rows="8" readonly>@s.Corps</textarea>
                </label>
                <div>
                    @foreach (var d in s.DomainesModele)
                    {
                        <span class="rig-chip">@d</span>
                    }
                </div>
            </div>
        }
        else if (Apercu)
        {
            <div class="rig-table__vide" style="padding:var(--rig-esp-4)">
                Choisissez un modele dans la liste de gauche.
            </div>
        }
        else
        {
            <div class="rig-table-cadre">
                <table class="rig-table">
                    <thead>
                        <tr>
                            <th>Liste</th>
                            <th>Libelle</th>
                            <th>Domaine</th>
                            <th class="rig-table__centre">Destinataires</th>
                            <th>Adresses</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Distributions)
                        {
                            <tr>
                                <td class="rig-table__mono">@l.Code</td>
                                <td>@l.Libelle</td>
                                <td>@l.Domaine</td>
                                <td class="rig-table__centre">@l.Adresses.Length</td>
                                <td class="rig-table__mono">@string.Join(" ; ", l.Adresses)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private sealed record ModeleMail(string Code, string Libelle, string LibelleEcran, string Type,
                                     string Sujet, string Corps, string ExpediteurLib,
                                     string ExpediteurAdr, string[] DomainesModele);
    private sealed record ListeDistribution(string Code, string Libelle, string Domaine, string[] Adresses);

    private static readonly string[] Domaines = ["RCS", "Judiciaire", "Comptabilite", "Inscriptions"];

    private static readonly ModeleMail[] Modeles =
    [
        new("ACC_DEM", "Accuse de reception de demande", "Accuse de reception", "Transactionnel",
            "Votre demande {NUM_DEMANDE} a bien ete recue",
            "Bonjour {CIVILITE} {NOM},\n\nNous avons bien recu votre demande {NUM_DEMANDE} du {DATE_DEMANDE}.\nElle est en cours de traitement par le greffe.\n\nCordialement,\nLe greffe du tribunal de commerce",
            "Greffe du tribunal de commerce", "greffe@exemple.fr", ["RCS"]),
        new("REJ_DEM", "Rejet de demande", "Rejet", "Transactionnel",
            "Votre demande {NUM_DEMANDE} a ete rejetee",
            "Bonjour {CIVILITE} {NOM},\n\nVotre demande {NUM_DEMANDE} ne peut etre traitee : {MOTIF_REJET}.\nVous pouvez la deposer a nouveau apres correction.\n\nCordialement,\nLe greffe",
            "Greffe du tribunal de commerce", "greffe@exemple.fr", ["RCS"]),
        new("CONV_AUD", "Convocation a une audience", "Convocation", "Judiciaire",
            "Convocation a l'audience du {DATE_AUDIENCE}",
            "Maitre,\n\nVous etes convoque a l'audience du {DATE_AUDIENCE} a {HEURE_AUDIENCE}, chambre {CHAMBRE}.\n\nLe greffe judiciaire",
            "Greffe judiciaire", "judiciaire@exemple.fr", ["Judiciaire"]),
        new("REL_FAC", "Relance de facture", "Relance", "Comptabilite",
            "Relance : facture {NUM_FACTURE}",
            "Bonjour,\n\nSauf erreur, la facture {NUM_FACTURE} du {DATE_FACTURE} reste impayee ({MONTANT} EUR).\n\nLe service comptable",
            "Service comptable", "compta@exemple.fr", ["Comptabilite"])
    ];

    private static readonly ListeDistribution[] Distributions =
    [
        new("LD_MAND", "Mandataires judiciaires", "Judiciaire",   ["a.leroy@exemple.fr", "s.blanc@exemple.fr"]),
        new("LD_COMPTA", "Comptabilite interne",  "Comptabilite", ["compta@exemple.fr"]),
        new("LD_RCS",  "Guichet RCS",             "RCS",          ["rcs@exemple.fr", "accueil@exemple.fr"])
    ];

    private string Recherche = string.Empty;
    private readonly HashSet<string> CritDomaines = new();
    private bool Apercu = true;
    private ModeleMail? Selection = Modeles[0];

    private void BasculerDomaine(string d) { if (!CritDomaines.Add(d)) CritDomaines.Remove(d); }

    private ModeleMail[] Trouves
    {
        get
        {
            IEnumerable<ModeleMail> q = Modeles;
            if (!string.IsNullOrWhiteSpace(Recherche))
            {
                var t = Recherche.Trim();
                q = q.Where(m => m.Code.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || m.Libelle.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (CritDomaines.Count > 0) q = q.Where(m => m.DomainesModele.Any(CritDomaines.Contains));
            return q.ToArray();
        }
    }
}
