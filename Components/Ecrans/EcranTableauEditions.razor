@* ============ ECRAN : TABLEAU DES EDITIONS ============
   Ecran a part entiere, ouvert par un bouton depuis l'affaire : la
   colonne de droite de l'affaire est desormais la saisie guidee.
   Colonnes de PROC_TABLEAU_LOT3/Processus/TreeviewEditions.cs,
   champs de detail d'OPE_DESTINATAIRE.Designer.cs (v2).

   PORTE EN REACT (lot 3 de la migration, 19/11/2026) : l'ecran est rendu par
   web/src/ecrans/EcranTableauEditions.tsx ; les types de papier viennent de
   Pont/EcranTableauEditions.cs. Ce fichier n'est plus qu'une COQUILLE : il
   garde les parametres d'origine (Editions, Affaire, Fermer). Mode d'emploi :
   web/README.md. *@

<IleReact Composant="EcranTableauEditions" Proprietes="Proprietes" Rappels="Rappels" />

@code {
    /// <summary>Les lignes d'edition de l'affaire ouverte.</summary>
    [Parameter] public LigneEdition[] Editions { get; set; } = [];

    /// <summary>Numero et denomination de l'affaire, pour l'entete.</summary>
    [Parameter] public string Affaire { get; set; } = "";

    /// <summary>Referme l'ecran et revient a l'affaire.</summary>
    [Parameter] public EventCallback Fermer { get; set; }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["editions"] = Editions,
        ["affaire"] = Affaire
    };

    private Dictionary<string, IleReact.RappelIle> Rappels => new()
    {
        ["fermer"] = IleReact.Rappel(Fermer)
    };
}
