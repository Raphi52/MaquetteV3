@* Ecran de la procedure PROC_EXPERT.

   Sources RIG v2 (D:/RigApplication/Source/RIG/DLL/Processus/PROC_EXPERT) :
     - Recherche/OPE_RECHERCHE_EXPERT : TextRecherche, DataListviewExpert
     - Edition/OPE_EDITION_EXPERT     : ComboBoxCivilite, TextNom, TextAbrege,
       TextCompNom, TextDateNaissance, TextAdresse, TextTel, TextFax, TextMail,
       ComboBoxQualifProfession, CheckBoxActif, OpeMesureActif / OpeMesureInactif
     - Edition/OPE_MESURE_EXPERT -> Rig_Ult_Metier/LISTVIEW/
       ULT_LISTVIEW_MESURES_EXPERT.cs, dont InitColumns() donne les SIX colonnes
       reprises ici : Num mesure, Civilite, Nom participant, Complement nom,
       Qualif prof, Adresse. *@

<div class="rig-proc__corps">

    <aside class="rig-criteres">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Recherche d'un expert</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Nom, abrege</span>
            <input class="rig-saisie-champ__saisie" @bind="Recherche" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Qualite / profession</span>
            <select class="rig-saisie-champ__saisie" @bind="CritQualif">
                <option value="">Toutes</option>
                @foreach (var q in Experts.Select(e => e.Qualif).Distinct().Order())
                {
                    <option value="@q">@q</option>
                }
            </select>
        </label>

        <button class="rig-bascule @(ActifsSeuls ? "rig-bascule--actif" : "")"
                @onclick="() => ActifsSeuls = !ActifsSeuls">
            <span class="rig-bascule__temoin"></span>
            <span>Experts actifs uniquement</span>
        </button>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Resultats (@Trouves.Length)</div>
            @foreach (var item in Trouves)
            {
                var ex = item;
                <button class="rig-bascule @(Selection?.Abrege == ex.Abrege ? "rig-bascule--actif" : "")"
                        @onclick="() => Selection = ex">
                    <span class="rig-bascule__temoin"></span>
                    <span>@ex.Abrege — @ex.Nom</span>
                </button>
            }
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-kicker">Edition d'un expert</div>
            <span class="rig-resultats-proc__compte">@(Selection?.Abrege ?? "aucun expert selectionne")</span>
        </div>

        @if (Selection is { } e)
        {
            <div class="rig-criteres__bloc" style="padding:var(--rig-esp-3)">
                <div class="rig-kicker">Identite</div>
                <div class="rig-criteres__paire">
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Civilite</span>
                        <input class="rig-saisie-champ__saisie" value="@e.Civilite" readonly />
                    </label>
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Abrege</span>
                        <input class="rig-saisie-champ__saisie" value="@e.Abrege" readonly />
                    </label>
                </div>
                <div class="rig-criteres__paire">
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Nom</span>
                        <input class="rig-saisie-champ__saisie" value="@e.Nom" readonly />
                    </label>
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Complement de nom</span>
                        <input class="rig-saisie-champ__saisie" value="@e.ComplementNom" readonly />
                    </label>
                </div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Date de naissance</span>
                    <input class="rig-saisie-champ__saisie" value="@e.Naissance" readonly />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Adresse</span>
                    <input class="rig-saisie-champ__saisie" value="@e.Adresse" readonly />
                </label>
                <div class="rig-criteres__paire">
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Telephone</span>
                        <input class="rig-saisie-champ__saisie" value="@e.Tel" readonly />
                    </label>
                    <label class="rig-saisie-champ">
                        <span class="rig-saisie-champ__libelle">Fax</span>
                        <input class="rig-saisie-champ__saisie" value="@e.Fax" readonly />
                    </label>
                </div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">E-mail</span>
                    <input class="rig-saisie-champ__saisie" value="@e.Mail" readonly />
                </label>
                <span class="rig-etat rig-etat--@(e.Actif ? "ok" : "attente")">@(e.Actif ? "Actif" : "Inactif")</span>
            </div>

            <div class="rig-resultats-proc__entete">
                <div class="rig-onglets">
                    <button class="rig-onglet @(MesuresActives ? "rig-onglet--actif" : "")"
                            @onclick="() => MesuresActives = true">Mesures en cours</button>
                    <button class="rig-onglet @(!MesuresActives ? "rig-onglet--actif" : "")"
                            @onclick="() => MesuresActives = false">Mesures terminees</button>
                </div>
            </div>

            <div class="rig-table-cadre">
                <table class="rig-table">
                    <thead>
                        <tr>
                            <th>Num mesure</th>
                            <th>Civilite</th>
                            <th>Nom participant</th>
                            <th>Complement nom</th>
                            <th>Qualif prof</th>
                            <th>Adresse</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Mesures.Where(m => m.Expert == e.Abrege && m.EnCours == MesuresActives))
                        {
                            <tr>
                                <td class="rig-table__mono">@m.NumMesure</td>
                                <td>@m.Civilite</td>
                                <td>@m.NomParticipant</td>
                                <td>@m.ComplementNom</td>
                                <td>@m.QualifProf</td>
                                <td>@m.Adresse</td>
                            </tr>
                        }
                        @if (!Mesures.Any(m => m.Expert == e.Abrege && m.EnCours == MesuresActives))
                        {
                            <tr><td colspan="6" class="rig-table__vide">Aucune mesure dans cette liste.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rig-table__vide" style="padding:var(--rig-esp-4)">
                Choisissez un expert dans la liste de gauche.
            </div>
        }
    </section>
</div>

@code {
    private sealed record Expert(string Abrege, string Civilite, string Nom, string ComplementNom,
                                 string Naissance, string Adresse, string Tel, string Fax,
                                 string Mail, string Qualif, bool Actif);

    // Colonnes de ULT_LISTVIEW_MESURES_EXPERT.InitColumns() (RIG v2) :
    // MSINS_NUM_MESURE, PRTCP_CIVILITE, PRTCP_NOM, PRTCP_COMPLEMENT_NOM,
    // PRTCP_QUALIF_PROFESSION, Adresse.AdresseComplete.
    private sealed record MesureExpert(string Expert, string NumMesure, string Civilite,
                                       string NomParticipant, string ComplementNom,
                                       string QualifProf, string Adresse, bool EnCours);

    private static readonly Expert[] Experts =
    [
        new("GIRARD", "M.",  "GIRARD Paul",  "Cabinet Girard & Fils", "14/05/1971", "9 rue Gambetta, 51100 Reims",    "03 26 12 30 44", "",               "p.girard@exemple.fr", "Expert-comptable",     true),
        new("NOEL",   "Mme", "NOEL Julie",   "",                      "02/11/1980", "5 bd Foch, 51100 Reims",         "03 26 44 12 87", "03 26 44 12 88", "j.noel@exemple.fr",   "Expert en evaluation", true),
        new("ROUX",   "M.",  "ROUX Bernard", "SELARL Roux Expertise", "27/03/1958", "18 rue Talleyrand, 51100 Reims", "03 26 05 76 21", "",               "b.roux@exemple.fr",   "Expert immobilier",    false)
    ];

    private static readonly MesureExpert[] Mesures =
    [
        new("GIRARD", "M-2026-0114", "M.",  "GIRARD Paul",  "Cabinet Girard & Fils", "Expert-comptable",     "9 rue Gambetta, 51100 Reims",    true),
        new("GIRARD", "M-2024-0503", "M.",  "GIRARD Paul",  "Cabinet Girard & Fils", "Expert-comptable",     "9 rue Gambetta, 51100 Reims",    false),
        new("NOEL",   "M-2026-0128", "Mme", "NOEL Julie",   "",                      "Expert en evaluation", "5 bd Foch, 51100 Reims",         true),
        new("ROUX",   "M-2025-0087", "M.",  "ROUX Bernard", "SELARL Roux Expertise", "Expert immobilier",    "18 rue Talleyrand, 51100 Reims", false)
    ];

    private string Recherche = string.Empty;
    private string CritQualif = string.Empty;
    private bool ActifsSeuls = true;
    private bool MesuresActives = true;
    private Expert? Selection = Experts[0];

    private Expert[] Trouves
    {
        get
        {
            IEnumerable<Expert> q = Experts;
            if (!string.IsNullOrWhiteSpace(Recherche))
            {
                var t = Recherche.Trim();
                q = q.Where(e => e.Nom.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || e.Abrege.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrEmpty(CritQualif)) q = q.Where(e => e.Qualif == CritQualif);
            if (ActifsSeuls) q = q.Where(e => e.Actif);
            return q.ToArray();
        }
    }
}
