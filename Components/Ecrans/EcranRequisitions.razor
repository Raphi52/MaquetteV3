@* Ecran de la procedure PROC_REQUI - requisitions / commande de documents (fiche 275).

   Il porte le PARCOURS de PROC_REQUI/Operations, ecrit par William LIVIO le
   22/05/2026 sur la branche Feature/RCS/275_Refonte_Requi :
     OPE_REQUI_RECHERCHE  -> les criteres, la limite de dossiers, le compteur
     OPE_REQUI_RESULTATS  -> la grille des entreprises trouvees
     OPE_REQUI_PANIER     -> les commandes groupees par entreprise + adresse
     OPE_REQUI_ARTICLES   -> les documents et les 37 cases d inscription
   Les libelles, les colonnes et les regles viennent de ces fichiers ; rien n est
   invente. Aucune base n est branchee : les societes sont un jeu d exemple. *@

<div class="rig-proc__corps rig-proc__corps--cmdweb">

    @* Zone HAUTE : les commandes passees sur le web et arrivees par EDI.
       C est le raccordement demande par la fiche 275 : choisir une commande
       remplit les criteres et lance la recherche pour rapprocher un dossier. *@
    <section class="rig-cmdweb">
        <div class="rig-cmdweb__entete">
            <div class="rig-kicker">Commandes web a traiter (@NbATraiter)</div>
            <button class="rig-bascule @(MasquerTraitees ? "rig-bascule--actif" : "")"
                    @onclick="() => MasquerTraitees = !MasquerTraitees">
                <span class="rig-bascule__temoin"></span><span>Masquer les traitees</span>
            </button>
        </div>
        <div class="rig-table-cadre">
            <table class="rig-table">
                <thead>
                    <tr>
                        <EnteteTriable Libelle="Origine" Cle="Origine" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="N commande" Cle="Numero" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Recue le" Cle="Recue" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Demandeur" Cle="Demandeur" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Famille" Cle="Famille" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="EDI" Cle="CodeEdi" Classe="rig-table__centre" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Societe visee" Cle="Societe" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Siren" Cle="Siren" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                        <EnteteTriable Libelle="Etat" Cle="Etat" Classe="rig-table__centre" CleActive="@CleTri" Ascendant="TriAscendant" Trier="BasculerTri" />
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in CommandesWebVisibles)
                    {
                        var web = w;
                        <tr class="@(web == CommandeWebEnCours ? "rig-table__ligne--alerte" : (web.Etat == "Traitee" ? "rig-table__ligne--inerte" : ""))"
                            title="Double-cliquez pour rapprocher cette commande d un dossier."
                            @onclick="() => ChoisirCommandeWeb(web)"
                            @ondblclick="() => RapprocherCommandeWeb(web)">
                            <td>@web.Origine</td>
                            <td class="rig-table__mono">@web.Numero</td>
                            <td class="rig-table__mono">@web.Recue.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@web.Demandeur</td>
                            <td>@web.Famille</td>
                            <td class="rig-table__centre rig-table__mono">@web.CodeEdi</td>
                            <td>@web.Societe</td>
                            <td class="rig-table__mono">@web.Siren</td>
                            <td class="rig-table__centre">@web.Etat</td>
                        </tr>
                    }
                    @if (CommandesWebVisibles.Length == 0)
                    {
                        <tr><td colspan="9" class="rig-table__vide">Aucune commande web en attente.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="rig-criteres__actions" style="padding:var(--rig-esp-2) var(--rig-esp-4)">
            <button class="rig-bouton" disabled="@(CommandeWebEnCours is null)"
                    @onclick="MarquerTraitee">Marquer traitee</button>
        </div>
    </section>


    <aside class="rig-criteres" @onkeydown="SurToucheCritere">
        <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">Criteres de recherche</div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Raison sociale</span>
            <input class="rig-saisie-champ__saisie" placeholder="nom de la societe"
                   @bind="CritRaisonSociale" @bind:event="oninput" />
        </label>
        @if (RaisonSocialeInvalide)
        {
            <div class="rig-saisie-champ__refus">Designation invalide : saisissez autre chose que des chiffres.</div>
        }

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">N identification</span>
            <input class="rig-saisie-champ__saisie" placeholder="siren"
                   @bind="CritSiren" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Dirigeant</span>
            <input class="rig-saisie-champ__saisie" @bind="CritDirigeant" @bind:event="oninput" />
        </label>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Activite</span>
            <input class="rig-saisie-champ__saisie" @bind="CritActivite" @bind:event="oninput" />
        </label>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Adresse</div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">N voie</span>
                    <input class="rig-saisie-champ__saisie" @bind="CritNumVoie" @bind:event="oninput" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Adresse</span>
                    <input class="rig-saisie-champ__saisie" @bind="CritAdresse" @bind:event="oninput" />
                </label>
            </div>
            <div class="rig-criteres__paire">
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Code postal</span>
                    <input class="rig-saisie-champ__saisie" @bind="CritCodePostal" @bind:event="oninput" />
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Ville</span>
                    <input class="rig-saisie-champ__saisie" @bind="CritVille" @bind:event="oninput" />
                </label>
            </div>
        </div>

        <div class="rig-criteres__bloc">
            <button class="rig-bascule @(CritPhonetique ? "rig-bascule--actif" : "")"
                    @onclick="() => CritPhonetique = !CritPhonetique">
                <span class="rig-bascule__temoin"></span><span>Phonetique</span>
            </button>
            <button class="rig-bascule @(CritEtendre ? "rig-bascule--actif" : "")"
                    @onclick="() => CritEtendre = !CritEtendre">
                <span class="rig-bascule__temoin"></span><span>Etendre la recherche</span>
            </button>
            <button class="rig-bascule @(CritTousEtb ? "rig-bascule--actif" : "")"
                    @onclick="() => CritTousEtb = !CritTousEtb">
                <span class="rig-bascule__temoin"></span><span>Tous les etablissements</span>
            </button>
            <button class="rig-bascule @(CritSupprCompris ? "rig-bascule--actif" : "")"
                    @onclick="() => CritSupprCompris = !CritSupprCompris">
                <span class="rig-bascule__temoin"></span><span>Inclure les supprimes</span>
            </button>
            <button class="rig-bascule @(CritGuichet ? "rig-bascule--actif" : "")"
                    @onclick="() => CritGuichet = !CritGuichet">
                <span class="rig-bascule__temoin"></span><span>Guichet</span>
            </button>
        </div>

        <label class="rig-saisie-champ">
            <span class="rig-saisie-champ__libelle">Limite max dossiers (50 a 500)</span>
            <input class="rig-saisie-champ__saisie" type="number" min="50" max="500" @bind="CritLimiteDossiers" />
        </label>

        <div class="rig-criteres__actions">
            <button class="rig-bouton rig-bouton--fort" @onclick="Rechercher">Rechercher</button>
            <button class="rig-bouton" @onclick="Effacer">Reinitialiser</button>
        </div>

        <div class="rig-criteres__bloc">
            <div class="rig-kicker">Commandes particulieres</div>
            <button class="rig-bouton rig-bouton--plat" @onclick="@(() => Message = MessageNonPorte("L edition de l Etat de synthese"))">Etat de synthese</button>
            <button class="rig-bouton rig-bouton--plat" @onclick="@(() => Message = MessageNonPorte("La visualisation du KBIS"))">Voir le KBIS</button>
            <button class="rig-bouton rig-bouton--plat" @onclick="@(() => Message = MessageNonPorte("La commande de decisions judiciaires"))">Cmde decisions</button>
            <button class="rig-bouton rig-bouton--plat" @onclick="@(() => Message = MessageNonPorte("La commande par navire"))">Cmde par navire</button>
        </div>
    </aside>

    <section class="rig-resultats-proc">
        <div class="rig-resultats-proc__entete">
            <div class="rig-onglets">
                <button class="rig-onglet @(Volet == "resultats" ? "rig-onglet--actif" : "")"
                        @onclick="@(() => Volet = "resultats")">Resultats</button>
                <button class="rig-onglet @(Volet == "panier" ? "rig-onglet--actif" : "")"
                        @onclick="@(() => Volet = "panier")">Panier (@Panier.Count)</button>
                <button class="rig-onglet @(Volet == "articles" ? "rig-onglet--actif" : "")"
                        @onclick="@(() => Volet = "articles")">Articles commandes</button>
            </div>
            <span class="rig-resultats-proc__compte">@Compteur</span>
        </div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="rig-nonmaq__texte" style="padding:0 var(--rig-esp-4) var(--rig-esp-3)">@Message</div>
        }

        @if (Volet == "resultats")
        {
            <div class="rig-table-cadre">
                <table class="rig-table">
                    <thead>
                        <tr>
                            <th>Id</th><th>Siren</th><th>Gestion</th><th>Designation</th>
                            <th>Type Adresse</th><th>Adresse</th><th class="rig-table__centre">Type</th>
                            <th class="rig-table__centre">Non Inscrit</th>
                            <th class="rig-table__centre">Nb Inscriptions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Trouvees)
                        {
                            var soc = s;
                            <tr class="@(soc.Radie ? "rig-table__ligne--inerte" : "")"
                                title="@Infobulle(soc)"
                                @ondblclick="() => AjouterAuPanier(soc)">
                                <td class="rig-table__mono">@soc.Id</td>
                                <td class="rig-table__mono">@soc.Siren</td>
                                <td class="rig-table__mono">@soc.Gestion</td>
                                <td>@soc.Designation</td>
                                <td>@soc.TypeAdresse</td>
                                <td>@soc.Adresse</td>
                                <td class="rig-table__centre">@soc.Type</td>
                                <td class="rig-table__centre">@(soc.NonInscrit ? "oui" : "")</td>
                                <td class="rig-table__centre">@soc.NbInscriptions</td>
                            </tr>
                        }
                        @if (Trouvees.Length == 0)
                        {
                            <tr><td colspan="9" class="rig-table__vide">
                                @(ARecherche ? "Aucune societe ne repond a ces criteres." : "Saisissez un critere puis lancez la recherche.")
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Interrompue)
            {
                <div class="rig-nonmaq__texte" style="padding:var(--rig-esp-3) var(--rig-esp-4)">
                    Votre recherche a ete interrompue a @LimiteRetenue dossiers.
                    Veuillez preciser votre recherche pour reduire le nombre de resultats.
                </div>
            }
        }
        else if (Volet == "panier")
        {
            <div class="rig-table-cadre">
                <table class="rig-table">
                    <thead>
                        <tr>
                            <th>N</th><th>Siren</th><th>Gestion</th><th>Designation</th>
                            <th>Adresse</th><th>Articles commandes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Panier)
                        {
                            var cmd = c;
                            <tr class="@(cmd == CommandeEnCours ? "rig-table__ligne--alerte" : "")"
                                @onclick="() => Selectionner(cmd)"
                                @ondblclick="() => Supprimer(cmd)">
                                <td class="rig-table__mono">@cmd.NumCommande</td>
                                <td class="rig-table__mono">@cmd.Societe.Siren</td>
                                <td class="rig-table__mono">@cmd.Societe.Gestion</td>
                                <td>@cmd.Societe.Designation</td>
                                <td>@cmd.Societe.Adresse</td>
                                <td>@Resume(cmd)</td>
                            </tr>
                        }
                        @if (Panier.Count == 0)
                        {
                            <tr><td colspan="6" class="rig-table__vide">
                                Le panier est vide : double-cliquez une ligne des resultats pour l y ajouter.
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rig-criteres__actions" style="padding:var(--rig-esp-3) var(--rig-esp-4)">
                <button class="rig-bouton" @onclick="Valider">Valider</button>
                <button class="rig-bouton rig-bouton--fort" @onclick="Terminer">Terminer</button>
            </div>
        }
        else
        {
            @if (CommandeEnCours is null)
            {
                <div class="rig-table__vide" style="padding:var(--rig-esp-4)">
                    Selectionnez une commande dans le panier pour choisir ses articles.
                </div>
            }
            else
            {
                <div style="padding:0 var(--rig-esp-4) var(--rig-esp-4);overflow-y:auto">
                    <div class="rig-kicker" style="margin-bottom:var(--rig-esp-3)">
                        Commande @CommandeEnCours.NumCommande - @CommandeEnCours.Societe.Designation
                    </div>

                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ @(CommandeEnCours.KBisPossible ? "" : "rig-saisie-champ--refuse")">
                            <span class="rig-saisie-champ__libelle">KBIS</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0"
                                   disabled="@(!CommandeEnCours.KBisPossible)"
                                   @bind="CommandeEnCours.NbKBis" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Histo</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbHistorique" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">DAS</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbDAS" />
                        </label>
                    </div>
                    @if (!CommandeEnCours.KBisPossible)
                    {
                        <div class="rig-saisie-champ__refus">KBIS interdit : cette ligne n est pas inscrite au registre.</div>
                    }

                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ @(CommandeEnCours.CnfPossible ? "" : "rig-saisie-champ--refuse")">
                            <span class="rig-saisie-champ__libelle">Certif. Non Faillite</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0"
                                   disabled="@(!CommandeEnCours.CnfPossible)"
                                   @bind="CommandeEnCours.NbCertifNonFaillite" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Date CNF</span>
                            <input class="rig-saisie-champ__saisie" type="date" @bind="CommandeEnCours.DateCnf" />
                        </label>
                    </div>
                    @if (!CommandeEnCours.CnfPossible)
                    {
                        <div class="rig-saisie-champ__refus">
                            Certificat de non faillite bloque : procedure collective en cours ou dossier radie.
                        </div>
                    }

                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Certif. Non RCS</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbCertifNonRcs" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Date CN RCS</span>
                            <input class="rig-saisie-champ__saisie" type="date" @bind="CommandeEnCours.DateCnRcs" />
                        </label>
                    </div>
                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Certif. Non RSAC</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbCertifNonRsac" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Date CN RSAC</span>
                            <input class="rig-saisie-champ__saisie" type="date" @bind="CommandeEnCours.DateCnRsac" />
                        </label>
                    </div>
                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Certif. Non Opposition</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbCertifNonOppo" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Date CN Opposition</span>
                            <input class="rig-saisie-champ__saisie" type="date" @bind="CommandeEnCours.DateCnOppo" />
                        </label>
                    </div>
                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">DJ Copie</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbDjCopie" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">DJ Expedition</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbDjExpedition" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Navire</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbNavire" />
                        </label>
                    </div>
                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">BE Interne</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbBeInterne" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">BE Externe</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" @bind="CommandeEnCours.NbBeExterne" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Nom de la SCI</span>
                            <input class="rig-saisie-champ__saisie" @bind="CommandeEnCours.NomSci" />
                        </label>
                    </div>

                    <div class="rig-criteres__paire">
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Nom du requi</span>
                            <input class="rig-saisie-champ__saisie" @bind="CommandeEnCours.NomRequi" />
                        </label>
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Date de travail</span>
                            <input class="rig-saisie-champ__saisie" type="date" @bind="CommandeEnCours.DateTravail" />
                        </label>
                    </div>
                    @if (CommandeEnCours.TravailFrais)
                    {
                        <div class="rig-kicker">
                            Travail frais : @CommandeEnCours.AgeTravailJours jour(s), limite @CommandeRequi.JoursFraicheur jours.
                        </div>
                    }
                    else
                    {
                        <div class="rig-saisie-champ__refus">
                            Travail perime : @CommandeEnCours.AgeTravailJours jour(s), au-dela des @CommandeRequi.JoursFraicheur jours. Pieces a refaire.
                        </div>
                    }

                    <div class="rig-criteres__bloc">
                        <div class="rig-kicker">Inscriptions</div>
                        <div class="rig-inscriptions">
                            <button class="rig-bascule @(ToutCoche ? "rig-bascule--actif" : "")" @onclick="ToutCocher">
                                <span class="rig-bascule__temoin"></span><span>Tout cocher</span>
                            </button>
                            @foreach (var c in JeuDemo.CasesInscription)
                            {
                                var cas = c;
                                <button class="rig-bascule @(CommandeEnCours.Inscriptions.Contains(cas.Libelle) ? "rig-bascule--actif" : "")"
                                        title="@(string.IsNullOrEmpty(cas.Codes) ? cas.Libelle : "Types d inscription : " + cas.Codes)"
                                        @onclick="() => BasculerInscription(cas)">
                                    <span class="rig-bascule__temoin"></span><span>@cas.Libelle</span>
                                </button>
                            }
                        </div>
                        @if (CommandeEnCours.Inscriptions.Count > 0)
                        {
                            <div class="rig-criteres__paire">
                                @foreach (var c in JeuDemo.CasesInscription.Where(x => CommandeEnCours.Inscriptions.Contains(x.Libelle)))
                                {
                                    var cas = c;
                                    <label class="rig-saisie-champ">
                                        <span class="rig-saisie-champ__libelle">Qte @cas.Libelle</span>
                                        <input class="rig-saisie-champ__saisie" type="number" min="0"
                                               value="@QteInscription(cas.Libelle)"
                                               @onchange="e => ChangerQteInscription(cas.Libelle, e.Value?.ToString())" />
                                    </label>
                                }
                            </div>
                        }
                        <label class="rig-saisie-champ">
                            <span class="rig-saisie-champ__libelle">Qte inscriptions (total)</span>
                            <input class="rig-saisie-champ__saisie" type="number" min="0" readonly @bind="CommandeEnCours.NbInscr" />
                        </label>
                    </div>
                </div>
            }
        }
    </section>
</div>

@code {
    // ---- Criteres (OPE_REQUI_RECHERCHE : proprietes d acces aux criteres) ----
    private string CritRaisonSociale = string.Empty;
    private string CritSiren = string.Empty;
    private string CritDirigeant = string.Empty;
    private string CritActivite = string.Empty;
    private string CritNumVoie = string.Empty;
    private string CritAdresse = string.Empty;
    private string CritCodePostal = string.Empty;
    private string CritVille = string.Empty;
    private bool CritPhonetique, CritEtendre, CritTousEtb, CritSupprCompris, CritGuichet;
    private int CritLimiteDossiers = 500;

    // ---- Zone haute : commandes web (fiche 275) ----
    private readonly CommandeWeb[] CommandesWeb = JeuDemo.CommandesWeb();
    private CommandeWeb? CommandeWebEnCours;
    private bool MasquerTraitees;

    private CommandeWeb[] CommandesWebVisibles
    {
        get
        {
            IEnumerable<CommandeWeb> q = MasquerTraitees
                ? CommandesWeb.Where(c => c.Etat != "Traitee")
                : CommandesWeb;

            // Sans clic sur un en-tete, l'ordre d'arrivee est conserve.
            if (CleTri is null) return q.ToArray();

            Func<CommandeWeb, object> clef = CleTri switch
            {
                "Origine" => c => c.Origine,
                "Numero" => c => c.Numero,
                "Demandeur" => c => c.Demandeur,
                "Famille" => c => c.Famille,
                "CodeEdi" => c => c.CodeEdi,
                "Societe" => c => c.Societe,
                "Siren" => c => c.Siren,
                "Etat" => c => c.Etat,
                _ => c => c.Recue
            };
            return (TriAscendant ? q.OrderBy(clef) : q.OrderByDescending(clef)).ToArray();
        }
    }

    // ---- Tri de la grille des commandes web (en-tetes cliquables) ----
    private string? CleTri;
    private bool TriAscendant = true;

    /// <summary>Premier clic : ordre croissant. Second clic sur la MEME
    /// colonne : ordre inverse.</summary>
    private void BasculerTri(string cle)
    {
        if (CleTri == cle) TriAscendant = !TriAscendant;
        else { CleTri = cle; TriAscendant = true; }
    }

    private int NbATraiter => CommandesWeb.Count(c => c.Etat != "Traitee");

    private string Volet = "resultats";
    private string Message = string.Empty;
    private bool ARecherche;
    private bool Interrompue;
    private int LimiteRetenue = 500;
    private EntrepriseRequi[] Trouvees = [];

    private readonly List<CommandeRequi> Panier = new();
    private CommandeRequi? CommandeEnCours;

    /// <summary>Vrai quand la prochaine ligne ajoutee ouvre une commande NEUVE
    /// sans regroupement (ForcedNewCmd de frmRechLET, porte dans OPE_REQUI_PANIER).</summary>
    private bool ForcerNouvelleCommande;

    /// <summary>Limite ramenee dans 50..500, comme LimiteDossiers de OPE_REQUI_RECHERCHE.</summary>
    private int Limite => Math.Clamp(CritLimiteDossiers, 50, 500);

    /// <summary>AuMoinsUnCritere de OPE_REQUI_RECHERCHE : les cases a cocher ne comptent pas.</summary>
    private bool AuMoinsUnCritere =>
        !string.IsNullOrWhiteSpace(CritRaisonSociale) || !string.IsNullOrWhiteSpace(CritSiren)
        || !string.IsNullOrWhiteSpace(CritDirigeant) || !string.IsNullOrWhiteSpace(CritActivite)
        || !string.IsNullOrWhiteSpace(CritNumVoie) || !string.IsNullOrWhiteSpace(CritAdresse)
        || !string.IsNullOrWhiteSpace(CritCodePostal) || !string.IsNullOrWhiteSpace(CritVille);

    /// <summary>Refus de _ValiderRaisonSociale : au-dela de 6 caracteres, une
    /// designation faite QUE de chiffres est rejetee.</summary>
    private bool RaisonSocialeInvalide =>
        CritRaisonSociale.Length > 6 && int.TryParse(CritRaisonSociale, out _);

    private string Compteur => Volet switch
    {
        "panier" => Panier.Count + " commande(s) au panier",
        "articles" => CommandeEnCours is null ? "aucune commande selectionnee"
                                              : "commande " + CommandeEnCours.NumCommande,
        _ => ARecherche
                ? Trouvees.Length + " ligne(s) / " + NbDossiers + " dossier"
                  + (NbDossiers > 1 ? "s" : "")
                : "recherche non lancee"
    };

    private int NbDossiers => Trouvees.Select(s => s.Gestion).Where(g => g.Length > 0).Distinct().Count();

    private static string MessageNonPorte(string quoi) =>
        quoi + " n est pas encore implementee dans la maquette des requisitions.";

    /// <summary>Entree dans le bloc des criteres = clic sur Rechercher.
    /// C'est le geste de RIG v2 : on tape, on valide, sans lacher le clavier.</summary>
    private void SurToucheCritere(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Rechercher();
    }

    private void Rechercher()
    {
        Message = string.Empty;
        Interrompue = false;

        if (RaisonSocialeInvalide)
        {
            Message = "Designation invalide : saisissez autre chose que des chiffres.";
            Trouvees = [];
            ARecherche = true;
            return;
        }
        if (!AuMoinsUnCritere)
        {
            Message = "Veuillez saisir un critere de recherche.";
            Trouvees = [];
            ARecherche = false;
            return;
        }

        IEnumerable<EntrepriseRequi> q = JeuDemo.EntreprisesRequi;

        if (Filtre(CritRaisonSociale)) q = q.Where(s => Contient(s.Designation, CritRaisonSociale));
        if (Filtre(CritSiren))
        {
            var t = CritSiren.Replace(" ", string.Empty);
            q = q.Where(s => s.Siren.Replace(" ", string.Empty).Contains(t, StringComparison.OrdinalIgnoreCase));
        }
        if (Filtre(CritDirigeant)) q = q.Where(s => Contient(s.Dirigeant, CritDirigeant));
        if (Filtre(CritActivite)) q = q.Where(s => Contient(s.Activite, CritActivite));
        if (Filtre(CritNumVoie)) q = q.Where(s => Contient(s.Adresse, CritNumVoie));
        if (Filtre(CritAdresse)) q = q.Where(s => Contient(s.Adresse, CritAdresse));
        if (Filtre(CritCodePostal)) q = q.Where(s => Contient(s.CodePostal, CritCodePostal));
        if (Filtre(CritVille)) q = q.Where(s => Contient(s.Ville, CritVille));

        // « Tous les etablissements » decoche : seul le siege remonte.
        if (!CritTousEtb) q = q.Where(s => s.TypeAdresse != "Etablissement");
        // « Inclure les supprimes » decoche : les radies sont ecartes.
        if (!CritSupprCompris) q = q.Where(s => !s.Radie);

        LimiteRetenue = Limite;
        var toutes = q.ToArray();
        Trouvees = toutes.Take(LimiteRetenue).ToArray();
        Interrompue = toutes.Length > LimiteRetenue;
        ARecherche = true;
        Volet = "resultats";
    }

    private static bool Filtre(string v) => !string.IsNullOrWhiteSpace(v);

    private static bool Contient(string champ, string critere) =>
        champ.Contains(critere.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>Infobulle de la grille des resultats : ce que _TooltipDesignation
    /// de OPE_REQUI_RESULTATS affiche (forme, dirigeant, procedure collective).</summary>
    private static string Infobulle(EntrepriseRequi s)
    {
        var lignes = new List<string> { s.Designation };
        if (s.Dirigeant.Length > 0) lignes.Add("Dirigeant : " + s.Dirigeant);
        if (s.Activite.Length > 0) lignes.Add("Activite : " + s.Activite);
        if (s.ProcedureCollective) lignes.Add("Procedure collective en cours");
        if (s.Radie) lignes.Add("Dossier radie");
        if (s.NonInscrit) lignes.Add("Non inscrit au registre");
        return string.Join("\n", lignes);
    }

    /// <summary>AjouterDepuisRecherche de OPE_REQUI_PANIER : on regroupe sous le
    /// MEME numero de commande les lignes de la meme entreprise a la meme adresse,
    /// sauf si « Valider » vient de demander une commande neuve.</summary>
    private void AjouterAuPanier(EntrepriseRequi societe)
    {
        Message = string.Empty;

        var existante = ForcerNouvelleCommande
            ? null
            : Panier.FirstOrDefault(c => c.Societe.Siren == societe.Siren
                                      && c.Societe.Adresse == societe.Adresse);

        if (existante is not null)
        {
            CommandeEnCours = existante;
        }
        else
        {
            // Fiche 275, « Nom de la demande » : quand la commande vient du web, le
            // nom du requi est prerempli avec « Site local ou Infogreffe - N de
            // commande et date ». En saisie manuelle, il reste vide.
            var cmd = new CommandeRequi
            {
                NumCommande = Panier.Count == 0 ? 1 : Panier.Max(c => c.NumCommande) + 1,
                Societe = societe,
                NomRequi = CommandeWebEnCours?.NomDemande ?? string.Empty
            };
            Panier.Add(cmd);
            CommandeEnCours = cmd;
            ForcerNouvelleCommande = false;
        }

        Volet = "articles";
    }

    /// <summary>Selection simple d une commande web : elle devient la commande
    /// courante, sans rien lancer.</summary>
    private void ChoisirCommandeWeb(CommandeWeb web)
    {
        CommandeWebEnCours = web;
        Message = string.Empty;
    }

    /// <summary>Rapprochement : les criteres sont remplis avec ce que le demandeur
    /// a saisi sur le web (siren s il existe, sinon la raison sociale) et la
    /// recherche part. C est le raccordement CMD_WEB -> ecran de la fiche 275.</summary>
    private void RapprocherCommandeWeb(CommandeWeb web)
    {
        CommandeWebEnCours = web;
        Effacer();

        if (!string.IsNullOrWhiteSpace(web.Siren)) CritSiren = web.Siren;
        else CritRaisonSociale = web.Societe;

        Rechercher();
        if (Trouvees.Length == 0 && string.IsNullOrEmpty(Message))
        {
            Message = "Commande " + web.Numero + " : aucun dossier ne correspond a "
                    + web.Societe + ". Cherchez a la main.";
        }
    }

    /// <summary>« Marquer traitee » : la commande web passe a l etat Traitee.
    /// TODO #275 - ce que « valider » declenche vraiment (accuse de reception EDI,
    /// edition des documents, facturation) n est PAS defini par la fiche : ici on
    /// ne change QUE l etat affiche.</summary>
    private void MarquerTraitee()
    {
        if (CommandeWebEnCours is null) return;
        CommandeWebEnCours.Etat = "Traitee";
        Message = "Commande " + CommandeWebEnCours.Numero + " marquee traitee. "
                + "L accuse EDI, l edition et la facturation ne sont pas portes (TODO #275).";
    }

    private void Selectionner(CommandeRequi cmd)
    {
        CommandeEnCours = cmd;
        Message = string.Empty;
    }

    /// <summary>Suppression d une ligne du panier : les commandes en aval sont
    /// renumerotees (RenumeroterCommandes de OPE_REQUI_PANIER).</summary>
    private void Supprimer(CommandeRequi cmd)
    {
        Panier.Remove(cmd);
        if (CommandeEnCours == cmd) CommandeEnCours = null;
        for (var i = 0; i < Panier.Count; i++) Panier[i].NumCommande = i + 1;
    }

    /// <summary>« Valider » : le panier est CONSERVE, seuls les criteres sont vides
    /// et le regroupement repart a zero (btnValider_Click de frmRechLET).</summary>
    private void Valider()
    {
        ForcerNouvelleCommande = true;
        Effacer();
        Message = "Criteres vides : la prochaine ligne ajoutee ouvrira une nouvelle commande.";
    }

    /// <summary>« Terminer » : la maquette montre l apercu des commandes a inserer.
    /// L impression et la facturation restent a porter (TODO #275, points 1 a 5 de
    /// OPE_REQUI_PANIER.Terminer).</summary>
    private void Terminer()
    {
        if (Panier.Count == 0)
        {
            Message = "Aucune commande n a ete trouvee.";
            Volet = "panier";
            return;
        }
        Message = "Apercu des commandes a inserer : "
                + string.Join(" | ", Panier.Select(c => "n" + c.NumCommande + " " + c.Societe.Designation
                                                        + " -> " + Resume(c)))
                + ". L impression et la facturation ne sont pas encore portees (TODO #275).";
        Volet = "panier";
    }

    private void Effacer()
    {
        CritRaisonSociale = string.Empty;
        CritSiren = string.Empty;
        CritDirigeant = string.Empty;
        CritActivite = string.Empty;
        CritNumVoie = string.Empty;
        CritAdresse = string.Empty;
        CritCodePostal = string.Empty;
        CritVille = string.Empty;
        CritPhonetique = CritEtendre = CritTousEtb = CritSupprCompris = CritGuichet = false;
        CritLimiteDossiers = 500;
        Trouvees = [];
        ARecherche = false;
        Interrompue = false;
    }

    private bool ToutCoche =>
        CommandeEnCours is not null
        && CommandeEnCours.Inscriptions.Count == JeuDemo.CasesInscription.Length;

    private void ToutCocher()
    {
        if (CommandeEnCours is null) return;
        if (ToutCoche)
        {
            CommandeEnCours.Inscriptions.Clear();
            CommandeEnCours.QteParInscription.Clear();
        }
        else
        {
            foreach (var c in JeuDemo.CasesInscription)
            {
                if (CommandeEnCours.Inscriptions.Add(c.Libelle)) CommandeEnCours.QteParInscription[c.Libelle] = 1;
            }
        }
        GestionQteInscr();
    }

    private void BasculerInscription(CaseInscription cas)
    {
        if (CommandeEnCours is null) return;
        if (CommandeEnCours.Inscriptions.Add(cas.Libelle))
        {
            CommandeEnCours.QteParInscription[cas.Libelle] = 1;
        }
        else
        {
            CommandeEnCours.Inscriptions.Remove(cas.Libelle);
            CommandeEnCours.QteParInscription.Remove(cas.Libelle);
        }
        GestionQteInscr();
    }

    /// <summary>Quantite demandee pour UN type d inscription (0 si la case n est pas cochee).</summary>
    private int QteInscription(string libelle) =>
        CommandeEnCours is not null && CommandeEnCours.QteParInscription.TryGetValue(libelle, out var n) ? n : 0;

    /// <summary>Saisie d une quantite pour un type d inscription : une valeur illisible
    /// ou negative vaut 0, et le total NbInscr est recalcule derriere.</summary>
    private void ChangerQteInscription(string libelle, string? saisie)
    {
        if (CommandeEnCours is null || !CommandeEnCours.Inscriptions.Contains(libelle)) return;
        CommandeEnCours.QteParInscription[libelle] = int.TryParse(saisie, out var v) && v > 0 ? v : 0;
        GestionQteInscr();
    }

    /// <summary>GestionQteInscr de frmRechLET : des qu une case d inscription STRICTE
    /// est cochee, la quantite passe a 1 si elle valait 0 ; plus aucune cochee, elle
    /// retombe a 0. Les cases non strictes (NJ, FA, ST, VNO, STP, GSD, Parts, CLR,
    /// Fluvial, Maritime, NAIJ, Z) ne comptent pas.</summary>
    private void GestionQteInscr()
    {
        if (CommandeEnCours is null) return;
        var auMoinsUne = JeuDemo.CasesInscription
            .Where(c => c.Stricte)
            .Any(c => CommandeEnCours.Inscriptions.Contains(c.Libelle));

        if (auMoinsUne)
        {
            // La quantite globale est desormais la SOMME des quantites par type ;
            // elle ne peut pas retomber a 0 tant qu une case stricte est cochee.
            var somme = JeuDemo.CasesInscription
                .Where(c => CommandeEnCours.Inscriptions.Contains(c.Libelle))
                .Sum(c => QteInscription(c.Libelle));
            CommandeEnCours.NbInscr = somme > 0 ? somme : 1;
        }
        else
        {
            CommandeEnCours.NbInscr = 0;
        }
    }

    /// <summary>Colonne « Articles commandes » du panier : ce qui a ete demande,
    /// en clair.</summary>
    private static string Resume(CommandeRequi c)
    {
        var parts = new List<string>();
        void Add(int n, string quoi) { if (n > 0) parts.Add(n + " " + quoi); }
        Add(c.NbKBis, "KBIS");
        Add(c.NbHistorique, "Histo");
        Add(c.NbDAS, "DAS");
        Add(c.NbCertifNonFaillite, "Certif. Non Faillite");
        Add(c.NbCertifNonRcs, "Certif. Non RCS");
        Add(c.NbCertifNonRsac, "Certif. Non RSAC");
        Add(c.NbCertifNonOppo, "Certif. Non Opposition");
        Add(c.NbDjCopie, "DJ Copie");
        Add(c.NbDjExpedition, "DJ Expedition");
        Add(c.NbNavire, "Navire");
        Add(c.NbBeInterne, "BE Interne");
        Add(c.NbBeExterne, "BE Externe");
        if (c.NbInscr > 0)
        {
            parts.Add(c.NbInscr + " inscription(s) : "
                      + string.Join(", ", JeuDemo.CasesInscription
                            .Where(x => c.Inscriptions.Contains(x.Libelle))
                            .Select(x => x.Libelle + " x"
                                        + (c.QteParInscription.TryGetValue(x.Libelle, out var q) ? q : 0))));
        }
        if (!string.IsNullOrWhiteSpace(c.NomRequi)) parts.Add("requi " + c.NomRequi);
        parts.Add("travail du " + c.DateTravail.ToString("dd/MM/yyyy")
                  + (c.TravailFrais ? "" : " (perime)"));
        return parts.Count == 0 ? "rien de demande" : string.Join(", ", parts);
    }
}
