@* Ecran de la procedure PROC_DEMANDE.
   Motif de RIG v2 : CRITERES DE RECHERCHE a gauche, RESULTATS a droite
   (PROC_DEMANDE/RECHERCHE/OPE_SEARCH.cs et PROC_DEMANDE/RESULTATS).
   Les colonnes viennent de PROC_DEMANDE/DemandeDataGridView.cs.

   PORTE EN REACT (lot 3 de la migration, 18/11/2026) : l'ecran est rendu par
   web/src/ecrans/EcranDemandes.tsx, ses lignes viennent de
   Pont/EcranDemandes.cs (filtre sur JeuDemo.Demandes). Ce fichier n'est plus
   qu'une COQUILLE : il garde les parametres d'origine (EstValide, Ouvrir) pour
   que Home.razor ne change pas. Mode d'emploi : web/README.md.

   EstValide est une FONCTION : elle ne traverse pas vers React. La coquille
   l'applique ici aux dossiers connus et passe la LISTE des dossiers valides ;
   l'accueil se re-rendant apres une validation, la liste suit. *@

<IleReact Composant="EcranDemandes" Proprietes="Proprietes" Rappels="Rappels" />

@code {
    /// <summary>Dit si un dossier a passe le controle final.</summary>
    [Parameter, EditorRequired] public Func<string, bool> EstValide { get; set; } = _ => false;

    /// <summary>Remonte le numero du dossier a ouvrir dans la visionneuse.</summary>
    [Parameter] public EventCallback<string> Ouvrir { get; set; }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["valides"] = JeuDemo.Demandes.Select(d => d.Dossier).Distinct().Where(EstValide).ToArray()
    };

    private Dictionary<string, IleReact.RappelIle> Rappels => new()
    {
        ["ouvrir"] = IleReact.Rappel(Ouvrir)
    };
}
