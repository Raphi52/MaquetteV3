    [
        new("004176", "Modification - SCI DU PARC",     "J+9", "hors delai",     "alerte"),
        new("004182", "Immatriculation - AMIENS BILLARDS",   "J+4", "en cours",       "action"),
        new("004179", "Radiation - MARTIN EURL",        "J+1", "attente pieces", "attente"),
        new("004168", "Immatriculation - BATIPRO SARL", "",    "",               "neutre", "M. DURAND")
    ];

    private readonly Service[] Services =
    [
        new("Base & editions",     "ok"),
        new("Teletransmission",    "ok"),
        new("Fusion documentaire", "alerte", "lente")
    ];

    /// <summary>
    /// Tuile « Mes affaires recentes » : les affaires REELLEMENT ouvertes,
    /// la plus recente en tete. Un clic SIMPLE ouvre directement l'affaire.
    /// </summary>
    private RenderFragment CorpsRecents => @<div>
        @if (Etat.Consultations.Count == 0)
        {
            <div class="rig-table__vide" style="padding:var(--rig-esp-3)">
                Aucune affaire consultee pour l'instant. Les affaires que vous
                ouvrez apparaitront ici, la plus recente en tete.
            </div>
        }
        else
        {
            @foreach (var c in Etat.Consultations.Take(8))
            {
                var vue = c;
                <div class="rig-ligne @(EstValide(vue.Numero) ? "rig-ligne--valide" : "")"
                     @onclick="() => OuvrirParNumero(vue.Numero)"
                     style="cursor:pointer">
                    <span class="rig-filet-v rig-filet-v--@vue.Statut"></span>
                    <span>
                        <span class="rig-ligne__id">@vue.Numero</span><br />
                        <span class="rig-ligne__objet">@vue.Objet</span>
                    </span>
                    <span class="rig-ligne__droite">
                        <span style="font-size:12px;color:var(--rig-texte-2)">@vue.Depuis</span><br />
                        <span style="font-size:11px;color:var(--rig-texte-3)">@vue.Type</span>
                    </span>
                </div>
            }
        }
