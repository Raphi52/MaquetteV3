    private PoseTuile Pose(string id)
    {
        if (Etat.Tuiles.TryGetValue(id, out var pose)) return pose;
        var defaut = Definitions.First(d => d.Id == id).Defaut;
        var copie = new PoseTuile
        {
            Colonne = defaut.Colonne, Ligne = defaut.Ligne,
            Largeur = defaut.Largeur, Hauteur = defaut.Hauteur,
            Visible = true
        };
        Etat.Tuiles[id] = copie;
        return copie;
    }

    private void BasculerPanneauTuiles() => PanneauTuilesOuvert = !PanneauTuilesOuvert;

    private void BasculerPanneauBarre() => PanneauBarreOuvert = !PanneauBarreOuvert;

    /// <summary>
    /// Remet CHAQUE tuile a sa pose d'origine (colonne, ligne, largeur,
    /// hauteur) : la disposition par defaut est calee sur la grille 12
    /// colonnes et ne comporte aucun chevauchement. Ce que l'utilisateur a
    /// allume ou eteint est conserve : seule la geometrie est reprise.
    /// </summary>
    private void ReinitialiserDisposition()
    {
        var rang = 1;
        foreach (var def in Definitions)
        {
            var pose = Pose(def.Id);
            pose.Colonne = def.Defaut.Colonne;
            pose.Ligne   = def.Defaut.Ligne;
            pose.Largeur = def.Defaut.Largeur;
            pose.Hauteur = def.Defaut.Hauteur;
            pose.Ordre   = rang++;
        }
        Etat.Enregistrer();
    }

    private void BasculerTuile(string id)
    {
        var p = Pose(id);
        p.Visible = !p.Visible;
        // Une tuile qu'on rallume est la derniere manipulee : elle passe
        // devant, sinon elle pourrait reapparaitre sous une voisine.
        if (p.Visible) Etat.Avancer(id);
        Etat.Enregistrer();
    }

    /// <summary>Appelee par rig-accueil.js quand la tuile est lachee sur une case.</summary>
    [JSInvokable]
    public void PoserTuile(string id, int colonne, int ligne)
    {
        var p = Pose(id);
        p.Colonne = Math.Clamp(colonne, 1, Math.Max(13 - p.Largeur, 1));
        p.Ligne = Math.Max(ligne, 1);
        Etat.Avancer(id);
        Etat.Enregistrer();
        StateHasChanged();
    }

    [JSInvokable]
    public void DimensionnerTuile(string id, int largeur, int hauteur)
    {
        var p = Pose(id);
        p.Largeur = Math.Clamp(largeur, 3, Math.Max(13 - p.Colonne, 3));
        p.Hauteur = Math.Max(hauteur, 1);
        Etat.Avancer(id);
        Etat.Enregistrer();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Etat = AccueilEtat.Charger();
        RelevePerf();

        foreach (var def in Definitions) { Pose(def.Id); }
        foreach (var a in Alertes)
        {
            if (!Etat.Alertes.ContainsKey(a.Id)) Etat.Alertes[a.Id] = true;
        }
    }

    private bool PaginationSuivie;

    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        // La saisie guidee n'existe pas au premier rendu : son observateur de
        // defilement doit etre branche au rendu ou elle apparait.
        if (!premierRendu)
        {
            if (Module is null) return;
            if (ModeSaisie && !PaginationSuivie && Lien is not null)
            {
                PaginationSuivie = true;
                try { await Module.InvokeVoidAsync("suivrePagination", ZonePages, Lien); }
                catch (JSException) { PaginationSuivie = false; }
            }
            else if (!ModeSaisie && PaginationSuivie)
            {
                PaginationSuivie = false;
                try { await Module.InvokeVoidAsync("arreterPagination"); }
                catch (JSException) { }
            }
            return;
        }
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./rig-accueil.js");
        Lien = DotNetObjectReference.Create(this);
        await Module.InvokeVoidAsync("activerPose", Grille, Lien);
        await AppliquerTheme();
        MinuteurPerf = new Timer(_ =>
        {
            RelevePerf();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Le rechargement de la vue (reprise a chaud du CSS) demonte ce composant
    // APRES que la page JS a disparu : les appels de nettoyage levent alors
    // JSException. Non attrapee, elle remonte au dispatcher WPF et FERME
    // l'application -- exactement ce que la reprise a chaud doit eviter.
    public async ValueTask DisposeAsync()
    {
        if (MinuteurPerf is not null) await MinuteurPerf.DisposeAsync();
        if (Module is not null)
        {
            try { await Module.InvokeVoidAsync("arreterPose"); } catch (JSException) { }
            try { await Module.InvokeVoidAsync("arreterPagination"); } catch (JSException) { }
            try { await Module.DisposeAsync(); } catch (JSException) { }
        }
        Lien?.Dispose();
    }

