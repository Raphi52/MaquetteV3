    /// <summary>Statut affiche par le filet d'une tuile : fixe par defaut, mais les
    /// tuiles qui portent un etat vivant (la file, les alertes) le recalculent.</summary>
    private string StatutTuile(DefinitionTuile def) => def.Id switch
    {
        "alertes" or "alertes-bis" => AlertesVues.Any(a => a.Statut == "alerte") ? "alerte" : "attente",
        "taches" => TachesVues.Any(a => a.Statut == "alerte") ? "alerte"
                    : TachesVues.Length > 0 ? "action" : "ok",
        "actualites" => ActualitesVues.Actifs.Any(b => b.Statut == "alerte") ? "alerte" : def.Statut,
        _         => def.Statut
    };

