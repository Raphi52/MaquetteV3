    /// <summary>Sous-menus deplies, reperes par « Metier/Verbe ». A l'ouverture
    /// d'un metier, son PREMIER verbe s'ouvre seul : on voit tout de suite des
    /// ecrans, pas une liste de titres vides.</summary>
    private readonly HashSet<string> SousOuverts = new() { "Ouvrir/Creer une affaire" };
    private static string CleSous(Moment m, SousMenu s) => $"{m.Titre}/{s.Titre}";
    private bool SousEstOuvert(Moment m, SousMenu s)
        => s.Titre.Length == 0 || SousOuverts.Contains(CleSous(m, s));
    private void BasculerSous(Moment m, SousMenu s)
    {
        var cle = CleSous(m, s);
        if (!SousOuverts.Add(cle)) SousOuverts.Remove(cle);
    }

    private readonly HashSet<string> MomentsOuverts = new() { "Ouvrir" };
    private void BasculerMoment(string titre)
    {
        if (!MomentsOuverts.Add(titre)) { MomentsOuverts.Remove(titre); return; }

        // A l'ouverture d'un metier, son premier verbe s'ouvre avec lui : sans
        // cela on ne verrait qu'une liste de titres, et il faudrait deux clics
        // de plus pour atteindre le moindre ecran.
        var m = Moments.FirstOrDefault(x => x.Titre == titre);
        if (m is not null && m.Sous.Length > 0 && m.Sous[0].Titre.Length > 0)
            SousOuverts.Add(CleSous(m, m.Sous[0]));
    }

    /// <summary>Menu de gauche replie sur un rail etroit. Le menu reste
    /// visible dans les deux etats : seule la largeur de sa colonne change.</summary>
    private bool MenuReduit;
    private void BasculerMenu() => MenuReduit = !MenuReduit;

    /// <summary>Clic sur un moment. Si le menu est replie, le clic le deploie
    /// d'abord : sur le rail, les libelles ne sont pas lisibles.</summary>
    private void OuvrirMoment(string titre)
    {
        if (MenuReduit)
        {
            MenuReduit = false;
            MomentsOuverts.Add(titre);
            return;
        }
        BasculerMoment(titre);
    }

    /// <summary>Ouvre l'ecran d'un code sans que l'appelant ait a connaitre son
    /// libelle : le catalogue <see cref="Groupes"/> reste la seule source.</summary>
    private void OuvrirCode(string code)
    {
        var p = Groupes.SelectMany(g => g.Procs).FirstOrDefault(x => x.Code == code);
        if (p is not null) { OuvrirProc(p); return; }

        // Le menu couvre desormais TOUT le catalogue de RIG v2, pas seulement
        // les ecrans deja portes. Pour une procedure sans ecran, le libelle du
        // menu sert de titre : on ouvre un ecran « a venir » qui se nomme,
        // plutot que de ne rien faire au clic.
        var e = EntreeDeCode(code);
        if (e is not null) OuvrirProc(new Proc(code, e.Libelle));
    }

    /// <summary>L'entree de menu qui porte un code, ou null.</summary>
    private Entree? EntreeDeCode(string code)
        => Moments.SelectMany(m => m.Sous).SelectMany(s => s.Entrees)
                  .FirstOrDefault(x => x.Code == code);

    /// <summary>La TACHE (le sous-menu) a laquelle appartient une procedure :
    /// le meme geste metier, quels que soient les ecrans qui le servent. Elle
    /// sert de repli au bandeau quand la procedure n'appartient a aucun sujet
    /// d'objet — ainsi TOUTE procedure ouverte montre ses voisines de geste.</summary>
    private SousMenu? TacheDe(string code)
        => Moments.SelectMany(m => m.Sous)
                  .FirstOrDefault(s => s.Entrees.Any(e => e.Code == code));

    /// <summary>Le titre affichable d'une tache : son verbe, prefixe du metier
    /// quand le sous-menu n'a pas de titre propre (« Terminer »).</summary>
    private string TitreTache(SousMenu s)
    {
        var m = Moments.First(x => x.Sous.Contains(s));
        return s.Titre.Length > 0 ? $"{m.Titre} : {s.Titre}" : m.Titre;
    }

