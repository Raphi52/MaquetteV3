@page "/"
@implements IAsyncDisposable
@inject FenetreInterop Fenetre
@inject IJSRuntime JS

<PageTitle>RIG V3 - Accueil</PageTitle>

<div data-rig-theme="@(ThemeSombre ? "sombre" : "clair")"
     style="background:var(--rig-fond);color:var(--rig-texte);min-height:100vh">

<div class="rig-filet-marque"></div>

<header class="rig-barre" @onmousedown="Fenetre.Deplacer">
    <span class="rig-barre__marque">RIG <b>V3</b></span>
    <span class="rig-barre__version">@Version</span>

    <div class="rig-barre__droite">
        <div class="rig-fenetre">
            <button class="rig-fenetre__bouton" title="Reduire"
                    @onclick="Fenetre.Reduire" @onmousedown:stopPropagation="true">&#8211;</button>
            <button class="rig-fenetre__bouton" title="Agrandir"
                    @onclick="Fenetre.BasculerAgrandissement" @onmousedown:stopPropagation="true">&#9633;</button>
            <button class="rig-fenetre__bouton rig-fenetre__bouton--fermer" title="Fermer"
                    @onclick="Fenetre.Fermer" @onmousedown:stopPropagation="true">&#10005;</button>
        </div>
    </div>
</header>

<div class="rig-accueil">

    @* ============ MENU DE GAUCHE : les procs, ranges par domaine ============ *@
    <nav class="rig-menu">
        <div class="rig-kicker" style="padding:var(--rig-esp-2);margin-bottom:var(--rig-esp-2)">
            Traitements
        </div>
        @foreach (var groupe in Groupes)
        {
            var ouvert = GroupesOuverts.Contains(groupe.Code);
            <div class="rig-menu__groupe @(ouvert ? "rig-menu__groupe--ouvert" : "")">
                <button class="rig-menu__tete" @onclick="() => BasculerGroupe(groupe.Code)">
                    <span class="rig-menu__chevron">&#9656;</span>
                    <span class="rig-menu__filet" style="background:var(--rig-grad-@groupe.Statut)"></span>
                    <span>@groupe.Libelle</span>
                    <span class="rig-menu__compte">@groupe.Procs.Length</span>
                </button>
                @if (ouvert)
                {
                    <ul class="rig-menu__liste">
                        @foreach (var proc in groupe.Procs)
                        {
                            <li>
                                <button class="rig-menu__lien @(ProcOuverte == proc ? "rig-menu__lien--actif" : "")"
                                        title="@proc.Code"
                                        @onclick="() => OuvrirProc(proc)">
                                    <span class="rig-menu__code">@proc.Code.Replace("PROC_", "")</span>@proc.Libelle
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </nav>

    @* ============ PLAN DE TRAVAIL ============ *@
    <div class="rig-plan">

        <div class="rig-entete">
            <div class="rig-titre">
                Bonjour <b>@Utilisateur</b>
                <span style="color:var(--rig-texte-3);font-size:12px">
                    &middot; greffe @Greffe &middot; @DateDuJour
                </span>
            </div>
            <div class="rig-entete__outils">
                <button class="rig-entete__action @(PanneauTuilesOuvert ? "rig-entete__action--ouvert" : "")"
                                title="Reglages de l'accueil"
                                @onclick="BasculerPanneauTuiles" @onmousedown:stopPropagation="true">&#9881;</button>
                @if (PanneauTuilesOuvert)
                {
                    <div class="rig-tuiles-panneau" @onmousedown:stopPropagation="true">
                                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">
                                    Tuiles affichees sur l'accueil
                                </div>
                                @foreach (var def in Definitions)
                                {
                                    var visible = Pose(def.Id).Visible;
                                    <button class="rig-bascule @(visible ? "rig-bascule--actif" : "")"
                                                    @onclick="() => BasculerTuile(def.Id)">
                                                <span class="rig-bascule__temoin"></span>
                                                <span>@def.Titre</span>
                                    </button>
                                }
                                <div class="rig-reglages__filet"></div>
                                <button class="rig-bascule @(ThemeSombre ? "" : "rig-bascule--actif")"
                                                @onclick="BasculerTheme">
                                    <span class="rig-bascule__temoin"></span>
                                    <span>Mode clair</span>
                                </button>
                    </div>
                }
            </div>
        </div>

        @* --- Recherche : centree, toujours a la meme place, jamais deplacable --- *@
        <div class="rig-recherche rig-recherche--fixe" style="position:sticky">
            <span style="font:13px var(--rig-font-mono);color:var(--rig-focus)">&#8981;</span>
            <input class="rig-recherche__saisie"
                   placeholder="Rechercher un SIREN, une societe, un dirigeant, un n° de demande…"
                   @bind="Recherche" @bind:event="oninput" />
            <span class="rig-touche">Ctrl K</span>
            @if (Resultats.Length > 0)
            {
                <div class="rig-resultats">
                    @foreach (var r in Resultats)
                    {
                        <button class="rig-resultat" @onclick="() => OuvrirDossier(r)">
                            <span class="rig-filet-v rig-filet-v--@r.Statut"></span>
                            <span class="rig-resultat__id">@r.Numero</span>
                            <span>@r.Objet<br />
                                <span style="font-size:11px;color:var(--rig-texte-3)">SIREN @r.Siren</span>
                            </span>
                            <span class="rig-resultat__type">@r.Type</span>
                        </button>
                    }
                </div>
            }
        </div>

        @* --- Grille : chaque tuile reste ou on l'a posee --- *@
        <div class="rig-grille" @ref="Grille">
            @foreach (var def in Definitions)
            {
                var p = Pose(def.Id);
                if (!p.Visible) { continue; }
                <section class="rig-widget"
                         data-tuile="@def.Id"
                         data-col="@p.Colonne" data-ligne="@p.Ligne"
                         data-larg="@p.Largeur" data-haut="@p.Hauteur"
                         style="grid-column:@p.Colonne / span @p.Largeur;grid-row:@p.Ligne / span @p.Hauteur">
                    <header class="rig-widget__tete">
                        <span class="rig-widget__poignee">&#8942;&#8942;</span>
                        <span class="rig-widget__titre">@def.Titre</span>
                        <button class="rig-widget__reglages @(ReglagesTuile == def.Id ? "rig-widget__reglages--ouvert" : "")"
                                title="Reglages de la tuile"
                                @onclick="() => BasculerReglages(def.Id)"
                                @onmousedown:stopPropagation="true">&#9881;</button>
                    </header>
                    <div class="rig-widget__corps">
                        @if (ReglagesTuile == def.Id)
                        {
                            @ReglagesDe(def)
                        }
                        else
                        {
                            @switch (def.Id)
                            {
                                case "performance": @CorpsPerformance; break;
                                case "alertes":     @CorpsAlertes;     break;
                                case "file":        @CorpsFile;        break;
                                case "reprise":     @CorpsReprise;     break;
                                case "services":    @CorpsServices;    break;
                                case "brouillons":  @CorpsBrouillons;  break;
                                case "nouveautes":  @CorpsNouveautes;  break;
                            }
                        }
                    </div>
                    <span class="rig-widget__taille" title="Redimensionner"></span>
                </section>
            }
        </div>
    </div>
</div>

@* ============ ECRAN DE PROCEDURE ============ *@
@* Le cadre est commun ; chaque procedure a son composant dans
   Components/Ecrans/. Les procedures sans ecran dedie retombent sur
   celui des demandes. *@
@if (ProcOuverte is not null)
{
    <div class="rig-proc">

        <div class="rig-vged__entete">
            <span class="rig-filet-v rig-filet-v--action"></span>
            <b style="font:13px var(--rig-font-mono)">@ProcOuverte.Code</b>
            <span>@ProcOuverte.Libelle</span>
            <span style="margin-left:auto"></span>
            <button class="rig-bouton" @onclick="FermerProc">Fermer</button>
        </div>

        @switch (ProcOuverte.Code)
        {
            case "PROC_ACTES_NUM":
                <EcranActes OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ARRIVEE":
                <EcranArrivee OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_DEMANDE":
                <EcranDemandes EstValide="EstValide" Ouvrir="OuvrirParNumero" />
                break;

            case "PROC_CLOT":
                <EcranCloture OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ARCHIRAD":
                <EcranArchivage OuvrirDossier="OuvrirParNumero" />
                break;

            case "BODACC":
                <EcranBodacc OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_DEPOTJUD":
                <EcranDepotsJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ACTEUR_JUD":
                <EcranActeurs />
                break;

            case "PROC_CJUD":
                <EcranConsultationJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_AUDIENCE":
                <EcranAudiences />
                break;

            case "PROC_EXPERT":
                <EcranExperts />
                break;

            case "PROC_GEDJUD":
                <EcranGedJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_DOC_DEMAT":
                <EcranDocDemat OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_CONTROLE_VIDIGED":
                <EcranControleVidiged />
                break;

            case "PROC_COFFRE_FORT":
                <EcranCoffreFort />
                break;

            case "PROC_FACTURE":
                <EcranFactures />
                break;

            case "PROC_ENCAISS":
                <EcranEncaissements />
                break;

            case "PROC_FCLIENT":
                <EcranFicheClient />
                break;

            case "PROC_GCLIENT":
                <EcranClients />
                break;

            case "PROC_ACCUEIL_PARAM":
                <EcranParametresAccueil />
                break;

            case "PROC_GESTEMAIL":
                <EcranMessagerie />
                break;

            case "PROC_GESTBANQ":
                <EcranBanques />
                break;

            case "PROC_EDIT_MAQUETTE":
                <EcranMaquettesEdition />
                break;

            // PROC_CREANCE n'a PAS d'ecran porte, et ce n'est pas un oubli :
            // dans RIG v2, PROC_CREANCE.cs ne contient qu'un constructeur et
            // FORM_CREANCE.Designer.cs aucun controle (32 lignes, un simple
            // conteneur). Il n'y a donc rien a porter ; inventer un ecran de
            // creances serait inventer RIG v2.
            default:
                <EcranNonMaquette Code="@ProcOuverte.Code" Libelle="@ProcOuverte.Libelle"
                                  Motif="@MotifNonMaquette(ProcOuverte.Code)" />
                break;
        }
    </div>
}

@* ============ VISIONNEUSE DOCUMENTAIRE (esprit VGED) ============ *@
@if (DossierOuvert is not null)
{
    <div class="rig-vged">
        <div class="rig-vged__entete">
            <span class="rig-filet-v rig-filet-v--@DossierOuvert.Statut"></span>
            <b style="font:13px var(--rig-font-mono)">@DossierOuvert.Numero</b>
            <span>@DossierOuvert.Objet</span>
            <span style="color:var(--rig-texte-3);font-size:12px">
                &middot; SIREN @DossierOuvert.Siren &middot; @DossierOuvert.Type
            </span>
            <span style="margin-left:auto"></span>
            <button class="rig-bouton" @onclick="FermerDossier">Fermer</button>
        </div>

        @* Commandes reprises de ETP_VGED/OPE_VGED.cs (RIG v2). *@
        <div class="rig-vged__outils">
            <div class="rig-onglets">
                <button class="rig-onglet @(ModeSaisie ? "" : "rig-onglet--actif")"
                        @onclick="() => ModeSaisie = false">Documents</button>
                <button class="rig-onglet @(ModeSaisie ? "rig-onglet--actif" : "")"
                        @onclick="() => ModeSaisie = true">Saisie guidee</button>
            </div>
            <button class="rig-bouton rig-bouton--plat" disabled>Ajouter une piece jointe au dossier</button>
            <button class="rig-bouton rig-bouton--plat" disabled>Importer sans bordereau</button>
            <button class="rig-bouton rig-bouton--plat" disabled>Generation bordereau</button>
            <button class="rig-bouton rig-bouton--plat" disabled>Envoi par courriel</button>
            <button class="rig-bouton rig-bouton--plat @(HistoriqueOuvert ? "rig-bouton--enfonce" : "")"
                    title="Evenements horodates de ce dossier"
                    @onclick="() => HistoriqueOuvert = !HistoriqueOuvert">
                Historique VGED@(HistoriqueAffaire.Count > 0 ? $" ({HistoriqueAffaire.Count})" : "")
            </button>
            <span class="rig-vged__compte">
                @Arbre.NbPieces pieces &middot;
                @Arbre.Enfants.Count(n => n.NbPieces > 0) / @Arbre.Enfants.Length dossiers servis &middot;
                @Editions.Count(e => !e.EstGroupe) editions
            </span>
        </div>

        @* Historique VGED : lignes horodatees au moment de l action, lues
           dans accueil.json. Le plus recent en haut. *@
        @if (HistoriqueOuvert)
        {
            <div class="rig-historique">
                <div class="rig-historique__titre">
                    Historique VGED &middot; @DossierOuvert.Numero
                    <span class="rig-historique__compte">@HistoriqueAffaire.Count evenement(s)</span>
                </div>
                @if (HistoriqueAffaire.Count == 0)
                {
                    <div class="rig-historique__vide">
                        Aucun evenement : rien n'a encore ete saisi ni valide sur ce dossier.
                    </div>
                }
                else
                {
                    <ul class="rig-historique__liste">
                        @foreach (var ligne in HistoriqueAffaire)
                        {
                            <li>@ligne</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (ModeSaisie)
        {
            <div class="rig-saisie">

                @* --- La frise : une pastille par etape, l'etat se lit d'un coup --- *@
                <ol class="rig-frise">
                    @for (var i = 0; i < Etapes.Length; i++)
                    {
                        var index = i;
                        var etape = Etapes[i];
                        var (remplis, total) = Avancement(etape);
                        var nbFiches = Fiches(etape.Code).Count;
                        var (manquants, refuses) = Defauts(etape);
                        var etat = refuses > 0 ? "refuse"
                                 : total > 0 && remplis == total ? "complet"
                                 : index == EtapeCourante ? "encours"
                                 : remplis > 0 ? "partiel" : "vide";
                        <li class="rig-frise__pas rig-frise__pas--@etat @(index == EtapeCourante ? "rig-frise__pas--courant" : "")">
                            <button class="rig-frise__bouton" @onclick="() => AllerEtape(index)">
                                <span class="rig-frise__pastille">
                                    @(refuses > 0 ? "!" : total > 0 && remplis == total ? "OK" : (index + 1).ToString())
                                </span>
                                <span class="rig-frise__libelle">
                                    @etape.Titre
                                    @if (etape.Multiple && nbFiches > 1)
                                    {
                                        <span class="rig-frise__fiches">@nbFiches @(etape.Unite.ToLower())s</span>
                                    }
                                    @if (refuses > 0)
                                    {
                                        <span class="rig-frise__defaut">@refuses valeur(s) refusee(s)</span>
                                    }
                                    else if (manquants > 0)
                                    {
                                        <span class="rig-frise__requis">@manquants requis manquant(s)</span>
                                    }
                                </span>
                                <span class="rig-frise__compte">@remplis / @total</span>
                            </button>
                        </li>
                    }
                </ol>

                @* --- Le formulaire de l'etape courante --- *@
                @{
                    var courante = Etapes[EtapeCourante];
                    var fiches = Fiches(courante.Code);
                    var iFiche = Math.Clamp(FicheCourante, 0, fiches.Count - 1);
                }
                <div class="rig-saisie__corps">
                    <div class="rig-saisie__entete">
                        <div>
                            <div class="rig-kicker">Etape @(EtapeCourante + 1) sur @Etapes.Length</div>
                            <h2 class="rig-saisie__titre">@courante.Titre</h2>
                            <div class="rig-saisie__source">@courante.Source</div>
                        </div>
                        <div class="rig-saisie__navigation">
                            <button class="rig-bouton" disabled="@(EtapeCourante == 0)"
                                    @onclick="() => AllerEtape(EtapeCourante - 1)">Precedent</button>
                            <button class="rig-bouton" disabled="@(EtapeCourante == Etapes.Length - 1)"
                                    @onclick="() => AllerEtape(EtapeCourante + 1)">Suivant</button>
                        </div>
                    </div>

                    @* Une etape multiple presente ses fiches en onglets. *@
                    @if (courante.Multiple)
                    {
                        <div class="rig-fiches">
                            @for (var f = 0; f < fiches.Count; f++)
                            {
                                var indexFiche = f;
                                <button class="rig-fiches__onglet @(indexFiche == iFiche ? "rig-fiches__onglet--actif" : "")"
                                        @onclick="() => FicheCourante = indexFiche">
                                    @courante.Unite @(indexFiche + 1)
                                </button>
                            }
                            <button class="rig-fiches__ajout" title="Ajouter"
                                    @onclick="() => AjouterFiche(courante)">+ Ajouter</button>
                            @if (fiches.Count > 1)
                            {
                                <button class="rig-fiches__retrait" title="Retirer cette fiche"
                                        @onclick="() => SupprimerFiche(courante)">Retirer</button>
                            }
                        </div>
                    }

                    @* --- Controle final : le recapitulatif de TOUT ce qui bloque --- *@
                    @if (courante.Code == "CONTROLE")
                    {
                        var defauts = TousLesDefauts();
                        <div class="rig-recap">
                            @if (DossierValide)
                            {
                                <div class="rig-recap__entete rig-recap__entete--valide">
                                    <span class="rig-recap__pastille rig-recap__pastille--ok">OK</span>
                                    <div>
                                        <div class="rig-recap__titre">Dossier valide</div>
                                        <div class="rig-recap__detail">
                                            Les 7 etapes sont completes et acceptees.
                                        </div>
                                    </div>
                                    <button class="rig-bouton" style="margin-left:auto"
                                            @onclick="RouvrirDossier">Rouvrir la saisie</button>
                                </div>
                            }
                            else
                            {
                                <div class="rig-recap__entete">
                                    <span class="rig-recap__pastille @(defauts.Count == 0 ? "rig-recap__pastille--ok" : "rig-recap__pastille--bloque")">
                                        @(defauts.Count == 0 ? "OK" : defauts.Count.ToString())
                                    </span>
                                    <div>
                                        <div class="rig-recap__titre">
                                            @(defauts.Count == 0
                                                ? "Rien ne bloque la validation"
                                                : defauts.Count == 1
                                                    ? "1 point bloque la validation"
                                                    : $"{defauts.Count} points bloquent la validation")
                                        </div>
                                        <div class="rig-recap__detail">
                                            @defauts.Count(d => d.EstManquant) a renseigner &middot;
                                            @defauts.Count(d => !d.EstManquant) valeur(s) refusee(s)
                                        </div>
                                    </div>
                                    <button class="rig-bouton rig-bouton--fort" style="margin-left:auto"
                                            disabled="@(defauts.Count > 0)"
                                            @onclick="ValiderDossier">Valider le dossier</button>
                                </div>

                                @if (defauts.Count > 0)
                                {
                                    <ul class="rig-recap__liste">
                                        @foreach (var groupe in defauts.GroupBy(d => (d.IndexEtape, d.Etape, d.Fiche, d.Unite)))
                                        {
                                            var g = groupe;
                                            var multi = Fiches(Etapes[g.Key.IndexEtape].Code).Count > 1;
                                            <li class="rig-recap__groupe">
                                                <button class="rig-recap__aller"
                                                        @onclick="() => AllerAuDefaut(g.First())">
                                                    <span class="rig-recap__rang">@(g.Key.IndexEtape + 1)</span>
                                                    <span>
                                                        @g.Key.Etape
                                                        @if (multi)
                                                        {
                                                            <span class="rig-recap__fiche">@g.Key.Unite @(g.Key.Fiche + 1)</span>
                                                        }
                                                    </span>
                                                    <span class="rig-recap__nb">@g.Count()</span>
                                                </button>
                                                <ul class="rig-recap__points">
                                                    @foreach (var d in g)
                                                    {
                                                        <li class="rig-recap__point @(d.EstManquant ? "" : "rig-recap__point--refuse")">
                                                            <span class="rig-recap__champ">@d.Champ</span>
                                                            <span class="rig-recap__motif">@d.Motif</span>
                                                            <span class="rig-recap__colonne">@d.Colonne</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                        </div>
                    }

                    <div class="rig-champs">
                        @foreach (var champ in courante.Champs)
                        {
                            var c = champ;
                            var e = courante;
                            var refus = RefusDe(e, c);
                            var manque = RequisManquant(e, c);
                            var etatChamp = refus is not null ? "rig-saisie-champ--refuse"
                                          : manque ? "rig-saisie-champ--manque" : "";
                            <label class="rig-saisie-champ rig-saisie-champ--@c.Largeur @etatChamp">
                                <span class="rig-saisie-champ__libelle">
                                    @c.Libelle
                                    @if (c.Obligatoire) { <span class="rig-saisie-champ__requis">requis</span> }
                                </span>
                                @if (c.Choix.Length > 0)
                                {
                                    <select class="rig-saisie-champ__saisie"
                                            value="@Valeur(e, c)"
                                            @onchange="ev => Ecrire(e, c, ev.Value?.ToString())">
                                        <option value=""></option>
                                        @foreach (var choix in c.Choix)
                                        {
                                            <option value="@choix">@choix</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="rig-saisie-champ__saisie" type="@c.Type"
                                           placeholder="@c.Exemple"
                                           value="@Valeur(e, c)"
                                           @onchange="ev => Ecrire(e, c, ev.Value?.ToString())" />
                                }
                                @if (refus is not null)
                                {
                                    <span class="rig-saisie-champ__refus">@refus</span>
                                }
                                else if (manque)
                                {
                                    <span class="rig-saisie-champ__manque">a renseigner</span>
                                }
                                <span class="rig-saisie-champ__colonne">@c.Colonne</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
        <div class="rig-vged__corps">

            @* ---- Arbre documentaire, colonnes de TreeviewGed (v2) ---- *@
            <div class="rig-vged__arbre">
                <div class="rig-arbre__entete">
                    <span class="rig-arbre__libelle">Liste des pieces</span>
                    <span class="rig-arbre__date">Date</span>
                    <span class="rig-arbre__pages">Nb pages</span>
                </div>
                <div class="rig-arbre">
                    <ArbreGedNoeud Noeud="Arbre" Niveau="0" Ouverts="NoeudsOuverts"
