        }
    </div>;

    // ================= Reglages d'une tuile =================
    // Un seul panneau ouvert a la fois, dans le corps de la tuile concernee.
    private string? ReglagesTuile;

    private void BasculerReglages(string id)
        => ReglagesTuile = ReglagesTuile == id ? null : id;

    // Les reglages d'une tuile portent sur SON contenu (quelles alertes,
    // quelles mesures). Retirer la tuile de l'accueil n'est pas un reglage
    // de tuile : cela se fait dans les reglages generaux, dans la barre du
    // haut, seul endroit d'ou l'on peut aussi la faire revenir.
    private RenderFragment ReglagesDe(DefinitionTuile def) => @<div class="rig-reglages">
        @switch (def.Id)
        {
            case "alertes":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Alertes surveillees</div>
                @foreach (var a in Alertes)
                {
                    var active = AlerteActive(a.Id);
                    <button class="rig-bascule @(active ? "rig-bascule--actif" : "")"
                            @onclick="() => BasculerAlerte(a.Id)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@a.Titre</span>
                    </button>
                }
                break;

            case "performance":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Mesures affichees</div>
                @foreach (var m in Mesures)
                {
                    var vue = MesureActive(m.Libelle);
                    <button class="rig-bascule @(vue ? "rig-bascule--actif" : "")"
                            @onclick="() => BasculerMesure(m.Libelle)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@m.Libelle</span>
                    </button>
                }
                break;

            default:
                <div class="rig-vide">
                    Cette tuile n'a pas de reglage propre.
                    Pour la retirer de l'accueil, ouvrir les reglages en haut a droite.
                </div>
                break;
        }
    </div>;

