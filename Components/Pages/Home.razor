    // ================= Corps des tuiles =================

    // --- Performance : activite des DOSSIERS, calculee dans MesuresPerf.cs
    //     (traites, en cours, hors delai, rejets, pieces, delai moyen).
    private readonly MesuresPerf Sonde = new();
    private MesurePerf[] Mesures = [];
    private Timer? MinuteurPerf;

    private void RelevePerf()
    {
        Mesures = Sonde.Relever();
    }

    private bool MesureActive(string libelle)
        => !Etat.Mesures.TryGetValue(libelle, out var v) || v;

    private void BasculerMesure(string libelle)
    {
        Etat.Mesures[libelle] = !MesureActive(libelle);
        Etat.Enregistrer();
    }

    private RenderFragment CorpsPerformance => @<div class="rig-perf">
        @foreach (var m in Mesures.Where(m => MesureActive(m.Libelle)))
        {
            <div class="rig-perf__mesure">
                <div class="rig-perf__valeur">@m.Valeur</div>
                <div class="rig-perf__libelle" title="@m.Libelle">@m.Libelle</div>
                <div class="rig-perf__barre">
                    <span style="width:@(m.Part)%;background:var(--rig-grad-@m.Statut)"></span>
                </div>
            </div>
        }
    </div>;

    // --- Alertes : relevees sur les dossiers connus (AlertesGreffe), jamais
    // ecrites en dur, et chacune s'allume ou s'eteint independamment.
    private readonly AlertesGreffe SondeAlertes = new();
    private AlerteGreffe[] Alertes = [];

    /// <summary>Reglages d'affichage de la tuile, conserves dans accueil.json.</summary>
    private ReglagesAlertes ReglagesAlertes => Etat.ReglagesAlertes;

    /// <summary>Ce que la tuile montre reellement : ecoute, gravite, ordre, plafond.</summary>
    private AlerteGreffe[] AlertesVues => ReglagesAlertes.Appliquer(Alertes, AlerteActive);

    private void BasculerAlerte(string id)
    {
        Etat.Alertes[id] = !(Etat.Alertes.TryGetValue(id, out var v) && v);
        Etat.Enregistrer();
    }

    private bool AlerteActive(string id) => !Etat.Alertes.TryGetValue(id, out var v) || v;

    private void ReglerAlertes(Action<ReglagesAlertes> geste)
    {
        geste(Etat.ReglagesAlertes);
        Etat.Enregistrer();
    }

    // Les trois reglages passent par des methodes nommees : une expression
    // avec des guillemets ne tient pas dans un attribut Razor.
    private void ChoisirNiveauAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.NiveauMini = int.TryParse(e.Value?.ToString(), out var n)
                                             ? Math.Clamp(n, 0, 3) : 0);

    private void ChoisirTriAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.Tri = e.Value?.ToString() is { Length: > 0 } t ? t : "gravite");

    private void ChoisirLimiteAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.Limite = int.TryParse(e.Value?.ToString(), out var n)
                                         ? Math.Clamp(n, 0, 20) : 0);

    /// <summary>
    /// Le clic sur une alerte EMMENE : soit sur l'affaire nommee par l'alerte,
    /// soit sur l'ecran du traitement concerne. Sans cela la tuile disait un
    /// probleme sans donner le moyen de le traiter.
    /// </summary>
    private void OuvrirAlerte(AlerteGreffe a)
    {
        // Une alerte de LOT ouvre le TABLEAU des dossiers de cette recette,
        // deja selectionnee : l'alerte dit « ces dossiers-la », l'ecran doit
        // s'ouvrir dessus, pas sur un choix a refaire.
        if (a.Lot is { Length: > 0 } codeLot)
        {
            LotDemande = codeLot;
            OuvrirCode("PROC_TACHES_LOT");
            return;
        }

        // Une alerte task driven ouvre la TACHE, pas seulement l'affaire.
        if (a.Tache is { } t && RecettesTaches.ParCode(t.Code) is { } recette)
        {
            OuvrirTache(recette, t.Dossier);
            return;
        }
        if (a.Affaire is { Length: > 0 } numero) { OuvrirParNumero(numero); return; }
        OuvrirCode(a.Cible);
    }

    // Le corps ne montre QUE les alertes surveillees : les interrupteurs
    // vivent dans les reglages de la tuile (bouton engrenage de son entete),
    // pas dans la lecture courante.
    private RenderFragment CorpsAlertes => @<div>
        @if (AlertesVues.Length == 0)
        {
            <div class="rig-vide">Aucune alerte a afficher. Ouvrir les reglages de la tuile pour elargir.</div>
        }
        @foreach (var item in AlertesVues)
        {
            var a = item;
            <button class="rig-alerte rig-alerte--lien" type="button"
                    title="Aller vers @a.LibelleCible"
                    @onclick="() => OuvrirAlerte(a)">
                <span class="rig-filet-v rig-filet-v--@a.Statut"></span>
                <span class="rig-alerte__corps">
                    <span class="rig-alerte__titre">@a.Titre</span>
                    @if (ReglagesAlertes.AfficherDetail)
                    {
                        <br />
                        <span class="rig-alerte__detail">@a.Detail</span>
                    }
                </span>
                <span class="rig-alerte__vers">@a.LibelleCible &rsaquo;</span>
            </button>
        }
    </div>;

    // ================= Reglages d'une tuile =================
    // Un seul panneau ouvert a la fois, dans le corps de la tuile concernee.
    private string? ReglagesTuile;

    private void BasculerReglages(string id)
        => ReglagesTuile = ReglagesTuile == id ? null : id;

    // Les reglages d'une tuile portent sur SON contenu (quelles alertes,
    // quelles mesures). Retirer la tuile de l'accueil n'est pas un reglage
    // de tuile : cela se fait dans les reglages generaux, dans la barre du
    // haut, seul endroit d'ou l'on peut aussi la faire revenir.
    private RenderFragment ReglagesDe(DefinitionTuile def) => @<div class="rig-reglages">
        @switch (def.Id)
        {
            case "alertes":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Alertes surveillees</div>
                @foreach (var a in Alertes)
                {
                    var active = AlerteActive(a.Id);
                    <button class="rig-bascule @(active ? "rig-bascule--actif" : "")"
                            title="Mene vers @a.LibelleCible"
                            @onclick="() => BasculerAlerte(a.Id)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@a.Titre</span>
                    </button>
                }

                <div class="rig-kicker" style="margin:var(--rig-esp-3) 0 var(--rig-esp-2)">Ce que la tuile affiche</div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">A partir de</span>
                    <select class="rig-saisie-champ__saisie"
                            value="@ReglagesAlertes.NiveauMini"
                            @onchange="ChoisirNiveauAlertes">
                        <option value="0">Tout, meme ce qui va bien</option>
                        <option value="1">A surveiller et au-dela</option>
                        <option value="2">A traiter et au-dela</option>
                        <option value="3">Hors delai seulement</option>
                    </select>
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Ordre</span>
                    <select class="rig-saisie-champ__saisie"
                            value="@ReglagesAlertes.Tri"
                            @onchange="ChoisirTriAlertes">
                        <option value="gravite">Le plus grave en tete</option>
                        <option value="titre">Par libelle</option>
                    </select>
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Lignes au plus (0 = toutes)</span>
                    <input class="rig-saisie-champ__saisie" type="number" min="0" max="20"
                           value="@ReglagesAlertes.Limite"
                           @onchange="ChoisirLimiteAlertes" />
                </label>
                <button class="rig-bascule @(ReglagesAlertes.AfficherDetail ? "rig-bascule--actif" : "")"
                        @onclick="() => ReglerAlertes(r => r.AfficherDetail = !r.AfficherDetail)">
                    <span class="rig-bascule__temoin"></span>
                    <span>Afficher le detail sous chaque alerte</span>
                </button>
                break;

            case "performance":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Mesures affichees</div>
                @foreach (var m in Mesures)
                {
                    var vue = MesureActive(m.Libelle);
                    <button class="rig-bascule @(vue ? "rig-bascule--actif" : "")"
                            @onclick="() => BasculerMesure(m.Libelle)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@m.Libelle</span>
                    </button>
                }
                break;

            default:
                <div class="rig-vide">
                    Cette tuile n'a pas de reglage propre.
                    Pour la retirer de l'accueil, ouvrir les reglages en haut a droite.
                </div>
                break;
        }
    </div>;

    // --- Le reste de l'accueil, inchange, simplement mis en tuiles
    private record Demande(string Numero, string Objet, string Delai, string Etat,
                           string Statut, string? VerrouillePar = null);
    private record Service(string Nom, string Statut, string? Commentaire = null);
