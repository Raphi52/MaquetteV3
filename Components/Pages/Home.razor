@page "/"
@implements IAsyncDisposable
@inject FenetreInterop Fenetre
@inject DocumentPartage Partage

<PageTitle>RIG V3 - Accueil</PageTitle>

@* ============ COQUILLE DE L'APPLICATION REACT (lot 2 du plan « finir le passage a React », 19/11/2026) ============
   Toute la page est rendue par React : web/src/composants/Application.tsx
   monte l'accueil (lot 1 : barre, menu, tuiles) et le plan de travail (barre
   d'onglets, ecrans de procedure, visionneuse d'affaire, saisie guidee,
   modales), et les ecrans React s'y appellent directement entre eux.
   L'etat et les regles vivent dans Pont/PlanTravail.cs (SessionPlanTravail :
   le @code de cette page, deplace tel quel) et Pont/Accueil.cs. Ce fichier ne
   fait plus que tenir la session, monter l'application avec la vue calculee
   UNE fois par rendu, et lui renvoyer chaque geste par deux rappels :
     geste  -> l'accueil (SessionAccueil.Agir, comme au lot 1) ;
     plan   -> le plan de travail (SessionPlanTravail.Agir).
   Mode d'emploi : web/README.md. *@
<IleReact Composant="Application" Proprietes="@(new Dictionary<string, object?> { ["vue"] = Plan.Vue() })" Rappels="Rappels" />

@code {
    /// <summary>Le code de l ecran a ouvrir d emblee. Rempli par FenetreVue
    /// quand la page est celle d un onglet SORTI dans sa propre fenetre.</summary>
    [Parameter] public string? VueInitiale { get; set; }

    /// <summary>Vrai dans une fenetre d onglet arrache : la fenetre ne montre
    /// QUE l ecran arrache (voir SessionPlanTravail.ModeFenetreVue).</summary>
    [Parameter] public bool ModeFenetreVue { get; set; }

    private Pont.SessionPlanTravail Plan = default!;

    private Dictionary<string, IleReact.RappelIle>? rappels;
    private Dictionary<string, IleReact.RappelIle> Rappels => rappels ??= new()
    {
        ["geste"] = IleReact.Rappel(EventCallback.Factory.Create<Pont.GesteIle>(this, g => Plan.SurGesteAccueil(g))),
        ["plan"] = IleReact.Rappel(EventCallback.Factory.Create<Pont.GestePlan>(this, g => Plan.Jouer(g)))
    };

    protected override void OnInitialized()
    {
        Plan = new Pont.SessionPlanTravail(Fenetre, Partage, ModeFenetreVue, VueInitiale);
        // Un changement venu d'ailleurs (fenetre WPF refermee, autre fenetre) se
        // rejoue sur le fil de la page, puis la page redessine.
        Plan.Planifier = action => _ = InvokeAsync(() => { action(); StateHasChanged(); });
        Plan.Change += SurChange;
        Plan.Initialiser();
    }

    protected override void OnAfterRender(bool premierRendu)
    {
        if (premierRendu) Plan.Demarrer();
    }

    /// <summary>Un minuteur de l'accueil a releve (performance, actualites) : la vue suit.</summary>
    private void SurChange() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Plan.Change -= SurChange;
        await Plan.DisposeAsync();
    }
}
