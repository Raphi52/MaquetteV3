    /// <summary>
    /// Remet CHAQUE tuile a sa pose dans la disposition choisie (colonne,
    /// ligne, largeur, hauteur) : chaque disposition est calee sur la grille
    /// 12 colonnes sans chevauchement. Ce que l'utilisateur a allume ou
    /// eteint est conserve : seule la geometrie est reprise.
    /// </summary>
    private void ReinitialiserDisposition()
    {
        var rang = 1;
        var poses = DispositionActive.Poses;
        foreach (var def in Definitions)
        {
            var pose = Pose(def.Id);
            var propre = poses.FirstOrDefault(x => x.Id == def.Id);
            var (c, l, w, h) = propre.Id is null
                ? (def.Defaut.Colonne, def.Defaut.Ligne, def.Defaut.Largeur, def.Defaut.Hauteur)
                : (propre.C, propre.L, propre.W, propre.H);
            pose.Colonne = c;
            pose.Ligne   = l;
            pose.Largeur = w;
            pose.Hauteur = h;
            pose.Ordre   = rang++;
        }
        Etat.Enregistrer();
    }

    private void BasculerTuile(string id)
    {
        var p = Pose(id);
        p.Visible = !p.Visible;
        // Une tuile qu'on rallume est la derniere manipulee : elle passe
        // devant, sinon elle pourrait reapparaitre sous une voisine.
        if (p.Visible) Etat.Avancer(id);
        Etat.Enregistrer();
    }

    /// <summary>Appelee par rig-accueil.js quand la tuile est lachee sur une case.</summary>
    [JSInvokable]
    public void PoserTuile(string id, int colonne, int ligne)
    {
        var p = Pose(id);
        p.Colonne = Math.Clamp(colonne, 1, Math.Max(13 - p.Largeur, 1));
        p.Ligne = Math.Max(ligne, 1);
        Etat.Avancer(id);
        Etat.Enregistrer();
        StateHasChanged();
    }

    /// <summary>Echap : ferme ce qui est ouvert, du plus interieur au plus
    /// exterieur -- l'affaire d'abord, l'ecran de procedure ensuite. Un seul
    /// appui ne referme donc jamais deux choses a la fois.</summary>
    [JSInvokable]
    public void ToucheEchap()
    {
        if (DossierOuvert is not null) FermerDossier();
        else if (ProcOuverte is not null) FermerProc();
        else return;
        StateHasChanged();
    }

    [JSInvokable]
    public void DimensionnerTuile(string id, int largeur, int hauteur)
    {
        var p = Pose(id);
        p.Largeur = Math.Clamp(largeur, 3, Math.Max(13 - p.Colonne, 3));
        p.Hauteur = Math.Max(hauteur, 1);
        Etat.Avancer(id);
        Etat.Enregistrer();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Etat = AccueilEtat.Charger();
        AccueilEtat.FavorisChanges += SurFavorisChanges;
        ThemeSombre = Etat.ThemeSombre;
        // L AGENCEMENT d abord : les onglets ouverts la derniere fois, dans leur
        // ordre, et les vues qui etaient sorties en fenetre.
        RestaurerAgencement();
        RelevePerf();
        ReleveActualites();
        Alertes = AlertesOuvertes();
        Taches = TachesOuvertes();

        // La disposition d'origine a change (tuiles « Reprendre » et « Ma file »
        // retirees, grille retassee sur 5 lignes) : un accueil.json ecrit avant
        // ce changement garderait l'ancienne grille, donc on la repose une fois.
        if (Etat.VersionDisposition < DispositionCourante)
        {
            foreach (var disparue in Etat.Tuiles.Keys
                         .Where(id => !Definitions.Any(d => d.Id == id)).ToList())
            {
                Etat.Tuiles.Remove(disparue);
            }
            // v9 : les dispositions preparees. La disposition active est
            // appliquee EN ENTIER, allumage compris : sinon « A traiter BIS »,
            // allumee par defaut en v8, recouvrirait le haut de l'accueil.
            AppliquerDisposition(DispositionActive.Id);
            Etat.VersionDisposition = DispositionCourante;
            Etat.Enregistrer();
        }

        foreach (var def in Definitions) { Pose(def.Id); }
        foreach (var a in Alertes)
        {
            if (!Etat.Alertes.ContainsKey(a.Id)) Etat.Alertes[a.Id] = true;
        }
    }

    private bool PaginationSuivie;

    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        // La saisie guidee n'existe pas au premier rendu : son observateur de
        // defilement doit etre branche au rendu ou elle apparait.
        if (!premierRendu)
        {
            if (Module is null) return;
            if (EtapesAffichees && !PaginationSuivie && Lien is not null)
            {
                PaginationSuivie = true;
                try { await Module.InvokeVoidAsync("suivrePagination", ZonePages, Lien); }
                catch (JSException) { PaginationSuivie = false; }
            }
            else if (!EtapesAffichees && PaginationSuivie)
            {
                PaginationSuivie = false;
                try { await Module.InvokeVoidAsync("arreterPagination"); }
                catch (JSException) { }
            }
            // Ouvrir une piece amene la frise sur SON etape.
            if (EtapeADefiler && EtapesAffichees)
            {
                EtapeADefiler = false;
                try { await Module.InvokeVoidAsync("allerEtape", ZonePages, EtapeCourante, false); }
                catch (JSException) { }
            }
            return;
        }
        Module = await JS.InvokeAsync<IJSObjectReference>("import", "./rig-accueil.js");
        Lien = DotNetObjectReference.Create(this);
        // Une fenetre d onglet arrache n affiche PAS l accueil : sa grille de
        // tuiles n est jamais rendue, et la brancher faisait planter l app
        // entiere (« zone.addEventListener is not a function », 18/09/2026).
        if (!ModeFenetreVue) await Module.InvokeVoidAsync("activerPose", Grille, Lien);
        await Module.InvokeVoidAsync("activerClavier", Lien);
        await AppliquerTheme();
        MinuteurPerf = new Timer(_ =>
        {
            RelevePerf();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        // Les actualites vivent sur le reseau : une minute de retard est sans
        // consequence, une lecture par seconde martyriserait le partage.
        MinuteurActualites = new Timer(_ =>
        {
            ReleveActualites();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    // Le rechargement de la vue (reprise a chaud du CSS) demonte ce composant
    // APRES que la page JS a disparu : les appels de nettoyage levent alors
    // JSException. Non attrapee, elle remonte au dispatcher WPF et FERME
    // l'application -- exactement ce que la reprise a chaud doit eviter.
    /// <summary>Une autre fenetre a allume/eteint une etoile : on reprend sa
    /// liste, sinon notre copie perimee l'ecraserait au prochain enregistrement.</summary>
    private void SurFavorisChanges(AccueilEtat source, List<string> liste)
    {
        if (ReferenceEquals(source, Etat)) return;
        _ = InvokeAsync(() => { Etat.VuesFavorites = liste; StateHasChanged(); });
    }

    public async ValueTask DisposeAsync()
    {
        AccueilEtat.FavorisChanges -= SurFavorisChanges;
        VueFermee = true;
        if (MinuteurPerf is not null) await MinuteurPerf.DisposeAsync();
        if (MinuteurActualites is not null) await MinuteurActualites.DisposeAsync();
        if (Module is not null)
        {
            try { await Module.InvokeVoidAsync("arreterPose"); } catch (JSException) { }
            try { await Module.InvokeVoidAsync("arreterPagination"); } catch (JSException) { }
            try { await Module.InvokeVoidAsync("arreterClavier"); } catch (JSException) { }
            try { await Module.DisposeAsync(); } catch (JSException) { }
        }
        Lien?.Dispose();
    }

