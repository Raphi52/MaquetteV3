@page "/"
@implements IAsyncDisposable
@inject FenetreInterop Fenetre
@inject DocumentPartage Partage
@inject IJSRuntime JS

<PageTitle>RIG V3 - Accueil</PageTitle>

<div data-rig-theme="@(ThemeSombre ? "sombre" : "clair")"
     style="background:var(--rig-fond);color:var(--rig-texte);height:100vh;overflow:hidden;display:flex;flex-direction:column">

<div class="rig-filet-marque"></div>

@if (!ModeFenetreVue)
{
<header class="rig-barre" @onmousedown="Fenetre.Deplacer">
    <span class="rig-barre__marque">RIG <b>V3</b></span>
    <span class="rig-barre__version">@Version</span>

    <div class="rig-barre__droite">
        @* Les domaines se parametrent par login : changer de login change les branches
           visibles dans l'arbre de l'affaire. Le selecteur vit dans la BARRE (demande
           utilisateur du 2026-09-10) : il reste atteignable depuis n'importe quel ecran. *@
        <select class="rig-login" title="Login connecte et domaines autorises"
                value="@LoginCourant"
                @onchange="ChangerLogin" @onmousedown:stopPropagation="true">
            @foreach (var compte in JeuDemo.Comptes)
            {
                <option value="@compte.Login">
                    @compte.Login &middot; @compte.Profil (@compte.DomainesLisibles)
                </option>
            }
        </select>
        @* Reglages de la BARRE : toujours atteignables, y compris quand un ecran de
           procedure occupe le plan de travail. Ne contient que le theme pour l'instant. *@
        <div class="rig-barre__reglages" @onmousedown:stopPropagation="true">
            <button class="rig-barre__action @(PanneauBarreOuvert ? "rig-barre__action--ouvert" : "")"
                    title="Reglages" @onclick="BasculerPanneauBarre">&#9881;</button>
            @if (PanneauBarreOuvert)
            {
                @* Voile transparent plein ecran : un clic AILLEURS ferme le panneau. *@
                <div class="rig-voile-clic" @onclick="() => PanneauBarreOuvert = false"
                     @onmousedown:stopPropagation="true"></div>
                <div class="rig-tuiles-panneau">
                    <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Affichage</div>
                    <button class="rig-bascule @(ThemeSombre ? "rig-bascule--actif" : "")"
                            @onclick="BasculerTheme">
                        <span class="rig-bascule__temoin"></span>
                        <span>Mode sombre</span>
                    </button>
                </div>
            }
        </div>
        <div class="rig-fenetre">
            <button class="rig-fenetre__bouton" title="Reduire"
                    @onclick="Fenetre.Reduire" @onmousedown:stopPropagation="true">&#8211;</button>
            <button class="rig-fenetre__bouton" title="Agrandir"
                    @onclick="Fenetre.BasculerAgrandissement" @onmousedown:stopPropagation="true">&#9633;</button>
            <button class="rig-fenetre__bouton rig-fenetre__bouton--fermer" title="Fermer"
                    @onclick="Fenetre.Fermer" @onmousedown:stopPropagation="true">&#10005;</button>
        </div>
    </div>
</header>
}

@* ============ BARRE D ONGLETS (esprit navigateur) ============
   Chaque vue ouverte prend un onglet. On les reordonne en les glissant ;
   glisse HORS de la fenetre, un onglet part dans sa PROPRE fenetre, qu on
   peut poser sur un second ecran (demande du 17/09/2026). L agencement est
   retenu d une session a l autre. *@
@if (!ModeFenetreVue && Onglets.Onglets.Count > 0)
{
    <div class="rig-vonglets" id="rig-vonglets">
        @foreach (var item in Onglets.Onglets)
        {
            var onglet = item;
            <div class="rig-vonglet @(Onglets.Actuel == onglet ? "rig-vonglet--actif" : "") @(onglet.Detache ? "rig-vonglet--sorti" : "") @(GlisseEnCours && GlisseCode == onglet.Code ? "rig-vonglet--glisse" : "")"
                 @key="onglet.Code"
                 data-rig-onglet="@onglet.Code"
                 title="@(onglet.Detache ? "Ouvert dans sa propre fenetre" : "Glissez l onglet hors de la fenetre pour le sortir sur un autre ecran")"
                 @onpointerdown="e => DebutGlisse(onglet, e)"
                 @onpointermove="GlisseOnglet"
                 @onpointerup="FinGlisse"
                 @onclick="() => ActiverOnglet(onglet)">
                <span class="rig-vonglet__titre">@onglet.Libelle</span>
                @if (onglet.Detache)
                {
                    <span class="rig-vonglet__sorti" aria-label="sorti dans sa fenetre">&#x2197;</span>
                }
                <button class="rig-vonglet__fermer" aria-label="Fermer @onglet.Libelle"
                        @onclick="() => FermerOnglet(onglet.Code)"
                        @onclick:stopPropagation="true"
                        @onpointerdown:stopPropagation="true">&times;</button>
            </div>
        }
    </div>
}

@if (!ModeFenetreVue)
{
<div class="rig-accueil @(MenuReduit ? "rig-accueil--menu-reduit" : "")">

    @* ============ MENU DE GAUCHE : les METIERS du greffe ============ *@
    <nav class="rig-menu">
        @* Le panneau suit l'ORGANISATION du greffe : le RCS et le JUDICIAIRE sont
           deux mondes qu'un agent pratique rarement en meme temps. Chaque monde
           porte SA couleur : on reconnait ou on est avant meme d'avoir lu. *@
        @* Le menu reste TOUJOURS visible : reduit, il laisse un rail ou les
           pastilles de couleur restent cliquables ; il ne disparait jamais. *@
        <div class="rig-menu__entete">
            <button class="rig-menu__replier" @onclick="BasculerMenu"
                    title="@(MenuReduit ? "Deployer le menu" : "Reduire le menu")">
                @(MenuReduit ? "»" : "«")
            </button>
        </div>

        @* ============ FAVORIS : les ecrans etoiles, en haut du menu ============
           Ce groupe ne vient PAS du catalogue Moments : son contenu est choisi
           par l'utilisateur et vit dans accueil.json. Tant qu'aucune etoile
           n'est allumee, il ne prend pas de place. *@
@*  fix-ok: cause mesuree — un groupe Favoris ajoute au tableau Moments serait masque
    par MomentsVisibles, qui cache tout groupe sans sous-menu visible (et son contenu
    est dynamique, pas un readonly Moment[]). Il est donc rendu en bloc separe, avant
    la boucle des moments. L'etoile est un bouton FRERE du lien, pas imbrique :
    un bouton dans un bouton declencherait aussi l'ouverture de l'ecran. *@
        @{ var favoris = EntreesFavorites(); }
        @if (favoris.Length > 0)
        {
            <div class="rig-menu__groupe rig-menu__groupe--fav @(FavorisOuverts ? "rig-menu__groupe--ouvert" : "")">
                <button class="rig-menu__tete" title="Favoris"
                        @onclick="() => FavorisOuverts = !FavorisOuverts">
                    <span class="rig-menu__chevron">&#9656;</span>
                    <span class="rig-menu__pastille">&#9733;</span>
                    <span class="rig-menu__titre">Favoris</span>
                    <span class="rig-menu__compte">@favoris.Length</span>
                </button>
                @if (FavorisOuverts)
                {
                    <ul class="rig-menu__liste">
                        @foreach (var e in favoris)
                        {
                            <li class="rig-menu__ligne">
                                <button class="rig-menu__lien rig-menu__lien--metier @(ProcOuverte?.Code == e.Code ? "rig-menu__lien--actif" : "")"
                                        title="@e.Detail"
                                        @onclick="() => OuvrirCode(e.Code)">
                                    <span class="rig-menu__quoi">@e.Libelle</span>
                                </button>
                                <button class="rig-menu__etoile rig-menu__etoile--allumee"
                                        title="Retirer des favoris"
                                        @onclick="() => BasculerFavori(e.Code)">★</button>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @foreach (var moment in MomentsVisibles)
        {
            var ouvert = MomentsOuverts.Contains(moment.Titre);
            <div class="rig-menu__groupe rig-menu__groupe--@moment.Teinte @(ouvert ? "rig-menu__groupe--ouvert" : "")">
                <button class="rig-menu__tete" title="@moment.Titre"
                        @onclick="() => OuvrirMoment(moment.Titre)">
                    <span class="rig-menu__chevron">&#9656;</span>
                    <span class="rig-menu__pastille">@moment.Signe</span>
                    <span class="rig-menu__titre">@moment.Titre</span>
                    <span class="rig-menu__compte">@NombreEcransVisibles(moment)</span>
                </button>
                @if (ouvert)
                {
                    @* Troisieme niveau : le metier se lit par VERBES. Un verbe ouvert
                       montre ses ecrans ; les autres restent des titres d'une ligne. *@
                    foreach (var sous in SousVisibles(moment))
                    {
                        var sousOuvert = SousEstOuvert(moment, sous);
                        if (sous.Titre.Length > 0)
                        {
                            <button class="rig-menu__sous @(sousOuvert ? "rig-menu__sous--ouvert" : "")"
                                    title="@sous.Titre"
                                    @onclick="() => BasculerSous(moment, sous)">
                                <span class="rig-menu__chevron">&#9656;</span>
                                <span class="rig-menu__sous-titre">@sous.Titre</span>
                                <span class="rig-menu__compte">@EntreesVisibles(sous).Length</span>
                            </button>
                        }
                        @if (sousOuvert)
                        {
                            <ul class="rig-menu__liste">
                                @foreach (var e in EntreesVisibles(sous))
                                {
                                    <li class="rig-menu__ligne">
                                        @* Le code technique (PROC_xxx) n'est JAMAIS affiche :
                                           il reste l'identifiant interne, l'utilisateur lit le besoin. *@
                                        <button class="rig-menu__lien rig-menu__lien--metier @(ProcOuverte?.Code == e.Code ? "rig-menu__lien--actif" : "")"
                                                title="@e.Detail"
                                                @onclick="() => OuvrirCode(e.Code)">
                                            <span class="rig-menu__quoi">@e.Libelle</span>
                                        </button>
                                        @* L'etoile est un bouton FRERE du lien, jamais imbrique :
                                           un bouton dans un bouton declencherait les deux gestes. *@
                                        <button class="rig-menu__etoile @(Etat.EstFavori(e.Code) ? "rig-menu__etoile--allumee" : "")"
                                                title="@(Etat.EstFavori(e.Code) ? "Retirer des favoris" : "Mettre en favori")"
                                                @onclick="() => BasculerFavori(e.Code)">@(Etat.EstFavori(e.Code) ? "★" : "☆")</button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
            </div>
        }
    </nav>

    @* ============ PLAN DE TRAVAIL ============ *@
    <div class="rig-plan">

        <div class="rig-entete">
            <div class="rig-titre">
                Bonjour <b>@Utilisateur</b>
            </div>
            <div class="rig-entete__outils">
                <button class="rig-entete__action @(PanneauTuilesOuvert ? "rig-entete__action--ouvert" : "")"
                                title="Reglages de l'accueil"
                                @onclick="BasculerPanneauTuiles" @onmousedown:stopPropagation="true">&#9881;</button>
                @if (PanneauTuilesOuvert)
                {
                    @* Voile transparent plein ecran : un clic AILLEURS ferme le panneau. *@
                    <div class="rig-voile-clic" @onclick="() => PanneauTuilesOuvert = false"
                         @onmousedown:stopPropagation="true"></div>
                    <div class="rig-tuiles-panneau" @onmousedown:stopPropagation="true">
                                <div class="rig-tuiles-panneau__tete">
                                    <span class="rig-kicker">Tuiles affichees sur l'accueil</span>
                                    <button class="rig-tuiles-panneau__reset"
                                            title="Reinitialiser la disposition : replace et redimensionne les tuiles selon la disposition d'origine"
                                            aria-label="Reinitialiser la disposition"
                                            @onclick="ReinitialiserDisposition">&#8635;</button>
                                </div>
                                <span class="rig-kicker">Disposition</span>
                                <div class="rig-dispositions">
                                    @foreach (var d in Dispositions)
                                    {
                                        <button class="rig-disposition @(Etat.Disposition == d.Id ? "rig-disposition--actif" : "")"
                                                title="@d.Aide" @onclick="() => AppliquerDisposition(d.Id)">@d.Titre</button>
                                    }
                                </div>
                                @foreach (var def in Definitions.Where(TuileAutorisee))
                                {
                                    var visible = Pose(def.Id).Visible;
                                    <button class="rig-bascule @(visible ? "rig-bascule--actif" : "")"
                                                    @onclick="() => BasculerTuile(def.Id)">
                                                <span class="rig-bascule__temoin"></span>
                                                <span>@def.Titre</span>
                                    </button>
                                }
                    </div>
                }
            </div>
        </div>

        @* --- Recherche : centree, toujours a la meme place, jamais deplacable --- *@
        <div class="rig-recherche rig-recherche--fixe">
            <span style="font:13px var(--rig-font-mono);color:var(--rig-focus)">&#8981;</span>
            <input class="rig-recherche__saisie"
                   placeholder="Rechercher un SIREN, une societe, un dirigeant, un n° de demande…"
                   @bind="Recherche" @bind:event="oninput" />
            <span class="rig-touche">Ctrl K</span>
            @if (Resultats.Length > 0 || Traitements.Length > 0 || ElementsTrouves.Length > 0)
            {
                <div class="rig-resultats">
                    @foreach (var t in Traitements)
                    {
                        <button class="rig-resultat" @onclick="() => OuvrirProc(t)">
                            <span class="rig-filet-v rig-filet-v--action"></span>
                            <span class="rig-resultat__id">&#8594;</span>
                            <span>@t.Libelle<br />
                                <span style="font-size:11px;color:var(--rig-texte-3)">Ouvrir le traitement</span>
                            </span>
                            <span class="rig-resultat__type">Action</span>
                        </button>
                    }
                    @foreach (var r in Resultats)
                    {
                        <button class="rig-resultat" @onclick="() => OuvrirDossier(r)">
                            <span class="rig-filet-v rig-filet-v--@r.Statut"></span>
                            <span class="rig-resultat__id">@r.Numero</span>
                            <span>@r.Objet<br />
                                <span style="font-size:11px;color:var(--rig-texte-3)">SIREN @r.Siren</span>
                            </span>
                            <span class="rig-resultat__type">@r.Type</span>
                        </button>
                    }
                    @* Un numero de DEPOT, de FORMALITE ou de LIASSE ne designe pas
                       une affaire mais un ELEMENT dans son arbre : on ouvre
                       l'affaire deja depliee sur cet element. *@
                    @foreach (var e in ElementsTrouves)
                    {
                        <button class="rig-resultat" @onclick="() => OuvrirElementTrouve(e)">
                            <span class="rig-filet-v rig-filet-v--@e.Affaire.Statut"></span>
                            <span class="rig-resultat__id">&#128193;</span>
                            <span>@e.Chemin[^1]<br />
                                <span style="font-size:11px;color:var(--rig-texte-3)">@e.Affaire.Numero &middot; @string.Join(" > ", e.Chemin[..^1])</span>
                            </span>
                            <span class="rig-resultat__type">Element</span>
                        </button>
                    }
                </div>
            }
        </div>

        @* --- Grille : chaque tuile reste ou on l'a posee --- *@
        <div class="rig-grille" @ref="Grille">
            @foreach (var def in Definitions)
            {
                var p = Pose(def.Id);
                if (!p.Visible || !TuileAutorisee(def)) { continue; }
                @* Le z-index inline de la tuile (son rang d'empilement) cree un
                   CONTEXTE : un widget metier deploye, meme en position fixe et
                   z-index 89, restait donc enferme dans le rang de SA tuile et
                   passait derriere une tuile de rang superieur. Une tuile
                   deployee prend un rang qui bat toutes les autres. *@
                var devant = MetierEstDeploye(def.Id);
                <section class="rig-widget @(def.Maitresse ? "rig-widget--maitresse" : "") @(devant ? "rig-widget--devant" : "")"
                         data-tuile="@def.Id"
                         data-col="@p.Colonne" data-ligne="@p.Ligne"
                         data-larg="@p.Largeur" data-haut="@p.Hauteur"
                         style="grid-column:@p.Colonne / span @p.Largeur;grid-row:@p.Ligne / span @p.Hauteur;z-index:@(devant ? 96 : p.Ordre)">
                    @* Plus de filet colore en tete de tuile (choix du 2026-09-17) :
                       la couleur ne vit plus que dans les barres verticales des
                       alertes, ou elle code l'IMPORTANCE. *@
                    <header class="rig-widget__tete">
                        <span class="rig-widget__poignee">&#8942;&#8942;</span>
                        @* Un widget metier porte DEJA son titre complet dans son
                           propre en-tete (puce de registre, intitule metier,
                           pastille de charge). Le redire ici l'ecrivait DEUX FOIS
                           dans chaque widget. *@
                        @if (!def.Id.StartsWith("metier-"))
                        {
                            <span class="rig-widget__titre">@def.Titre</span>
                        }
                        <button class="rig-widget__reglages @(ReglagesTuile == def.Id ? "rig-widget__reglages--ouvert" : "")"
                                title="Reglages de la tuile"
                                @onclick="() => BasculerReglages(def.Id)"
                                @onmousedown:stopPropagation="true">&#9881;</button>
                    </header>
                    <div class="rig-widget__corps">
                        @if (ReglagesTuile == def.Id)
                        {
                            @ReglagesDe(def)
                        }
                        else
                        {
                            @switch (def.Id)
                            {
                                case "performance": @CorpsPerformance; break;
                                case "alertes":     @CorpsAlertes;     break;
                                case "alertes-bis": @CorpsAlertesBis;  break;
                                case "taches":      @CorpsTaches;      break;
                                case "nouveautes":  @CorpsNouveautes;  break;
                                case "actualites":  @CorpsActualites;   break;
                                case "activite":    @CorpsActivite;    break;
                                // Les huit widgets metier partagent UN corps,
                                // parametre par leur categorie.
                                case var m when m.StartsWith("metier-"): @CorpsMetier(def); break;
                            }
                        }
                    </div>
                    <span class="rig-widget__taille" title="Redimensionner"></span>
                </section>
            }
        </div>
    </div>
</div>
}

@* ============ ECRAN DE PROCEDURE ============ *@
@* Le cadre est commun ; chaque procedure a son composant dans
   Components/Ecrans/. Les procedures sans ecran dedie retombent sur
   celui des demandes. *@
@if (ProcOuverte is not null)
{
    <div class="rig-proc">

        <div class="rig-vged__entete">
            <span class="rig-filet-v rig-filet-v--action"></span>
            @* Le code technique (PROC_xxx) n'est JAMAIS affiche : l'agent lit
               son BESOIN, pas le nom interne de la procedure. Meme regle que
               dans le menu de gauche. *@
            <b>@ProcOuverte.Libelle</b>
            <span style="margin-left:auto"></span>
            @* Etoile de la vue : meme geste et meme etat que l'etoile du menu
               de gauche (BasculerFavori sur le CODE), pour que la vue ouverte
               puisse etre mise en favori sans retourner dans le menu. *@
            <button class="rig-vue__etoile @(Etat.EstFavori(ProcOuverte.Code) ? "rig-vue__etoile--allumee" : "")"
                    title="@(Etat.EstFavori(ProcOuverte.Code) ? "Retirer des favoris" : "Mettre en favori")"
                    aria-label="@(Etat.EstFavori(ProcOuverte.Code) ? "Retirer des favoris" : "Mettre en favori")"
                    aria-pressed="@(Etat.EstFavori(ProcOuverte.Code) ? "true" : "false")"
                    @onclick="() => BasculerFavori(ProcOuverte.Code)">@(Etat.EstFavori(ProcOuverte.Code) ? "★" : "☆")</button>
            @* Dans une fenetre d onglet sorti, la croix de la fenetre ferme deja
               la vue : un second bouton « Fermer » faisait doublon (18/09/2026). *@
            @if (!ModeFenetreVue)
            {
                <button class="rig-bouton" @onclick="FermerProc">Fermer</button>
            }
        </div>

        @* Bandeau du SUJET : tous les ecrans qui manipulent le meme objet
           metier (les personnes, les affaires, l'argent...) sont ici, dans
           une seule vue. On entre par l'objet, on choisit l'ecran ensuite ;
           plus besoin de savoir d'avance quelle procedure porte le geste. *@
        @{ var sujet = SujetDe(ProcOuverte.Code); }
        @if (sujet is not null)
        {
            <div class="rig-sujet">
                <span class="rig-kicker">@sujet.Titre</span>
                <div class="rig-onglets">
                    @foreach (var item in ProcsDuSujet(sujet))
                    {
                        var p = item;
                        <button class="rig-onglet @(p.Code == ProcOuverte.Code ? "rig-onglet--actif" : "")"
                                @onclick="() => OuvrirProc(p)">@p.Libelle</button>
                    }
                </div>
            </div>
        }
        else
        {
            @* Repli : la procedure n'appartient a aucun sujet d'OBJET, on
               montre alors ses voisines de GESTE — les ecrans du meme
               sous-menu. Aucune procedure ouverte ne reste donc isolee. *@
            var tache = TacheDe(ProcOuverte.Code);
            if (tache is not null)
            {
                <div class="rig-sujet">
                    <span class="rig-kicker">@TitreTache(tache)</span>
                    <div class="rig-onglets">
                        @foreach (var item in tache.Entrees)
                        {
                            var e = item;
                            <button class="rig-onglet @(e.Code == ProcOuverte.Code ? "rig-onglet--actif" : "")"
                                    title="@e.Detail"
                                    @onclick="() => OuvrirCode(e.Code)">@e.Libelle</button>
                        }
                    </div>
                </div>
            }
        }

        @switch (ProcOuverte.Code)
        {
            case "PROC_ACTES_NUM":
                <EcranActes OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ARRIVEE":
                <EcranArrivee OuvrirDossier="OuvrirParNumero" />
                break;

            case "OUVERTURE_DOSSIER":
                <EcranOuvertureDossier @key="CleOuverture" SirenDemande="@SirenAImmatriculer" />
                break;

            case "PROC_RECHAFF":
                <EcranRechAffaires Ouvrir="OuvrirParNumero"
                                   OuvrirUnDossier="OuvrirUnDossierPour" />
                break;

            case "PROC_DEMANDE":
                <EcranDemandes EstValide="EstValide" Ouvrir="OuvrirParNumero" />
                break;

            case "PROC_REQUI":
                <EcranRequisitions />
                break;

            case "PROC_CLOT":
                <EcranCloture OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ARCHIRAD":
                <EcranArchivage OuvrirDossier="OuvrirParNumero" />
                break;

            case "BODACC":
                <EcranBodacc OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_DEPOTJUD":
                <EcranDepotsJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_ACTEUR_JUD":
                <EcranActeurs />
                break;

            case "PROC_CJUD":
                <EcranConsultationJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_AUDIENCE":
                <EcranAudiences />
                break;

            case "PROC_GESTAUDS":
                <EcranGestionAudiences />
                break;

            case "PROC_EXPERT":
                <EcranExperts />
                break;

            case "PROC_GEDJUD":
                <EcranGedJud OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_REDA":
                <EcranRedaction />
                break;

            case "PROC_DOC_DEMAT":
                <EcranDocDemat OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_CONTROLE_VIDIGED":
                <EcranControleVidiged />
                break;

            case "PROC_COFFRE_FORT":
                <EcranCoffreFort />
                break;

            case "PROC_FACTURE":
                <EcranFactures />
                break;

            case "PROC_ENCAISS":
                <EcranEncaissements />
                break;

            case "PROC_FCLIENT":
                <EcranFicheClient />
                break;

            case "PROC_GCLIENT":
                <EcranClients />
                break;

            case "PROC_STAT":
                <EcranStatistiques />
                break;

            case "PROC_ACCUEIL_PARAM":
                <EcranParametresAccueil />
                break;

            case "PROC_ACTUALITES":
                <EcranActualites />
                break;

            case "PROC_GESTEMAIL":
                <EcranMessagerie />
                break;

            case "PROC_GESTBANQ":
                <EcranBanques />
                break;

            case "PROC_EDIT_MAQUETTE":
                <EcranMaquettesEdition />
                break;

            case "PROC_COMPTABILISATION":
                <EcranComptabilisation />
                break;

            case "PROC_COURRIER_DIVERS":
                <EcranCourriersDivers />
                break;

            case "PROC_TACHES_LOT":
                @* Traitement EN LOT : la meme recette sur plusieurs affaires. *@
                <EcranTachesLot Etat="Etat" Utilisateur="@Utilisateur"
                                CodeRecette="@LotDemande" />
                break;

            case "PROC_VERROUS":
                <EcranVerrous OuvrirDossier="OuvrirParNumero" />
                break;

            case "PROC_TELETRANS":
                <EcranTeletransmission OuvrirDossier="OuvrirParNumero" />
                break;

            // PROC_CREANCE n'a PAS d'ecran porte, et ce n'est pas un oubli :
            // dans RIG v2, PROC_CREANCE.cs ne contient qu'un constructeur et
            // FORM_CREANCE.Designer.cs aucun controle (32 lignes, un simple
            // conteneur). Il n'y a donc rien a porter ; inventer un ecran de
            // creances serait inventer RIG v2.
            default:
                <EcranNonMaquette Code="@ProcOuverte.Code" Libelle="@ProcOuverte.Libelle"
                                  Motif="@MotifNonMaquette(ProcOuverte.Code)" />
                break;
        }
    </div>
}

@* ============ VISIONNEUSE DOCUMENTAIRE (esprit VGED) ============ *@
@if (DossierOuvert is not null)
{
    <div class="rig-vged">
        <div class="rig-vged__entete">
            <button class="rig-bouton rig-bouton--icone rig-bouton--plat" title="Retour a l'accueil" aria-label="Retour a l'accueil" @onclick="FermerDossier">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5" /><path d="M12 19l-7-7 7-7" /></svg>
            </button>
            <span class="rig-filet-v rig-filet-v--@DossierOuvert.Statut"></span>
            <b style="font:13px var(--rig-font-mono)">@DossierOuvert.Numero</b>
            <span>@DossierOuvert.Objet</span>
            <span style="color:var(--rig-texte-3);font-size:12px">
                &middot; SIREN @DossierOuvert.Siren &middot; @DossierOuvert.Type
            </span>
            <span style="margin-left:auto"></span>
            @if (!GuideVisible && ApercuNoeud is not null)
            {
                <button class="rig-bouton rig-bouton--plat" title="Reafficher le document a droite"
                        @onclick="() => GuideVisible = true">Document</button>
            }
            <button class="rig-bouton rig-bouton--icone rig-bouton--plat" title="Fermer l'affaire" aria-label="Fermer l'affaire" @onclick="FermerDossier">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg>
            </button>
        </div>

        @* ---- FICHE SOMMAIRE (bandeau du haut de la vue arbre) ----
             Les champs d'identite que RIG v2 affiche au-dessus du treeview
             (PROC_VDOSSIER, panneau « Fiche sommaire ») : identite du dossier,
             denomination, adresse, dates, et la mention de procedure.
             Lecture seule : la saisie reste dans les fiches de droite. *@
        @{
            var fs = SommaireDu(DossierOuvert);
            // UN SEUL FLUX, pas de grille : chaque champ VIDE disparait --
            // libelle compris (demande du 17/09/2026). Un libelle sans valeur
            // n'apprend rien et mangeait trois lignes de haut d'ecran.
            var champs = new (string Libelle, string Valeur, bool Mono)[]
            {
                ("N° de gestion", DossierOuvert.Numero, true),
                ("SIREN", DossierOuvert.Siren, true),
                ("Type", DossierOuvert.Type, false),
                ("Type de dossier", DossierOuvert.TypeDossier, true),
                ("Forme juridique", fs.FormeJuridique, false),
                ("Sigle", fs.Sigle, false),
                ("Nom commercial", fs.NomCommercial, false),
                ("Civilite", fs.Civilite, false),
                ("Designation", fs.Designation, false),
                ("Adresse", fs.Adresse.Replace("\n", " - "), false),
                ("Immat.", fs.Immatriculation, true),
                ("Cessation", fs.Cessation, true),
                ("Date MAJ", fs.DateMaj, true)
            };
            var sommaireRemplis = champs.Where(c => c.Valeur is { Length: > 0 }).ToArray();
        }
        <details class="rig-sommaire" open>
            <summary class="rig-sommaire__titre">
                Fiche sommaire
                <span class="rig-sommaire__resume">@DossierOuvert.Numero &middot; @fs.Designation</span>
            </summary>
            <div class="rig-sommaire__ligne">
                @foreach (var c in sommaireRemplis)
                {
                    <span class="rig-sommaire__champ">
                        <span class="rig-sommaire__libelle">@c.Libelle</span>
                        <span class="rig-sommaire__valeur @(c.Mono ? "rig-sommaire__valeur--mono" : "")">@c.Valeur</span>
                    </span>
                }
                @if (fs.Mention.Length > 0)
                {
                    <span class="rig-sommaire__mention">@fs.Mention</span>
                }
            </div>
        </details>

        @* ---- Bandeau des defauts : visible des qu'un requis manque ou qu'une
             valeur est refusee. Chaque lien ouvre l'etape (et la fiche) ou
             corriger (demande du 2026-09-15). *@
        @if (!DossierValide && TousLesDefauts() is { Count: > 0 } defautsBandeau)
        {
            <div class="rig-bandeau-defauts @(defautsBandeau.Any(d => !d.EstManquant) ? "rig-bandeau-defauts--erreur" : "")" role="alert">
                @* Piste C du draft (2026-09-15) : compteur + liste repliable, sections triees par urgence. *@
                <details class="rig-bandeau-defauts__replis">
                    <summary class="rig-bandeau-defauts__resume">
                        <span class="rig-bandeau-defauts__titre">
                            <b>@defautsBandeau.Count</b> @(defautsBandeau.Count == 1 ? "point a corriger" : "points a corriger")
                        </span>
                        <span class="rig-bandeau-defauts__voir">voir les sections</span>
                    </summary>
                    <div class="rig-bandeau-defauts__liste">
                    @foreach (var groupe in defautsBandeau.GroupBy(d => (d.IndexEtape, d.Etape, d.Fiche, d.Unite))
                                                         .OrderByDescending(x => x.Count(d => !d.EstManquant))
                                                         .ThenByDescending(x => x.Count())
                                                         .ThenBy(x => x.Key.IndexEtape))
                    {
                        var g = groupe;
                        var refuses = g.Count(d => !d.EstManquant);
                        var multi = Fiches(Etapes[g.Key.IndexEtape].Code).Count > 1;
                        <button class="rig-bandeau-defauts__lien @(refuses > 0 ? "rig-bandeau-defauts__lien--refuse" : "rig-bandeau-defauts__lien--manquant")"
                                title="@string.Join(" · ", g.Select(d => $"{d.Champ} : {d.Motif}"))"
                                @onclick="() => AllerAuDefautDepuisBandeau(g.First())">
                            @g.Key.Etape@(multi ? $" ({g.Key.Unite} {g.Key.Fiche + 1})" : "")
                            <span class="rig-bandeau-defauts__nb">@g.Count()</span>
                        </button>
                    }
                    </div>
                </details>
            </div>
        }

        <div class="rig-vged__corps" style="@StyleCorps">

            @* ---- Arbre documentaire, colonnes de TreeviewGed (v2) ---- *@
            <div class="rig-vged__arbre">
                <div class="rig-arbre__entete">
                    <span class="rig-arbre__libelle">Visualisation du dossier</span>
                    <button class="rig-arbre__nouveau" title="Ajouter un dossier ou une piece dans l'arbre"
                            @onclick="OuvrirNouveau">+ Nouveau</button>
                </div>
                @* MODE TACHE : l'arbre est replie sur ce que la recette nomme.
                   Le bouton rouvre le dossier entier SANS fermer la tache. *@
                @if (RecetteActive is not null)
                {
                    <div class="rig-tache__bandeau">
                        <span class="rig-tache__code">@RecetteActive.Code</span>
                        <span class="rig-tache__titre">@RecetteActive.Titre</span>
                        <button class="rig-bouton rig-bouton--plat rig-tache__tout"
                                aria-pressed="@ToutLeDossier"
                                title="Afficher tout le dossier sans quitter la tache"
                                @onclick="BasculerToutLeDossier">
                            @(ToutLeDossier
                                ? "Revenir a la tache"
                                : $"Afficher tout le dossier ({BranchesMasquees} branches, {PiecesMasquees} pieces masquees)")
                        </button>
                        @* CONTROLE DE COMPLETUDE : la tache ne se termine que
                           lorsque TOUS ses champs sont renseignes, et la preuve
                           est la trace du dossier, pas l'ecran. *@
                        @{
                            var manquants = ChampsManquants();
                            // Le compte porte sur les champs EXIGES, pas sur
                            // tous : compter un champ facultatif comme fait
                            // affichait « 3 / 5 » quand 2 seulement etaient
                            // ecrits (defaut vu a l'ecran le 16/09/2026).
                            // Le compte porte sur les CASES a remplir : un
                            // champ repetable compte une fois PAR LIGNE. Sans
                            // cela, 3 dirigeants ouverts affichaient « 0 / 4 »
                            // alors que 5 cases etaient ecrites (vu le 16/09).
                            var trous = TrousDeLaTache();
                            var exiges = CasesExigees();
                            var faits = exiges - trous.Length;
                            var facultatifs = RecetteActive.Champs.Length
                                              - RecetteActive.ChampsObligatoires.Length;
                        }
                        <span class="rig-tache__etat @(trous.Length == 0 ? "rig-tache__etat--ok" : "")">
                            @faits / @exiges champs renseignes
                            @if (facultatifs > 0)
                            {
                                <span class="rig-tache__reste">+ @facultatifs facultatif(s)</span>
                            }
                            @if (trous.Length > 0)
                            {
                                <span class="rig-tache__reste">reste : @NommerTrous(trous)</span>
                            }
                        </span>
                        <button class="rig-bouton rig-tache__terminer" disabled="@(!TachePeutSeClore())"
                                title="@RaisonBlocage()"
                                @onclick="TerminerTache">Terminer la tache</button>
                        <button class="rig-bouton rig-bouton--plat" title="Fermer la tache sans la terminer"
                                @onclick="FermerTache">Fermer la tache</button>
                    </div>
                    @* PLUSIEURS LIGNES : trois dirigeants changes le meme jour
                       font UNE tache, pas trois. Chaque ligne a ses propres
                       champs, sa propre trace, et compte dans la completude. *@
                    @if (RecetteActive.ARepetition)
                    {
                        <div class="rig-tache__lignes">
                            @for (var i = 1; i <= NbLignesTache; i++)
                            {
                                var rang = i;
                                var trousLigne = TrousDeLaLigne(rang);
                                <button class="rig-tache__ligne @(rang == LigneCourante ? "rig-tache__ligne--courante" : "") @(trousLigne == 0 ? "rig-tache__ligne--ok" : "")"
                                        title="@(trousLigne == 0 ? "Ligne complete" : $"{trousLigne} champ(s) a renseigner")"
                                        @onclick="() => LigneCourante = rang">
                                    @RecetteActive.LibelleLigne @rang
                                </button>
                            }
                            <button class="rig-tache__ligne rig-tache__ligne--ajout"
                                    title="@($"Ajouter un {RecetteActive.LibelleLigne.ToLowerInvariant()} a cette tache")"
                                    @onclick="AjouterLigneTache">+</button>
                            @if (NbLignesTache > 1)
                            {
                                <button class="rig-tache__ligne rig-tache__ligne--ajout"
                                        title="Retirer la derniere ligne (ce qui y a ete ecrit reste dans la trace)"
                                        @onclick="RetirerLigneTache">&minus;</button>
                            }
                        </div>
                    }
                }
                @* RECHERCHE : filtre les elements visibles de l'arbre. *@
                <div class="rig-arbre__recherche">
                    <input type="search" class="rig-arbre__filtre" placeholder="Filtrer l'arbre..."
                           aria-label="Filtrer les elements de l'arbre"
                           @bind="FiltreDeLArbre" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(FiltreDeLArbre))
                    {
                        <button type="button" class="rig-arbre__filtre-effacer" title="Effacer le filtre"
                                @onclick="() => FiltreDeLArbre = string.Empty">&times;</button>
                    }
                </div>
                <div class="rig-arbre">
                    <ArbreGedNoeud Noeud="Arbre" Niveau="0" Ouverts="NoeudsOuverts" Filtre="@FiltreDeLArbre"
                                   Selection="NoeudSelectionne"
                                   Selectionner="OuvrirApercu"
                                   Domaines="Domaines" Ajouts="AjoutsArbre"
                                   Masques="MasquesArbre" Libelles="LibellesArbre"
                                   Recette="RecetteArbre"
                                   Renomme="NoeudRenomme" Renommer="ValiderRenommage"
                                   MenuContextuel="OuvrirMenuNoeud" />
                </div>
                @* PROPAGATION -- EN PIED DE COLONNE (17/09/2026). Ce bloc
                   etait AU-DESSUS de l'arbre : ouvrir la tache poussait tous
                   les noeuds vers le bas et on perdait sa place. Ici, l'arbre
                   ne bouge plus.
                   Chaque ligne se coche par PREUVE : la piece deposee dans
                   l'arbre (avis BODACC, accuse INPI). Cliquer la ligne filtre
                   l'arbre sur cette piece -- la checklist pilote la vue. *@
                @if (RecetteActive is not null)
                {
                    @* CHECKLIST DE SAISIE (17/09/2026). Les sous-taches de
                       SAISIE n'etaient visibles que dans le message du bouton
                       « Renseigner d'abord : ... » : elles se remplissaient
                       toutes seules mais ne se VOYAIENT pas comme des lignes
                       cochees. Elles sont ici, au-dessus des effets, dans la
                       MEME liste. Aucune n'est cliquable : la preuve est la
                       valeur ecrite dans la trace du dossier, jamais un clic. *@
                    <div class="rig-tache__effets rig-tache__effets--pied">
                        <div class="rig-tache__effets-titre">
                            A saisir
                            <span class="rig-tache__effets-compte">
                                @(CasesExigees() - TrousDeLaTache().Length)
                                / @CasesExigees() renseignes
                            </span>
                        </div>
                        @foreach (var item in CasesDeSaisie())
                        {
                            var c = item;
                            <div class="rig-tache__effet @(c.Exige ? "" : "rig-tache__effet--facultatif") @(c.Rempli ? "rig-tache__effet--prouve" : "")"
                                 title="@($"{c.Champ.Table}.{c.Champ.Colonne}"
                                          + (c.Rempli
                                             ? $" -- coche par la valeur ecrite : {c.Valeur}"
                                             : " -- se cochera des que la valeur sera saisie dans la fiche"))">
                                <input type="checkbox" checked="@c.Rempli" disabled="true" />
                                <span class="rig-tache__effet-libelle">@c.Libelle</span>
                                @if (c.Rempli)
                                {
                                    <span class="rig-tache__effet-preuve">saisi : @c.Valeur</span>
                                }
                                @if (!c.Exige)
                                {
                                    <span class="rig-tache__effet-note">non exige</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="rig-tache__effets rig-tache__effets--pied">
                        <div class="rig-tache__effets-titre">
                            Ce que ce changement entraine
                            <span class="rig-tache__effets-compte">
                                @(RecetteActive.EffetsObligatoires.Length - EffetsRestants().Length)
                                / @RecetteActive.EffetsObligatoires.Length traites
                            </span>
                        </div>
                        @foreach (var effet in RecetteActive.Effets)
                        {
                            var e = effet;
                            var atteste = EffetAtteste(e);
                            var coche = EffetCoche(e.Canal);
                            var cible = EffetCible == e.Canal;
                            <div class="rig-tache__effet @(e.Obligatoire ? "" : "rig-tache__effet--facultatif") @(atteste ? "rig-tache__effet--prouve" : "") @(cible ? "rig-tache__effet--cible" : "")"
                                 title="@($"Declare en base : {e.Source}"
                                          + (e.Piece.Length > 0
                                             ? atteste
                                                 ? $" -- coche par la piece deposee : {e.Piece}"
                                                 : $" -- se cochera des que la piece « {e.Piece} » sera deposee"
                                             : " -- aucun document ne l'atteste : a cocher a la main"))">
                                <input type="checkbox" checked="@coche" disabled="@atteste"
                                       @onchange="() => BasculerEffet(e)" />
                                @* Le libelle est un BOUTON : il filtre l'arbre
                                   sur la piece attendue par cet effet. *@
                                <button class="rig-tache__effet-libelle"
                                        disabled="@(e.Piece.Length == 0)"
                                        title="@(e.Piece.Length == 0
                                                 ? "Aucune piece a montrer pour cet effet"
                                                 : cible ? "Revenir a la tache entiere"
                                                         : $"Montrer dans l'arbre : {e.Piece}")"
                                        @onclick="() => ViserEffet(e)">@e.Libelle</button>
                                <span class="rig-tache__effet-code">@e.Code</span>
                                @if (atteste)
                                {
                                    <span class="rig-tache__effet-preuve">prouve : @e.Piece</span>
                                }
                                @if (!e.Obligatoire)
                                {
                                    <span class="rig-tache__effet-note">non exige</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* ---- Separateur deplacable : regle la largeur de l'arbre ---- *@
            @if (DonneesVisible || GuideVisible)
            {
            @* preventDefault : sans lui, le navigateur demarre une SELECTION de
               texte des l'appui et toute la vue se couvre de surlignage bleu. *@
            <div class="rig-vged__poignee" title="Glisser pour ajuster l'arbre"
                 @onpointerdown="DebutRedim" @onpointerdown:preventDefault="true"></div>
            }

            @* ---- ZONE 2 : LES DONNEES ----
                 Le formulaire de l'etape liee a la piece a desormais SA colonne :
                 il ne prend plus la place du document (demande du 2026-09-14). *@
            @* ---- ZONE 2 : LES ETAPES DU DOSSIER ----
                 Les 7 etapes cote a cote, a l'horizontale : la molette passe a
                 l'etape suivante (scroll-snap). Seules l'etape visible et ses deux
                 voisines sont rendues (demande du 2026-09-15). *@
            @if (DonneesVisible && NoeudSelectionne is { EstFiche: true })
            {
            @* « Informations du dossier » : le formulaire complet des donnees v2. *@
            <div class="rig-vged__guide rig-vged__donnees">
                @* fix-ok: ajout demande — GedCheck rouge « la vue affiche la fiche des formalites » avant branchement, vert apres *@
                @if (NoeudSelectionne.Libelle == InformationsFormalite.LibelleNoeud)
                {
                @* « Informations des Formalites » : les champs du processus v2 XACTION. *@
                <FicheInformationsDossier Numero="@DossierOuvert.Numero" Etat="Etat"
                                          Domaine="Formalites"
                                          Titre="@InformationsFormalite.LibelleNoeud"
                                          Sections="InformationsFormalite.Sections"
                                          Sources="InformationsFormalite.ProcessusSources"
                                          Fermer="() => DonneesVisible = false" />
                }
                else if (NoeudSelectionne.Libelle == InformationsDepots.LibelleNoeud)
                {
                @* « Informations des depots » : les champs du processus v2 XDAS. *@
                <FicheInformationsDossier Numero="@DossierOuvert.Numero" Etat="Etat"
                                          Domaine="Depots d'actes"
                                          Titre="@InformationsDepots.LibelleNoeud"
                                          Sections="InformationsDepots.Sections"
                                          Sources="InformationsDepots.ProcessusSources"
                                          Fermer="() => DonneesVisible = false" />
                }
                else
                {
                <FicheInformationsDossier Numero="@DossierOuvert.Numero" Etat="Etat"
                                          Recette="RecetteActive"
                                          Verrou="@(RecetteActive is null)"
                                          ToutAffiche="CompterToutAffiche"
                                          ChampModifie="StateHasChanged"
                                          LigneCourante="LigneCourante"
                                          Fermer="() => DonneesVisible = false" />
                }
            </div>
            @* Seconde poignee aussi pour les fiches : sans elle la grille (qui
               reserve 6px + colonne donnees) decalait le document et rien ne
               permettait d'ajuster la separation fiche / document. *@
            @if (GuideVisible)
            {
            <div class="rig-vged__poignee" title="Glisser pour ajuster les donnees"
                 @onpointerdown="DebutRedim2" @onpointerdown:preventDefault="true"></div>
            }
            }
            else if (DonneesVisible)
            {
            <div class="rig-vged__guide rig-vged__donnees">
                <div class="rig-guide__entete">
                    <div>
                        <div class="rig-kicker">Controle du dossier &middot; etape @(EtapeCourante + 1) / @Etapes.Length</div>
                        <h3 class="rig-guide__titre">@(ApercuNoeud?.Libelle ?? DossierOuvert.Numero)</h3>
                    </div>
                    @* Oeil : rouvre le panneau de droite (document) depuis
                       l'en-tete des etapes (demande du 2026-09-15). *@
                    @if (!GuideVisible)
                    {
                    <button class="rig-bouton rig-bouton--icone rig-bouton--plat" style="margin-left:auto"
                            title="Afficher le panneau de droite" aria-label="Afficher le panneau de droite"
                            @onclick="() => GuideVisible = true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                    }
                    <button class="rig-guide__fermer" title="Fermer les etapes"
                            @onclick="() => DonneesVisible = false">&times;</button>
                </div>
                <ol class="rig-frise rig-frise--h rig-frise--haut">
                    @* Fleches de part et d'autre des etapes : elles remplacent les
                       boutons Precedent / Suivant (demande du 2026-09-15). *@
                    <li class="rig-frise__fleche">
                        <button class="rig-frise__fleche-bouton" title="Etape precedente"
                                disabled="@(EtapeCourante == 0)"
                                @onclick="() => AllerEtape(EtapeCourante - 1)">&#8249;</button>
                    </li>
                    @for (var i = 0; i < Etapes.Length; i++)
                    {
                        var index = i;
                        var etape = Etapes[i];
                        var (remplis, total) = Avancement(etape);
                        var nbFiches = Fiches(etape.Code).Count;
                        var (manquants, refuses) = Defauts(etape);
                        var etat = refuses > 0 ? "refuse"
                                 : total > 0 && remplis == total ? "complet"
                                 : index == EtapeCourante ? "encours"
                                 : remplis > 0 ? "partiel" : "vide";
                        <li class="rig-frise__pas rig-frise__pas--@etat @(index == EtapeCourante ? "rig-frise__pas--courant" : "")">
                            <button class="rig-frise__bouton" @onclick="() => AllerEtape(index)">
                                <span class="rig-frise__pastille">
                                    @(refuses > 0 ? "!" : total > 0 && remplis == total ? "OK" : (index + 1).ToString())
                                </span>
                                <span class="rig-frise__libelle">
                                    @etape.Titre
                                    @if (etape.Multiple && nbFiches > 1)
                                    {
                                        <span class="rig-frise__fiches">@nbFiches @(etape.Unite.ToLower())s</span>
                                    }
                                    @if (refuses > 0)
                                    {
                                        <span class="rig-frise__defaut">@refuses valeur(s) refusee(s)</span>
                                    }
                                    else if (manquants > 0)
                                    {
                                        <span class="rig-frise__requis">@manquants requis manquant(s)</span>
                                    }
                                </span>
                                <span class="rig-frise__compte">@remplis / @total</span>
                            </button>
                        </li>
                    }
                    <li class="rig-frise__fleche">
                        <button class="rig-frise__fleche-bouton" title="Etape suivante"
                                disabled="@(EtapeCourante == Etapes.Length - 1)"
                                @onclick="() => AllerEtape(EtapeCourante + 1)">&#8250;</button>
                    </li>
                </ol>
                <div class="rig-saisie__pages rig-saisie__pages--h" @ref="ZonePages">
                @for (var iEtape = 0; iEtape < Etapes.Length; iEtape++)
                {
                    var indexEtape = iEtape;
                    var courante = Etapes[iEtape];
                    var fiches = Fiches(courante.Code);
                    var iFiche = IndexFiche(courante);
                    <section class="rig-saisie__page @(indexEtape == EtapeCourante ? "rig-saisie__page--courante" : "")"
                             id="rig-etape-@indexEtape" data-etape="@indexEtape">
                    @if (Math.Abs(indexEtape - EtapeCourante) <= 1)
                    {
                    <div class="rig-saisie__corps">
                            <div class="rig-saisie__entete">
                                <div>
                                    <div class="rig-kicker">Etape @(indexEtape + 1) sur @Etapes.Length</div>
                                    <h2 class="rig-saisie__titre">@courante.Titre</h2>
                                    <div class="rig-saisie__source">@courante.Source</div>
                                </div>
                            </div>

                            @* Une etape multiple presente ses fiches en onglets. *@
                            @if (courante.Multiple)
                            {
                                <div class="rig-fiches">
                                    @for (var f = 0; f < fiches.Count; f++)
                                    {
                                        var indexFiche = f;
                                        <button class="rig-fiches__onglet @(indexFiche == iFiche ? "rig-fiches__onglet--actif" : "")"
                                                @onclick="() => ChoisirFiche(courante, indexFiche)">
                                            @courante.Unite @(indexFiche + 1)
                                        </button>
                                    }
                                    <button class="rig-fiches__ajout" title="Ajouter"
                                            @onclick="() => AjouterFiche(courante)">+ Ajouter</button>
                                    @if (fiches.Count > 1)
                                    {
                                        <button class="rig-fiches__retrait" title="Retirer cette fiche"
                                                @onclick="() => SupprimerFiche(courante)">Retirer</button>
                                    }
                                </div>
                            }

                            @* --- Controle final : le recapitulatif de TOUT ce qui bloque --- *@
                            @if (courante.Code == "CONTROLE")
                            {
                                var defauts = TousLesDefauts();
                                <div class="rig-recap">
                                    @if (DossierValide)
                                    {
                                        <div class="rig-recap__entete rig-recap__entete--valide">
                                            <span class="rig-recap__pastille rig-recap__pastille--ok">OK</span>
                                            <div>
                                                <div class="rig-recap__titre">Dossier valide</div>
                                                <div class="rig-recap__detail">
                                                    Les 7 etapes sont completes et acceptees.
                                                </div>
                                            </div>
                                            <button class="rig-bouton" style="margin-left:auto"
                                                    @onclick="RouvrirDossier">Rouvrir la saisie</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rig-recap__entete">
                                            <span class="rig-recap__pastille @(defauts.Count == 0 ? "rig-recap__pastille--ok" : "rig-recap__pastille--bloque")">
                                                @(defauts.Count == 0 ? "OK" : defauts.Count.ToString())
                                            </span>
                                            <div>
                                                <div class="rig-recap__titre">
                                                    @(defauts.Count == 0
                                                        ? "Rien ne bloque la validation"
                                                        : defauts.Count == 1
                                                            ? "1 point bloque la validation"
                                                            : $"{defauts.Count} points bloquent la validation")
                                                </div>
                                                <div class="rig-recap__detail">
                                                    @defauts.Count(d => d.EstManquant) a renseigner &middot;
                                                    @defauts.Count(d => !d.EstManquant) valeur(s) refusee(s)
                                                </div>
                                            </div>
                                            <button class="rig-bouton rig-bouton--fort" style="margin-left:auto"
                                                    disabled="@(defauts.Count > 0)"
                                                    @onclick="ValiderDossier">Valider le dossier</button>
                                        </div>

                                        @if (defauts.Count > 0)
                                        {
                                            <ul class="rig-recap__liste">
                                                @foreach (var groupe in defauts.GroupBy(d => (d.IndexEtape, d.Etape, d.Fiche, d.Unite)))
                                                {
                                                    var g = groupe;
                                                    var multi = Fiches(Etapes[g.Key.IndexEtape].Code).Count > 1;
                                                    <li class="rig-recap__groupe">
                                                        <button class="rig-recap__aller"
                                                                @onclick="() => AllerAuDefaut(g.First())">
                                                            <span class="rig-recap__rang">@(g.Key.IndexEtape + 1)</span>
                                                            <span>
                                                                @g.Key.Etape
                                                                @if (multi)
                                                                {
                                                                    <span class="rig-recap__fiche">@g.Key.Unite @(g.Key.Fiche + 1)</span>
                                                                }
                                                            </span>
                                                            <span class="rig-recap__nb">@g.Count()</span>
                                                        </button>
                                                        <ul class="rig-recap__points">
                                                            @foreach (var d in g)
                                                            {
                                                                <li class="rig-recap__point @(d.EstManquant ? "" : "rig-recap__point--refuse")">
                                                                    <span class="rig-recap__champ">@d.Champ</span>
                                                                    <span class="rig-recap__motif">@d.Motif</span>
                                                                    <span class="rig-recap__colonne">@d.Colonne</span>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    }
                                </div>
                            }

                            @ChampsSaisie(courante)
                    </div>
                    }
                    else
                    {
                        <div class="rig-saisie__attente">@courante.Titre</div>
                    }
                    </section>
                }
                </div>
            </div>
            @if (GuideVisible)
            {
            <div class="rig-vged__poignee" title="Glisser pour ajuster les donnees"
                 @onpointerdown="DebutRedim2" @onpointerdown:preventDefault="true"></div>
            }
            }

            @* ---- ZONE 3 : LE DOCUMENT (visionneuse VGED) ----
                 « Detacher » sort cette zone dans une fenetre a part, posable
                 sur un autre ecran et dimensionnable independamment. *@
            @if (GuideVisible)
            {
            <div class="rig-vged__guide rig-vged__apercu">
                @* PLUSIEURS documents peuvent etre sortis en meme temps : la zone
                   reste donc utilisable pour ouvrir la piece suivante et la
                   detacher a son tour. Un rappel liste les fenetres ouvertes. *@
                @if (FenetresDetachees.Count > 0)
                {
                    <div class="rig-guide__entete rig-vged__detachees">
                        <div>
                            <div class="rig-kicker">Documents sortis</div>
                            <div class="rig-guide__source">@FenetresDetachees.Count fenetre(s) ouverte(s) — chacune revient toujours a la meme place.</div>
                        </div>
                        <button class="rig-bouton" @onclick="RattacherDocument">Tout rattacher</button>
                    </div>
                }
                @if (ApercuNoeud is not null)
                {
                    <div class="rig-apercu">
                        <div class="rig-apercu__entete">
                            <div>
                                <div class="rig-kicker">@ApercuNoeud.Extension &middot; @ApercuNoeud.Pages page(s) &middot; @ApercuNoeud.Date</div>
                                <div class="rig-apercu__titre">@ApercuNoeud.Libelle</div>
                            </div>
                            <div class="rig-apercu__actions">
                                @* Icones + info-bulle (demande du 15/09/2026 : les
                                   libelles en toutes lettres etaient juges laids). *@
                                <button class="rig-bouton rig-bouton--icone rig-bouton--fort" title="Imprimer" aria-label="Imprimer" @onclick="OuvrirImpression">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><rect x="7" y="14" width="10" height="7" /></svg>
                                </button>
                                <button class="rig-bouton rig-bouton--icone" title="Editer" aria-label="Editer" @onclick="EditerPiece">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg>
                                </button>
                                <button class="rig-bouton rig-bouton--icone" title="Detacher dans une fenetre" aria-label="Detacher" @onclick="DetacherDocument">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6" /><path d="M20 4l-9 9" /><path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" /></svg>
                                </button>
                                <button class="rig-bouton rig-bouton--icone" title="Sauvegarder" aria-label="Sauvegarder" @onclick="Sauvegarder">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h11l4 4v13a1 1 0 01-1 1H5a1 1 0 01-1-1V4a1 1 0 011-1z" /><path d="M8 3v5h7V3" /><rect x="7" y="13" width="10" height="8" /></svg>
                                </button>
                                <button class="rig-bouton rig-bouton--icone" title="Envoyer par mail" aria-label="Envoyer par mail" @onclick="OuvrirEnvoiMail">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3L10 14" /><path d="M21 3l-7 18-4-7-7-4z" /></svg>
                                </button>
                                <button class="rig-bouton rig-bouton--icone rig-bouton--plat" title="Fermer l'apercu" aria-label="Fermer" @onclick="FermerApercu">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg>
                                </button>
                            </div>
                        </div>
                        @if (ApercuMessage.Length > 0)
                        {
                            <div class="rig-apercu__message">@ApercuMessage</div>
                        }
                        <div class="rig-apercu__pages @(ApercuNoeud.APdf ? "rig-apercu__pages--pdf" : "")">
                            @if (ApercuNoeud.APdf)
                            {
                                <iframe class="rig-apercu__pdf" src="@(ApercuNoeud.Fichier)#view=FitH" title="@ApercuNoeud.Libelle"></iframe>
                            }
                            else if (EstKbis(ApercuNoeud))
                            {
                                <div class="rig-apercu__feuille rig-apercu__feuille--kbis">
                                    <ApercuKbis Numero="@DossierOuvert.Numero" Siren="@DossierOuvert.Siren"
                                                Denomination="@DenominationAffaire()" Lire="LireSaisie" />
                                </div>
                            }
                            else
                            {
                            @for (var feuille = 1; feuille <= Math.Max(1, ApercuNoeud.Pages); feuille++)
                            {
                                <div class="rig-apercu__feuille">
                                    @if (feuille == 1)
                                    {
                                        @* Valeurs du formulaire, relues a chaque frappe (EcrireEnDirect). *@
                                        <dl class="rig-apercu__saisie">
                                            @foreach (var (libelle, valeur) in ValeursDocument(ApercuNoeud))
                                            {
                                                <dt>@libelle</dt><dd>@valeur</dd>
                                            }
                                        </dl>
                                    }
                                    <div class="rig-apercu__feuille-texte">@TextePage(ApercuNoeud, feuille)</div>
                                    <div class="rig-apercu__folio">@feuille / @Math.Max(1, ApercuNoeud.Pages)</div>
                                </div>
                            }
                            }
                        </div>
                    </div>
                }
            </div>
            }
            @if (Redimensionne)
            {
                <div class="rig-vged__voile" @onpointermove="PendantRedim"
                     @onpointerup="() => Redimensionne = false"
                     @onpointerleave="() => Redimensionne = false"></div>
            }
        </div>
    </div>
}


