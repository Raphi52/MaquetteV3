            new("Denomination du dirigeant", "DRGPM_DENOMINATION_STATUT", Largeur: "pleine",
                Exemple: "HOLDING DUPONT SAS",
                VisibleSi: "DRGNT_PERSONNE_PHYSIQUE=Non"),
            new("Organe collegial", "DRGNT_ORGANE_COLLEGIAL", ChoixPossibles: ["Non", "Oui"], Defaut: "Non"),
            new("Associe indefiniment responsable", "DRGNT_ASSOCIE_ISR", ChoixPossibles: ["Non", "Oui"], Defaut: "Non")
        ], Multiple: true, Unite: "Dirigeant"),

        new("CONTROLE", "Controle", "table OBSERVATION_RCS",
        [
            new("Texte de la mention", "OBSRC_TEXTE_MENTION", Largeur: "pleine",
                Exemple: "Observation portee au registre"),
            // MENTION_OBSERVATION.DATE_MENTION et .DIFFUSABLE (Metier/InformationsDossier.cs) :
            // une mention sans date ni regle de diffusion n'est pas publiable.
            // Ils n'apparaissent que si une mention est effectivement redigee.
            new("Date de la mention", "MNTOB_DATE_MENTION", Type: "date", Controle: "date-passee",
                Defaut: DateDemo, VisibleSi: "OBSRC_TEXTE_MENTION=*"),
            new("Diffusable Kbis", "MNTOB_DIFFUSABLE", ChoixPossibles: ["Oui", "Non"], Defaut: "Oui",
                VisibleSi: "OBSRC_TEXTE_MENTION=*"),
            new("Etat du dossier", "DSSRC_ETAT_DOSSIER", Obligatoire: true,
                ChoixPossibles: ["A controler", "Conforme", "En anomalie"], Defaut: "A controler")
        ])
    ];

    // ================= Corps des tuiles =================

    // --- Performance : activite des DOSSIERS, calculee dans MesuresPerf.cs
    //     (traites, en cours, hors delai, rejets, pieces, delai moyen).
    private readonly MesuresPerf Sonde = new();
    private MesurePerf[] Mesures = [];
    private Timer? MinuteurPerf;

    private void RelevePerf()
    {
        Mesures = Sonde.Relever();
    }

    private bool MesureActive(string libelle)
        => !Etat.Mesures.TryGetValue(libelle, out var v) || v;

    private void BasculerMesure(string libelle)
    {
        Etat.Mesures[libelle] = !MesureActive(libelle);
        Etat.Enregistrer();
    }

    private RenderFragment CorpsPerformance => @<div class="rig-perf">
        @foreach (var m in Mesures.Where(m => MesureActive(m.Libelle)))
        {
            <div class="rig-perf__mesure rig-perf__mesure--@m.Statut">
                <div class="rig-perf__entete">
                    <span class="rig-perf__libelle" title="@m.Libelle">@m.Libelle</span>
                    <span class="rig-perf__chiffres">
                        <b class="rig-perf__valeur">@m.Valeur</b>
                        <span class="rig-perf__objectif-texte">@m.ObjectifTexte</span>
                    </span>
                </div>
                <div class="rig-perf__barre" role="img"
                     aria-label="@m.Libelle : @m.Valeur, @m.ObjectifTexte, objectif atteint a @(m.Atteinte) %">
                    <span style="width:@(m.Part)%;background:var(--rig-grad-@m.Statut)"></span>
                    <i class="rig-perf__repere" style="left:@(m.Objectif)%"></i>
                </div>
            </div>
        }
    </div>;

    // --- Alertes : relevees sur les dossiers connus (AlertesGreffe), jamais
    // ecrites en dur, et chacune s'allume ou s'eteint independamment.
    private readonly AlertesGreffe SondeAlertes = new();
    private AlerteGreffe[] Alertes = [];

    /// <summary>Les constats calcules, montres par la tuile « Mes taches du jour ».</summary>
    private AlerteGreffe[] Taches = [];

    /// <summary>Ce que la tuile des taches montre : le plus grave en tete.</summary>
    private AlerteGreffe[] TachesVues
        => Taches.OrderByDescending(a => a.Gravite)
                 .ThenBy(a => a.Titre, StringComparer.OrdinalIgnoreCase)
                 .ToArray();

    /// <summary>Reglages d'affichage de la tuile, conserves dans accueil.json.</summary>
    private ReglagesAlertes ReglagesAlertes => Etat.ReglagesAlertes;

    /// <summary>Ce que la tuile montre reellement : ecoute, gravite, ordre, plafond.</summary>
    private AlerteGreffe[] AlertesVues
        => ReglagesAlertes.Appliquer(Alertes, AlerteActive, CategorieActive);

    /// <summary>Les alertes vues, GROUPEES par categorie, dans l'ordre du
    /// catalogue metier. Une categorie sans alerte visible ne fait pas de
    /// titre vide : elle disparait.</summary>
    private (string Categorie, AlerteGreffe[] Lignes)[] AlertesParCategorie
        => CatalogueAlertes.Categories
            .Select(c => (Categorie: c, Lignes: AlertesVues.Where(a => a.Categorie == c).ToArray()))
            .Where(g => g.Lignes.Length > 0)
            .ToArray();

    /// <summary>Une categorie eteinte masque TOUTES ses alertes. Absente des
    /// reglages = surveillee : une nouvelle categorie livree plus tard se voit
    /// sans que personne ait a l'allumer.</summary>
    private bool CategorieActive(string categorie)
        => !Etat.CategoriesAlertes.TryGetValue(CatalogueAlertes.IdentifiantCategorie(categorie), out var v) || v;

    /// <summary>Une categorie REPLIEE garde son titre et son compte, mais cache
    /// ses lignes. C'est un rangement de lecture, pas un filtre : les alertes
    /// restent comptees dans le statut de la tuile.</summary>
    private bool CategorieRepliee(string categorie)
        => Etat.CategoriesRepliees.TryGetValue(CatalogueAlertes.IdentifiantCategorie(categorie), out var v) && v;

    private void BasculerRepliCategorie(string categorie)
    {
        var id = CatalogueAlertes.IdentifiantCategorie(categorie);
        Etat.CategoriesRepliees[id] = !CategorieRepliee(categorie);
        Etat.Enregistrer();
    }

    private void BasculerCategorie(string categorie)
    {
        var id = CatalogueAlertes.IdentifiantCategorie(categorie);
        Etat.CategoriesAlertes[id] = !(Etat.CategoriesAlertes.TryGetValue(id, out var v) && v);
        Etat.Enregistrer();
    }

    private void BasculerAlerte(string id)
    {
        Etat.Alertes[id] = !(Etat.Alertes.TryGetValue(id, out var v) && v);
        Etat.Enregistrer();
    }

    private bool AlerteActive(string id) => !Etat.Alertes.TryGetValue(id, out var v) || v;

    private void ReglerAlertes(Action<ReglagesAlertes> geste)
    {
        geste(Etat.ReglagesAlertes);
        Etat.Enregistrer();
    }

    // Les trois reglages passent par des methodes nommees : une expression
    // avec des guillemets ne tient pas dans un attribut Razor.
    private void ChoisirNiveauAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.NiveauMini = int.TryParse(e.Value?.ToString(), out var n)
                                             ? Math.Clamp(n, 0, 3) : 0);

    private void ChoisirTriAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.Tri = e.Value?.ToString() is { Length: > 0 } t ? t : "gravite");

    private void ChoisirLimiteAlertes(ChangeEventArgs e)
        => ReglerAlertes(r => r.Limite = int.TryParse(e.Value?.ToString(), out var n)
                                         ? Math.Clamp(n, 0, 20) : 0);

    /// <summary>
    /// Le clic sur une alerte EMMENE : soit sur l'affaire nommee par l'alerte,
    /// soit sur l'ecran du traitement concerne. Sans cela la tuile disait un
    /// probleme sans donner le moyen de le traiter.
    /// </summary>
    private void OuvrirAlerte(AlerteGreffe a)
    {
        // Une alerte de LOT ouvre le TABLEAU des dossiers de cette recette,
        // deja selectionnee : l'alerte dit « ces dossiers-la », l'ecran doit
        // s'ouvrir dessus, pas sur un choix a refaire.
        if (a.Lot is { Length: > 0 } codeLot)
        {
            LotDemande = codeLot;
            OuvrirCode("PROC_TACHES_LOT");
            return;
        }

        // Une alerte task driven ouvre la TACHE, pas seulement l'affaire.
        if (a.Tache is { } t && RecettesTaches.ParCode(t.Code) is { } recette)
        {
            OuvrirTache(recette, t.Dossier);
            return;
        }
        if (a.Affaire is { Length: > 0 } numero) { OuvrirParNumero(numero); return; }
        OuvrirCode(a.Cible);
    }


    // Le corps ne montre QUE les alertes surveillees : les interrupteurs
    // vivent dans les reglages de la tuile (bouton engrenage de son entete),
    // pas dans la lecture courante.
    private RenderFragment CorpsAlertes => @<div>
        @if (AlertesVues.Length == 0)
        {
            <div class="rig-vide">Aucune alerte a afficher. Ouvrir les reglages de la tuile pour elargir.</div>
        }
        @foreach (var groupe in AlertesParCategorie)
        {
        var cat = groupe.Categorie;
        var repliee = CategorieRepliee(cat);
        <div class="rig-alerte-groupe">
            <button class="rig-kicker rig-groupe-tete" type="button"
                    title="@(repliee ? "Deplier" : "Replier") la categorie @cat"
                    aria-expanded="@((!repliee).ToString().ToLowerInvariant())"
                    @onclick="() => BasculerRepliCategorie(cat)">
                <span class="rig-groupe-tete__chevron @(repliee ? "rig-groupe-tete__chevron--replie" : "")">&rsaquo;</span>
                <span>@cat</span>
                @* 17/09/2026 : le compte de la categorie n'est plus le nombre de
                   LIGNES mais la CHARGE -- la somme des elements a traiter de
                   ses lignes. Une categorie de 3 lignes qui cache 60 dossiers
                   ne doit pas s'annoncer « 3 ». *@
                <span class="rig-groupe-tete__compte">@groupe.Lignes.Sum(x => x.Nombre)</span>
            </button>
        @foreach (var item in repliee ? [] : groupe.Lignes)
        {
            var a = item;
            <button class="rig-alerte rig-alerte--lien" type="button"
                    title="Aller vers @a.LibelleCible"
                    @onclick="() => OuvrirAlerte(a)">
                @* 17/09/2026 : le COMBIEN remplace la barre de couleur. Le
                   niveau d'importance n'est pas perdu : il colore le chiffre. *@
                <span class="rig-alerte__compte rig-alerte__compte--@PanneauMetier.Palier(a.Nombre)">@a.Nombre</span>
                <span class="rig-alerte__corps">
                    <span class="rig-alerte__titre">@a.Titre</span>
                    @if (ReglagesAlertes.AfficherDetail)
                    {
                        <br />
                        <span class="rig-alerte__detail">@a.Detail</span>
                    }
                </span>
                <span class="rig-alerte__vers">@a.LibelleCible &rsaquo;</span>
            </button>
        }
        </div>
        }
    </div>;

    // La tuile des taches : les constats calcules sur les dossiers. Le clic
    // passe par le MEME chemin que les alertes (OuvrirAlerte) : une ligne
    // task driven ouvre la tache et replie la vue sur ce qu'il faut editer.
    private RenderFragment CorpsTaches => @<div>
        @if (TachesVues.Length == 0)
        {
            <div class="rig-vide">Aucune tache en attente sur les dossiers connus.</div>
        }
        @foreach (var item in TachesVues)
        {
            var a = item;
            <button class="rig-alerte rig-alerte--lien" type="button"
                    title="Aller vers @a.LibelleCible"
                    @onclick="() => OuvrirAlerte(a)">
                <span class="rig-alerte__compte rig-alerte__compte--@PanneauMetier.Palier(a.Nombre)">@a.Nombre</span>
                <span class="rig-alerte__corps">
                    <span class="rig-alerte__titre">@a.Titre</span><br />
                    <span class="rig-alerte__detail">@a.Detail</span>
                </span>
                <span class="rig-alerte__vers">@a.LibelleCible &rsaquo;</span>
            </button>
        }
    </div>;

    // ================= Actualites ==================
    // Des messages REDIGES, lus dans un fichier PARTAGE. Le reseau peut etre
    // coupe : on affiche alors le dernier bon contenu ET on l'ECRIT sous la
    // tuile -- sans cette ligne, l'utilisateur croirait lire l'actualite du
    // jour alors qu'il lit celle d'avant-hier.
    private readonly DepotActualites Actualites = new();
    private LectureActualites ActualitesVues = new([], SourceActualites.Aucune, null, string.Empty);
    private Timer? MinuteurActualites;

    private string EtatActualites => ActualitesVues.Etat;

    /// <summary>
    /// Releve les actualites. Au TOUT PREMIER demarrage, aucun fichier partage
    /// n'existe encore : on y SEME les deux actualites dictees par le metier
    /// (fraude CNG, INPI HS) plutot que d'afficher une tuile vide. Sans cela,
    /// le widget ne montre rien tant que personne n'a redige, et personne ne
    /// redige tant que le widget ne montre rien.
    /// </summary>
    private void ReleveActualites()
    {
        var maintenant = DateTime.Now;
        var lu = Actualites.Lire(maintenant);
        if (lu.Source == SourceActualites.Aucune
            && Actualites.Ecrire(DepotActualites.Exemples(maintenant)))
        {
            lu = Actualites.Lire(maintenant);
        }
        ActualitesVues = lu;
    }

    private RenderFragment CorpsActualites => @<div>
        @if (ActualitesVues.Actifs.Length == 0)
        {
            <div class="rig-vide">Aucune actualite en cours.</div>
        }
        @foreach (var item in ActualitesVues.Actifs)
        {
            var b = item;
            <div class="rig-alerte">
                <span class="rig-filet-v rig-filet-v--@b.Fiche.Filet"></span>
                <span class="rig-alerte__corps">
                    <span class="rig-actualite__type rig-actualite__type--@b.Fiche.Filet">@b.Fiche.Libelle</span><span class="rig-alerte__titre">@b.Titre</span><br />
                    <span class="rig-alerte__detail">@b.Message</span><br />
                    <span class="rig-alerte__detail">@b.Auteur — @b.Horodatage</span>
                </span>
            </div>
        }
        <button class="rig-alerte rig-alerte--lien" type="button"
                title="Ouvrir la redaction des actualites"
                @onclick="@(() => OuvrirCode("PROC_ACTUALITES"))">
            <span class="rig-alerte__corps">
                <span class="rig-alerte__detail">@EtatActualites</span>
            </span>
            <span class="rig-alerte__vers">Rediger &rsaquo;</span>
        </button>
    </div>;

    // ================= Reglages d'une tuile =================
    // Un seul panneau ouvert a la fois, dans le corps de la tuile concernee.
    private string? ReglagesTuile;

    private void BasculerReglages(string id)
        => ReglagesTuile = ReglagesTuile == id ? null : id;

    // Les reglages d'une tuile portent sur SON contenu (quelles alertes,
    // quelles mesures). Retirer la tuile de l'accueil n'est pas un reglage
    // de tuile : cela se fait dans les reglages generaux, dans la barre du
    // haut, seul endroit d'ou l'on peut aussi la faire revenir.
    // ============ LES WIDGETS METIER (un par categorie de la Feuil2) ============

    /// <summary>La categorie du catalogue portee par une tuile « metier-... ».
    /// L'identifiant de tuile est stable et sans accent ; la categorie, elle,
    /// vient du catalogue metier.</summary>
    private static string MetierCategorie(string idTuile) => idTuile switch
    {
        "metier-arrivees"      => CatalogueAlertes.Arrivees,
        "metier-formalites"    => CatalogueAlertes.Formalites,
        "metier-notifications" => CatalogueAlertes.Notifications,
        "metier-das"           => CatalogueAlertes.Das,
        "metier-dca"           => CatalogueAlertes.Dca,
        "metier-corrections"   => CatalogueAlertes.Corrections,
        "metier-surveillances" => CatalogueAlertes.Surveillances,
        _                      => CatalogueAlertes.Divers
    };

    /// <summary>Les alertes de la categorie, dans l'ordre du catalogue metier.
    /// Volontairement NON filtrees par les reglages de la tuile « A traiter » :
    /// un widget de categorie montre SA categorie en entier.</summary>
    private AlerteGreffe[] MetierLignes(string categorie)
        => Alertes.Where(a => a.Categorie == categorie).ToArray();

    /// <summary>Ce que chaque widget metier a d'ouvert a droite, et ce qu'on a
    /// tape dans sa recherche. Une entree vide = panneau de droite ferme.</summary>
    private readonly Dictionary<string, string> MetierChoix = new();
    private readonly Dictionary<string, string> MetierFiltre = new();

    /// <summary>Les widgets metier DEPLOYES. La maquette du 17/09/2026 porte un
    /// bouton de deploiement dans l'en-tete du panneau de gauche : la tuile fait
    /// 6 colonnes sur 2 lignes, donc le tableau de droite n'y montre que quelques
    /// demandes. Deployer sort le widget de la grille pour lire la liste en grand.</summary>
    private readonly HashSet<string> MetierDeploye = new();

    private bool MetierEstDeploye(string idTuile) => MetierDeploye.Contains(idTuile);

    private void BasculerDeploiementMetier(string idTuile)
    {
        if (!MetierDeploye.Remove(idTuile)) MetierDeploye.Add(idTuile);
    }

    private AlerteGreffe? MetierAlerte(string idTuile, AlerteGreffe[] lignes)
    {
        if (lignes.Length == 0) return null;
        return MetierChoix.TryGetValue(idTuile, out var id)
            ? lignes.FirstOrDefault(a => a.Id == id) ?? lignes[0]
            : lignes[0];
    }

    /// <summary>
    /// Le clic sur une alerte du panneau de gauche. REPLIE, le widget n'a pas
    /// de place pour la liste : il se DEPLOIE (demande du 17/09/2026), et la
    /// liste montree est celle de l'alerte qu'on vient de choisir. Sans cela le
    /// clic ne produisait rien de visible -- il ne faisait que preparer un
    /// panneau qui n'existait pas encore.
    /// </summary>
    private void ChoisirMetier(string idTuile, string idAlerte)
    {
        MetierChoix[idTuile] = idAlerte;
        MetierMenu = null;
        if (!MetierEstDeploye(idTuile)) MetierDeploye.Add(idTuile);
    }

    private void FermerMetier(string idTuile)
    {
        MetierChoix[idTuile] = "";
    }

    /// <summary>
    /// La croix du panneau de droite. DEPLOYE, elle REDUIT le widget -- elle le
    /// remet dans la grille (demande du 17/09/2026) : retirer le tableau sans
    /// replier aurait laisse un widget plein ecran a moitie vide. Replie, il n'y
    /// a rien a reduire : elle ferme le panneau.
    /// </summary>
    private void ReduireMetier(string idTuile)
    {
        MetierMenu = null;
        if (MetierEstDeploye(idTuile)) { BasculerDeploiementMetier(idTuile); return; }
        FermerMetier(idTuile);
    }

    /// <summary>Le widget dont le menu « trois points » est ouvert. UN SEUL a la
    /// fois : deux menus ouverts sur deux widgets voisins se recouvriraient.</summary>
    private string? MetierMenu;

    private bool MetierMenuOuvert(string idTuile) => MetierMenu == idTuile;

    private void BasculerMenuMetier(string idTuile)
        => MetierMenu = MetierMenu == idTuile ? null : idTuile;

    /// <summary>« Ouvrir le dossier » du menu : le MEME chemin que le clic sur
    /// une alerte, et le menu se referme -- sinon il resterait ouvert par-dessus
    /// l'ecran qui vient de s'ouvrir.</summary>
    private void OuvrirDepuisMenuMetier(string idTuile, AlerteGreffe? alerte)
    {
        MetierMenu = null;
        if (alerte is not null) OuvrirAlerte(alerte);
    }

    /// <summary>« Rafraichir les compteurs » : relit les alertes et les mesures
    /// a la source, comme au demarrage. Le menu se referme pour que le nouveau
    /// compte soit visible.</summary>
    private void RafraichirMetier(string idTuile)
    {
        MetierMenu = null;
        Alertes = AlertesOuvertes();
        Taches = TachesOuvertes();
        RelevePerf();
    }

    /// <summary>« Parametrer le widget » : ouvre le panneau de reglages de la
    /// tuile, celui de l'engrenage de son en-tete.</summary>
    private void ParametrerMetier(string idTuile)
    {
        MetierMenu = null;
        BasculerReglages(idTuile);
    }

    private void FiltrerMetier(string idTuile, ChangeEventArgs e)
    {
        MetierFiltre[idTuile] = e.Value?.ToString() ?? "";
    }

    private string MetierFiltreDe(string idTuile)
        => MetierFiltre.TryGetValue(idTuile, out var f) ? f : "";

    /// <summary>Les lignes du panneau de droite, filtrees par la recherche du
    /// widget (numero de chrono ou societe).</summary>
    private DemandeAlerte[] MetierDemandes(string idTuile, AlerteGreffe alerte)
    {
        var filtre = MetierFiltreDe(idTuile).Trim();
        var lignes = PanneauMetier.Lignes(alerte);
        return filtre.Length == 0
            ? lignes
            : lignes.Where(l => l.Chrono.Contains(filtre, StringComparison.OrdinalIgnoreCase)
                             || l.Societe.Contains(filtre, StringComparison.OrdinalIgnoreCase)).ToArray();
    }

    /// <summary>
    /// Le corps d'un widget metier : deux panneaux, comme la maquette metier du
    /// 17/09/2026. A GAUCHE la recherche, les gestes de la categorie, trois
    /// compteurs et la liste des alertes ; A DROITE les demandes de l'alerte
    /// selectionnee. Les BOUTONS DE GESTE sont de la maquette : ils nomment le
    /// geste, ils ne l'executent pas -- ils sont desactives, pas trompeurs.
    /// </summary>
    private RenderFragment CorpsMetier(DefinitionTuile def) => @<div class="rig-metier @(MetierEstDeploye(def.Id) ? "rig-metier--deploye" : "")">
        @{
            var cat = MetierCategorie(def.Id);
            var lignes = MetierLignes(cat);
            var choisie = MetierAlerte(def.Id, lignes);
            var ferme = MetierChoix.TryGetValue(def.Id, out var choix) && choix.Length == 0;
            // Demande du 17/09/2026 : replie, le widget ne montre QUE sa colonne
            // de gauche -- c'est la lecture courante. La liste des demandes est
            // une consultation, elle n'apparait qu'une fois le widget DEPLOYE.
            var ouverte = (ferme || !MetierEstDeploye(def.Id)) ? null : choisie;
            var filtre = MetierFiltreDe(def.Id);
        }
        <div class="rig-metier__gauche">
            <div class="rig-metier__tete">
                <span class="rig-metier__registre">@PanneauMetier.Registre(cat)</span>
                <span class="rig-metier__titre">@PanneauMetier.Titre(cat)</span>
                @{ var charge = lignes.Sum(a => a.Nombre); }
                <span class="rig-metier__charge rig-metier__charge--@PanneauMetier.Palier(charge)"
                      title="@charge element(s) a traiter dans cette categorie">@charge</span>
                <button class="rig-metier__deployer" type="button"
                        title="@(MetierEstDeploye(def.Id) ? "Replier le widget" : "Deployer pour voir la liste en grand")"
                        aria-pressed="@(MetierEstDeploye(def.Id) ? "true" : "false")"
                        @onclick="() => BasculerDeploiementMetier(def.Id)"
                        @onmousedown:stopPropagation="true">@(MetierEstDeploye(def.Id) ? "⤡" : "⛶")</button>
                @* Le menu des GESTES de la categorie (maquette du 17/09/2026) :
                   l'en-tete ne peut pas porter six boutons, et les gestes rares
                   (radier, parametrer) n'ont pas a occuper la place des trois
                   gestes courants. *@
                <button class="rig-metier__menu-bouton @(MetierMenuOuvert(def.Id) ? "rig-metier__menu-bouton--ouvert" : "")"
                        type="button" title="Autres gestes de ce widget"
                        aria-expanded="@(MetierMenuOuvert(def.Id) ? "true" : "false")"
                        @onclick="() => BasculerMenuMetier(def.Id)"
                        @onmousedown:stopPropagation="true">&#8942;</button>
            </div>
            @if (MetierMenuOuvert(def.Id))
            {
                <div class="rig-metier__menu" @onmousedown:stopPropagation="true">
                    @{ var gestes = PanneauMetier.ActionsDe(cat); }
                    @if (gestes.Length > 0)
                    {
                        <button class="rig-metier__menu-ligne rig-metier__menu-ligne--phare"
                                type="button" disabled
                                title="Maquette : ce geste n'est pas encore branché">
                            <span class="rig-metier__menu-glyphe">+</span>@gestes[0]
                        </button>
                    }
                    <div class="rig-metier__menu-filet"></div>
                    <button class="rig-metier__menu-ligne" type="button"
                            disabled="@(ouverte is null)"
                            title="@(ouverte is null ? "Choisir une alerte d'abord" : "Aller vers " + ouverte.LibelleCible)"
                            @onclick="() => OuvrirDepuisMenuMetier(def.Id, ouverte)">
                        <span class="rig-metier__menu-glyphe">&#8599;</span>Ouvrir le dossier
                    </button>
                    @foreach (var geste in gestes.Skip(1))
                    {
                        <button class="rig-metier__menu-ligne" type="button" disabled
                                title="Maquette : ce geste n'est pas encore branché">
                            <span class="rig-metier__menu-glyphe">&#9633;</span>@geste
                        </button>
                    }
                    <div class="rig-metier__menu-filet"></div>
                    <button class="rig-metier__menu-ligne" type="button"
                            title="Relire les alertes et les compteurs"
                            @onclick="() => RafraichirMetier(def.Id)">
                        <span class="rig-metier__menu-glyphe">&#8635;</span>Rafraichir les compteurs
                    </button>
                    <button class="rig-metier__menu-ligne" type="button"
                            title="Ouvrir les reglages de cette tuile"
                            @onclick="() => ParametrerMetier(def.Id)">
                        <span class="rig-metier__menu-glyphe">&#9881;</span>Parametrer le widget
                    </button>
                </div>
            }
            <div class="rig-metier__recherche">
                <span class="rig-metier__loupe">&#128269;</span>
                <input class="rig-metier__saisie" placeholder="N° de dossier ou société"
                       value="@filtre"
                       @oninput="e => FiltrerMetier(def.Id, e)"
                       @onmousedown:stopPropagation="true" />
                @* Etiquette de la maquette : elle dit ce que la recherche
                   CIBLE, elle est donc toujours lisible -- pas seulement une
                   fois qu'on a tape. *@
                <span class="rig-metier__puce @(filtre.Trim().Length > 0 ? "rig-metier__puce--active" : "")">dossier ciblé</span>
            </div>
            <div class="rig-metier__gestes">
                @foreach (var geste in PanneauMetier.ActionsDe(cat))
                {
                    <button class="rig-metier__geste" type="button" disabled
                            title="Maquette : ce geste n'est pas encore branché">@geste</button>
                }
            </div>
            <div class="rig-metier__compteurs">
                <div class="rig-metier__compteur">
                    <span class="rig-metier__chiffre">@lignes.Sum(a => a.Nombre)</span>
                    <span class="rig-metier__legende">à traiter</span>
                </div>
                <div class="rig-metier__compteur">
                    <span class="rig-metier__chiffre">@PanneauMetier.Urgents(lignes)</span>
                    <span class="rig-metier__legende">urgents</span>
                </div>
                <div class="rig-metier__compteur">
                    <span class="rig-metier__chiffre">@PanneauMetier.Demat(lignes)</span>
                    <span class="rig-metier__legende">démat.</span>
                </div>
            </div>
            <div class="rig-kicker">Alertes</div>
            @if (lignes.Length == 0)
            {
                <div class="rig-vide">Aucune alerte declaree dans cette categorie.</div>
            }
            @foreach (var item in lignes)
            {
                var a = item;
                <button class="rig-metier__ligne @(ouverte is not null && ouverte.Id == a.Id ? "rig-metier__ligne--active" : "")"
                        type="button"
                        title="@(MetierEstDeploye(def.Id) ? "Voir les demandes de : " + a.Titre : "Agrandir le widget sur les demandes de : " + a.Titre)"
                        @onclick="() => ChoisirMetier(def.Id, a.Id)"
                        @onmousedown:stopPropagation="true">
                    <span class="rig-alerte__compte rig-alerte__compte--@PanneauMetier.Palier(a.Nombre)">@a.Nombre</span>
                    <span class="rig-metier__ligne-titre">@a.Titre</span>
                </button>
            }
        </div>
        @if (MetierEstDeploye(def.Id))
        {
        @PanneauDemandes(def.Id, ouverte)
        }
    </div>;

    /// <summary>Le panneau de droite : les demandes de l'alerte ouverte. PARTAGE
    /// par les widgets metier et « A traiter BIS » -- un seul tableau.</summary>
    private RenderFragment PanneauDemandes(string idTuile, AlerteGreffe? ouverte) => @<text>
        <div class="rig-metier__droite">
            @if (ouverte is null)
            {
                <div class="rig-vide">Choisir une alerte à gauche pour voir ses demandes.</div>
            }
            else
            {
                var demandes = MetierDemandes(idTuile, ouverte);
                <div class="rig-metier__droite-tete">
                    <span class="rig-alerte__compte rig-alerte__compte--@PanneauMetier.Palier(ouverte.Nombre)">@ouverte.Nombre</span>
                    <span class="rig-metier__droite-titre">@ouverte.Titre</span>
                    <span class="rig-metier__droite-compte">@demandes.Length demande(s)</span>
                    <button class="rig-metier__ouvrir" type="button"
                            title="Aller vers @ouverte.LibelleCible"
                            @onclick="() => OuvrirAlerte(ouverte)"
                            @onmousedown:stopPropagation="true">Ouvrir &rsaquo;</button>
                    <button class="rig-metier__fermer" type="button"
                            title="@(MetierEstDeploye(idTuile) ? "Reduire le widget" : "Fermer le panneau")"
                            @onclick="() => ReduireMetier(idTuile)"
                            @onmousedown:stopPropagation="true">&times;</button>
                </div>
                @if (demandes.Length == 0)
                {
                    <div class="rig-vide">Aucune demande ne correspond à la recherche.</div>
                }
                else
                {
                    <table class="rig-metier__table">
                        <thead>
                            <tr>
                                <th>N° chrono</th><th>Société</th><th>SIREN</th><th>Type</th>
                                <th>Reçu le</th><th>Anc.</th><th>État</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in demandes)
                            {
                                <tr>
                                    <td><button class="rig-metier__chrono" type="button"
                                                title="Ouvrir le dossier @d.Chrono"
                                                @onclick="() => OuvrirParNumero(d.Chrono)"
                                                @onmousedown:stopPropagation="true">@d.Chrono</button></td>
                                    <td>@d.Societe</td>
                                    <td class="rig-metier__siren">@d.Siren</td>
                                    <td>@d.Type</td>
                                    <td>@d.RecuLe</td>
                                    <td>@d.Anciennete j</td>
                                    <td>@d.Etat</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </text>;

    /// <summary>« A traiter BIS » : l'arbre de toutes les categories (comme
    /// « A traiter ») a gauche ; le clic sur une alerte la SELECTIONNE et montre
    /// ses demandes a droite, au lieu d'ouvrir l'ecran cible.</summary>
    private RenderFragment CorpsAlertesBis => @<div class="rig-metier rig-metier--bis">
        @{
            const string id = "alertes-bis";
            var vues = AlertesVues;
            var choisie = MetierAlerte(id, vues);
            var ouverte = MetierChoix.TryGetValue(id, out var choix) && choix.Length == 0 ? null : choisie;
        }
        <div class="rig-metier__gauche">
            @if (vues.Length == 0)
            {
                <div class="rig-vide">Aucune alerte a afficher. Ouvrir les reglages de « A traiter » pour elargir.</div>
            }
            @foreach (var groupe in AlertesParCategorie)
            {
                var cat = groupe.Categorie;
                var repliee = CategorieRepliee(cat);
                <div class="rig-alerte-groupe">
                    <button class="rig-kicker rig-groupe-tete" type="button"
                            title="@(repliee ? "Deplier" : "Replier") la categorie @cat"
                            aria-expanded="@((!repliee).ToString().ToLowerInvariant())"
                            @onclick="() => BasculerRepliCategorie(cat)"
                            @onmousedown:stopPropagation="true">
                        <span class="rig-groupe-tete__chevron @(repliee ? "rig-groupe-tete__chevron--replie" : "")">&rsaquo;</span>
                        <span>@cat</span>
                        <span class="rig-groupe-tete__compte">@groupe.Lignes.Sum(x => x.Nombre)</span>
                    </button>
                    @foreach (var item in repliee ? [] : groupe.Lignes)
                    {
                        var a = item;
                        <button class="rig-metier__ligne @(ouverte is not null && ouverte.Id == a.Id ? "rig-metier__ligne--active" : "")"
                                type="button" title="Voir les demandes de : @a.Titre"
                                @onclick="() => MetierChoix[id] = a.Id"
                                @onmousedown:stopPropagation="true">
                            <span class="rig-alerte__compte rig-alerte__compte--@PanneauMetier.Palier(a.Nombre)">@a.Nombre</span>
                            <span class="rig-metier__ligne-titre">@a.Titre</span>
                        </button>
                    }
                </div>
            }
        </div>
        @PanneauDemandes(id, ouverte)
    </div>;

    private RenderFragment ReglagesDe(DefinitionTuile def) => @<div class="rig-reglages">
        @switch (def.Id)
        {
            case "alertes":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Categories surveillees</div>
                @foreach (var c in CatalogueAlertes.Categories)
                {
                    var cat = c;
                    var vivante = CategorieActive(cat);
                    <button class="rig-bascule @(vivante ? "rig-bascule--actif" : "")"
                            title="Afficher ou masquer toutes les alertes de @cat"
                            @onclick="() => BasculerCategorie(cat)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@cat</span>
                    </button>
                }

                <div class="rig-kicker" style="margin:var(--rig-esp-3) 0 var(--rig-esp-2)">Alertes surveillees</div>
                @foreach (var a in Alertes.Where(x => CategorieActive(x.Categorie)))
                {
                    var active = AlerteActive(a.Id);
                    <button class="rig-bascule @(active ? "rig-bascule--actif" : "")"
                            title="Mene vers @a.LibelleCible"
                            @onclick="() => BasculerAlerte(a.Id)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@a.Titre</span>
                    </button>
                }

                <div class="rig-kicker" style="margin:var(--rig-esp-3) 0 var(--rig-esp-2)">Ce que la tuile affiche</div>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">A partir de</span>
                    <select class="rig-saisie-champ__saisie"
                            value="@ReglagesAlertes.NiveauMini"
                            @onchange="ChoisirNiveauAlertes">
                        <option value="0">Tout, meme ce qui va bien</option>
                        <option value="1">A surveiller et au-dela</option>
                        <option value="2">A traiter et au-dela</option>
                        <option value="3">Hors delai seulement</option>
                    </select>
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Ordre</span>
                    <select class="rig-saisie-champ__saisie"
                            value="@ReglagesAlertes.Tri"
                            @onchange="ChoisirTriAlertes">
                        <option value="gravite">Le plus grave en tete</option>
                        <option value="titre">Par libelle</option>
                    </select>
                </label>
                <label class="rig-saisie-champ">
                    <span class="rig-saisie-champ__libelle">Lignes au plus (0 = toutes)</span>
                    <input class="rig-saisie-champ__saisie" type="number" min="0" max="20"
                           value="@ReglagesAlertes.Limite"
                           @onchange="ChoisirLimiteAlertes" />
                </label>
                <button class="rig-bascule @(ReglagesAlertes.AfficherDetail ? "rig-bascule--actif" : "")"
                        @onclick="() => ReglerAlertes(r => r.AfficherDetail = !r.AfficherDetail)">
                    <span class="rig-bascule__temoin"></span>
                    <span>Afficher le detail sous chaque alerte</span>
                </button>
                break;

            case "performance":
                <div class="rig-kicker" style="margin-bottom:var(--rig-esp-2)">Mesures affichees</div>
                @foreach (var m in Mesures)
                {
                    var vue = MesureActive(m.Libelle);
                    <button class="rig-bascule @(vue ? "rig-bascule--actif" : "")"
                            @onclick="() => BasculerMesure(m.Libelle)">
                        <span class="rig-bascule__temoin"></span>
                        <span>@m.Libelle</span>
                    </button>
                }
                break;

            default:
                <div class="rig-vide">
                    Cette tuile n'a pas de reglage propre.
                    Pour la retirer de l'accueil, ouvrir les reglages en haut a droite.
                </div>
                break;
        }
    </div>;

    // --- Le reste de l'accueil, inchange, simplement mis en tuiles
    private record Demande(string Numero, string Objet, string Delai, string Etat,
                           string Statut, string? VerrouillePar = null);
    private readonly Demande[] File =
    [
        new("004176", "Modification - SCI DU PARC",     "J+9", "hors delai",     "alerte"),
        new("004182", "Immatriculation - AMIENS BILLARDS",   "J+4", "en cours",       "action"),
        new("004179", "Radiation - MARTIN EURL",        "J+1", "attente pieces", "attente"),
        new("004168", "Immatriculation - BATIPRO SARL", "",    "",               "neutre", "M. DURAND")
    ];

    /// <summary>SIREN pose dans l'ecran d'ouverture quand on y arrive depuis une
    /// recherche restee vide.</summary>
    private string? SirenAImmatriculer;

    /// <summary>Change avec le SIREN : l'ecran est RECONSTRUIT, sinon Blazor
    /// reutiliserait l'instance et le numero ne serait pas repose.</summary>
    private object CleOuverture => SirenAImmatriculer ?? "ouverture-vierge";

    /// <summary>La recherche n'a rien trouve : on bascule sur l'ouverture d'un
    /// dossier, en emportant le SIREN deja saisi.</summary>
    private void OuvrirUnDossierPour(string siren)
    {
        SirenAImmatriculer = string.IsNullOrWhiteSpace(siren) ? null : siren.Trim();
        OuvrirProc(new Proc("OUVERTURE_DOSSIER", "Ouverture d'un dossier RCS"));
    }

    /// <summary>
    /// Une nouveaute LIVREE. <paramref name="Module"/> est l'ecran ou elle vit,
    /// <paramref name="Pictogramme"/> le code de l'icone (voir IconeNouveaute),
    /// reconnue avant meme d'etre lue, et
    /// <paramref name="Action"/> le debut de phrase A L'IMPERATIF : on annonce ce
    /// que l'utilisateur PEUT FAIRE, pas ce qui a ete code.
    /// </summary>
    private record Nouveaute(string Module, string Pictogramme, string Teinte,
        string Action, string Suite, string Detail);

    /// <summary>
    /// Les nouveautes de la version en cours, la plus utile en tete. Liste
    /// ECRITE A LA MAIN a chaque livraison : il n'y a pas de source a interroger,
    /// et une nouveaute se redige, elle ne se deduit pas d'un journal de commits.
    /// </summary>
    private readonly Nouveaute[] Nouveautes =
    [
        new("MENU",     "boussole",     "vert",   "Cherchez par geste", "154 procedures",
            "Le menu ne liste plus des modules mais des GESTES : tapez « immatriculer », "
            + "« radier », « nantir » et la procedure remonte directement, sans passer par "
            + "l'arborescence. Les 154 procedures du greffe sont couvertes."),
        new("PROFIL",   "profil",       "bleu",   "Votre metier seul",  "le reste s'efface",
            "Votre profil metier (greffier, formaliste, comptable) masque les ecrans qui ne "
            + "vous concernent pas. Rien n'est supprime : le profil se change a tout moment "
            + "depuis votre nom, en haut a droite."),
        new("ACCUEIL",  "megaphone",    "or",     "Publiez une actualite", "vu par le greffe",
            "Le widget Actualites permet d'ecrire une annonce visible par tout le greffe sur "
            + "son accueil. Utile pour une consigne du jour ou une indisponibilite : elle "
            + "s'affiche jusqu'a sa date de fin."),
        new("AFFICHAGE","clair-sombre", "violet", "Clair ou sombre",    "choix retenu",
            "Le theme clair et le theme sombre se basculent depuis l'entete. Le choix est "
            + "retenu poste par poste et reapplique au prochain demarrage.")
    ];

    // --- Activite des utilisateurs : le journal des gestes de l'equipe, lu
    // dans JournalActions. Le filtre vit ICI et non dans accueil.json : c'est
    // une question du moment (« qu'a fait Claire ce matin ? »), pas un reglage
    // qu'on veut retrouver demain matin.
    private string FiltreActivite = string.Empty;

    private ActionAgent[] ActivitesVues => JournalActions.De(FiltreActivite);

    private RenderFragment CorpsActivite => @<div class="rig-activite">
        <div class="rig-activite__barre">
            <select class="rig-activite__filtre" aria-label="Filtrer par utilisateur"
                    @bind="FiltreActivite" @onmousedown:stopPropagation="true">
                <option value="">Tous les utilisateurs</option>
                @foreach (var login in JournalActions.Agents)
                {
                    <option value="@login">@JeuDemo.Compte(login).Nom (@login)</option>
                }
            </select>
            <span class="rig-activite__total">@ActivitesVues.Length geste(s)</span>
        </div>
        <div class="rig-activite__comptes">
            @foreach (var c in JournalActions.ParAgentAujourdhui())
            {
                <span class="rig-activite__compte" title="@c.Agent : @c.Nombre geste(s) aujourd'hui">
                    <b>@c.Nombre</b> @c.Agent
                </span>
            }
        </div>
        <ul class="rig-activite__liste">
            @foreach (var a in ActivitesVues)
            {
                <li class="rig-activite__ligne">
                    <span class="rig-filet-v rig-filet-v--action"></span>
                    <span class="rig-activite__texte"><b>@a.Agent</b> @a.Verbe @a.Objet</span>
                    <span class="rig-activite__quand">@a.Depuis</span>
                </li>
            }
        </ul>
    </div>;

    // Le module de la nouveaute DEPLIEE, ou null quand tout est replie. Un seul
    // panneau ouvert a la fois : la tuile est basse, deux details ouverts la
    // feraient defiler au lieu de se lire d'un coup d'oeil.
    private string? NouveauteOuverte;

    private void BasculerNouveaute(string module)
        => NouveauteOuverte = NouveauteOuverte == module ? null : module;

    private RenderFragment CorpsNouveautes => @<div class="rig-nouv">
        @foreach (var n in Nouveautes)
        {
            var ouverte = NouveauteOuverte == n.Module;
            <button type="button"
                    class="rig-nouv__ligne @(ouverte ? "rig-nouv__ligne--ouverte" : "")"
                    aria-expanded="@(ouverte ? "true" : "false")"
                    title="@(ouverte ? "Replier" : "Voir le detail")"
                    @onclick="() => BasculerNouveaute(n.Module)"
                    @onmousedown:stopPropagation="true">
                <span class="rig-nouv__module rig-nouv__module--@n.Teinte">
                    <IconeNouveaute Nom="@n.Pictogramme" />@n.Module
                </span>
                <span class="rig-nouv__texte"><b>@n.Action</b> @n.Suite</span>
                <span class="rig-nouv__chevron">@(ouverte ? "▾" : "▸")</span>
            </button>
            @if (ouverte)
            {
                <p class="rig-nouv__detail rig-nouv__detail--@n.Teinte">@n.Detail</p>
            }
        }
    </div>;
}
