    /// <summary>
    /// Le theme ne peut pas rester porte par ce seul composant : le fond de la
    /// page hote (html/body) et le fond de la fenetre WPF, qui borde le
    /// WebView de 6 px, resteraient sombres et cerneraient le mode clair d'un
    /// cadre noir. On propage donc la teinte aux deux hors-Blazor.
    /// </summary>
    private async Task BasculerTheme()
    {
        ThemeSombre = !ThemeSombre;
        await AppliquerTheme();
    }

    private async Task AppliquerTheme()
    {
        Fenetre.AppliquerFond(ThemeSombre);
        if (Module is null) return;
        try { await Module.InvokeVoidAsync("appliquerTheme", ThemeSombre ? "sombre" : "clair"); }
        catch (JSException) { }
    }

