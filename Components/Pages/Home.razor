    /// <summary>N° d'affaire pose dans la vue de recherche a son ouverture.</summary>
    private string? NoAffaireDemande;

    /// <summary>
    /// Change quand le n° demande change : l'ecran est alors RECONSTRUIT,
    /// sinon Blazor reutiliserait l'instance et le critere ne serait pas
    /// repose (OnInitialized ne rejoue pas).
    /// </summary>
    private object CleRechAffaire => NoAffaireDemande ?? "toutes-les-affaires";

    /// <summary>SIREN pose dans l'ecran d'ouverture quand on y arrive depuis une
    /// recherche restee vide.</summary>
    private string? SirenAImmatriculer;

    /// <summary>Change avec le SIREN : l'ecran est RECONSTRUIT, sinon Blazor
    /// reutiliserait l'instance et le numero ne serait pas repose.</summary>
    private object CleOuverture => SirenAImmatriculer ?? "ouverture-vierge";

    /// <summary>La recherche n'a rien trouve : on bascule sur l'ouverture d'un
    /// dossier, en emportant le SIREN deja saisi.</summary>
    private void OuvrirUnDossierPour(string siren)
    {
        SirenAImmatriculer = string.IsNullOrWhiteSpace(siren) ? null : siren.Trim();
        OuvrirProc(new Proc("OUVERTURE_DOSSIER", "Ouverture d'un dossier RCS"));
    }

    /// <summary>Le bouton d'entete : la vue de recherche, SANS aucun critere.</summary>
    private void VoirToutesLesAffaires()
    {
        NoAffaireDemande = null;
        OuvrirProc(new Proc("PROC_RECHAFF", "Recherche d'affaires"));
    }

    private RenderFragment CorpsFile => @<div>
        @foreach (var d in File)
        {
            var valide = EstValide(d.Numero);
            <div class="rig-ligne @(d.VerrouillePar is not null ? "rig-ligne--verrouille" : "") @(valide ? "rig-ligne--valide" : "")"
                 @onclick="() => OuvrirParNumero(d.Numero)"
                 style="cursor:pointer">
                <span class="rig-filet-v rig-filet-v--@(valide ? "ok" : d.Statut)"></span>
                <span>
                    <span class="rig-ligne__id">@d.Numero</span><br />
                    <span class="rig-ligne__objet">@d.Objet</span>
                </span>
                <span class="rig-ligne__droite">
                    @if (valide)
                    {
                        <span class="rig-ligne__valide">valide</span>
                    }
                    else if (d.VerrouillePar is not null)
                    {
                        <span style="font-size:11px;color:var(--rig-texte-3)">
                            ouvert par<br /><b>@d.VerrouillePar</b>
                        </span>
                    }
                    else
                    {
                        <span class="@(d.Statut == "alerte" ? "rig-ligne__delai--alerte" : "")">@d.Delai</span>
                        <br />
                        <span style="font-size:11px;color:var(--rig-texte-3)">@d.Etat</span>
