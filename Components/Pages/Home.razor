    private void BasculerAlerte(string id)
    {
        Etat.Alertes[id] = !(Etat.Alertes.TryGetValue(id, out var v) && v);
        Etat.Enregistrer();
    }

    private bool AlerteActive(string id) => !Etat.Alertes.TryGetValue(id, out var v) || v;

    // Le corps ne montre QUE les alertes surveillees : les interrupteurs
    // vivent dans les reglages de la tuile (bouton engrenage de son entete),
    // pas dans la lecture courante.
    private RenderFragment CorpsAlertes => @<div>
        @if (!Alertes.Any(a => AlerteActive(a.Id)))
        {
            <div class="rig-vide">Aucune alerte surveillee. Ouvrir les reglages de la tuile pour en reactiver.</div>
        }
        @foreach (var a in Alertes.Where(a => AlerteActive(a.Id)))
        {
            <div class="rig-alerte">
                <span class="rig-filet-v rig-filet-v--@a.Statut"></span>
                <span class="rig-alerte__corps">
                    <span class="rig-alerte__titre">@a.Titre</span><br />
                    <span class="rig-alerte__detail">@a.Detail</span>
