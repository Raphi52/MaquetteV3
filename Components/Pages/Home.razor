@* ---- Bouton « Nouveau » de l'arbre : creation d'un dossier ou d'une piece ---- *@
@if (NouveauOuvert)
{
    <div class="rig-voile rig-voile--haut" @onclick="() => NouveauOuvert = false">
        <div class="rig-impression" @onclick:stopPropagation="true">
            <div class="rig-kicker">Nouvel element dans &laquo; @DossierCible.Libelle &raquo;</div>

            <label class="rig-saisie-champ">
                <span class="rig-saisie-champ__libelle">Nature</span>
