@implements IDisposable

@* ============================================================
   « Informations du dossier » (Dossier RCS) : la vue du milieu en
   formulaire. Les sections et les champs viennent de
   Metier/InformationsDossier.cs, liste generee a partir des processus
   RIG v2 REPRIAC, REPRIPP, REPRIPP2, REPRIPM2, XACORRI et XBCORRI.
   Un bloc par table v2, repliable ; un filtre retrouve un champ parmi
   les centaines de la liste.
   Le meme formulaire sert « Informations des Formalites » (XACTION,
   Metier/InformationsFormalite.cs) : titre, sections et sources en parametre.

   PORTE EN REACT (lot 6 de la migration, 19/11/2026) : la fiche est rendue
   par web/src/composants/FicheInformationsDossier.tsx ; son etat et ses
   regles (etapes, vues de remplissage, saisie guidee, verrou KBIS, mode
   tache, historique, actions XACTION) vivent dans la session de
   Pont/FicheInformationsDossier.cs. Ce fichier n'est plus qu'une COQUILLE :
   il garde ses parametres d'origine pour que Home.razor ne change pas.

   Pourquoi la coquille ouvre ELLE-MEME la session : la fiche ecrit dans
   l'etat VIVANT de l'accueil (AccueilEtat), un objet qui ne traverse pas
   vers React. La session le recoit ici ; React n'en recoit que
   l'identifiant, et « version » change quand un rendu de l'accueil change
   ce que la fiche affiche (autre dossier, tache, ligne, trace ecrite
   ailleurs). Mode d'emploi : web/README.md.
   ============================================================ *@

<IleReact Composant="FicheInformationsDossier" Proprietes="Proprietes" Rappels="Rappels" />

@code {
    [Parameter] public string Numero { get; set; } = "";
    [Parameter] public EventCallback Fermer { get; set; }
    [Parameter] public string Domaine { get; set; } = "Dossier RCS";
    [Parameter] public string Titre { get; set; } = InformationsDossier.LibelleNoeud;
    [Parameter] public SectionInfoDossier[] Sections { get; set; } = InformationsDossier.Sections;
    [Parameter] public string[] Sources { get; set; } = InformationsDossier.ProcessusSources;

    /// <summary>La tache en cours : elle restreint la fiche a ses seuls champs.</summary>
    [Parameter] public RecetteTache? Recette { get; set; }

    /// <summary>Un clic sur « Afficher tous les champs » : il se COMPTE (mesure
    /// de qualite de la recette -- chaque clic dit qu'elle est incomplete).</summary>
    [Parameter] public EventCallback ToutAffiche { get; set; }

    /// <summary>Un champ vient d'etre ecrit : la vue qui porte la tache recompte.</summary>
    [Parameter] public EventCallback ChampModifie { get; set; }

    /// <summary>La ligne saisie quand la tache en compte plusieurs (dirigeant 1, 2, 3...).</summary>
    [Parameter] public int LigneCourante { get; set; } = 1;

    /// <summary>Etat persistant : porte l'historique des modifications et le journal.</summary>
    [Parameter] public AccueilEtat? Etat { get; set; }

    /// <summary>Verrou KBIS : actif pour « Informations du dossier » seulement.</summary>
    [Parameter] public bool Verrou { get; set; }

    private string? Session;
    private int Version;

    private global::RigV3Desktop.Pont.ParametresFiche Parametres
        => new(Numero, Domaine, Titre, Sections, Sources, Recette, LigneCourante, Etat, Verrou);

    /// <summary>
    /// Premier passage : la session s'ouvre (l'etat initial du composant
    /// d'origine). Ensuite, a chaque rendu de l'accueil, la session recoit les
    /// nouveaux parametres et dit si la vue affichee a pu changer.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Session is null)
            Session = global::RigV3Desktop.Pont.FicheInformationsDossier.Ouvrir(Parametres);
        else if (global::RigV3Desktop.Pont.FicheInformationsDossier.Parametrer(Session, Parametres))
            Version++;
    }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["session"] = Session,
        ["version"] = Version
    };

    private Dictionary<string, IleReact.RappelIle> Rappels => new()
    {
        ["fermer"] = IleReact.Rappel(Fermer),
        ["toutAffiche"] = IleReact.Rappel(ToutAffiche),
        ["champModifie"] = IleReact.Rappel(ChampModifie)
    };

    public void Dispose()
    {
        if (Session is not null) global::RigV3Desktop.Pont.FicheInformationsDossier.Fermer(Session);
    }
}
