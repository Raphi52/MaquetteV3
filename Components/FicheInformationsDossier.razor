@* ============================================================
   « Informations du dossier » (Dossier RCS) : la vue du milieu en
   formulaire. Les sections et les champs viennent de
   Metier/InformationsDossier.cs, liste generee a partir des processus
   RIG v2 REPRIAC, REPRIPP, REPRIPP2, REPRIPM2, XACORRI et XBCORRI.
   Un bloc par table v2, repliable ; un filtre retrouve un champ parmi
   les centaines de la liste.
   Le meme formulaire sert « Informations des Formalites » (XACTION,
   Metier/InformationsFormalite.cs) : titre, sections et sources en parametre.
   ============================================================ *@

<div class="rig-guide__entete">
    <div>
        <div class="rig-kicker">@Domaine &middot; @Sections.Sum(s => s.Champs.Length) champs &middot; @Sections.Length sections</div>
        <h3 class="rig-guide__titre">@Titre</h3>
        <div class="rig-guide__source">@Numero &middot; source RIG v2 : @string.Join(", ", Sources)</div>
    </div>
    <div class="rig-fiche__outils">
        @* Bouton ACTIONS : les actions du processus v2 XACTION (Metier/ActionsXaction.cs). *@
        <div class="rig-fiche__menu">
            <button class="rig-bouton rig-bouton--plat" aria-expanded="@MenuActions"
                    @onclick="() => MenuActions = !MenuActions">Actions &#9662;</button>
            @if (MenuActions)
            {
                <ul class="rig-fiche__actions" role="menu">
                    @foreach (var a in ActionsXaction.Liste)
                    {
                        var action = a;
                        <li><button role="menuitem" title="@action.Code" @onclick="() => Choisir(action)">
                            <span>@action.Libelle</span><span class="rig-infos__table">@action.Code</span>
                        </button></li>
                    }
                </ul>
            }
        </div>
        @* Bouton HISTORIQUE : remplace le formulaire par le journal des modifications. *@
        <button class="rig-bouton rig-bouton--plat" aria-pressed="@Historique"
                @onclick="BasculerHistorique">@(Historique ? "Formulaire" : "Historique")</button>
        <button class="rig-guide__fermer" title="Fermer" @onclick="Fermer">&times;</button>
    </div>
</div>

@if (DerniereAction is not null)
{
    <div class="rig-fiche__note">Action demandée : @DerniereAction.Libelle (@DerniereAction.Code) &mdash; notée au journal du dossier.</div>
}

@if (Historique)
{
    var entrees = Entrees();
    <div class="rig-histo">
        @if (entrees.Length == 0)
        {
            <p class="rig-histo__vide">Aucune modification enregistrée pour @Numero.</p>
        }
        @foreach (var m in entrees)
        {
            <article class="rig-histo__entree">
                <div class="rig-histo__pastille">@Initiales(m.Auteur)</div>
                <div class="rig-histo__corps">
                    <div class="rig-histo__phrase">
                        <strong>@m.Auteur</strong> a modifié <strong>@m.Champ</strong> dans <em>@m.Element</em>
                    </div>
                    <div class="rig-histo__valeurs">
                        <span class="rig-histo__avant">@(m.Avant.Length == 0 ? "(vide)" : m.Avant)</span>
                        <span class="rig-histo__fleche">&rarr;</span>
                        <span class="rig-histo__apres">@(m.Apres.Length == 0 ? "(vide)" : m.Apres)</span>
                    </div>
                    <div class="rig-histo__meta">@m.Quand.ToString("dd/MM/yyyy HH:mm") &middot; @m.Colonne</div>
                </div>
            </article>
        }
    </div>
}
else
{

<div class="rig-infos">
    @* MODE TACHE : la recette declare les champs a modifier ; la fiche ne
       montre qu'eux. Le bouton rouvre les 523 champs SANS fermer la tache. *@
    @if (Recette is not null)
    {
        var caches = Sections.Sum(x => x.Champs.Length) - Recette.Champs.Length;
        <div class="rig-tache__bandeau">
            <span class="rig-tache__code">@Recette.Code</span>
            <span class="rig-tache__titre">@Recette.Titre</span>
            <button class="rig-bouton rig-bouton--plat rig-tache__tout"
                    aria-pressed="@TousChamps"
                    title="Afficher tous les champs de la fiche sans quitter la tache"
                    @onclick="BasculerTousChamps">
                @(TousChamps
                    ? "Revenir aux champs de la tache"
                    : $"Afficher tous les champs ({caches} masques)")
            </button>
        </div>
    }
    <input class="rig-saisie-champ__saisie rig-infos__filtre" type="search"
           placeholder="Filtrer un champ (libelle ou colonne)..."
           title="Filtrer un champ (libelle ou colonne)"
           @bind="Filtre" @bind:event="oninput" />

    @* Pagination NUMEROTEE par etape : une section a la fois, comme la frise
       des etapes du panneau du milieu. Un filtre actif montre toutes les
       sections qui correspondent (la pagination se met en retrait). *@
    @{
        var visibles = SectionsVisibles();
        var page = Math.Clamp(Page, 0, Math.Max(0, visibles.Length - 1));
    }
    @* En mode tache, les champs demandes tiennent ENSEMBLE a l'ecran : les
       paginer par section obligerait a chercher le second champ. *@
    @if (visibles.Length > 1 && !ModeTache)
    {
        <ol class="rig-infos__pages">
            <li><button class="rig-infos__page rig-infos__page--fleche" title="Section precedente"
                        disabled="@(page == 0 || Filtre.Length > 0)"
                        @onclick="() => Page = page - 1">&#8249;</button></li>
            @for (var i = 0; i < visibles.Length; i++)
            {
                var index = i;
                var s = visibles[i];
                <li>
                    <button class="rig-infos__page @(index == page && Filtre.Length == 0 ? "rig-infos__page--courante" : "")"
                            title="@s.Section.Titre (@s.Section.Table) - @s.Champs.Length champs"
                            @onclick="() => { Page = index; Filtre = string.Empty; }">@(index + 1)</button>
                </li>
            }
            <li><button class="rig-infos__page rig-infos__page--fleche" title="Section suivante"
                        disabled="@(page == visibles.Length - 1 || Filtre.Length > 0)"
                        @onclick="() => Page = page + 1">&#8250;</button></li>
            <li class="rig-infos__pages-etat">
                @if (Filtre.Length > 0)
                {
                    <span>@visibles.Length section(s) trouvee(s)</span>
                }
                else
                {
                    <span>etape @(page + 1) / @visibles.Length &middot; @visibles[page].Section.Titre</span>
                }
            </li>
        </ol>
    }

    @foreach (var vu in Filtre.Length > 0 || ModeTache ? visibles : visibles.Skip(page).Take(1).ToArray())
    {
        var bloc = vu.Section;
        var champs = vu.Champs;
        <details class="rig-infos__section" open="true">
            <summary class="rig-infos__titre">
                @bloc.Titre
                <span class="rig-infos__table">@bloc.Table</span>
                <span class="rig-infos__compte">@champs.Length</span>
            </summary>
            <div class="rig-champs">
                @foreach (var champ in champs)
                {
                    var c = champ;
                    @* Un champ REPETABLE de la tache porte le rang de la ligne
                       saisie : sans lui, le 2e dirigeant ecraserait le 1er. *@
                    var cle = CleDuChamp(bloc, c);
                    <label class="rig-saisie-champ rig-saisie-champ--moitie" title="@c.Processus">
                        <span class="rig-saisie-champ__libelle">@c.Libelle</span>
                        <input class="rig-saisie-champ__saisie"
                               value="@ValeurAffichee(cle)"
                               @onchange="ev => Modifier(bloc, c, cle, ev.Value?.ToString() ?? string.Empty)" />
                        @* Sous le champ : la cle de trace. En infobulle, la
                           COLONNE REELLE de la base -- « INSPP_PATRONYME »
                           et non « PATRONYME » (ColonnesRig). *@
                        @{
                            var reelle = ColonnesRig.Resoudre(bloc.Table, c.Colonne);
                        }
                        <span class="rig-saisie-champ__colonne"
                              title="@(reelle.Resolue ? $"En base : {reelle}" : cle)">@cle</span>
                    </label>
                }
            </div>
        </details>
    }
</div>
}

@code {
    [Parameter] public string Numero { get; set; } = "";
    [Parameter] public EventCallback Fermer { get; set; }
    [Parameter] public string Domaine { get; set; } = "Dossier RCS";
    [Parameter] public string Titre { get; set; } = InformationsDossier.LibelleNoeud;
    [Parameter] public SectionInfoDossier[] Sections { get; set; } = InformationsDossier.Sections;
    [Parameter] public string[] Sources { get; set; } = InformationsDossier.ProcessusSources;

    /// <summary>La tache en cours : elle restreint la fiche a ses seuls champs.</summary>
    [Parameter] public RecetteTache? Recette { get; set; }

    /// <summary>Un clic sur « Afficher tous les champs » : il se COMPTE (mesure
    /// de qualite de la recette -- chaque clic dit qu'elle est incomplete).</summary>
    [Parameter] public EventCallback ToutAffiche { get; set; }

    /// <summary>Un champ vient d'etre ecrit : la vue qui porte la tache recompte.</summary>
    [Parameter] public EventCallback ChampModifie { get; set; }

    /// <summary>La ligne saisie quand la tache en compte plusieurs (dirigeant 1, 2, 3...).</summary>
    [Parameter] public int LigneCourante { get; set; } = 1;

    /// <summary>
    /// La cle sous laquelle ce champ est ECRIT dans la trace. Un champ
    /// repetable de la tache courante porte son rang de ligne ; tous les
    /// autres gardent « TABLE.COLONNE » -- rien ne change hors tache.
    /// </summary>
    private string CleDuChamp(SectionInfoDossier bloc, ChampInfoDossier c)
    {
        var champ = Recette?.Champs.FirstOrDefault(
            x => x.Table == bloc.Table && x.Colonne == c.Colonne);
        return champ is { Repetable: true }
            ? RecetteTache.Cle(champ, LigneCourante)
            : $"{bloc.Table}.{c.Colonne}";
    }

    /// <summary>Etat persistant : porte l'historique des modifications et le journal.</summary>
    [Parameter] public AccueilEtat? Etat { get; set; }

    private bool MenuActions;
    private bool Historique;
    private ActionXaction? DerniereAction;

    private void BasculerHistorique()
    {
        Historique = !Historique;
        MenuActions = false;
    }

    private ModificationChamp[] Entrees()
        => Etat is not null && Etat.Modifications.TryGetValue(Numero, out var l)
            ? l.AsEnumerable().Reverse().ToArray()
            : Array.Empty<ModificationChamp>();

    private void Choisir(ActionXaction a)
    {
        MenuActions = false;
        DerniereAction = a;
        Etat?.Journaliser(Numero, $"Action {ActionsXaction.Processus} demandee : {a.Libelle} ({a.Code})");
    }

    /// <summary>
    /// Ce que le champ AFFICHE. Le dictionnaire local ne connait que ce qui a
    /// ete tape dans CETTE vue : a la reouverture d'une affaire, ou quand une
    /// valeur a ete ecrite ailleurs (proposition d'un flux EDI), il est vide
    /// et le champ paraissait vierge alors que la trace portait deja la
    /// valeur -- la tache se disait complete devant un formulaire blanc. La
    /// trace fait donc foi des que la vue n'a rien de plus recent.
    /// </summary>
    private string ValeurAffichee(string cle)
        => Valeurs.TryGetValue(cle, out var v) ? v
           : Etat?.DerniereValeur(Numero, cle) ?? string.Empty;

    // La trace nomme la LIGNE : « ... > Dirigeants (Dirigeant 2) ». Sans
    // cela, trois nominations le meme jour produisaient trois lignes
    // d'historique impossibles a distinguer.
    private async Task Modifier(SectionInfoDossier bloc, ChampInfoDossier c, string cle, string apres)
    {
        var avant = ValeurAffichee(cle);
        Valeurs[cle] = apres;
        var ou = $"{Titre} > {bloc.Titre}";
        if (Recette is not null && cle.Contains('[') && Recette.ARepetition)
            ou += $" ({Recette.LibelleLigne} {LigneCourante})";
        Etat?.NoterModification(Numero, new ModificationChamp(DateTime.Now, Environment.UserName,
            ou, c.Libelle, cle, avant, apres));
        // La vue qui porte la tache doit recompter ses champs renseignes :
        // sans ce signal, le bouton « Terminer la tache » resterait grise.
        await ChampModifie.InvokeAsync();
    }

    private static string Initiales(string auteur)
        => new string(auteur.Split('.', ' ', '_').Where(x => x.Length > 0)
                            .Take(2).Select(x => char.ToUpperInvariant(x[0])).ToArray());

    private string Filtre = "";
    private readonly Dictionary<string, string> Valeurs = new();

    /// <summary>Les sections qui ont au moins un champ retenu par le filtre.</summary>
    private (SectionInfoDossier Section, ChampInfoDossier[] Champs)[] SectionsVisibles()
        => Sections.Select(s => (Section: s, Champs: s.Champs.Where(c => Garde(s, c)).ToArray()))
                   .Where(x => x.Champs.Length > 0)
                   .ToArray();

    private int Page;

    /// <summary>Vrai quand l'utilisateur a rouvert la fiche entiere depuis la tache.</summary>
    private bool TousChamps;

    private async Task BasculerTousChamps()
    {
        TousChamps = !TousChamps;
        Page = 0;
        if (TousChamps) await ToutAffiche.InvokeAsync();
    }

    private bool Garde(SectionInfoDossier s, ChampInfoDossier c)
        => GardeTache(s, c)
           && (Filtre.Length == 0
               || c.Libelle.Contains(Filtre, StringComparison.OrdinalIgnoreCase)
               || c.Colonne.Contains(Filtre, StringComparison.OrdinalIgnoreCase));

    /// <summary>Vrai quand la fiche est restreinte aux champs de la tache.</summary>
    private bool ModeTache => Recette is not null && !TousChamps;

    private bool GardeTache(SectionInfoDossier s, ChampInfoDossier c)
        => Recette is null || TousChamps || Recette.GardeChamp(s.Table, c.Colonne);
}
