@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web

@* ============================================================
   Une ligne de l'arbre GED, et ses enfants par recursion.

   L'arbre de RIG v2 (PROC_VDOSSIER/Control/TreeviewGed) est un vrai
   arbre : dossier > sous-dossier > piece, sur autant de niveaux que le
   dossier en compte (Judiciaire > Ordonnances > Demandeur > piece). Un
   composant qui s'appelle lui-meme rend cette profondeur sans la
   plafonner ; l'ancienne liste plate de categories ne le pouvait pas.

   PORTE EN REACT (lot 6 de la migration, 19/11/2026) : l'arbre est rendu
   par web/src/composants/ArbreGedNoeud.tsx, qui s'appelle lui-meme pour
   chaque enfant ; ses regles (enfants visibles, filtre, branches ouvertes,
   chemin, repli au clic) vivent dans Pont/ArbreGedNoeud.cs. Ce fichier
   n'est plus qu'une COQUILLE : il garde ses parametres d'origine pour que
   Home.razor ne change pas.

   Pourquoi la coquille calcule la vue : ses parametres sont des objets
   VIVANTS de l'accueil (HashSet des noeuds ouverts, ajouts, masques,
   libelles renommes) qui ne traversent pas vers React. Elle les passe au
   pont, envoie la ligne racine a React, et retrouve le noeud de chaque geste
   par son identifiant. Mode d'emploi : web/README.md.
   ============================================================ *@

<IleReact Composant="ArbreGedNoeud" Proprietes="Proprietes" Rappels="Rappels" />

@code {
    [Parameter, EditorRequired] public NoeudGed Noeud { get; set; } = default!;
    [Parameter] public int Niveau { get; set; }
    [Parameter, EditorRequired] public HashSet<NoeudGed> Ouverts { get; set; } = default!;
    [Parameter] public NoeudGed? Selection { get; set; }
    [Parameter] public EventCallback<NoeudGed> Selectionner { get; set; }

    /// <summary>Niveau d'acces du login courant : les dossiers reserves au-dessus ne se rendent pas.</summary>
    [Parameter] public string[] Domaines { get; set; } = [];

    /// <summary>Elements ajoutes a la main sous un dossier, par le bouton « Nouveau ».</summary>
    [Parameter] public IReadOnlyDictionary<NoeudGed, List<NoeudGed>>? Ajouts { get; set; }

    /// <summary>Noeuds supprimes depuis l'arbre : ils ne se rendent plus.</summary>
    [Parameter] public IReadOnlyCollection<NoeudGed>? Masques { get; set; }

    /// <summary>Libelles reecrits par un renommage, par identite de noeud.</summary>
    [Parameter] public IReadOnlyDictionary<NoeudGed, string>? Libelles { get; set; }

    /// <summary>La tache en cours : elle replie les branches qu'elle ne nomme pas.</summary>
    [Parameter] public RecetteTache? Recette { get; set; }

    /// <summary>Le noeud en cours de renommage sur place, s'il y en a un.</summary>
    [Parameter] public NoeudGed? Renomme { get; set; }

    /// <summary>Renommage valide (texte vide = renommage abandonne).</summary>
    [Parameter] public EventCallback<(NoeudGed Noeud, string Texte)> Renommer { get; set; }

    /// <summary>Bouton « trois points » d'une ligne : ouvre le menu des operations.</summary>
    [Parameter] public EventCallback<(NoeudGed Noeud, MouseEventArgs Souris)> MenuContextuel { get; set; }

    /// <summary>Texte de la barre de recherche au-dessus de l'arbre : seules les
    /// branches dont un element porte ce texte restent affichees.</summary>
    [Parameter] public string? Filtre { get; set; }

    /// <summary>Les noeuds rendus au dernier rendu, par identifiant : un geste de React les nomme ainsi.</summary>
    private Dictionary<string, NoeudGed> Index = new(StringComparer.Ordinal);

    private Dictionary<string, object?> Proprietes
    {
        get
        {
            var index = new Dictionary<string, NoeudGed>(StringComparer.Ordinal);
            var ligne = global::RigV3Desktop.Pont.ArbreGedNoeud.Vue(
                Noeud, Niveau, Ouverts, Selection, Domaines, Ajouts, Masques, Libelles,
                Recette, Renomme, Filtre, index);
            Index = index;
            return new() { ["ligne"] = ligne };
        }
    }

    private Dictionary<string, IleReact.RappelIle> Rappels => new()
    {
        ["activer"] = new(v => Activer(v.GetString())),
        ["renommer"] = new(v => Valider(v.Deserialize<Renommage>(Json))),
        ["menuContextuel"] = new(v => Menu(v.Deserialize<Souris>(Json)))
    };

    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private sealed record Renommage(string Id, string Texte);

    private sealed record Souris(string Id, double ClientX, double ClientY, double ScreenX, double ScreenY,
                                 double OffsetX, double OffsetY, double PageX, double PageY,
                                 long Button, long Buttons, long Detail,
                                 bool CtrlKey, bool ShiftKey, bool AltKey, bool MetaKey);

    private NoeudGed? Trouver(string? id) => id is not null && Index.TryGetValue(id, out var n) ? n : null;

    // Un dossier se replie/se deplie ; une piece se selectionne (Pont/ArbreGedNoeud.Activer).
    private async Task Activer(string? id)
    {
        if (Trouver(id) is not { } noeud) return;
        global::RigV3Desktop.Pont.ArbreGedNoeud.Activer(noeud, Ouverts, Domaines, Ajouts, Masques, Recette);
        await Selectionner.InvokeAsync(noeud);
        StateHasChanged();
    }

    private async Task Valider(Renommage? r)
    {
        if (r is null || Trouver(r.Id) is not { } noeud) return;
        await Renommer.InvokeAsync((noeud, r.Texte ?? ""));
        StateHasChanged();
    }

    private async Task Menu(Souris? s)
    {
        if (s is null || Trouver(s.Id) is not { } noeud) return;
        var souris = new MouseEventArgs
        {
            Type = "click",
            ClientX = s.ClientX, ClientY = s.ClientY, ScreenX = s.ScreenX, ScreenY = s.ScreenY,
            OffsetX = s.OffsetX, OffsetY = s.OffsetY, PageX = s.PageX, PageY = s.PageY,
            Button = s.Button, Buttons = s.Buttons, Detail = s.Detail,
            CtrlKey = s.CtrlKey, ShiftKey = s.ShiftKey, AltKey = s.AltKey, MetaKey = s.MetaKey
        };
        await MenuContextuel.InvokeAsync((noeud, souris));
        StateHasChanged();
    }
}
