@implements IDisposable
@inject DocumentPartage Partage

@* Contenu de la FENETRE DETACHEE du document : le meme apercu que la 3e zone
   de l'ecran VDossier, seul dans sa fenetre. Il suit la piece ouverte dans la
   fenetre principale (voir DocumentPartage).

   PORTE EN REACT (lot 6 de la migration, 19/11/2026) : l'apercu est rendu par
   web/src/composants/DocumentDetacheVue.tsx, qui tient aussi l'objectif
   (zoom) PROPRE a cette fenetre ; la piece vient de Pont/DocumentDetacheVue.cs.
   Ce fichier reste la RACINE de FenetreDocument (RootComponent) et garde son
   parametre Rang : FenetreDocument ne change pas. Il suit l'emplacement de SA
   fenetre et re-rend React a chaque changement. Mode d'emploi : web/README.md. *@

<IleReact Composant="DocumentDetacheVue" Proprietes="Proprietes" />

@code {
    /// <summary>Rang de CETTE fenetre (1re detachee, 2e...). Sert de clef a son
    /// emplacement : c'est ce qui permet d'externaliser PLUSIEURS documents a
    /// la fois, chacun dans sa fenetre, sans qu'ils se recopient l'un l'autre.</summary>
    [Parameter] public int Rang { get; set; } = 1;

    private DocumentDetache Emplacement = default!;

    protected override void OnInitialized()
    {
        Emplacement = Partage.Emplacement(Rang);
        Emplacement.Change += Rafraichir;
    }

    private void Rafraichir() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Emplacement is not null) Emplacement.Change -= Rafraichir;
    }

    private Dictionary<string, object?> Proprietes => new()
    {
        ["piece"] = global::RigV3Desktop.Pont.DocumentDetacheVue.Vue(Emplacement)
    };
}
