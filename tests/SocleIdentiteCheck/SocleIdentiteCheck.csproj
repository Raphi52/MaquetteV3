<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc de SOC-001 (lot 2 du plan de reconstruction) : ouvrir RIG avec sa session
       Windows, sans mot de passe. Un controle par critere CA01 a CA08. Il lui faut le
       SQL Server de developpement : docker compose up -d (racine du depot). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleIdentiteCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Le client et la session de l'ecran, compiles seuls (ils ne dependent que de
         Contrats/) : essayes contre le vrai serveur, sans monter l'application WPF. -->
    <Compile Include="../../Pont/ClientServeur.cs" Link="Pont/ClientServeur.cs" />
    <Compile Include="../../Pont/SessionAgent.cs" Link="Pont/SessionAgent.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
