<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banc de REC-002, REC-003 et REC-004 (la recopie continue entre la V2 et la V3 d'un greffe, et les fiches modifiees des
       deux cotes), lot 9 du plan de reconstruction, phase 2. Il lui faut le SQL Server du poste (docker compose up -d) et la
       lecture de RIG_DEV (SQL-DEV\DEV, compte Windows ; autre serveur : RIGV3_RIG_DEV). En tete de Program.cs : ce que
       chaque controle prouve. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RecopieDeuxSensCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- La base V2 jetable tiree de RIG_DEV : la meme construction que le banc du transfert (lot 7). -->
    <Compile Include="../RecopieTransfertCheck/ExtraitRigDev.cs" Link="ExtraitRigDev.cs" />
    <!-- Le script de la V2 (Base\v2\recopie-v2.sql) joue comme sqlcmd le jouerait (banc de la numerotation V2). -->
    <Compile Include="../NumerotationV2Check/Sqlcmd.cs" Link="Sqlcmd.cs" />
    <!-- L'ecran « Fiches en conflit » et son client, joues contre le vrai serveur en memoire. -->
    <Compile Include="../../Pont/ClientServeur.cs" Link="Pont/ClientServeur.cs" />
    <Compile Include="../../Pont/JSInvokable.cs" Link="Pont/JSInvokable.cs" />
    <Compile Include="../../Pont/SessionAgent.cs" Link="Pont/SessionAgent.cs" />
    <Compile Include="../../Pont/EcranConflits.cs" Link="Pont/EcranConflits.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

</Project>
