<Project Sdk="Microsoft.NET.Sdk">

  <!-- Le theme se choisit dans la barre du haut, rendue par React depuis le lot 1
       du passage a React (19/11/2026) ; le choix passe par la session de l'accueil
       (Pont/Accueil.cs). Le banc l'EXECUTE : il reference donc l'application
       entiere, comme les bancs des ecrans a session (web/README.md, lot 2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThemeCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../RigV3Desktop.csproj" />
  </ItemGroup>

</Project>
