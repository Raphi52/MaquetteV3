<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du lot 6 du plan de reconstruction, phase 2 : SOC-021 (copie anonymisee de la base d'un
       greffe pour les tests). Un controle par critere CAxx, qui cite son id.
       Il lit RIG_DEV (SQL-DEV\DEV) en LECTURE SEULE, en fait une base V2 jetable sur le SQL Server local
       (extrait coherent : clients, parties, factures signees et leur journal, dirigeants, agents,
       courriels, lots d'editions), la copie avec l'outil Outils/Anonymisation, puis controle la copie.
       Il lui faut le SQL Server de developpement (docker compose up -d) et la lecture de RIG_DEV
       (session Windows ; autre serveur : RIGV3_RIG_DEV). Doc : docs/reconstruction/socle-anonymisation.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleAnonymisationCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Outils/Anonymisation/RigV3.Anonymisation.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
  </ItemGroup>
</Project>
