<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du cote V2 de la numerotation (lot 7 du plan de reconstruction : NUM-002, NUM-003, NUM-006,
       NUM-007, NUM-022). Un controle par critere CAxx. Il monte une base V3 jetable (toutes les migrations
       du depot) et des bases V2 jetables (v2\ : les seuls objets utiles, copies de la V2), joue les
       scripts de Base\v2 tels que les lancera l'exploitation, puis les appels de la V2 tels qu'ils sont
       ecrits. Il lui faut le SQL Server de developpement : docker compose up -d. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NumerotationV2Check</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Sqlcmd.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
