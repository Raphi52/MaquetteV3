<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banc de REC-007, REC-009, REC-010, REC-011 et REC-018 (le retour d'un greffe beta a l'ancien RIG avec ses affaires de la V3,
       les anciens numeros des anciens logiciels, l'historique des affaires des deux logiciels, les liens entre demandes des deux
       logiciels, l'arrivee enregistree une fois), lot 11 du plan de reconstruction, phase 2. Il lui faut le SQL Server du poste
       (docker compose up -d) et la lecture de RIG_DEV (SQL-DEV\DEV, compte Windows ; autre serveur : RIGV3_RIG_DEV). En tete de
       Program.cs : ce que chaque controle prouve. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- La base V2 jetable tiree de RIG_DEV : la meme construction que le banc du transfert (lot 7). -->
    <Compile Include="../RecopieTransfertCheck/ExtraitRigDev.cs" Link="ExtraitRigDev.cs" />
    <!-- Les scripts de la V2 (Base\v2\recopie-v2.sql) joues comme sqlcmd les jouerait (banc de la numerotation V2). -->
    <Compile Include="../NumerotationV2Check/Sqlcmd.cs" Link="Sqlcmd.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
  </ItemGroup>

</Project>
