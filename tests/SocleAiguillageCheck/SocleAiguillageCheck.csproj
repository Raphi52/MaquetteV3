<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du lot 3 de la phase 2 du plan de reconstruction : SOC-014 (chaque affaire au bon logiciel
       selon sa date de creation) et SOC-015 (ouvrir une ancienne affaire dans la V2 depuis la V3).
       Un controle par critere CAxx, qui cite son id. Il lui faut le SQL Server de developpement
       (docker compose up -d, racine du depot) et les sources de la V2 (D:\RigApplication\Source) pour
       l'inventaire des chemins de creation d'affaire. Mode d'emploi : docs/reconstruction/socle-aiguillage.md.

       net10.0-windows + WPF : le banc se relance lui-meme en « fausse V2 » (une fenetre titree comme la
       console de la V2, hors ecran, qui note ses arguments et les messages WM_COPYDATA recus). L'app est
       referencee entiere (comme TriCheck) : Pont/AncienRig.cs lit le fonds de la recherche d'affaires. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleAiguillageCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../RigV3Desktop.csproj" />
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
