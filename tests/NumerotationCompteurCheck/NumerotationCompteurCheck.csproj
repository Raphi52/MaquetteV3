<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du compteur central des numeros (lot 5 du plan de reconstruction : NUM-001, NUM-004,
       NUM-008). Un controle par critere CAxx, sur une base jetable ou toutes les migrations du depot
       sont jouees, avec le vrai serveur en memoire et des sessions « V2 » qui appellent les memes
       programmes SQL. Il lui faut le SQL Server de developpement : docker compose up -d. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NumerotationCompteurCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- L'ecran « Compteurs de numéros » et son client, joues contre le vrai serveur en memoire. -->
    <Compile Include="../../Pont/ClientServeur.cs" Link="Pont/ClientServeur.cs" />
    <Compile Include="../../Pont/JSInvokable.cs" Link="Pont/JSInvokable.cs" />
    <Compile Include="../../Pont/EcranCompteurs.cs" Link="Pont/EcranCompteurs.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
