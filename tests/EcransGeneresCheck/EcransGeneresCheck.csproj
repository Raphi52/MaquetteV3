<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0-windows + reference au projet (lot 1 du plan « les 125 ecrans manquants du menu ») :
       le banc lit le catalogue des ecrans generiques (Pont/EcransGeneres/) et le menu
       (Pont/MenuAccueil.cs) par leurs noms, sans en recopier une ligne. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcransGeneresCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../RigV3Desktop.csproj" />
  </ItemGroup>

</Project>
