<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du lot 4 du plan de reconstruction : SOC-003 (reglages du greffe),
       SOC-007 (catalogue commun des greffes), SOC-008 (base V3 de chaque greffe).
       Un controle par critere CAxx, qui cite son id.
       Il lui faut le SQL Server de developpement (docker compose up -d, racine du
       depot) et la LECTURE de RIG_DEV sur SQL-DEV\DEV (session Windows) : la reprise
       des reglages y est lue, jamais ecrite. Mode d'emploi :
       docs/reconstruction/socle-greffes.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleGreffesCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- L'ecran « Réglages du greffe » et son client, joues contre le vrai serveur en memoire. -->
    <Compile Include="../../Pont/ClientServeur.cs" Link="Pont/ClientServeur.cs" />
    <Compile Include="../../Pont/JSInvokable.cs" Link="Pont/JSInvokable.cs" />
    <Compile Include="../../Pont/SessionAgent.cs" Link="Pont/SessionAgent.cs" />
    <Compile Include="../../Pont/EcranReglages.cs" Link="Pont/EcranReglages.cs" />
    <!-- La copie d'essai de COMMUN_RIG.dbo.GREFFE (40 greffes exploites + 2 non exploites). -->
    <None Include="commun_rig_greffe.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
