<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimuEdiCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Metier/AlertesGreffe.cs" Link="AlertesGreffe.cs" />
    <Compile Include="../../Metier/RecetteTache.cs" Link="RecetteTache.cs" />
    <Compile Include="../../Metier/JeuDemo.cs" Link="JeuDemo.cs" />
    <Compile Include="../../Metier/SimulationEdi.cs" Link="SimulationEdi.cs" />
    <!-- Le courrier et les demandes, portes en React le 19/11/2026 (lot 3) : leurs ponts sont executes ici. -->
    <Compile Include="../../Pont/EcranArrivee.cs" Link="Pont/EcranArrivee.cs" />
    <Compile Include="../../Pont/EcranDemandes.cs" Link="Pont/EcranDemandes.cs" />
  </ItemGroup>

  <!-- Pont/*.cs porte [JSInvokable] (Microsoft.JSInterop), livre avec ASP.NET Core. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
