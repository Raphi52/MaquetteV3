MU JURIS | Cnbf 300008 | Personnes physiques | AFaire | []
VIOLETTE Marc | Cnbf 250002 · SIREN 512 500 102 · reçue le {J-1} | Personnes physiques | AFaire | []
controle: SELECT CONCAT(RPJCI_ETAT, '/', RPJCI_ETAT_TRAITEMENT_RIG, '/', RPJCI_USER_TRAITEMENT_RIG, '/', CASE WHEN RPJCI_DATE_TRAITEMENT_RIG IS NULL THEN 'sans date' ELSE 'datee' END) FROM v2.DEMAT_RPJC_INS WHERE RPJCI_ID_RPJCI = 2500101 => 2/A/banc.ecrans/datee
controle: SELECT CONCAT(MNDTR_NUMERO_CNBF, '/', MNDTR_NUMERO_CNBF_STRUCTURE, '/', MNDTR_SIREN, '/', MNDTR_ADRESSE_MAIL, '/', MNDTR_TELEPHONE, '/', MNDTR_FAX, '/', CAST(MNDTR_ACTIF AS int)) FROM v2.MANDATAIRE WHERE MNDTR_ID_MNDTR = 2500101 => 250001/250901/512500101/verger@ancien.test/0476250101/0476250109/1
controle: SELECT CONCAT(MNDTR_NUMERO_CNBF, '/', MNDTR_NUMERO_CNBF_STRUCTURE, '/', MNDTR_SIREN, '/', MNDTR_ADRESSE_MAIL, '/', MNDTR_TELEPHONE, '/', MNDTR_FAX, '/', CAST(MNDTR_ACTIF AS int)) FROM v2.MANDATAIRE WHERE MNDTR_ID_MNDTR = 2500102 => 250001/250901/512500101/anne.verger@barreau.test/0476250101/0476250109/0
controle: SELECT CONCAT(CASE WHEN MNDTR_NUMERO_CNBF IS NULL THEN 'sans cnbf' ELSE MNDTR_NUMERO_CNBF END, '/', MNDTR_NUMERO_CNBF_STRUCTURE, '/', MNDTR_SIREN, '/', CAST(MNDTR_ACTIF AS int)) FROM v2.MANDATAIRE WHERE MNDTR_ID_MNDTR = 2500106 => sans cnbf/250901/512500101/1
controle: SELECT STRING_AGG(CONCAT(INSTN_ID_INSTN, ':', CAST(INSTN_TOP_EXPERIAN AS int), ':', CASE WHEN INSTN_DATE_MAJ_INFOG IS NULL THEN 'sans date' ELSE 'datee' END), ' ') WITHIN GROUP (ORDER BY INSTN_ID_INSTN) FROM v2.INSTANCE WHERE INSTN_ID_INSTN IN (2500101, 2500102) => 2500101:0:datee 2500102:1:sans date
