ENJOINDRE ALPHA SARL · SIREN 511 000 101 | Injonction du {J+0} | Injonction à suivre | Validee | [0,1,2]
ENJOINDRE ZETA SAS · SIREN 511 000 106 | Injonction du {J-10} | Injonction à suivre | Validee | [0,1,2]
ENJOINDRE GAMMA SARL · SIREN 511 000 103 | Injonction du {J-20} | Injonction à suivre | Validee | [0,1,2]
ENJOINDRE DELTA SAS · SIREN 511 000 104 | Injonction du {J-100} · régularisée le {J-3} | Injonction à suivre | Validee | [0,1,2,3]
ENJOINDRE EPSILON SARL · SIREN 511 000 105 | Injonction du {J-200} · close sans régularisation | Injonction à suivre | Validee | [0,1,2,3]
controle: SELECT COUNT(*) FROM v2.INSTANCE WHERE INSTN_CODE_AFFAIRE = 'INJ18' AND INSTN_TYPE_INSTANCE = 'RP' AND INSTN_ETAT_INSTANCE = '0' AND INSTN_NATURE_AFFAIRE = 'INJ18' AND INSTN_CODE_ACTE_PROCE = 'QP8' => 2
controle: SELECT STRING_AGG(p.PRT_QUALIF_PARTIE + ':' + p.PRT_DESIGNATION + ':' + p.PRT_CIVILITE, ' / ') WITHIN GROUP (ORDER BY p.PRT_QUALIF_PARTIE) FROM v2.PARTIE AS p JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = p.PRT_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' => D:Le PRESIDENT DU TRIBUNAL DE COMMERCE:MR / F:ENJOINDRE ALPHA SARL:PM / I:DURAND Paul Henri:MR
controle: SELECT CAST(p.PRT_ID_DSRCS AS varchar(10)) + '|' + CAST(p.PRT_ID_RPRTR AS varchar(10)) + '|' + p.PRT_MODE_PRESENTATION FROM v2.PARTIE AS p JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = p.PRT_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' AND p.PRT_QUALIF_PARTIE = 'F' => 1100101|1100101|A
controle: SELECT p.PRT_DESIGNATION + '|' + p.PRT_SIREN + '|' + CONVERT(varchar(10), p.PRT_DATE_NAISSANCE, 103) + '|' + p.PRT_LIEU_NAISSANCE FROM v2.PARTIE AS p JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = p.PRT_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100102 AND r.RLCRC_TYPE_RELANCE = 'IDBE' AND p.PRT_QUALIF_PARTIE = 'I' => BERNARD Julie|123456789|02/01/1980|Nantes
controle: SELECT d.DCJDC_TYPE_DECISION + '|' + CAST(d.DCJDC_ID_JUG AS varchar(10)) + '|' + CAST(d.DCJDC_ID_GRASS AS varchar(10)) + '|' + d.DCJDC_SENS_GENERAL + '|' + CONVERT(varchar(10), d.DCJDC_DATE_PREVUE, 103) + '|' + CAST(CAST(d.DCJDC_AVEC_PIECE_NUMERISE AS int) AS varchar(1)) + '|' + d.DCJDC_NATURE_DOC_GED + '|' + d.DCJDC_NOM_DEPOSANT_GED FROM v2.DECISION_JUDICIAIRE AS d JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = d.DCJDC_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' => OPRBE18|1800061|1800071|ACCTT|15/01/2099|1|OPHP|PDT
controle: SELECT CAST(a.APPAF_ID_ADNC AS varchar(10)) + '|' + a.APPAF_TYPE_CLASSEMENT + '|' + a.APPAF_HEURE_APPEL + '|' + CAST(a.APPAF_NUM_ORDRE AS varchar(3)) FROM v2.APPEL_AFFAIRE AS a JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = a.APPAF_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' => 1800051|CJ|09:45|1
controle: SELECT STRING_AGG(e.EVNPR_CODE_EVE_PRO, ',') WITHIN GROUP (ORDER BY e.EVNPR_CODE_EVE_PRO) FROM v2.EVENEMENT_PROCEDURE AS e JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = e.EVNPR_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' => INJQ18,RBEI18
controle: SELECT CAST(r.RLCRC_NUM_ORDRE AS varchar(3)) + '|' + r.RLCRC_AUTEUR + '|' + r.RLCRC_INTERVENANT + '|' + g.DLGRC_ETAT_RELANCE + '|' + p.DLGPA_NON_DISTRIBUE + '|' + p.DLGPA_NPAI + '|' + p.DLGPA_RETRAIT_ROLE + '|' + CAST(CAST(p.DLGPA_TARIFER AS int) AS varchar(1)) + CAST(CAST(p.DLGPA_EDITIONS_DIFFEREES AS int) AS varchar(1)) FROM v2.RELANCE_RCS AS r JOIN v2.DILIGENCE_RCS AS g ON g.DLGRC_ID_DLGRC = r.RLCRC_ID_DLGRC JOIN v2.DILIGENCE_RCS_PARAMETRE AS p ON p.DLGPA_ID_DLGPA = g.DLGRC_ID_DLGPA WHERE r.RLCRC_ID_DLGRC = 1100101 AND r.RLCRC_TYPE_RELANCE = 'IDBE' => 2|4|1|4|CITA|LRAR|ORDO|11
controle: SELECT COUNT(*) FROM v2.DEMANDE AS d JOIN v2.DEMANDE AS m ON m.DMND_ID_DMND = d.DMND_ID_DMND_MERE JOIN v2.DOSSIER_DEMANDE AS dd ON dd.DSSDM_ID_DMND = d.DMND_ID_DMND AND dd.DSSDM_CODE_SEQUENCEUR = '2J' WHERE d.DMND_CODE_PROSS = 'OPE' AND d.DMND_ETAT_DEMANDE = 'V' AND m.DMND_CODE_PROSS = 'ISURV' AND m.DMND_ETAT_DEMANDE = 'V' AND d.DMND_ID_DSRCS IN (1100101, 1100102) => 2
controle: SELECT COUNT(*) FROM v2.DEMANDE_EDITION WHERE DMNED_CODE_ENTITE_SOURCE = 'DECI_JUDICIAIRE' AND DMNED_LIBELLE_DOCUMENT = 'Ordonnance d injonction DBE' => 2
controle: SELECT COUNT(*) FROM v2.CHEF_DEMANDE AS c JOIN v2.INSTANCE AS i ON i.INSTN_ID_INSTN = c.CHFDM_ID_INSTN WHERE i.INSTN_CODE_AFFAIRE = 'INJ18' => 0
