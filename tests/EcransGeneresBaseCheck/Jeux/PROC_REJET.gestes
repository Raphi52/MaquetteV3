controle: SELECT ENCMT_MODE_PAIEMENT + ' ' + CONVERT(varchar(20), CAST(ENCMT_MONTANT AS decimal(19,2))) + ' ' + ENCMT_NUMERO_TITRE + ' ' + ENCMT_GUID + ' ' + CONVERT(varchar(10), ENCMT_ID_ARRV) + ' ' + CASE WHEN ENCMT_COMMENTAIRE = 'Annulation de l''encaissement n° J12CHQ02 du ' + CONVERT(varchar(10), (SELECT o.ENCMT_DATE_ENCAISSEMENT FROM v2.ENCAISSEMENT AS o WHERE o.ENCMT_ID_ENCMT = 2204002), 103) THEN 'commentaire de la V2' ELSE ENCMT_COMMENTAIRE END FROM v2.ENCAISSEMENT WHERE ENCMT_ID_ENCMT = (SELECT a.ENCMT_ID_ENCMT FROM v2.ENCAISSEMENT AS a WHERE a.ENCMT_NUMERO_TITRE = 'J12CHQ02' AND a.ENCMT_MONTANT < 0) AND ENCMT_DATE_COMPTABILISATION IS NULL AND ENCMT_DESIGNATION_PAYEUR = 'PAYEUR J12B' => REG -80.00 J12CHQ02 G12-0002 2204901 commentaire de la V2
controle: SELECT CAST(SUM(VENTI_MONTANT) AS decimal(19,2)) FROM v2.VENTILATION WHERE VENTI_ID_ENCMT IN (2204002, (SELECT a.ENCMT_ID_ENCMT FROM v2.ENCAISSEMENT AS a WHERE a.ENCMT_NUMERO_TITRE = 'J12CHQ02' AND a.ENCMT_MONTANT < 0)) => 0.00
controle: SELECT CAST(SUM(VENTI_MONTANT) AS decimal(19,2)) FROM v2.VENTILATION WHERE VENTI_ID_ENCMT IN (2204002, (SELECT a.ENCMT_ID_ENCMT FROM v2.ENCAISSEMENT AS a WHERE a.ENCMT_NUMERO_TITRE = 'J12CHQ02' AND a.ENCMT_MONTANT < 0)) AND VENTI_ID_CLIEN = 2204201 AND VENTI_ID_AFFRE = 2204301 => 0.00
controle: SELECT CONVERT(varchar(10), (SELECT VENTI_ID_CLIEN FROM v2.VENTILATION WHERE VENTI_ID_VENTI = 2204103)) + ' ' + CONVERT(varchar(10), (SELECT COUNT(*) FROM v2.VENTILATION WHERE VENTI_ID_ENCMT = (SELECT a.ENCMT_ID_ENCMT FROM v2.ENCAISSEMENT AS a WHERE a.ENCMT_NUMERO_TITRE = 'J12CHQ02' AND a.ENCMT_MONTANT < 0) AND VENTI_ID_CLIEN = 2204204 AND VENTI_MONTANT = -30)) => 2204204 1
controle: SELECT ENCRR_CLIENT + ' / ' + ENCRR_CLIENT_EMAIL FROM v2.ENCAISSEMENT_RECUS_REJETES WHERE ENCRR_ID_ENCRR = 2204403 => M. DUPONT / cli.a@banc12.test
