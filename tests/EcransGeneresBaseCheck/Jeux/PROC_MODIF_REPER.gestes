controle: SELECT R_CODEAFFAIR_ABREGE_DEMANDEUR FROM v2.CODE_AFFAIRE WHERE R_CODEAFFAIR_VALEUR = 'RP13' => REP-OMEGA
controle: SELECT COUNT(*) FROM v2.REPERTORIE WHERE PRTRP_ID_PRTRP = 1315001 AND PRTRP_ID_CLIEN IS NULL AND PRTRP_TEXTE_ASSISTANCE IS NULL => 1
controle: SELECT COUNT(*) FROM soc.Journal WHERE Ecran = 'Repertoire' AND IdObjet = '1315001' AND Famille = 'reglage' AND Verbe = 'a modifie' => 1
---
