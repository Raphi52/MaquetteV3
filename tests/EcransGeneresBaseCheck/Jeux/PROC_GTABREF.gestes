---
# La copie de G14A : tous ses champs sauf la cle (ouverture, cloture, regime), son libelle non saisi ; pas ses collections (etats
# suivants, saisie : Copie ne parcourt que ListeChamps, SQLBase_Handler_PC_Etat.cs:66-77).
geste: Ajouter
ids: PC_ETAT|G14A
valeur: Code = G14D
resultat: fait
message: PC_ETAT G14D créé, copie de G14A : ETAT BANC ALPHA.
controle: SELECT CONCAT(R_PCETAT_LIBELLE_ECRAN, '/', CAST(R_PCETAT_OUVERTURE AS int), CAST(R_PCETAT_CLOTURE AS int), '/', R_PCETAT_MODALITE_REGIME, '/', (SELECT COUNT(*) FROM v2.PC_ETAT_SUIVANT WHERE PETSV_AVANT = 'G14D'), (SELECT COUNT(*) FROM v2.PC_ETAT_SAISIE WHERE PETSA_ETAT = 'G14D')) FROM v2.PC_ETAT WHERE R_PCETAT_VALEUR = 'G14D' => ETAT BANC ALPHA/10/R/00
---
