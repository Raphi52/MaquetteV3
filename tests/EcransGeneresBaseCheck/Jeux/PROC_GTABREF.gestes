# Une zone creee dans son onglet (Table vide : celle de ses champs), ses champs obligatoires saisis ; le type et l'etat de la liste
# RIG v2 (l'etat enregistre par son rang), l'abrege laisse vide (NULL) ; creation et modification par l'agent (MiseAJourChampsCreation,
# SousOPE_HISTORIQUE.cs:59-67 ; MiseAJourChampsModification, OPE_TABLE_REF_BUTTONS_BAR.cs:298) ; saisissable par defaut (Create_PC_Etat_Zone).
geste: Ajouter
valeur: Code = GZ3
valeur: Libellé = ZONE BANC CREEE
valeur: Champs d'une zone › Synonyme = GZ3
valeur: Champs d'une zone › ISO = GZ3
valeur: Champs d'une zone › Abrégé pour édition =
valeur: Champs d'une zone › Simplifié pour édition = zone creee
valeur: Champs d'une zone › Développé pour édition = zone creee au banc
valeur: Champs d'une zone › Table de la zone = PROCEDURE_COLLECTIVE
valeur: Champs d'une zone › Attribut = PRCLL_DATE_JUGEMENT
valeur: Champs d'une zone › Type = date
valeur: Champs d'une zone › État = En vigueur pour tout
valeur: Champs d'une zone › Date de désactivation = 2030-12-31
resultat: fait
message: PC_ETAT_ZONE GZ3 créé : ZONE BANC CREEE.
controle: SELECT CONCAT(R_PCETATZONE_SYNONYME, '/', R_PCETATZONE_TYPE, '/', R_PCETATZONE_ETAT, '/', R_PCETATZONE_ATTRIBUT, '/', CONVERT(varchar(10), R_PCETATZONE_DATE_DESACTIVATION, 23), '/', ISNULL(R_PCETATZONE_ABREGE_EDIT, 'null'), '/', R_PCETATZONE_AUTEUR_CREATION, '/', R_PCETATZONE_AUTEUR_MODIF, '/', CAST(R_PCETATZONE_UTILISABLE_SAISIE AS int)) FROM v2.PC_ETAT_ZONE WHERE R_PCETATZONE_VALEUR = 'GZ3' => GZ3/DATE/1/PRCLL_DATE_JUGEMENT/2030-12-31/null/BANC Ecrans/BANC Ecrans/1
---
