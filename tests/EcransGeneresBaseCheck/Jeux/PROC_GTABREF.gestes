# La copie de GZ1 : ses champs (synonyme, textes, type, etat, table) et sa creation (03/02/2001, BANC ORIGINE : Copie ne les exclut
# pas), l'attribut et le libelle saisis, la modification par l'agent.
geste: Ajouter
ids: PC_ETAT_ZONE|GZ1
valeur: Code = GZ4
valeur: Libellé = ZONE BANC COPIEE
valeur: Champs d'une zone › Attribut = PRCLL_DATE_COPIE
resultat: fait
message: PC_ETAT_ZONE GZ4 créé, copie de GZ1 : ZONE BANC COPIEE.
controle: SELECT CONCAT(R_PCETATZONE_SYNONYME, '/', R_PCETATZONE_SIMPLIFIE_EDIT, '/', R_PCETATZONE_TYPE, '/', R_PCETATZONE_ETAT, '/', R_PCETATZONE_TABLE, '/', R_PCETATZONE_ATTRIBUT, '/', CONVERT(varchar(10), R_PCETATZONE_DATE_CREATION, 23), '/', R_PCETATZONE_AUTEUR_CREATION, '/', R_PCETATZONE_AUTEUR_MODIF) FROM v2.PC_ETAT_ZONE WHERE R_PCETATZONE_VALEUR = 'GZ4' => GZ1/zone citee/DATE/1/PROCEDURE_COLLECTIVE/PRCLL_DATE_COPIE/2001-02-03/BANC ORIGINE/BANC Ecrans
