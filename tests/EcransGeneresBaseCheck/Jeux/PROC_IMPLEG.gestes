controle: SELECT MSINS_NUM_MESURE + ' / ' + CONVERT(varchar(10), MSINS_DATE_OUVERTURE, 103) FROM v2.MESURE WHERE MSINS_ID_MSINS = 2000701 => 1990X00001 / 11/06/1990
