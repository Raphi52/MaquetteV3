# Ce que RIG v2 ecrit en plus (PROC_RSURV.cs:99-131, 320-380) : l'etat relance et l'etat EDI de la diligence, l'auteur
# (4, juge) et l'intervenant (1) de la relance, son type et son delai ; l'etat DCA de l'exercice relance (444), pas de
# l'exercice depose (454) ; la demande RSURV validee du dossier et ses parametres ; la demande du lot et ses deux filles ;
# le courrier en phase « C » dans la file d'impression du reglage.
controle: SELECT DLGRC_ETAT_RELANCE + '/' + DLGRC_ETAT_EDI FROM v2.DILIGENCE_RCS WHERE DLGRC_ID_DLGRC = 1100404 => 6/1
controle: SELECT RLCRC_AUTEUR + RLCRC_INTERVENANT + '/' + RLCRC_TYPE_RELANCE + '/' + CAST(DATEDIFF(DAY, RLCRC_DATE_RELANCE, RLCRC_DATE_LIMITE) AS varchar(5)) FROM v2.RELANCE_RCS WHERE RLCRC_ID_DLGRC = 1100403 AND RLCRC_NUM_ORDRE = 2 => 41/S/15
controle: SELECT EXRCC_ETAT_DCA FROM v2.EXERCICE WHERE EXRCC_ID_EXRCC = 1100444 => 66
controle: SELECT EXRCC_ETAT_DCA + '/' + ISNULL(CONVERT(varchar(10), EXRCC_DATE_RELANCE, 120), 'aucune') FROM v2.EXERCICE WHERE EXRCC_ID_EXRCC = 1100454 => 44/aucune
controle: SELECT DMND_ETAT_DEMANDE + '/' + DMND_NOM FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'RSURV' AND DMND_ID_DSRCS = 1100403 => V/Relance 2 SDCA (31/12/2024) : RELANCE GAMMA SARL
controle: SELECT DMND_TEXTE_PARAMETRE FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'RSURV' AND DMND_ID_DSRCS = 1100404 => LstIdExer=1100444,;NumRelance=3;NatureDiligence=SDCA;IdDiligenceRcs=1100404
controle: SELECT COUNT(*) FROM v2.DEMANDE AS m WHERE m.DMND_CODE_PROSS = 'RSURV' AND m.DMND_ETAT_DEMANDE = 'V' AND m.DMND_NOM = 'Relance des DCA - 2 occurence(s)' AND (SELECT COUNT(*) FROM v2.DEMANDE AS f WHERE f.DMND_ID_DMND_MERE = m.DMND_ID_DMND) = 2 => 1
controle: SELECT de.DMNED_LIBELLE_DOCUMENT + '/' + de.DMNED_PHASE_TRAITEMENT + '/' + ISNULL(de.DMNED_LOT, '') FROM v2.DEMANDE_EDITION AS de JOIN v2.DEMANDE AS d ON d.DMND_ID_DMND = de.DMNED_ID_DMND WHERE d.DMND_ID_DSRCS = 1100404 AND d.DMND_CODE_PROSS = 'RSURV' => Relance Greffe AP DCA SDCA/C/AMIRCSRBE
# La demande du dossier porte l'action RCS de sa diligence (trt.Dmnd.AddActionRcs, PROC_RSURV.cs:115).
controle: SELECT CAST(d.DMND_ID_ACTRC AS varchar(10)) FROM v2.DEMANDE AS d WHERE d.DMND_CODE_PROSS = 'RSURV' AND d.DMND_ID_DSRCS = 1100403 => 1100403
---
# Rejoue la relance de 403 : elle n'est plus due (sa relance 2 est du jour, limite {J+15}) -- refusee, rien d'ecrit.
geste: Agir Valider
ids: 1100403
resultat: refuse
message: RELANCE GAMMA SARL · SIREN 511 000 403 : aucune relance n'est due (la relance précédente n'est pas échue, ou la diligence est close).
