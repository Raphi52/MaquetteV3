controle: SELECT CASE WHEN c.DOCOC_FICHIER = o.DOCOC_FICHIER THEN 'meme fichier' ELSE 'autre fichier' END + '|' + CAST(c.DOCOC_NB_PAGES AS varchar(9)) + '|' + CAST(c.DOCOC_TAILLE AS varchar(9)) + '|' + COALESCE(c.DOCOC_CODE_PROC_EN_COURS, 'libre') + '|' + (SELECT DOCOT_TYPE + '=' + CONVERT(varchar(10), DOCOT_DONNEES_OCERISEES) + '/' + CAST(DOCOT_NUM_PAGE AS varchar(9)) FROM v2.DOCUMENT_OCERISE_TAGS WHERE DOCOT_ID_DOCOC = c.DOCOC_ID_DOCOC) FROM v2.DOCUMENT_OCERISE AS c CROSS JOIN v2.DOCUMENT_OCERISE AS o WHERE c.DOCOC_NOM_FICHIER = 'scan_du_banc_11-copie.tif' AND o.DOCOC_ID_DOCOC = 2110302 => meme fichier|1|500|libre|OCR_DIFFERE=0/0
controle: SELECT CAST((SELECT COUNT(*) FROM v2.DOCUMENT_OCERISE_TAGS WHERE DOCOT_ID_DOCOC = 2110302) AS varchar(9)) + ' / ' + COALESCE((SELECT DOCOC_CODE_PROC_EN_COURS FROM v2.DOCUMENT_OCERISE WHERE DOCOC_ID_DOCOC = 2110302), 'libre') => 1 / NUM
