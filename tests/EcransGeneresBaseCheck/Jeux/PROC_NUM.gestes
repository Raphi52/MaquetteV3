controle: SELECT CAST((SELECT COUNT(*) FROM v2.DOCUMENT_OCERISE WHERE DOCOC_ID_DOCOC = 2110301) AS varchar(9)) + ' / ' + CAST((SELECT COUNT(*) FROM v2.DOCUMENT_OCERISE_TAGS WHERE DOCOT_ID_DOCOC = 2110301) AS varchar(9)) + ' / ' + CAST((SELECT COUNT(*) FROM v2.DOCUMENT_OCERISE_TAGS WHERE DOCOT_ID_DOCOC = 2110302) AS varchar(9)) => 0 / 0 / 1
