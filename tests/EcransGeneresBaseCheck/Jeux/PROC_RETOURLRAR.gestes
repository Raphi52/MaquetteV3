controle: SELECT LRARI_TYPE_DATE + ' / ' + CONVERT(varchar(10), LRARI_DATE_RECEPTION, 103) FROM v2.LRAR_INFOS WHERE LRARI_NUM_LRAR = '1A2110101' => RECEPTION / 25/03/2001
