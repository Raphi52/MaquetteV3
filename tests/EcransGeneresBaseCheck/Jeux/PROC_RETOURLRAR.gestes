# « Pli non envoye », date non renseignee, sur 1A2110102 : PAS_ENVOYE n'est pas « a gerer » (PRMLI_A_GERER = 0) -- sa demande
# d'edition repart en emission (l. 825-835) : pre-emission au 01/01/1900, phase E, sans lot ni groupe.
geste: Confirmer Enregistrer le retour
ids: 1A2110102
valeur: Retour › Modalité de retour = Pli non envoyé
valeur: Retour › Date non renseignée = oui
resultat: fait
message: Pli 1A2110102 : Non envoyé · date non précisée sur l'imprimé. 1 demande d'édition remise en file d'émission.
controle: SELECT LRARI_TYPE_DATE + ' / ' + ISNULL(CONVERT(varchar(10), LRARI_DATE_RECEPTION, 103), 'sans date') FROM v2.LRAR_INFOS WHERE LRARI_NUM_LRAR = '1A2110102' => PAS_ENVOYE / sans date
controle: SELECT DMNED_PHASE_TRAITEMENT + ' / ' + CONVERT(varchar(10), DMNED_DATE_PRE_EMISSION, 103) + ' / ' + ISNULL(DMNED_LOT, 'sans lot') FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMNED = 2110102 => E / 01/01/1900 / sans lot
---
# Un retour deja saisi sans date (1A1200004, incomplet) se corrige : la V2 demande d'ecraser, la confirmation de l'operation en tient
# lieu, puis « Date reception mise a jour » (ChangementDateReception, l. 899-984). INCOMPLET etait « a gerer » : aucun courriel.
geste: Confirmer Enregistrer le retour
ids: 1A1200004
valeur: Retour › Modalité de retour = Réception
valeur: Retour › Date de réception = 2001-03-26
resultat: fait
message: Pli 1A1200004 : date réception mise à jour (Reçu le 26/03/2001).
controle: SELECT LRARI_TYPE_DATE + ' / ' + CONVERT(varchar(10), LRARI_DATE_RECEPTION, 103) FROM v2.LRAR_INFOS WHERE LRARI_NUM_LRAR = '1A1200004' => RECEPTION / 26/03/2001
---
