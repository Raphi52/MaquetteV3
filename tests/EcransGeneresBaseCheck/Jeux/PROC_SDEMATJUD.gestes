controle: SELECT m.DMND_NOM + '|' + m.DMND_ETAT_DEMANDE + '|' + m.DMND_CODE_PROSS FROM v2.DEMANDE AS m WHERE m.DMND_ID_DMND = (SELECT MAX(f.DMND_ID_DMND_MERE) FROM v2.DEMANDE AS f WHERE f.DMND_CODE_PROSS = 'SDEMATJUD') => Génération d'édition pour 2 instances|V|SDEMATJUD
controle: SELECT STRING_AGG(dd.DSSDM_CODE_SEQUENCEUR + ':' + dd.DSSDM_VALEUR_SEQUENCEUR + ':' + f.DMND_ETAT_DEMANDE + ':' + f.DMND_NUM_INDICATIF + ':' + f.DMND_NOM, ';') WITHIN GROUP (ORDER BY dd.DSSDM_CODE_SEQUENCEUR) FROM v2.DEMANDE AS f JOIN v2.DOSSIER_DEMANDE AS dd ON dd.DSSDM_ID_DMND = f.DMND_ID_DMND WHERE f.DMND_CODE_PROSS = 'SDEMATJUD' AND f.DMND_ID_DMND_MERE IS NOT NULL => 2P:1400103:V:1990P14103:CHM GAMMA;2R:1400201:V:1990V14201:XLIEN PRV ALPHA
controle: SELECT STRING_AGG(x, ';') WITHIN GROUP (ORDER BY x) FROM (SELECT f.DMND_NUM_INDICATIF + '=' + CAST(COUNT(*) AS varchar(3)) AS x FROM v2.DEMANDE_EDITION AS e JOIN v2.DEMANDE AS f ON f.DMND_ID_DMND = e.DMNED_ID_DMND WHERE f.DMND_CODE_PROSS = 'SDEMATJUD' GROUP BY f.DMND_NUM_INDICATIF) AS t => 1990P14103=3;1990V14201=1
controle: SELECT STRING_AGG(e.DMNED_VALEUR_ID_SOURCE + '/' + e.DMNED_PHASE_TRAITEMENT + '/' + e.DMNED_MEDIA + '/' + CAST(e.DMNED_NOMBRE_EXEMPLAIRE AS varchar(5)) + '/' + CAST(e.DMNED_IMPRESSION AS varchar(1)) + '/' + CAST(e.DMNED_AFF_AVANT_IMPRESSION AS varchar(1)) + '/' + e.DMNED_TYPE_GENERATION + '/' + e.DMNED_LIBELLE_DOCUMENT + '/' + ISNULL(e.DMNED_IMPRIMANTE, '-'), ';') WITHIN GROUP (ORDER BY e.DMNED_VALEUR_ID_SOURCE) FROM v2.DEMANDE_EDITION AS e JOIN v2.DEMANDE AS f ON f.DMND_ID_DMND = e.DMNED_ID_DMND WHERE f.DMND_CODE_PROSS = 'SDEMATJUD' => 1908210/P/IMPR/1/1/0/EMISSION_SIMPLE/Journal d'annonces légales numérisée/Imprimante banc 9;1908211/P/IMPR/1/1/0/EMISSION_SIMPLE/Justificatif de facture journal d'annonces légales numérisée/Imprimante banc 9;1908212/P/IMPR/1/1/0/EMISSION_SIMPLE/Journal d'annonces légales numérisée/Imprimante banc 9;1908214/P/IMPR/1/1/0/EMISSION_SIMPLE/Justificatif de facture journal d'annonces légales numérisée/Imprimante banc 9
controle: SELECT STRING_AGG(CAST(v.VGIDX_ID_VGIDX AS varchar(10)) + ':' + g.GDRG_EXTENSION + ':' + g.GDRG_BASE_VIDIGED + ':' + CASE WHEN g.GDRG_FICHIER IS NULL THEN 'sans fichier' ELSE 'fichier' END, ';') WITHIN GROUP (ORDER BY v.VGIDX_ID_VGIDX) FROM v2.DEMANDE_EDITION AS e JOIN v2.GED_RIG AS g ON g.GDRG_NUM_DOCUMENT = e.DMNED_NUM_DOCUMENT_EDITION JOIN v2.VIDIGED_INDEX AS v ON v.VGIDX_GUID_DOCUMENT = g.GDRG_GUID_VIDIGED AND CAST(v.VGIDX_ID_VGIDX AS varchar(40)) = e.DMNED_VALEUR_ID_SOURCE WHERE e.DMNED_CODE_ENTITE_SOURCE = 'VIDIGED_INDEX' => 1908210:TIF:JUDICIAIRE:sans fichier;1908211:pdf:JUDICIAIRE:sans fichier;1908212:pdf:JUDICIAIRE:sans fichier;1908214:pdf:JUDICIAIRE:sans fichier
