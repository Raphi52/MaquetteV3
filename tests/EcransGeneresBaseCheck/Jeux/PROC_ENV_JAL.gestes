controle: SELECT CAST(COUNT(*) AS varchar(9)) FROM v2.BORDEREAU_JAL WHERE BRDRJ_NUM_BORDEREAU IN ('B11J01', 'BB/0001') => 1
controle: SELECT PBLCT_ETAT_PUBLICITE + '|' + COALESCE(PBLCT_ETAT_XML, 'sans XML') + '|' + COALESCE(PBLCT_NUM_BORDEREAU, 'sans bordereau') + '|' + CASE WHEN PBLCT_DATE_ENVOI_ELECTRONIQUE IS NULL AND PBLCT_ID_BRDRJ IS NULL AND PBLCT_DOC_ENVOI_ELECTRONIQUE IS NULL THEN 'libre' ELSE 'liee' END FROM v2.PUBLICITE WHERE PBLCT_ID_PBLCT = 2110321 => 1|sans XML|sans bordereau|libre
controle: SELECT PBLCT_NUM_BORDEREAU FROM v2.PUBLICITE WHERE PBLCT_ID_PBLCT = 2110312 => BB/0001
