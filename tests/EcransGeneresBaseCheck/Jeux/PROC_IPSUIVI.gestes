controle: SELECT STRING_AGG(e.EVNPR_CODE_EVE_PRO + '|' + CAST(CAST(e.EVNPR_SURVENU AS int) AS varchar(1)) + '|' + CASE WHEN DATEDIFF(DAY, e.EVNPR_DATE, SYSDATETIME()) = 0 THEN 'du jour' ELSE 'autre date' END, ' / ') FROM v2.EVENEMENT_PROCEDURE AS e JOIN v2.INSTANCE AS i ON i.INSTN_ID_INSTN = e.EVNPR_ID_INSTN WHERE i.INSTN_ID_INSTN_INSTANCE_PRINCIPA = 1801702 AND i.INSTN_CODE_AFFAIRE = 'TIP1' => NOIP|1|du jour
