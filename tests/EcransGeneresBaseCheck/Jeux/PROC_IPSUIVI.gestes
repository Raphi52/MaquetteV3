controle: SELECT i.INSTN_CODE_AFFAIRE + '|' + i.INSTN_TYPE_INSTANCE + '|' + i.INSTN_NUM_ROLE + '|' + CASE WHEN i.INSTN_NUM_REP_GENERAL IS NULL THEN 'sans repertoire' ELSE 'repertoire' END + '|' + i.INSTN_NOM_COURANT + '|' + ISNULL(i.INSTN_NATURE_AFFAIRE, '-') + '|' + ISNULL(i.INSTN_NAT_AFF_PART, '-') + '|' + ISNULL(i.INSTN_CODE_ACTE_PROCE, '-') + '|' + CONVERT(varchar(10), i.INSTN_DATE_ACTE, 103) + '|' + CASE WHEN DATEDIFF(DAY, i.INSTN_DATE_JONCTION, SYSDATETIME()) = 0 THEN 'jointe du jour' ELSE 'jonction ?' END FROM v2.INSTANCE AS i WHERE i.INSTN_ID_INSTN_INSTANCE_PRINCIPA = 1801702 AND i.INSTN_CODE_AFFAIRE = 'TIP1' => TIP1|07|2026J81901|repertoire|CREANCIER OMICRON # DEBITEUR OMICRON|-|1B|LOI|15/01/2099|jointe du jour
controle: SELECT STRING_AGG(p.PRT_QUALIF_PARTIE + '|' + p.PRT_DESIGNATION + '|' + ISNULL(CAST(p.PRT_ID_ADRBS AS varchar(10)), '-') + '|' + CASE WHEN p.PRT_NUMERO_SOURCE IS NULL THEN 'sans source' WHEN p.PRT_NUMERO_SOURCE LIKE 'PRT-%' THEN 'source de l''IP' ELSE 'source neuve' END, ' / ') WITHIN GROUP (ORDER BY p.PRT_NUM_ORDRE, p.PRT_ID_PRT) FROM v2.PARTIE AS p JOIN v2.INSTANCE AS i ON i.INSTN_ID_INSTN = p.PRT_ID_INSTN WHERE i.INSTN_ID_INSTN_INSTANCE_PRINCIPA = 1801702 AND i.INSTN_CODE_AFFAIRE = 'TIP1' => DOIP|CREANCIER OMICRON|1801991|source neuve / FOIP|DEBITEUR OMICRON|-|source neuve
