controle: SELECT CONCAT(SCTMQ_LIBELLE, '/', SCTMQ_REQUETE_SQL, '/', SCTMQ_NIVEAU_OCCURRENCE, '/', SCTMQ_NIVEAU_FUSION, '/', SCTMQ_NIVEAU_GENERATION, '/', SCTMQ_NIVEAU_PERSISTANCE) FROM v2.SECTION_MAQUETTE WHERE SCTMQ_CODE_SECTION_MAQUETTE = 'L15_SECT' => Section banc modifiée/SELECT 3/2/2/1/0
---
# Refus : la V2 ne duplique pas une section (MetierAllowUserDuplicate = false, OPE_EDT_SECTION.cs:22). Jumeau accepte : le bloc « CREE »
# (un modele se duplique).
geste: Ajouter
ids: section:L15_SECT
valeur: Code = L15_SECT2
resultat: refuse
message: RIG v2 ne duplique pas une section (OPE_EDT_SECTION : duplication interdite).
---
# Refus : banc.ecrans ne supprime pas une section. Jumeau accepte : le bloc « SUPPRIMEE » (banc.amitel.l15).
geste: Supprimer
ids: section:L15_SECT
resultat: refuse
message: Les sections ne se modifient que par l'équipe Amitel : RIG v2 cache leur barre d'édition aux autres agents.
---
# SUPPRIMEE (OPE_EDT_SECTION.cs:75-77) par l'agent Amitel : la liste revient a celle de PROC_REDAA.attendu.
agent: banc.amitel.l15
geste: Supprimer
ids: section:L15_SECT
resultat: fait
message: Section « L15_SECT » supprimée.
