controle: SELECT CASE WHEN DCJDC_NUM_REPERTOIRE IS NULL AND CONVERT(date, DCJDC_DATE) = CONVERT(date, GETDATE()) THEN 'rendue sans minute' ELSE 'non' END FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC = 2000108 => rendue sans minute
controle: SELECT d.DMND_NOM + ' / ' + d.DMND_ETAT_DEMANDE + ' / ' + d.DMND_LES_NUMEROS + ' / ' + (SELECT x.DSSDM_VALEUR_SEQUENCEUR FROM v2.DOSSIER_DEMANDE AS x WHERE x.DSSDM_ID_DMND = d.DMND_ID_DMND AND x.DSSDM_CODE_SEQUENCEUR = '2R') + ' / ' + m.DMND_NOM + ' / ' + m.DMND_ETAT_DEMANDE FROM v2.DEMANDE AS d JOIN v2.DOSSIER_DEMANDE AS s ON s.DSSDM_ID_DMND = d.DMND_ID_DMND AND s.DSSDM_CODE_SEQUENCEUR = '2J' AND s.DSSDM_VALEUR_SEQUENCEUR = '2000108' JOIN v2.DEMANDE AS m ON m.DMND_ID_DMND = d.DMND_ID_DMND_MERE WHERE d.DMND_CODE_PROSS = 'ORDOSIGN' => ORDO H / V / 2026OS20108 / 2000801 / Décision rendue / V
controle: SELECT COUNT(*) FROM v2.EVENEMENT_PROCEDURE WHERE EVNPR_ID_INSTN = 2000108 => 0
---
# « Signer la sélection » sur 2000101 (type OPOS20 : serie JGOSX, evenement OSEVE20, expertise liee EXP20) : la date du jour et la minute
# du jour (_DoSauver, :3315-3327 ; num.Attribuer, le premier numero du jour : AAQQQ00001) ; l'evenement OSEVE20 survenu ce jour
# (_DoGenererEvenementsProcedure, :2546-2551) et son edition OS20NOTIF au document interne, phase C, sur la demande de l'instance
# (evePRo.CreateDemandeEdition, :2849) ; l'expertise EXP20 creee (DecisionJudiciaire.AddMesure), ouverte ce jour et numerotee JMEXP
# (:3365-3387) ; les numeros de la demande : le role, la minute, la mesure (:3361-3384).
geste: Agir Signer la sélection
ids: 2000101
resultat: fait
controle: SELECT CASE WHEN DCJDC_NUM_REPERTOIRE = RIGHT(CONVERT(varchar(4), YEAR(GETDATE())), 2) + RIGHT('00' + CONVERT(varchar(3), DATEPART(dayofyear, GETDATE())), 3) + '00001' AND CONVERT(date, DCJDC_DATE) = CONVERT(date, GETDATE()) THEN 'minute du jour' ELSE ISNULL(DCJDC_NUM_REPERTOIRE, 'sans minute') END FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC = 2000101 => minute du jour
controle: SELECT COUNT(*) FROM v2.EVENEMENT_PROCEDURE WHERE EVNPR_ID_INSTN = 2000101 AND EVNPR_CODE_EVE_PRO = 'OSEVE20' AND EVNPR_SURVENU = 1 AND CONVERT(date, EVNPR_DATE) = CONVERT(date, GETDATE()) => 1
controle: SELECT e.DMNED_LIBELLE_DOCUMENT + ' / ' + e.DMNED_PHASE_TRAITEMENT + ' / ' + d.DMND_CODE_PROSS + ' / ' + d.DMND_ETAT_DEMANDE FROM v2.DEMANDE_EDITION AS e JOIN v2.DEMANDE AS d ON d.DMND_ID_DMND = e.DMNED_ID_DMND JOIN v2.DOSSIER_DEMANDE AS s ON s.DSSDM_ID_DMND = d.DMND_ID_DMND AND s.DSSDM_CODE_SEQUENCEUR = '2J' AND s.DSSDM_VALEUR_SEQUENCEUR = '2000101' WHERE d.DMND_CODE_PROSS = 'ORDOSIGN' => Notification de l'ordonnance du banc 10 / C / ORDOSIGN / V
controle: SELECT m.MSINS_TYPE_MESURE + ' / ' + CASE WHEN m.MSINS_NUM_MESURE LIKE CONVERT(varchar(4), YEAR(GETDATE())) + 'X%' THEN 'JMEXP' ELSE ISNULL(m.MSINS_NUM_MESURE, 'sans numéro') END + ' / ' + CASE WHEN CONVERT(date, m.MSINS_DATE_OUVERTURE) = CONVERT(date, GETDATE()) THEN 'ouverte ce jour' ELSE 'autre date' END + ' / ' + CONVERT(varchar(10), m.MSINS_ID_INSTN) FROM v2.MESURE AS m WHERE m.MSINS_ID_DCJDC = 2000101 => EXP20 / JMEXP / ouverte ce jour / 2000101
controle: SELECT CASE WHEN d.DMND_LES_NUMEROS = '2026OS20101 ' + j.DCJDC_NUM_REPERTOIRE + ' ' + m.MSINS_NUM_MESURE THEN 'rôle, minute, mesure' ELSE d.DMND_LES_NUMEROS END + ' / ' + d.DMND_NOM + ' / ' + mere.DMND_NOM FROM v2.DEMANDE AS d JOIN v2.DOSSIER_DEMANDE AS s ON s.DSSDM_ID_DMND = d.DMND_ID_DMND AND s.DSSDM_CODE_SEQUENCEUR = '2J' AND s.DSSDM_VALEUR_SEQUENCEUR = '2000101' JOIN v2.DEMANDE AS mere ON mere.DMND_ID_DMND = d.DMND_ID_DMND_MERE JOIN v2.DECISION_JUDICIAIRE AS j ON j.DCJDC_ID_DCJDC = 2000101 JOIN v2.MESURE AS m ON m.MSINS_ID_DCJDC = 2000101 WHERE d.DMND_CODE_PROSS = 'ORDOSIGN' => rôle, minute, mesure / ORDO A / Décision rendue
controle: SELECT COUNT(*) FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC IN (2000103, 2000106, 2000107, 2000111, 2000112, 2000114, 2000115, 2000117, 2000118) AND DCJDC_DATE IS NOT NULL => 0
controle: SELECT COUNT(*) FROM v2.EVENEMENT_PROCEDURE WHERE EVNPR_ID_INSTN IN (2000106, 2000114) => 0
