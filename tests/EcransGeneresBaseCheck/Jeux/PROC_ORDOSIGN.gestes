controle: SELECT CASE WHEN DCJDC_NUM_REPERTOIRE IS NULL AND CONVERT(date, DCJDC_DATE) = CONVERT(date, GETDATE()) THEN 'rendue sans minute' ELSE 'non' END FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC = 2000107 => rendue sans minute
---
# « Signer la sélection » sur 2000101 (type a serie JGOSX) : la date du jour et la minute du jour (_DoSauver, :3315-3327 : serie,
# annee, quantieme ; num.Attribuer, le premier numero du jour : AAQQQ00001).
geste: Agir Signer la sélection
ids: 2000101
resultat: fait
controle: SELECT CASE WHEN DCJDC_NUM_REPERTOIRE = RIGHT(CONVERT(varchar(4), YEAR(GETDATE())), 2) + RIGHT('00' + CONVERT(varchar(3), DATEPART(dayofyear, GETDATE())), 3) + '00001' AND CONVERT(date, DCJDC_DATE) = CONVERT(date, GETDATE()) THEN 'minute du jour' ELSE ISNULL(DCJDC_NUM_REPERTOIRE, 'sans minute') END FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC = 2000101 => minute du jour
controle: SELECT COUNT(*) FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_DCJDC IN (2000103, 2000112, 2000117, 2000118) AND DCJDC_DATE IS NOT NULL => 0
