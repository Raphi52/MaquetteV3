# 15. PAY12-001 ACCEPTE : l'encaissement de 245,50 (le total du fichier), a la date de maintenant (date vide), arrivee de la demande
# D12INPI0001 (2206190), deux ventilations -- ENT12INPI0001 : 145,50 sur l'affaire 2206101 au client de sa derniere facture
# (2204201) ; A12INPI0002 : 100,00 sur 2206102 au client de SA derniere facture F12P003 (2204202), pas celui de la facture de la
# demande du numero (F12P002, 2204201). ENT12INPI0404 (0,00) est ignore. Le fichier passe a l'etat 2 sans demande (journal des gestes).
# Le titre de plus de 32 caracteres n'est pas un refus : la V2 le tronque (VerifieLongueurMax(true), :101).
geste: Agir Valider
ids: 2206001
valeur: Montant du virement = 245,50
valeur: Mode de paiement = L12VICB
valeur: N° de titre = VIR12-001-REFERENCE-BANCAIRE-TRES-LONGUE
resultat: fait
message: Fichier de reversements n°PAY12-001 validé dans la base du greffe : encaissement INPI de 245,50 € (L12VICB), 2 ventilations par numéro national. Le mode de paiement n'est pas enregistré comme défaut du greffe (réglage INPIPAY_MODE_PAIEMENT, non écrit par la V3).
lignes:
Reversement INPI PAY12-002 | extraction du {J-20} au {J-13} · 1 reversement · 80,00 € | Virements INPI | AFaire | []
Reversement INPI PAY12-005 | extraction du {J-9} au {J-8} · 1 reversement · 30,00 € | Virements INPI | AFaire | []
Reversement INPI PAY12-006 | extraction du {J-8} au {J-7} · 1 reversement · 25,00 € | Virements INPI | AFaire | []
Reversement INPI PAY12-007 | extraction du {J-7} au {J-6} · 1 reversement · 50,00 € | Virements INPI | AFaire | []
Reversement INPI PAY12-008 | extraction du {J-6} au {J-5} · 2 reversements · 15,00 € | Virements INPI | AFaire | []
controle: SELECT INPIRV_ETAT_TRAITEMENT FROM v2.INPI_REVERSEMENTS WHERE INPIRV_ID_INPIRV = 2206001 => 2
controle: SELECT CAST(INPIRV_MONTANT_VALIDATION AS decimal(19,2)) FROM v2.INPI_REVERSEMENTS WHERE INPIRV_ID_INPIRV = 2206001 => 245.50
controle: SELECT INPIRV_ID_UTLST FROM v2.INPI_REVERSEMENTS WHERE INPIRV_ID_INPIRV = 2206001 => 2000901
controle: SELECT COUNT(*) FROM v2.INPI_REVERSEMENTS WHERE INPIRV_ID_INPIRV = 2206001 AND INPIRV_DATE_TRAITEMENT IS NOT NULL AND INPIRV_ID_DMND IS NULL => 1
# L'encaissement : relu par le lien du fichier (INPIRV_ID_ENCMT), montants en decimal exact.
controle: SELECT CAST(e.ENCMT_MONTANT AS decimal(19,2)) FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => 245.50
controle: SELECT e.ENCMT_MODE_PAIEMENT + '|' + e.ENCMT_NUMERO_TITRE + '|' + e.ENCMT_DESIGNATION_PAYEUR + '|' + e.ENCMT_EXT_SOURCE + '|' + e.ENCMT_EXT_ID FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => L12VICB|VIR12-001-REFERENCE-BANCAIRE-TRE|INPI|INPI|PAY12-001
controle: SELECT e.ENCMT_COMMENTAIRE FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => Période du 01/10/2026 au 31/10/2026 Virement n°PAY12-001
controle: SELECT CONVERT(varchar(19), e.ENCMT_EXT_DATE, 120) FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => 2026-11-02 10:00:00
controle: SELECT CONCAT(e.ENCMT_ID_ARRV, '|', e.ENCMT_ID_UTLST, '|', LEN(e.ENCMT_GUID), '|', CASE WHEN e.ENCMT_GUID = UPPER(e.ENCMT_GUID) COLLATE Latin1_General_CS_AS THEN 'MAJ' ELSE 'min' END) FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => 2206190|2000901|36|MAJ
controle: SELECT COUNT(*) FROM v2.ENCAISSEMENT AS e INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 AND DATEDIFF(DAY, e.ENCMT_DATE_ENCAISSEMENT, GETDATE()) = 0 => 1
# Les ventilations : une par numero national, a la date de l'encaissement ; leur somme est le total du fichier.
controle: SELECT COUNT(*) FROM v2.VENTILATION AS v INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = v.VENTI_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => 2
controle: SELECT CAST(SUM(v.VENTI_MONTANT) AS decimal(19,2)) FROM v2.VENTILATION AS v INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = v.VENTI_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 => 245.50
controle: SELECT CAST(v.VENTI_MONTANT AS decimal(19,2)) FROM v2.VENTILATION AS v INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = v.VENTI_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 AND v.VENTI_ID_AFFRE = 2206101 AND v.VENTI_ID_CLIEN = 2204201 => 145.50
controle: SELECT CAST(v.VENTI_MONTANT AS decimal(19,2)) FROM v2.VENTILATION AS v INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = v.VENTI_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 AND v.VENTI_ID_AFFRE = 2206102 AND v.VENTI_ID_CLIEN = 2204202 => 100.00
controle: SELECT COUNT(*) FROM v2.VENTILATION AS v INNER JOIN v2.ENCAISSEMENT AS e ON e.ENCMT_ID_ENCMT = v.VENTI_ID_ENCMT INNER JOIN v2.INPI_REVERSEMENTS AS r ON r.INPIRV_ID_ENCMT = e.ENCMT_ID_ENCMT WHERE r.INPIRV_ID_INPIRV = 2206001 AND v.VENTI_DATE_VENTILATION = e.ENCMT_DATE_ENCAISSEMENT => 2
# La note interne des affaires (:166-169) ; 2206106 (PAY12-006, refuse) reste intacte.
controle: SELECT AFFRE_NOTE_INTERNE FROM v2.AFFAIRE WHERE AFFRE_ID_AFFRE = 2206101 => Commandes n° : 501, 502
controle: SELECT AFFRE_NOTE_INTERNE FROM v2.AFFAIRE WHERE AFFRE_ID_AFFRE = 2206102 => NOTE INPI Commandes n° : 503
controle: SELECT COUNT(*) FROM v2.AFFAIRE WHERE AFFRE_ID_AFFRE = 2206106 AND AFFRE_NOTE_INTERNE IS NULL => 1
# Le solde relu tombe juste : chaque affaire est soldee, ses factures (145,50 ; 60,00 + 40,00) moins ses ventilations = 0,00.
controle: SELECT CAST((SELECT SUM(f.FACTU_MONTANT_TTC) FROM v2.FACTURE AS f INNER JOIN v2.DEMANDE AS d ON d.DMND_NUM_DEMANDE = f.FACTU_NUM_DEMANDE WHERE d.DMND_ID_AFFRE = 2206101) - (SELECT SUM(VENTI_MONTANT) FROM v2.VENTILATION WHERE VENTI_ID_AFFRE = 2206101) AS decimal(19,2)) => 0.00
controle: SELECT CAST((SELECT SUM(f.FACTU_MONTANT_TTC) FROM v2.FACTURE AS f INNER JOIN v2.DEMANDE AS d ON d.DMND_NUM_DEMANDE = f.FACTU_NUM_DEMANDE WHERE d.DMND_ID_AFFRE = 2206102) - (SELECT SUM(VENTI_MONTANT) FROM v2.VENTILATION WHERE VENTI_ID_AFFRE = 2206102) AS decimal(19,2)) => 0.00
