# Les gestes de EcrivainConvocations (« Convocations », PROC_GCONV) : « Citer par huissier », joué par la route POST sur les lignes
# du cabinet 1706101 de PROC_GCONV.sql (identifiant de ligne : instance-demande d'édition-relance-exercice, LecteurConvocations.cs).
# Format : en tête de tests/EcransGeneresBaseCheck/Program.cs. Un refus n'écrit rien ; chaque refus a son jumeau accepté (bloc 5).
# Le refus « maquette sans destinataire huissier » se prouve sur la copie de dev (aucune maquette CITATION n'y a de « H ») : ce jeu
# pose la maquette, il ne peut pas la retirer d'un bloc à l'autre.
# fix-ok: banc du 27/11/2026, mesuré -- « Cannot perform an aggregate function on an expression containing an aggregate or a
# subquery » : le numéro source de la citation se lit par OUTER APPLY, jamais par une sous-requête dans STRING_AGG.

# 1. Une LRAR revenue NPAI : la ligne est grisée, non cochable (OPE_CITATIONS.cs:94-95). Jumeau : bloc 5 (LRAR sans retour).
geste: Decider Citer par huissier
ids: 1706013-1706413-1706613-
valeur: Huissier = 1706901
resultat: refuse
message: La LRAR de l'instance 2026J17603 est revenue (NPAI) : sa ligne est grisée, elle ne se cite pas.
---
# 2. Sans huissier (Verifier, OPE_CITATIONS.cs:270-272). Jumeau : bloc 5.
geste: Decider Citer par huissier
ids: 1706011-1706411-1706611-
resultat: refuse
message: La saisie de l'huissier est obligatoire pour l'instance 2026J17601
---
# 3. Une instance cochée deux fois (doublons de numéro de rôle, :307-320). Jumeau : bloc 5 (chaque instance une fois).
geste: Decider Citer par huissier
ids: 1706011-1706411-1706611-,1706011-1706411-1706611-
valeur: Huissier = 1706901
resultat: refuse
message: L'instance suivante 2026J17601 a été cochée plusieurs fois.
---
# 4. Un huissier absent de la base : la liste de RIG v2 ne le proposerait pas. Jumeau : bloc 5 (l'intervenant 1706901).
geste: Decider Citer par huissier
ids: 1706011-1706411-1706611-
valeur: Huissier = 1706999
resultat: refuse
message: L'huissier « 1706999 » n'est pas dans la base du greffe.
---
# 5. Deux instances : une citation SURVENUE au code CITATION, datée du jour, numéro d'ordre = événements de l'instance + 1
#    (OPE_CITATIONS.cs:245, Instance.cs:594-596). 1706011 devient « Citée » ; 1706014 (sans retour de LRAR) aussi.
#    Une demande « GCONV instance <rôle> » par instance, code GCONV, validée, sans affaire, avec le dossier RCS (createDemande,
#    :500-505 ; Cloturer("V"), :330). Ses éditions dans la file (EditionsEvenementV2 ; OPE_CITATIONS.cs:334-459) : 1706011 (nature
#    INJ17) n'a que la maquette CITATION17B (« +NAINJ17 »), 1706014 (sans nature) que CITATION17A (« -NAINJ17 ») ; « H,CFEC » donne
#    une lettre simple aux huissiers sans coffre (H17SIM ; H17FUT, coffre pas encore ouvert) et une « - Coffre » à H17COF ; H17INA,
#    inactif, n'y est pas. Source = l'événement de citation (EVT_PROC), libellé source « CITATION - <jour> (EP sans n° ordre) »
#    (l'événement n'est pas encore sauvé quand RIG v2 calcule ses éditions). L'huissier intervenant est ajouté coché, tout autre
#    huissier décoché (:367-386) ; sans nom de coffre, l'édition garde son impression.
geste: Decider Citer par huissier
ids: 1706011-1706411-1706611-,1706014-1706414-1706614-
valeur: Huissier = 1706901
resultat: fait
message: 2 citations par huissier enregistrées (HUISSIER BANC). 4 éditions placées dans la file des éditions. La copie conforme de l'ordonnance et la facture ne sont pas produites : RIG v2 tire la copie de la GED et facture les articles de la citation par son moteur de facturation, que RIG v3 ne reprend pas.
controle: SELECT STRING_AGG(CONCAT(EVNPR_ID_INSTN, ':', EVNPR_NUM_ORDRE, ':', CAST(EVNPR_SURVENU AS int), ':', EVNPR_TYPE_EVE_PRO, ':', CASE WHEN EVNPR_DATE = CAST(GETDATE() AS date) THEN 'jour' ELSE CONVERT(varchar(10), EVNPR_DATE, 23) END), ',') WITHIN GROUP (ORDER BY EVNPR_ID_INSTN) FROM v2.EVENEMENT_PROCEDURE WHERE EVNPR_CODE_EVE_PRO = 'CITATION' AND EVNPR_ID_INSTN IN (1706011, 1706014) => 1706011:2:1:S:jour,1706014:2:1:S:jour
controle: SELECT STRING_AGG(CONCAT(DMND_NOM, ':', DMND_CODE_PROSS, ':', DMND_ETAT_DEMANDE, ':', DMND_NUM_INDICATIF, ':', ISNULL(CAST(DMND_ID_DSRCS AS varchar(10)), '-'), ':', ISNULL(CAST(DMND_ID_AFFRE AS varchar(10)), '-')), ',') WITHIN GROUP (ORDER BY DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_NOM LIKE 'GCONV instance 2026J176%' => GCONV instance 2026J17601:GCONV:V:2026J17601:-:-,GCONV instance 2026J17604:GCONV:V:2026J17604:1706731:-
controle: SELECT STRING_AGG(CONCAT(d.DMND_NUM_INDICATIF, '|', de.DMNED_LIBELLE_DOCUMENT, '|', CAST(de.DMNED_ENVOI_AU_COFFRE AS int), CAST(de.DMNED_IMPRESSION AS int), '|', de.DMNED_PHASE_TRAITEMENT, '|', de.DMNED_CODE_ENTITE_SOURCE, '|', CASE WHEN de.DMNED_VALEUR_ID_SOURCE = c.EVNPR_NUMERO_SOURCE THEN 'citation' ELSE de.DMNED_VALEUR_ID_SOURCE END, '|', de.DMNED_CODE_MAQUETTE, '|', de.DMNED_TYPE_GENERATION, '|', ISNULL(de.DMNED_TYPE_DOCUMENT, '-'), '|', de.DMNED_NOMBRE_EXEMPLAIRE, '|', REPLACE(de.DMNED_LIBELLE_SOURCE, CONVERT(varchar(10), GETDATE(), 103), 'jour')), ',') WITHIN GROUP (ORDER BY de.DMNED_ID_DMNED) FROM v2.DEMANDE_EDITION AS de JOIN v2.DEMANDE AS d ON d.DMND_ID_DMND = de.DMNED_ID_DMND OUTER APPLY (SELECT TOP (1) e.EVNPR_NUMERO_SOURCE FROM v2.EVENEMENT_PROCEDURE AS e JOIN v2.INSTANCE AS i ON i.INSTN_ID_INSTN = e.EVNPR_ID_INSTN WHERE e.EVNPR_CODE_EVE_PRO = 'CITATION' AND i.INSTN_NUM_ROLE = d.DMND_NUM_INDICATIF ORDER BY e.EVNPR_ID_EVNPR DESC) AS c WHERE d.DMND_NOM LIKE 'GCONV instance 2026J176%' => 2026J17601|LETTRE HUISS 17B|01|C|EVT_PROC|citation|CIT17B|FUSION_RIG|NOTIF|1|CITATION - jour (EP sans n° ordre),2026J17601|LETTRE HUISS 17B - Coffre|11|C|EVT_PROC|citation|CIT17B|FUSION_RIG|NOTIF|1|CITATION - jour (EP sans n° ordre),2026J17604|LETTRE HUISS 17A|01|C|EVT_PROC|citation|CIT17A|FUSION_RIG|-|2|CITATION - jour (EP sans n° ordre),2026J17604|LETTRE HUISS 17A - Coffre|11|C|EVT_PROC|citation|CIT17A|FUSION_RIG|-|2|CITATION - jour (EP sans n° ordre)
controle: SELECT CONCAT(SUM(CASE WHEN de.DMNED_PARAMETRE_GENERATION LIKE '%PAR_DEFAUT=&quot;1&quot; CODE=&quot;INST_H&quot; VALEUR=&quot;HUISSIER BANC&quot;%' THEN 1 ELSE 0 END), ':', SUM(CASE WHEN de.DMNED_PARAMETRE_GENERATION LIKE '%PAR_DEFAUT=&quot;1&quot; CODE=&quot;INST_H&quot; VALEUR=&quot;H17%' THEN 1 ELSE 0 END), ':', SUM(CASE WHEN de.DMNED_PARAMETRE_GENERATION LIKE '%VALEUR=&quot;H17INA&quot;%' THEN 1 ELSE 0 END)) FROM v2.DEMANDE_EDITION AS de JOIN v2.DEMANDE AS d ON d.DMND_ID_DMND = de.DMNED_ID_DMND WHERE d.DMND_NOM LIKE 'GCONV instance 2026J176%' => 4:0:0
---
# 6. Une maquette que la V3 ne reprend pas (destinataire demandeur « D », EditionsEvenementV2) : 1706012 (nature REF17) a la maquette
#    CITATION17C (« +NAREF17 », « D,LRAR ») ; rien n'est écrit, ni citation ni édition. Jumeau : bloc 5 (1706011, même cabinet, que
#    CITATION17C ne vise pas).
geste: Decider Citer par huissier
ids: 1706012-1706412-1706612-
valeur: Huissier = 1706901
resultat: refuse
message: Le destinataire « D » de l'édition CITATION17C n'est pas repris par RIG v3 : rien n'est enregistré, faire la citation dans RIG v2.
---
# 7. Un huissier destinataire institutionnel AVEC coffre, et « Éditer le Kbis » coché (CheckBoxEditerKbis, :436-457). 1706014 est
#    cité à nouveau (RIG v2 laisse cocher une instance déjà citée) : CITATION17A, lettre simple et « - Coffre ». Seul H17COF reste
#    coché (:384-386) ; son nom de coffre fait passer les deux éditions au coffre, sans impression (:388-391). Pour CHAQUE édition un
#    KBIS du dossier 1706731 (LOT1_KBISXML_1_PDF, RIG_LOT_UN, source DOSSIER_RCS), au coffre comme elle, avec ses destinataires.
geste: Decider Citer par huissier
ids: 1706014-1706414-1706614-
valeur: Huissier = H17COF
valeur: Éditer le Kbis = oui
resultat: fait
message: 1 citation par huissier enregistrée (H17COF). 4 éditions placées dans la file des éditions. La copie conforme de l'ordonnance et la facture ne sont pas produites : RIG v2 tire la copie de la GED et facture les articles de la citation par son moteur de facturation, que RIG v3 ne reprend pas.
controle: SELECT STRING_AGG(CONCAT(de.DMNED_LIBELLE_DOCUMENT, '|', CAST(de.DMNED_ENVOI_AU_COFFRE AS int), CAST(de.DMNED_IMPRESSION AS int), '|', de.DMNED_CODE_ENTITE_SOURCE, '|', CASE WHEN de.DMNED_VALEUR_ID_SOURCE = c.EVNPR_NUMERO_SOURCE THEN 'citation' ELSE de.DMNED_VALEUR_ID_SOURCE END, '|', de.DMNED_TYPE_GENERATION, '|', CASE WHEN de.DMNED_PARAMETRE_GENERATION LIKE '%PAR_DEFAUT=&quot;1&quot; CODE=&quot;INST_H&quot; VALEUR=&quot;H17COF&quot;%' THEN 'H17COF' ELSE '-' END, CASE WHEN de.DMNED_PARAMETRE_GENERATION LIKE '%PAR_DEFAUT=&quot;1&quot; CODE=&quot;INST_H&quot; VALEUR=&quot;H17SIM%' OR de.DMNED_PARAMETRE_GENERATION LIKE '%PAR_DEFAUT=&quot;1&quot; CODE=&quot;INST_H&quot; VALEUR=&quot;H17FUT%' THEN '+autre' ELSE '' END), ',') WITHIN GROUP (ORDER BY de.DMNED_ID_DMNED) FROM v2.DEMANDE_EDITION AS de OUTER APPLY (SELECT TOP (1) e.EVNPR_NUMERO_SOURCE FROM v2.EVENEMENT_PROCEDURE AS e WHERE e.EVNPR_CODE_EVE_PRO = 'CITATION' AND e.EVNPR_ID_INSTN = 1706014 ORDER BY e.EVNPR_ID_EVNPR DESC) AS c WHERE de.DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_NOM = 'GCONV instance 2026J17604') => LETTRE HUISS 17A|10|EVT_PROC|citation|FUSION_RIG|-,KBIS|10|DOSSIER_RCS|1706731|RIG_LOT_UN|-,LETTRE HUISS 17A - Coffre|10|EVT_PROC|citation|FUSION_RIG|H17COF,KBIS|10|DOSSIER_RCS|1706731|RIG_LOT_UN|H17COF
controle: SELECT COUNT(*) FROM v2.EVENEMENT_PROCEDURE WHERE EVNPR_CODE_EVE_PRO = 'CITATION' AND EVNPR_ID_INSTN = 1706014 => 2
---
# 8. « Éditer le Kbis » coché sans dossier RCS : RIG v2 lit node.Dossier sans garde (:442) ; son message pour un dossier
#    introuvable (:301). La relance de 1706011 est sur la diligence 1706701, sans action. Jumeau : bloc 7 (1706014, dossier 1706731).
geste: Decider Citer par huissier
ids: 1706011-1706411-1706611-
valeur: Huissier = 1706901
valeur: Éditer le Kbis = oui
resultat: refuse
message: La récupération du dossier RCS pour l'instance 2026J17601 a échoué.
