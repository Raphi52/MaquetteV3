controle: SELECT COUNT(*) FROM v2.DEMAT_RPJC_REN WHERE RPJCR_ID_RPJCR = 2600106 AND RPJCR_ETAT = '2' AND RPJCR_ETAT_TRAITEMENT_RIG = 'R' AND RPJCR_CODE_REJET_RIG = 'DIVERS' AND RPJCR_DATE_PRONONCE_REJET_RIG IS NULL AND RPJCR_MOTIF_REJET_RIG IS NULL => 1
