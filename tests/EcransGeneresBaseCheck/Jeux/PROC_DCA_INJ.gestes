controle: SELECT STRING_AGG(c.CHFDM_CODE_CHEF + ':' + c.CHFDM_TEXTE_LIBRE, ' / ') WITHIN GROUP (ORDER BY c.CHFDM_TEXTE_LIBRE) FROM v2.CHEF_DEMANDE AS c JOIN v2.RELANCE_RCS AS r ON r.RLCRC_ID_INSTN = c.CHFDM_ID_INSTN WHERE r.RLCRC_ID_DLGRC = 1800662 => INJ18:31/12/2022 / INJ18:31/12/2023
controle: SELECT STRING_AGG(CAST(r.RLCRC_NUM_ORDRE AS varchar(3)) + ':' + r.RLCRC_TYPE_RELANCE, ',') WITHIN GROUP (ORDER BY r.RLCRC_NUM_ORDRE) FROM v2.RELANCE_RCS AS r WHERE r.RLCRC_ID_DLGRC = 1800662 => 1:S,2:IDCA,3:IDCA
