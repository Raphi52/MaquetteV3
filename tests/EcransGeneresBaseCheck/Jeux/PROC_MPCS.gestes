controle: SELECT CONCAT(APPAF_CODE_PLUMITIF, ':', APPAF_ETAT_RETOUR) FROM v2.APPEL_AFFAIRE WHERE APPAF_ID_APPAF = 1705526 => M17N:M
controle: SELECT COUNT(*) FROM v2.DECISION_JUDICIAIRE WHERE DCJDC_ID_INSTN = 1705026 => 1
