controle: SELECT STRING_AGG(CONCAT(m.MSINS_ID_INSTN, ':', m.MSINS_NUM_ORDRE, ':', m.MSINS_TYPE_MESURE, ':', CASE WHEN LEN(m.MSINS_NUMERO_SOURCE) = 36 THEN 'guid' ELSE '-' END, ':', d.DCJDC_TYPE_DECISION), ',') FROM v2.MESURE AS m JOIN v2.DECISION_JUDICIAIRE AS d ON d.DCJDC_ID_DCJDC = m.MSINS_ID_DCJDC WHERE m.MSINS_ID_INSTN = 1705034 => 1705034:1:EXP17:guid:T17M
