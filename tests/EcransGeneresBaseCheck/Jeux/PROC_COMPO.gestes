# 13. Créer la composition d'une audience qui n'en a pas : numéro 1, par défaut (AudienceCabinet.cs:1338-1350, Composition.cs:359),
#     greffier et parquetier ; les siégeants dans l'ordre saisi, « PAU » puis « JAU » (Composition.cs:365-379).
geste: Decider Valider
ids: 1702120
valeur: Juges = J17A, J17B
valeur: Greffier = G17A
valeur: Parquetier = P17A
resultat: fait
message: Composition enregistrée : 2 juges, greffier G17A, parquetier P17A.
controle: SELECT COUNT(*) FROM v2.COMPOSITION WHERE CMPST_ID_ADNC = 1702120 AND CMPST_NUM_ORDRE = 1 AND CMPST_PAR_DEFAUT = 1 AND CMPST_ID_GRASS = 1702511 AND CMPST_ID_PRQTR = 1702701 => 1
controle: SELECT COUNT(*) FROM v2.COMPOSITION WHERE CMPST_ID_ADNC = 1702120 => 1
controle: SELECT STRING_AGG(CONCAT(s.SGR_ID_JUG, ':', s.SGR_NUM_ORDRE, ':', s.SGR_TITRE_SIEGEANT), ',') WITHIN GROUP (ORDER BY s.SGR_NUM_ORDRE) FROM v2.SIEGER AS s JOIN v2.COMPOSITION AS c ON c.CMPST_ID_CMAUD = s.SGR_ID_CMAUD WHERE c.CMPST_ID_ADNC = 1702120 => 1702311:1:PAU,1702312:2:JAU
---
# 14. Modifier la seule composition d'une audience : renumérotée 1 et par défaut, nouveau greffier, plus de parquetier ; les
#     siégeants existants gardent leur ligne (ETP_COMPO_AUDIENCE.cs:314) dans le nouvel ordre, le troisième, de trop, est supprimé.
geste: Decider Valider
ids: 1702121
valeur: Juges = J17C, J17A
valeur: Greffier = G17B
resultat: fait
message: Composition enregistrée : 2 juges, greffier G17B.
controle: SELECT CONCAT(CMPST_NUM_ORDRE, ':', CAST(CMPST_PAR_DEFAUT AS int), ':', CMPST_ID_GRASS, ':', ISNULL(CAST(CMPST_ID_PRQTR AS varchar(10)), '-')) FROM v2.COMPOSITION WHERE CMPST_ID_CMAUD = 1702204 => 1:1:1702512:-
controle: SELECT STRING_AGG(CONCAT(SGR_ID_SGR, ':', SGR_ID_JUG, ':', SGR_NUM_ORDRE, ':', SGR_TITRE_SIEGEANT), ',') WITHIN GROUP (ORDER BY SGR_NUM_ORDRE) FROM v2.SIEGER WHERE SGR_ID_CMAUD = 1702204 => 1702601:1702313:1:PAU,1702602:1702311:2:JAU
