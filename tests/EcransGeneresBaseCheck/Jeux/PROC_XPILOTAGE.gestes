# Deux cellules de la feuille RCS (« 1 »), janvier 2026 : « Tableau pilotage RCS du 01-01-2026 au 31-01-2026 » (:183), la demande
# XPILOTAGE validee a ce nom, et son edition REPORT_SQL rattachee, « Tableau de pilotage » en libelle source (:240).
geste: Agir Visualiser
ids: 1900601|20260101|20260131,1900603|20260101|20260131
resultat: fait
controle: SELECT CONCAT(d.DMND_ETAT_DEMANDE, '|', e.DMNED_LIBELLE_DOCUMENT, '|', e.DMNED_TYPE_GENERATION, '|', e.DMNED_LIBELLE_SOURCE) FROM v2.DEMANDE AS d JOIN v2.DEMANDE_EDITION AS e ON e.DMNED_ID_DMND = d.DMND_ID_DMND WHERE d.DMND_CODE_PROSS = 'XPILOTAGE' AND d.DMND_NOM = 'Tableau pilotage RCS du 01-01-2026 au 31-01-2026' => V|Tableau pilotage RCS du 01-01-2026 au 31-01-2026|REPORT_SQL|Tableau de pilotage
---
