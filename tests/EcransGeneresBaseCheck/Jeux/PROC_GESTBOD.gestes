controle: SELECT CONCAT(DMNED_LIBELLE_DOCUMENT, '|', DMNED_CODE_MAQUETTE, '|', DMNED_NUM_GROUPE, '|', DMNED_CODE_ENTITE_SOURCE, '|', CASE WHEN DMNED_VALEUR_ID_SOURCE = CONVERT(varchar(20), DMNED_ID_DMND) THEN 'la demande' ELSE DMNED_VALEUR_ID_SOURCE END, '|[', DMNED_LIBELLE_SOURCE, ']') FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') => Liste des rejets du BODACC|LOT2_LISTE_REJETS|ListeRejetsBodacc|DEMANDE|la demande|[ ]
controle: SELECT CONCAT(x.p.value('(/PARAMETRES/@TitreEtat)[1]', 'nvarchar(200)'), '|', x.p.value('(/PARAMETRES/@GreffeNom)[1]', 'nvarchar(200)'), '|', x.p.exist('/PARAMETRES/@LISTE_ENTITE_DESTINATION')) FROM v2.DEMANDE_EDITION CROSS APPLY (SELECT CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)) AS p) AS x WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') => Bodacc rejeté dont la date envoi est 02/04/2001|GREFFE DU TRIBUNAL DE COMMERCE DU BANC<BR>ONZE|0
controle: SELECT CONCAT('[', CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)).value('(/PARAMETRES/@SQL)[1]', 'nvarchar(max)'), ']') FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') => [ Select Isnull(PREVE_NUM_PRV,PRCLL_NUM_PC) as NUM_PC_OU_PRV , EVNPR_CODE_EVE_PRO, EVNPR_DATE, BDCCR_DATE_ENVOI, isnull(BDCCR_MOTIF_REJET_BODACC_1,'') + ' ' + isnull(BDCCR_MOTIF_REJET_BODACC_2,'') + case isnull(BDCCR_COMMENTAIRE,'') when '' then '' else ' Commentaire : ' + BDCCR_COMMENTAIRE end as BDCCR_MOTIF_REJET, convert(varchar(8000),BDCCR_TEXTE_BODACC)  From BODACC With (nolock) INNER JOIN EVENEMENT_PROCEDURE With (nolock) ON BDCCR_ID_EVNPR = EVNPR_ID_EVNPR LEFT OUTER JOIN PROCEDURE_COLLECTIVE With (nolock) ON EVNPR_ID_PRCLL = PRCLL_ID_PRCLL LEFT OUTER JOIN PREVENTION With (nolock) ON EVNPR_ID_PREVE = PREVE_ID_PREVE  Where BDCCR_DATE_ENVOI = convert(datetime, '02/04/2001',103) And (BDCCR_ETAT_BODACC = '9' AND BDCCR_TYPE_BODACC like 'P%') UNION  Select Isnull(PREVE_NUM_PRV,PRCLL_NUM_PC) as NUM_PC_OU_PRV , EVNPR_CODE_EVE_PRO, EVNPR_DATE, BDCCR_DATE_ENVOI, isnull(BDCCR_MOTIF_REJET_BODACC_1,'') + ' ' + isnull(BDCCR_MOTIF_REJET_BODACC_2,'') + case isnull(BDCCR_COMMENTAIRE,'') when '' then '' else ' Commentaire : ' + BDCCR_COMMENTAIRE end as BDCCR_MOTIF_REJET, convert(varchar(8000),BDCCR_TEXTE_BODACC)  From BODACC With (nolock) INNER JOIN EVENEMENT_PROCEDURE With (nolock) ON BDCCR_ID_EVNPR = EVNPR_ID_EVNPR LEFT OUTER JOIN PROCEDURE_COLLECTIVE With (nolock) ON EVNPR_ID_PRCLL = PRCLL_ID_PRCLL LEFT OUTER JOIN PREVENTION With (nolock) ON EVNPR_ID_PREVE = PREVE_ID_PREVE  WHERE BDCCR_ID_PREC_BOD in (Select BDCCR_ID_BDCRC From BODACC With (nolock)  Where BDCCR_DATE_ENVOI = convert(datetime, '02/04/2001',103) And (BDCCR_ETAT_BODACC = '9' AND BDCCR_TYPE_BODACC like 'P%') AND BDCCR_ID_EVNPR is null)]
