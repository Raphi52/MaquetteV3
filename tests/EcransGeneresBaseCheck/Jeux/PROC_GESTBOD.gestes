controle: SELECT CONCAT(DMNED_CODE_MAQUETTE, '|', x.p.value('(/PARAMETRES/@TitreEtat)[1]', 'nvarchar(200)'), '|', CASE WHEN CHARINDEX('PREVE_ID_PREVE  Where EVNPR_DATE between convert(datetime, ''01/04/2001'',103) and convert(datetime, ''01/04/2001'',103) And (BDCCR_ETAT_BODACC = ''5'' or BDCCR_ETAT_BODACC = ''6'' or BDCCR_ETAT_BODACC = ''10'') And BDCCR_CONTROLE_QUALITE is not null', x.p.value('(/PARAMETRES/@SQL)[1]', 'nvarchar(max)')) > 0 THEN 1 ELSE 0 END) FROM v2.DEMANDE_EDITION CROSS APPLY (SELECT CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)) AS p) AS x WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') => LOT2_LISTE_QUALITENC|Listes des 2 Bodaccs en contrôle qualité non conforme dont la date d'évènement est comprise entre le 01/04/2001 et le 01/04/2001|1
