# Certificat 2110210 de la PC 1990P14101 : une demande CERTIF_BOD par destinataire -- le mandataire MDJ 1400551, au coffre-fort (nom et
# date de demarrage passee : envoi au coffre, pas d'impression, CFE-CP « BODACC », :85-93), puis le document interne (« DI », :77).
geste: Confirmer Éditer
ids: C-2110210
resultat: fait
message: 2 éditions placées dans la file des éditions : Certificat de parution au Bodacc, 1990P14101 EP BANC11C du 15/05/2001 00:00:00 → Me MANDAUN Selarl (coffre-fort) ; Certificat de parution au Bodacc, 1990P14101 EP BANC11C du 15/05/2001 00:00:00 → document interne. Impression et envoi au coffre-fort simulés : le service d'édition de RIG v2 les fait, RIG v3 ne l'appelle pas.
controle: SELECT CONCAT(DMND_ETAT_DEMANDE, '/', DMND_CODE_PROSS, '/', CONVERT(int, DMND_EN_COURS), '/', (SELECT COUNT(*) FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMND = d.DMND_ID_DMND)) FROM v2.DEMANDE AS d WHERE DMND_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') => V/GESTBOD/0/2
controle: SELECT CONCAT(DMNED_LIBELLE_DOCUMENT, '|', DMNED_CODE_MAQUETTE, '|', CONVERT(int, DMNED_ENVOI_AU_COFFRE), '|', CONVERT(int, DMNED_IMPRESSION), '|', DMNED_CODE_CFECP, '|', DMNED_CODE_ENTITE_SOURCE, '|', DMNED_VALEUR_ID_SOURCE, '|', DMNED_LIBELLE_SOURCE, '|', DMNED_CODE_PROCESSUS, '|', DMNED_TYPE_DOCUMENT, '|', DMNED_PHASE_TRAITEMENT) FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') AND DMNED_ENVOI_AU_COFFRE = 1 => Certificat de parution au Bodacc, 1990P14101 EP BANC11C du 15/05/2001 00:00:00|3801_CERTIF_BOD|1|0|BODACC|BODACC|NS-2110210|Jgt ouverture du banc|EDT_CRTBOD|BODAC|C
controle: SELECT CONCAT(e.value('@PAR_DEFAUT', 'varchar(1)'), '|', e.value('@CODE', 'varchar(10)'), '|', e.value('@VALEUR', 'varchar(10)'), '|', e.value('@LIBELLE', 'nvarchar(100)'), '|', e.value('@EMAIL', 'varchar(100)'), '|', e.value('@NOM_COFFRE', 'varchar(100)'), '|', e.value('@KEY_DESTINATAIRE', 'varchar(100)'), '|', e.value('@ADRESSE', 'nvarchar(400)')) FROM v2.DEMANDE_EDITION CROSS APPLY (SELECT CONVERT(xml, CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)).value('(/PARAMETRES/@LISTE_ENTITE_DESTINATION)[1]', 'nvarchar(max)')) AS l) AS x CROSS APPLY x.l.nodes('/LISTE_ENTITES/ENTITE') AS t(e) WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') AND DMNED_ENVOI_AU_COFFRE = 1 => 1|MDJ|1400551|Me MANDAUN Selarl|mandaun@banc.test|COFFRE-MANDAUN|GERER_PC_MDJ_1400551|Toque n° 42&amp;crlf;Résidence du Banc&amp;crlf;12 bis avenue des Essais &amp; Mesures&amp;crlf;BP 7&amp;crlf;38000 GRENOBLE CEDEX 1
# La reference du mandataire (GRRPC_NUMERO_INTERNE de sa mission 1400761) et le pays de son adresse (ADRBS_PAYS : BEL, PROC_GESTBOD.sql),
# comme RIG v2 (DestinatairesEditionsLot2.cs:1643, :1647) ; le document interne garde le defaut d'ENTITE : pas de reference, PAYS FRA.
controle: SELECT CONCAT(COALESCE(e.value('@REFERENCE_DESTINATAIRE', 'varchar(15)'), 'absente'), '|', e.value('@PAYS', 'varchar(3)')) FROM v2.DEMANDE_EDITION CROSS APPLY (SELECT CONVERT(xml, CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)).value('(/PARAMETRES/@LISTE_ENTITE_DESTINATION)[1]', 'nvarchar(max)')) AS l) AS x CROSS APPLY x.l.nodes('/LISTE_ENTITES/ENTITE') AS t(e) WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') AND DMNED_ENVOI_AU_COFFRE = 1 => MDJ-2110-11|BEL
controle: SELECT CONCAT(COALESCE(e.value('@REFERENCE_DESTINATAIRE', 'varchar(15)'), 'absente'), '|', e.value('@PAYS', 'varchar(3)')) FROM v2.DEMANDE_EDITION CROSS APPLY (SELECT CONVERT(xml, CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)).value('(/PARAMETRES/@LISTE_ENTITE_DESTINATION)[1]', 'nvarchar(max)')) AS l) AS x CROSS APPLY x.l.nodes('/LISTE_ENTITES/ENTITE') AS t(e) WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') AND DMNED_ENVOI_AU_COFFRE = 0 => absente|FRA
controle: SELECT CONCAT(CONVERT(int, DMNED_IMPRESSION), '|', CONVERT(int, DMNED_ENVOI_AU_COFFRE), '|', ISNULL(DMNED_CODE_CFECP, 'null'), '|', CONVERT(xml, CONVERT(xml, CONVERT(nvarchar(max), DMNED_PARAMETRE_GENERATION)).value('(/PARAMETRES/@LISTE_ENTITE_DESTINATION)[1]', 'nvarchar(max)')).value('count(/LISTE_ENTITES/ENTITE[@PAR_DEFAUT="1" and @CODE="" and @VALEUR="" and @LIBELLE=""])', 'int')) FROM v2.DEMANDE_EDITION WHERE DMNED_ID_DMND = (SELECT MAX(DMND_ID_DMND) FROM v2.DEMANDE WHERE DMND_CODE_PROSS = 'GESTBOD') AND DMNED_ENVOI_AU_COFFRE = 0 => 1|0|null|1
