controle: SELECT CONCAT(d.DMND_CODE_PROSS, ':', d.DMND_ETAT_DEMANDE, ':', DATALENGTH(d.DMND_LES_NUMEROS), ':', ISNULL(CAST(d.DMND_ID_AFFRE AS varchar(10)), '-'), ':', (SELECT COUNT(*) FROM v2.DOSSIER_DEMANDE AS x WHERE x.DSSDM_ID_DMND = d.DMND_ID_DMND), ':', (SELECT COUNT(*) FROM v2.DEMANDE_EDITION AS e WHERE e.DMNED_ID_DMND = d.DMND_ID_DMND)) FROM v2.DEMANDE AS d WHERE d.DMND_ID_DMND = (SELECT DSSDM_ID_DMND FROM v2.DOSSIER_DEMANDE WHERE DSSDM_CODE_SEQUENCEUR = '2J' AND DSSDM_VALEUR_SEQUENCEUR = '1700031') => MJUDS:V:11:-:1:0
