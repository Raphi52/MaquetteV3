# Puis Lettrer : l'« annule et refait » de RIG v2. Sans lettrage, tout ce qui est comptabilise se lettre (pas de premier solde pour lui) :
# les memes deux lignes qu'au bloc 7.
geste: Agir Lettrer
ids: C-2300571
resultat: fait
message: 2 lettrages écrits pour 1 client.
controle: SELECT STRING_AGG(CONCAT(CONVERT(char(10), LTTRG_DATE, 23), ' ', CAST(LTTRG_MT_FACTURE AS decimal(9, 2)), ' ', CAST(LTTRG_MT_ENCAISSEMENT AS decimal(9, 2)), ' ', CAST(LTTRG_FACT_HT AS decimal(9, 2)), '/', CAST(LTTRG_REGLE_HT AS decimal(9, 2)), ' ', CAST(LTTRG_FACT_TVA AS decimal(9, 2)), '/', CAST(LTTRG_REGLE_TVA AS decimal(9, 2)), ' ', CAST(LTTRG_FACT_BODACC AS decimal(9, 2)), '/', CAST(LTTRG_REGLE_BODACC AS decimal(9, 2)), ' ', ISNULL(LTTRG_NUMERO_FACTURE, '-'), ' ', ISNULL(CAST(LTTRG_ID_VENTI AS varchar(10)), '-')), ' | ') WITHIN GROUP (ORDER BY LTTRG_ID_LTTRG) FROM v2.LETTRAGE WHERE LTTRG_ID_CLIEN = 2300571 => 2025-01-05 120.00 0.00 90.00/0.00 20.00/0.00 10.00/0.00 L13LF01 - | 2025-01-10 0.00 50.00 0.00/20.00 0.00/20.00 0.00/10.00 - 2300531
