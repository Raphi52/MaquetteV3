# 3. Un type de decision dont les minutes ne sont pas celles des ordonnances du president (JGOP, OPE_DECISION_JUDICIAIRE.cs:67-71).
#    Jumeau accepte : bloc 4, OPCHJ6.
geste: Confirmer Valider
