controle: SELECT CONVERT(int, DTINS_ACTIF) FROM v2.DESTINATAIRE_INSTITUTIONNEL WHERE DTINS_CODE = 'B16NEW' => 1
controle: SELECT COUNT(*) FROM v2.DESTINATAIRE_INSTITUTIONNEL WHERE DTINS_CODE = 'B16NEW' AND DTINS_CIVILITE_DEVELOPPEE IS NULL AND DTINS_FORMULE_POLITESSE IS NULL AND DTINS_NOM_COFFRE IS NULL => 1
controle: SELECT DIHIS_ACTION FROM v2.DESTINATAIRE_INSTITUTIONNEL_HISTO WHERE DIHIS_CODE = 'B16NEW' => Insertion
controle: SELECT DIHIS_LOGIN FROM v2.DESTINATAIRE_INSTITUTIONNEL_HISTO WHERE DIHIS_CODE = 'B16NEW' => banc.ecrans
controle: SELECT COUNT(*) FROM soc.Journal WHERE Ecran = 'Destinataires institutionnels' AND Famille = 'reglage' AND Objet = 'le destinataire institutionnel B16NEW' AND Verbe = 'a cree' => 1
---
# Refus : le code ne se modifie pas (txtCode grise en modification, frmAddDestInst.cs:72 ; message sans source V2). Jumeau accepte : bloc 10,
# le meme destinataire modifie sans toucher au code.
geste: Modifier
ids: B16NEW
valeur: Code = B16AUTRE
resultat: refuse
message: Le code d'un destinataire institutionnel ne se modifie pas (B16NEW) : RIG v2 le grise en modification.
---
# Refus : le nom vide, en modification (l. 253, 257). Jumeau accepte : bloc 10, nom garde.
geste: Modifier
ids: B16NEW
valeur: Nom =
resultat: refuse
message: Modification d'un destinataire institutionnel impossible. Le code, le nom, l'adresse et le type sont obligatoires.
---
# Refus : rien ne change (le nom renvoye tel quel) : un geste qui n'ecrit rien est un refus (EcrivainEcran.cs, point 5 ; la V2
# enregistrerait sans rien changer). Jumeau accepte : bloc 10, adresse et type changes.
geste: Modifier
ids: B16NEW
valeur: Nom = Tribunal de commerce de Grenoble
resultat: refuse
message: Aucune modification du destinataire institutionnel B16NEW : rien n'est enregistré.
---
# Modification acceptee : l'adresse et le type ; l'historique « Modification : » suivi des changements, au format de
# constructionTextChangements (l. 355-375), une ligne par changement ; le type change, la V2 demande confirmation (l. 286-290) : le
# message le rappelle. Les colonnes non envoyees (nom, courriel) gardent la valeur de la base.
geste: Modifier
ids: B16NEW
valeur: Adresse = 2 rue du Greffe 38000 Grenoble
valeur: Type = DDFP
resultat: fait
message: Destinataire institutionnel B16NEW modifié. Attention : le type a changé, ce qui peut avoir des conséquences sur les éditions paramétrées.
controle: SELECT DTINS_TYPE + ' / ' + DTINS_BLOC_ADRESSE + ' / ' + DTINS_LIBELLE + ' / ' + DTINS_ADRESSE_MAIL FROM v2.DESTINATAIRE_INSTITUTIONNEL WHERE DTINS_CODE = 'B16NEW' => DDFP / 2 rue du Greffe 38000 Grenoble / Tribunal de commerce de Grenoble / greffe@tc-grenoble.test
controle: SELECT COUNT(*) FROM v2.DESTINATAIRE_INSTITUTIONNEL_HISTO WHERE DIHIS_CODE = 'B16NEW' AND DIHIS_ACTION = 'Modification : Adresse :1 rue du Greffe 38000 Grenoble modifiée en 2 rue du Greffe 38000 Grenoble' + CHAR(13) + CHAR(10) + 'Type :PROC modifié en DDFP' => 1
---
# Refus : un code absent de la base (message sans source V2 : le bouton de la V2 agit sur une ligne de sa liste). Jumeau accepte : bloc 12.
geste: Supprimer
ids: B16INCONNU
resultat: refuse
message: Destinataire institutionnel introuvable dans la base du greffe (B16INCONNU).
---
# Suppression acceptee (frmListeDestInst.cs:230-231) : l'historique du code, puis le destinataire ; la V2 ne controle rien.
geste: Supprimer
ids: B3VIDE
resultat: fait
message: Destinataire institutionnel B3VIDE « Chambre de commerce » supprimé, avec son historique.
controle: SELECT COUNT(*) FROM v2.DESTINATAIRE_INSTITUTIONNEL WHERE DTINS_CODE = 'B3VIDE' => 0
controle: SELECT COUNT(*) FROM v2.DESTINATAIRE_INSTITUTIONNEL_HISTO WHERE DIHIS_CODE = 'B3VIDE' => 0
controle: SELECT COUNT(*) FROM v2.DESTINATAIRE_INSTITUTIONNEL_HISTO WHERE DIHIS_CODE = 'B16NEW' => 2
