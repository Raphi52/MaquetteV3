controle: SELECT DCMDS_SUPPLEMENT_COPIE + ' / ' + CONVERT(varchar(10), DCMDS_DATE_IMPRESSION_MINUTE, 103) FROM v2.DOCUMENT_DOSSIER WHERE DCMDS_ID_DCMDS = 2000601 => 2 / 20/03/1990
