<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du lot 1 du plan « Reconstruction de RIG, phase 2 » : SOC-006 (envoyer les courriels du greffe
       avec ses modeles et en garder la trace). Un controle par critere CAxx, qui cite son id.
       Il lui faut le SQL Server de developpement (docker compose up -d, racine du depot) et la LECTURE de
       RIG_DEV sur SQL-DEV\DEV (session Windows) : la reprise des modeles y est lue, jamais ecrite.
       Aucun vrai courriel : le banc porte son propre serveur de messagerie jetable (127.0.0.1, port libre)
       et une boite de depot dans un dossier temporaire. Mode d'emploi : docs/reconstruction/socle-courriels.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleCourrielsCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ServeurSmtpJetable.cs" />
    <!-- L'ecran « Courriels envoyés » et son client, joues contre le vrai serveur en memoire. -->
    <Compile Include="../../Pont/ClientServeur.cs" Link="Pont/ClientServeur.cs" />
    <Compile Include="../../Pont/JSInvokable.cs" Link="Pont/JSInvokable.cs" />
    <Compile Include="../../Pont/SessionAgent.cs" Link="Pont/SessionAgent.cs" />
    <Compile Include="../../Pont/EcranCourriels.cs" Link="Pont/EcranCourriels.cs" />
    <!-- L'ecran « Messagerie » (modeles du greffe, listes, apercu : SOC-006 T04, CA05 cote ecran). -->
    <Compile Include="../../Pont/EcranMessagerie.cs" Link="Pont/EcranMessagerie.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
