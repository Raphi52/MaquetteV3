<Project Sdk="Microsoft.NET.Sdk">

  <!-- Banc du PARCOURS COMPLET du RIG v3 (28/11/2026) : chaque entree du menu de l'accueil (Pont/MenuAccueil.cs),
       procedures reunies comprises, ouverte par le pont de l'application contre le vrai serveur en memoire, sur les
       bases des jeux de tests/EcransGeneresBaseCheck. Pour chacune : la forme affichee, des donnees de la base ou
       l'exemple (et pourquoi), un geste joue puis relu. Une ligne n'est verte qu'avec « base + geste prouve ».
       Mode d'emploi et regles : en tete de Program.cs. Il lui faut le SQL Server de developpement : docker compose up -d. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParcoursCompletCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Sondes/*.cs" />
    <!-- L'analyseur des jeux .gestes / .recherches, le meme que celui du banc qui les joue tous. -->
    <Compile Include="../EcransGeneresBaseCheck/Blocs.cs" Link="Blocs.cs" />
    <ProjectReference Include="../../RigV3Desktop.csproj" />
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

</Project>
