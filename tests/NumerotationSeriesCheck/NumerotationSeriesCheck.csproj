<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc des series de numeros reprises de la V2 (lot 6 du plan de reconstruction : NUM-005, NUM-009 a
       NUM-021). Il lit RIG_DEV (SQL-DEV\DEV) en LECTURE SEULE, en fait une copie V2 sur une base jetable
       locale avec le vrai GENERER_NUMERO de RIG_DEV, reprend cette copie dans une base V3 jetable
       (num.Reprendre) et compare, serie par serie, le numero suivant des deux logiciels. Il lui faut le
       SQL Server de developpement (docker compose up -d) et l'acces en lecture a RIG_DEV. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NumerotationSeriesCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
</Project>
