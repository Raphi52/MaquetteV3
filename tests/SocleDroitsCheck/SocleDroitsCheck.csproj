<Project Sdk="Microsoft.NET.Sdk">
  <!-- Banc du lot 3 du plan de reconstruction : SOC-002 (droits repris a l'identique), SOC-004 (comptes
       des agents), SOC-005 (journal des droits), SOC-016 (journal des gestes). Un controle par critere.
       Il lui faut le SQL Server de developpement (docker compose up -d) et, pour la comparaison avec la
       V2, la lecture de RIG_DEV sur SQL-DEV\DEV (session Windows ; RIGV3_V2 pour une autre base V2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SocleDroitsCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="OracleDroitsV2.cs" />
    <Compile Include="BaseV2Jetable.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Serveur/RigV3.Serveur.csproj" />
    <ProjectReference Include="../../Base/RigV3.Migrations.csproj" />
    <ProjectReference Include="../../Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
