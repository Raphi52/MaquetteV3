<Window x:Class="RigV3Desktop.FenetreVue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RIG V3"
        Icon="rig.ico"
        Height="900" Width="1200"
        WindowStartupLocation="Manual"
        Background="#0C0F16">
    <!-- Barre de titre NATIVE, comme la fenetre du document : cette fenetre-ci
         doit se deplacer d'un ecran a l'autre toute seule, sans passer par les
         commandes de la page (qui pilotent la fenetre PRINCIPALE).
         La page (l'application, en mode « onglet sorti ») est branchee par
         Pont/PageWeb.cs sur la racine de cette fenetre. -->
    <Grid>
        <wv2:WebView2 x:Name="Vue" />
    </Grid>
</Window>
