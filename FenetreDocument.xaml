<Window x:Class="RigV3Desktop.FenetreDocument"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RIG V3 - Document"
        Icon="rig.ico"
        Height="900" Width="800"
        WindowStartupLocation="Manual"
        Background="#0C0F16">
    <!-- Barre de titre NATIVE, contrairement a la fenetre principale : cette
         fenetre-ci doit se deplacer, se redimensionner et passer d'un ecran a
         l'autre toute seule, sans dependre des commandes de la page (qui, elles,
         pilotent la fenetre PRINCIPALE via FenetreInterop).
         La page (l'apercu du document de SON emplacement) est branchee par
         Pont/PageWeb.cs sur la racine de cette fenetre. -->
    <Grid>
        <wv2:WebView2 x:Name="Vue" />
    </Grid>
</Window>
