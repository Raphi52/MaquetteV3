<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>rig.ico</ApplicationIcon>
    <!-- web/ (sources React et leur node_modules, des milliers de fichiers) n'est
         PAS un dossier de fichiers du projet : ni compile, ni copie, ni surveille
         par « dotnet watch ». L'exclure ICI, et pas par un Remove apres coup,
         evite aussi que chaque evaluation du projet parcoure node_modules. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);web\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le banc de controle (tests/) a son propre projet : il ne fait pas partie de l'application. -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- La V3 (lot 1 du plan de reconstruction, 20/11/2026) : le serveur, l'outil
         des migrations et les contrats ont chacun leur projet, la documentation
         n'est pas du code. Comme tests/** : rien de ces dossiers (ni leurs obj/,
         dont les .cs generes) n'entre dans l'application. -->
    <Compile Remove="Serveur/**;Base/**;Contrats/**;docs/**" />
    <Content Remove="Serveur/**;Base/**;Contrats/**;docs/**" />
    <None Remove="Serveur/**;Base/**;Contrats/**;docs/**" />
    <!-- Les outils d'exploitation (Outils/, phase 2 du plan) et le lanceur des serveurs
         RDS (Lanceur/, SOC-012) ont aussi leur projet : sans ces lignes, leurs .cs
         entreraient dans RigV3Desktop.exe (doublons de Main, d'App, de types). -->
    <Compile Remove="Outils/**;Lanceur/**" />
    <Content Remove="Outils/**;Lanceur/**" />
    <None Remove="Outils/**;Lanceur/**" />
  </ItemGroup>

  <!-- Les types echanges avec le serveur V3 (Pont/ClientServeur.cs) : le meme
       projet que celui du serveur, pour qu'un champ renomme d'un cote casse la
       compilation de l'autre. -->
  <ItemGroup>
    <ProjectReference Include="Contrats/RigV3.Contrats.csproj" />
  </ItemGroup>

  <!-- ECRANS REACT (web/, migration Blazor -> React du 18/11/2026 ; Blazor
       retire le 19/11/2026). Un « dotnet build » (donc dev.ps1 et lancer.ps1)
       produit l'appli complete sans geste de plus : les paquets npm sont
       installes si besoin, puis Vite construit web/src dans
       wwwroot/app/rig-iles.js (ignore par git), copie avec le reste de wwwroot
       dans le dossier de sortie, que la fenetre sert par un nom d'hote
       virtuel (Pont/PageWeb.cs). Les deux etapes sont INCREMENTALES : rien ne
       tourne si leurs entrees n'ont pas change. Elles sont accrochees a la
       COPIE vers la sortie, pas a la compilation : compiler.ps1 (qui s'arrete
       avant) n'ecrit donc jamais dans wwwroot/app. Mode d'emploi : web/README.md. -->
  <ItemGroup>
    <_EntreesInstallWeb Include="web/package.json;web/package-lock.json" />
    <_EntreesConstructionWeb Include="web/src/**/*;web/package.json;web/package-lock.json;web/vite.config.ts;web/tsconfig.json" />
  </ItemGroup>

  <Target Name="VerifierNodeWeb" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm --version" StandardOutputImportance="low" IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_CodeNpm" />
    </Exec>
    <Error Condition="'$(_CodeNpm)' != '0'"
           Text="Node.js (npm) est requis pour construire les ecrans React de web/ : installer Node 22 ou plus recent (https://nodejs.org), puis relancer." />
  </Target>

  <!-- LA REGLE « PAQUETS A JOUR » (19/11/2026) : web/node_modules est installe
       quand le marqueur .rig-install-ok manque ou qu'il est plus ancien que
       package.json ou package-lock.json. C'est la SEULE definition de la regle :
       compiler.ps1, dev.ps1 (AVANT de lancer Vite) et tests.ps1 appellent cette
       cible (« dotnet msbuild -t:InstallerWeb », ~1 s quand tout est a jour)
       au lieu de tester la presence d'un binaire. Tester « tsc.cmd existe »
       laissait des paquets PERIMES en place apres l'ajout de @types/node
       (TS2591 dans vite.config.ts, compiler.ps1 rouge).
       GARDE : npm ci EFFACE node_modules avant de reinstaller. Si un processus
       de CE dossier le tient (serveur Vite de dev.ps1, vitest, esbuild), Windows
       refuse d'effacer les fichiers charges, l'installation s'arrete a moitie
       (mesure : 14 paquets sur 77) et le serveur Vite casse sous l'utilisateur.
       On s'arrete donc AVANT d'effacer, en nommant les processus. Le chemin
       passe par l'environnement : sur la ligne de commande, le PowerShell de
       la garde se trouverait lui-meme. -->
  <Target Name="InstallerWeb" DependsOnTargets="VerifierNodeWeb"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_EntreesInstallWeb)" Outputs="web/node_modules/.rig-install-ok">
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;$d = $env:RIG_WEB_MODULES.ToLower().Replace('/','\'); $p = Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -ne $PID -and (('' + $_.CommandLine + ' ' + $_.ExecutablePath).ToLower().Replace('/','\')).Contains($d) }; foreach ($x in $p) { Write-Host ('  pid ' + $x.ProcessId + ' ' + $x.Name) }; if ($p) { exit 3 }&quot;"
          EnvironmentVariables="RIG_WEB_MODULES=$(MSBuildProjectDirectory)\web\node_modules\"
          IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_CodeWebEnUsage" />
    </Exec>
    <Error Condition="'$(_CodeWebEnUsage)' == '3'"
           Text="Paquets npm a mettre a jour (web/package.json ou package-lock.json plus recent que la derniere installation), mais web/node_modules est tenu par les processus ci-dessus (serveur Vite de dev.ps1, vitest...) : npm ci les effacerait sous eux. Une fois ces processus termines, relancer : dev.ps1 met les paquets a jour AVANT de demarrer Vite." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)/web" />
    <Touch Files="web/node_modules/.rig-install-ok" AlwaysCreate="true" />
  </Target>

  <Target Name="ConstruireWeb" DependsOnTargets="InstallerWeb"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(_EntreesConstructionWeb)" Outputs="wwwroot/app/rig-iles.js">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/web" />
  </Target>

  <!-- wwwroot/ est copie tel quel dans la sortie. Ses fichiers fixes (charte,
       documents, Kbis) le sont par le None ci-dessous ; wwwroot/app/ peut NAITRE
       pendant ce build (copie neuve, dossier vide par Vite), apres que la liste
       des None a ete dressee : il est donc copie par CopierWeb, qui le liste
       une fois la construction faite. -->
  <ItemGroup>
    <None Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="wwwroot/app/**" />
  </ItemGroup>

  <Target Name="CopierWeb" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="ConstruireWeb"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_SortieWeb Include="wwwroot/app/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_SortieWeb)"
          DestinationFiles="@(_SortieWeb->'$(OutDir)wwwroot/app/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="rig.ico" />
  </ItemGroup>

  <!-- « dotnet watch » ne doit PAS reconstruire sur un changement de wwwroot :
       la fenetre surveille elle-meme ces fichiers et recharge sa page (voir
       MainWindow.xaml.cs), et les .tsx sont repris par le serveur Vite
       (dev.ps1). Sans cette exclusion, watch relance une compilation qui
       echoue, l'application etant en cours d'execution et verrouillant
       RigV3Desktop.exe. Les journaux sont exclus pour la meme raison. -->
  <ItemGroup>
    <Watch Remove="wwwroot/**" />
    <Watch Remove="**/*.log" />
    <Watch Remove="tests/**" />
    <!-- Ni le serveur V3, ni ses migrations, ni la documentation : l'app n'en
         depend pas (Contrats/, si : l'app le reference, une retouche la reconstruit). -->
    <Watch Remove="Serveur/**;Base/**;docs/**" />
    <Watch Remove="Outils/**;Lanceur/**" />
  </ItemGroup>

  <!-- Le controle WebView2 DIRECT (19/11/2026, retrait de Blazor). Version
       1.0.3179.45 : celle que le BlazorWebView 9.0.120 tirait deja, donc le
       moteur d'affichage prouve sur le bureau cache. Le controle classique
       (Microsoft.Web.WebView2.Wpf.WebView2), PAS WebView2CompositionControl :
       c'est ce dernier qui laissait la page blanche avec le BlazorWebView 10
       (github.com/dotnet/wpf/issues/11291). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

</Project>
